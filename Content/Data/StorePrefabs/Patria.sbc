ViewPortOffsetX=8
ViewPortOffsetY=8
ShowBars=true
UseColors=true

[Mercenary.SpaceMap]
gridScale=1000
scanRadius=20000

[SettingsLifeSupportStatus]
; [ LIFESUPPORT - GENERAL OPTIONS ]
SearchId=*
ExcludeIds=Airlock,
ShowHeader=True
ShowSubgrids=False
SubgridUpdateFrequency=100
; Subgrid scan frequency: 1=fastest (60/sec), 10=normal (6/sec), 100=slowest (0.6/sec)
ShowDocked=False
UseColors=True
; [ LIFESUPPORT - LAYOUT OPTIONS ]
TextSize=0.45
ViewPortOffsetX=12
ViewPortOffsetY=12
TitleFieldWidth=128
RatioFieldWidth=96
; [ LIFESUPPORT - SCREEN OPTIONS ]
ShowBatteries=True
ShowHydrogen=True
ShowOxygen=True
ShowIce=True
ShowVent=True
ShowIntakeVent=True
; [ LIFESUPPORT - ITEM THRESHOLDS ]
IceMinAmount=50000

[SettingsSystemsStatus]

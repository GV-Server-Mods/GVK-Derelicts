                            <Value>[SettingsAmmoSummary]

; [ AMMO - GENERAL OPTIONS ]
SearchId=*
; Block name filter: Use '*' for all, or text to match block names (case-insensitive substring match)
; Examples: 'Cargo' matches 'Main Cargo', 'Engineering,Medical' matches blocks containing either word
ExcludeIds=
; Exclude blocks containing these words (comma-separated, case-insensitive)
; Example: 'Airlock,Backup' excludes blocks with 'Airlock' or 'Backup' in their names
ShowHeader=True
; Display the app title bar at the top of the screen

ShowSummary=True
; Display summary totals at the top (combined statistics for all matching blocks)

ShowMissing=False
; Display items that have zero quantity (show empty inventory slots)

ShowRatio=False
; Display current/maximum values as numbers instead of percentages

ShowBars=True
; Display visual progress bars for capacity and resource levels

ShowSubgrids=False
; Include blocks from subgrids connected via rotors, pistons, and hinges

SubgridUpdateFrequency=100
; Subgrid scan frequency: 1=fastest (60/sec), 10=normal (6/sec), 100=slowest (0.6/sec)

ShowDocked=False
; Include blocks from grids connected via ship connectors

UseColors=True
; Enable color-coded status indicators (green=good, yellow=warning, red=critical)


; [ SCROLLING OPTIONS ]
ToggleScroll=False
; Enable scrolling to view items that don't fit on screen
; Set to 'true' to activate. Scrolling only occurs when there's overflow data.

ReverseDirection=False
; Scroll direction: 'false' scrolls up (bottom items appear), 'true' scrolls down (top items appear)
; The list wraps around, so you'll eventually see all items in a continuous loop

ScrollSpeed=5
; Time between scroll steps in ticks (60 ticks ≈ 1 second at normal game speed)
; Lower = faster scrolling, Higher = slower scrolling

ScrollLines=1
; Number of lines to scroll per step
; Set to 1 for smooth scrolling, higher values for faster navigation

; [ AMMO - LAYOUT OPTIONS ]
TextSize=0.4
ViewPortOffsetX=20
ViewPortOffsetY=10
TitleFieldWidth=280
RatioFieldWidth=82

; [ AMMO - SCREEN OPTIONS ]
showAmmo=True
showHandAmmo=True
UseSubtypeId=False

; [ AMMO - ITEM THRESHOLDS ]
LargeCalibreAmmo=250
MediumCalibreAmmo=500
AutocannonClip=500
FireworksBoxBlue=0

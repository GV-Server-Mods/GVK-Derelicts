<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<!-- Base-game planetary encounters (SpawnGroups_PlanetaryEncounters.sbc), redefined with Enabled = false.
	     MES turns every base-game IsPlanetaryEncounter group into a Planetary Installation and skips disabled
	     spawn groups (SpawnGroupManager.cs:606). Copied from the base game; only Enabled was added. -->
	<SpawnGroups>
        <SpawnGroup>
            <Id>
                <TypeId>SpawnGroupDefinition</TypeId>
                <SubtypeId>P1_SupplyPost</SubtypeId>
            </Id>
            <Enabled>false</Enabled>
            <IsPlanetaryEncounter>true</IsPlanetaryEncounter>
            <Frequency>1</Frequency>
            <ReactorsOn>true</ReactorsOn>
            <Prefabs>
                <Prefab SubtypeId="P1_SupplyPost">
                </Prefab>
            </Prefabs>
            <FactionTypes>
                <Type>Builder</Type>
            </FactionTypes>
			<PlanetaryInstallationSettings>
				<Planets>
					<PlanetName>Alien</PlanetName>
					<PlanetName>EarthLike</PlanetName>
					<PlanetName>Mars</PlanetName>
					<PlanetName>Pertam</PlanetName>
					<PlanetName>Titan</PlanetName>
				</Planets>
				<VoxelMaterials>
					<MaterialTypeName>Sand</MaterialTypeName>
					<MaterialTypeName>MarsSoil</MaterialTypeName>
					<MaterialTypeName>MoonSoil</MaterialTypeName>
					<MaterialTypeName>Snow</MaterialTypeName>
					<MaterialTypeName>Grass</MaterialTypeName>
					<MaterialTypeName>GrassDry</MaterialTypeName>
					<MaterialTypeName>Soil</MaterialTypeName>
					<MaterialTypeName>AlienGreenGrass</MaterialTypeName>
					<MaterialTypeName>OrangeAlienGrass</MaterialTypeName>
					<MaterialTypeName>AlienYellowGrass</MaterialTypeName>
					<MaterialTypeName>SoilDry</MaterialTypeName>
				</VoxelMaterials>
			</PlanetaryInstallationSettings>
        </SpawnGroup>

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- 
		
			TriggerGroups available:
				[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-SmallUnit]
				[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-SmallUnit-COALITION]
				[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-SmallUnit-GAALSIEN]
				[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-MediumUnit]
				[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-MediumUnit-COALITION]
				[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-MediumUnit-GAALSIEN]
				[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-LargeUnit]
				[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-LargeUnit-COALITION]
				[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-LargeUnit-GAALSIEN]
			
			The Unit-specific defaults. Targeting, weapon range and combat chatter are in GVK-Universal-TriggerGroup-CombatDefaults,
			which every behavior using one of these groups also lists, directly before it.
		
		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-TriggerGroup-UnitDefaults-SmallUnit</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Unit-All-Trigger-BarrelRoll]
			[Triggers:GVK-Universal-Trigger-DespawnInZ0]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-TriggerGroup-UnitDefaults-SmallUnit-COALITION</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Unit-All-Trigger-BarrelRoll]
			[Triggers:GVK-Unit-Encounter-Trigger-SpawnSmallGAALSIENAttackers]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-TriggerGroup-UnitDefaults-SmallUnit-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LargeFlyerFighterPlane Autopilots: large-grid aircraft with fixed forward guns (Chad Shuttle, GR-650).
		     Guns reach about 2000 m. The Strike offset sits 1800-2200 m out, about the edge of gun range, for closer and quicker passes (owner, 2026-11-11; GVK-Settings#730).
		     At 3000-3400 m each run started lined up well outside gun range, but a pass took about 30 s. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Patrol</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:true]
				[CollisionEvasionWaypointDistance:50]
				[CollisionFallEvasionWaypointDistance:35]
				[RotationMultiplier:0.7]
				[RotationMultiplierPitch:2]
				[RotationMultiplierRoll:2]
				[LimitPitchTurning:true]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:true]
				[MaxVerticalSpeed:20]
				[IdealPlanetAltitude:600]
				[MinimumPlanetAltitude:450]
				[AltitudeTolerance:50]
				[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
				[WaypointTolerance:100]
				[WaypointWaitTimeTrigger:0]
				[WaypointAbandonTimeTrigger:30]
				[IdealMinSpeed:50]
				[IdealMaxSpeed:50]
				[SlowDownOnWaypointApproach:false]
				[OffsetPlanetMinDistFromTarget:600]
				[OffsetPlanetMaxDistFromTarget:601]
				[OffsetPlanetMinTargetAltitude:300]
				[OffsetPlanetMaxTargetAltitude:500]
				[AngleAllowedForForwardThrust:90]
				[MaxVelocityAngleForSpeedControl:180]
				[UseAircraftFlightModel:true]
				[MaxAngleFromVelocity:60]
				[RollIntoTurnsMultiplier:0.6]
				[MaxBankAngle:30]
				[ReturnToLevelMultiplier:0.25]
				[MaxRotationStep:0.5]
				[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Strike</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[AttackRunDistancePlanet:500]
				[AttackRunBreakawayDistance:600]
				[AttackRunOverrideWithDistanceAndTimer:true]
				[AttackRunOverrideTimerTrigger:3]
				[AttackRunOverrideDistance:1000]
				[OffsetRecalculationTime:40]
				[AttackRunUseSafePlanetPathing:false]
				[AttackRunUseCollisionEvasionPlanet:false]
				[WaypointWaitTimeTrigger:0]
				[WaypointAbandonTimeTrigger:30]
				[RotationMultiplier:0.7]
				[RotationMultiplierPitch:2]
				[RotationMultiplierRoll:2]
				[LimitPitchTurning:true]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[//A line-up point under the minimum altitude is moved up to halfway between it and this, so against a ground target every line-up sits about 440 m up (340 m at 600, until GVK-Settings#730).]
				[IdealPlanetAltitude:800]
				[//The run aims straight at the target and ignores this floor; below it on the way out, planet pathing climbs nearly straight up to IdealPlanetAltitude.]
				[//At 400 a run from the line-up point ended below it, so every breakaway climbed vertically over the target. 75 is only a terrain floor.]
				[MinimumPlanetAltitude:75]
				[AltitudeTolerance:50]
				[WaypointTolerance:200]
				[IdealMinSpeed:80]
				[//Large grids top out at about 90 m/s on the server (owner, 2026-11-11).]
				[IdealMaxSpeed:90]
				[OffsetPlanetMinDistFromTarget:1800]
				[OffsetPlanetMaxDistFromTarget:2200]
				[OffsetPlanetMinTargetAltitude:-100]
				[OffsetPlanetMaxTargetAltitude:100]
				[AngleAllowedForForwardThrust:180]
				[MaxVelocityAngleForSpeedControl:180]
				[UseAircraftFlightModel:true]
				[MaxAngleFromVelocity:60]
				[RollIntoTurnsMultiplier:1]
				[MaxBankAngle:30]
				[ReturnToLevelMultiplier:0.25]
				[MaxRotationStep:0.5]
				[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Dogfight: swapped into the Secondary slot against a target more than 100 m up (GVK-Unit-All-TriggerGroup-LargeFlyerFighterPlaneDogfight). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Dogfight</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[AttackRunDistancePlanet:300]
				[AttackRunBreakawayDistance:350]
				[AttackRunOverrideWithDistanceAndTimer:true]
				[//A chased plane may never reach its line-up point: within 550 m of it for 3 s, it turns in anyway.]
				[AttackRunOverrideTimerTrigger:3]
				[AttackRunOverrideDistance:550]
				[//The line-up point moves with the target and is only re-rolled after this many seconds; reaching one up to ~1.6 km away after a pass, with the slow turn, takes ~25 s at 80-90 m/s.]
				[OffsetRecalculationTime:30]
				[AttackRunUseSafePlanetPathing:false]
				[AttackRunUseCollisionEvasionPlanet:false]
				[WaypointWaitTimeTrigger:0]
				[WaypointAbandonTimeTrigger:30]
				[RotationMultiplier:0.7]
				[RotationMultiplierPitch:2]
				[RotationMultiplierRoll:2]
				[LimitPitchTurning:true]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[//A line-up point under the minimum altitude is moved up to halfway between it and the ideal one. Strike's 400 and 600 m put every line-up against a lower aircraft at 500 m, and a
				chasing plane followed it up.]
				[//200 and 400 (150 and 300 until GVK-Settings#730): a fight near the ground lines up no lower than 200 m, and a lower point goes to 300 m.]
				[IdealPlanetAltitude:400]
				[MinimumPlanetAltitude:200]
				[AltitudeTolerance:50]
				[WaypointTolerance:200]
				[IdealMinSpeed:80]
				[IdealMaxSpeed:90]
				[//Line-up points 0.9-1.2 km out (inside gun range; 1.2-1.6 km until GVK-Settings#730), 50-200 m below the target. Two NPC planes fighting each other only have each other's height to go by, and the
				minimum-altitude rules only push up, so with points above the target the pair climbed together, and with points up to 150 m below it the pair still drifted up (a plane can only pitch nose-up toward a point behind it; GVK-Settings#742, 2026-11-09). 150-300 m below sometimes flew planes into the ground (owner, 2026-11-09).]
				[OffsetPlanetMinDistFromTarget:900]
				[OffsetPlanetMaxDistFromTarget:1200]
				[OffsetPlanetMinTargetAltitude:-200]
				[OffsetPlanetMaxTargetAltitude:-50]
				[AngleAllowedForForwardThrust:180]
				[MaxVelocityAngleForSpeedControl:180]
				[UseAircraftFlightModel:true]
				[MaxAngleFromVelocity:60]
				[RollIntoTurnsMultiplier:1]
				[//Dogfight turns run far off heading, so they bank at this cap (30 until GVK-Settings#730). If a plane dives in a turn, raise MaxAngleFromVelocity first, then lower this.]
				[MaxBankAngle:40]
				[ReturnToLevelMultiplier:0.25]
				[MaxRotationStep:0.5]
				[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Break: loaded by the dogfight group's Chased trigger when the target chases the plane, and swapped back for Dogfight when the run ends. The Dogfight profile with only the run distances and bank cap changed (tools/Test-Docs.ps1 checks). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Break</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[//Wider than any line-up distance, so the run starts at once and the plane turns at its chaser instead of flying to a line-up point that moves with it.]
				[AttackRunDistancePlanet:5000]
				[//Strike starts no run with the target inside this distance; at Dogfight's 350 a close chaser blocks it.]
				[AttackRunBreakawayDistance:200]
				[AttackRunOverrideWithDistanceAndTimer:true]
				[AttackRunOverrideTimerTrigger:3]
				[AttackRunOverrideDistance:550]
				[OffsetRecalculationTime:30]
				[AttackRunUseSafePlanetPathing:false]
				[AttackRunUseCollisionEvasionPlanet:false]
				[WaypointWaitTimeTrigger:0]
				[WaypointAbandonTimeTrigger:30]
				[RotationMultiplier:0.7]
				[RotationMultiplierPitch:2]
				[RotationMultiplierRoll:2]
				[LimitPitchTurning:true]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[//200 and 400 (150 and 300 until GVK-Settings#730): a fight near the ground lines up no lower than 200 m, and a lower point goes to 300 m.]
				[IdealPlanetAltitude:400]
				[MinimumPlanetAltitude:200]
				[AltitudeTolerance:50]
				[WaypointTolerance:200]
				[IdealMinSpeed:80]
				[IdealMaxSpeed:90]
				[OffsetPlanetMinDistFromTarget:900]
				[OffsetPlanetMaxDistFromTarget:1200]
				[OffsetPlanetMinTargetAltitude:-200]
				[OffsetPlanetMaxTargetAltitude:-50]
				[AngleAllowedForForwardThrust:180]
				[MaxVelocityAngleForSpeedControl:180]
				[UseAircraftFlightModel:true]
				[MaxAngleFromVelocity:60]
				[RollIntoTurnsMultiplier:1]
				[//5 above Dogfight's cap, never below it: the break turn lasts a few seconds, so it costs little height.]
				[MaxBankAngle:45]
				[ReturnToLevelMultiplier:0.25]
				[MaxRotationStep:0.5]
				[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
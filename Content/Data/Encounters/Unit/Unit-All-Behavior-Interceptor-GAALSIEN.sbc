<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallFlyer-Interceptor Patrol to Hosrefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Behavior-Interceptor-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[DialogueBanks:GVK-Units-GAALSIEN-Small.xml]
			[WeaponSystem:GVK-Universal-Weapons-Static90]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:240]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km-GAALSIEN]
			[AutopilotData:GVK-Unit-Autopilot-Interceptor-Passive]
			[SecondaryAutopilotData:GVK-Unit-Autopilot-Interceptor-Aggressive]
			[Triggers:GVK-Unit-All-Trigger-Init-Interceptor-GAALSIEN]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-SmallUnit-GAALSIEN]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-PeerEscort-Air]
			[EscortOffsets:{X:150 Y:0 Z:100}]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-PatrolHorseflyKPL]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Trigger-Init-Interceptor-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:true]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-Unit-All-Action-Init-Interceptor-GAALSIEN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Action-Init-Interceptor-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,UnitSmall]
			[CustomStrings:EncounterDisplayName,aircraft]
			[SetBooleansTrue:GVK_MobilityType_Aircraft]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- MediumHoverHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Behavior-MediumHoverPatrolHorsefly-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[DialogueBanks:GVK-Units-GAALSIEN-Medium.xml]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:240]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km-GAALSIEN]
			[AutopilotData:GVK-Unit-All-Autopilot-MediumHoverPatrolHorsefly-Passive]
			[SecondaryAutopilotData:GVK-Unit-All-Autopilot-MediumHoverPatrolHorsefly-Aggressive]
			[Triggers:GVK-Unit-All-Trigger-Init-MediumHoverPatrolHorsefly-GAALSIEN]
			[TriggerGroups:GVK-Universal-TriggerGroup-CombatDefaults]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-MediumUnit-GAALSIEN]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-PatrolHorseflyKPL]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-FlyAwayFailsafe]
			[TriggerGroups:GVK-ConvoySystem-Escort-TriggerGroup]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Trigger-Init-MediumHoverPatrolHorsefly-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:true]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-Unit-All-Action-Init-MediumHoverPatrolHorsefly-GAALSIEN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Action-Init-MediumHoverPatrolHorsefly-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,UnitMedium]
			[CustomStrings:EncounterDisplayName,craft]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>
		<!-- These are separate from Unit Encounters since spawn groups are called directly by the spawner -->
		<!-- NUN Interceptor Flyer Single-->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<!--Do
				Not Edit-->
				<SubtypeId>GVK-Unit-Defense-SpawnGroup-KHAANEPH-InterceptorSingle</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:GVK-Universal-Manipulation-Small5x5StandardTurrets]
				[ManipulationProfiles:GVK-Unit-All-Manipulation-Interceptor]
				[SpawnConditionsProfiles:GVK-Unit-Defense-SpawnCondition-KHAANEPH-InterceptorSingle]
			</Description>
			<IsPirate>true</IsPirate>
			<!--Do
			not edit-->
			<Frequency>0.2</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NUN [KHAA] Interceptor">
					<Position>
						<X>0</X>
						<Y>0.0</Y>
						<Z>0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Interceptor</BeaconText>
					<Behaviour>GVK-Unit-Behavior-Interceptor-KHAANEPH</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

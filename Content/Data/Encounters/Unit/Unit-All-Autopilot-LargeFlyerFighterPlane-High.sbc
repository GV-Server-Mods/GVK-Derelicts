<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
			GENERATED by tools/New-DogfightGroup.ps1 (group LargeFlyerFighterPlane) from Unit-All-Autopilot-LargeFlyerFighterPlane.sbc. Do not edit by hand; edit the original profiles and rerun the script.
			Copies of the Dogfight and Break profiles with LimitPitchTurning off. GVK-Unit-All-TriggerGroup-LargeFlyerFighterPlaneDogfight loads them above 1000 m and puts the originals back under 900 m.
		-->
		<!-- GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Dogfight with LimitPitchTurning off, loaded above 1000 m -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-DogfightHigh</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[AttackRunDistancePlanet:300]
				[AttackRunBreakawayDistance:500]
				[AttackRunOverrideWithDistanceAndTimer:true]
				[//A chased plane may never reach its line-up point: within 700 m of it for 3 s, it turns in anyway.]
				[AttackRunOverrideTimerTrigger:3]
				[AttackRunOverrideDistance:700]
				[//The line-up point moves with the target and is only re-rolled after this many seconds; reaching one up to ~2 km away after a pass, with the slow turn, takes ~30 s at 80-100 m/s.]
				[OffsetRecalculationTime:35]
				[AttackRunUseSafePlanetPathing:false]
				[AttackRunUseCollisionEvasionPlanet:false]
				[WaypointWaitTimeTrigger:0]
				[WaypointAbandonTimeTrigger:30]
				[RotationMultiplier:0.7]
				[RotationMultiplierPitch:2]
				[RotationMultiplierRoll:2]
				[LimitPitchTurning:false]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[//A line-up point under the minimum altitude is moved up to halfway between it and the ideal one. Strike's 400 and 600 m put every line-up against a lower aircraft at 500 m, and a
				chasing plane followed it up.]
				[IdealPlanetAltitude:300]
				[MinimumPlanetAltitude:150]
				[AltitudeTolerance:50]
				[WaypointTolerance:200]
				[IdealMinSpeed:80]
				[IdealMaxSpeed:100]
				[//Line-up points 1.2-1.6 km out (inside gun range), 50-200 m below the target. Two NPC planes fighting each other only have each other's height to go by, and the
				minimum-altitude rules only push up, so with points above the target the pair climbed together, and with points up to 150 m below it the pair still drifted up (a plane can only pitch nose-up toward a point behind it; GVK-Settings#742, 2026-11-09). 150-300 m below sometimes flew planes into the ground (owner, 2026-11-09).]
				[OffsetPlanetMinDistFromTarget:1200]
				[OffsetPlanetMaxDistFromTarget:1600]
				[OffsetPlanetMinTargetAltitude:-200]
				[OffsetPlanetMaxTargetAltitude:-50]
				[AngleAllowedForForwardThrust:180]
				[MaxVelocityAngleForSpeedControl:180]
				[UseAircraftFlightModel:true]
				[MaxAngleFromVelocity:60]
				[RollIntoTurnsMultiplier:0.75]
				[//Dogfight turns run far off heading, so they bank at this cap (30 until GVK-Settings#730). If a plane dives in a turn, raise MaxAngleFromVelocity first, then lower this.]
				[MaxBankAngle:40]
				[ReturnToLevelMultiplier:0.25]
				[MaxRotationStep:0.5]
				[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Break with LimitPitchTurning off, loaded above 1000 m -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-BreakHigh</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[//Wider than any line-up distance, so the run starts at once and the plane turns at its chaser instead of flying to a line-up point that moves with it.]
				[AttackRunDistancePlanet:5000]
				[//Strike starts no run with the target inside this distance; at Dogfight's 500 a close chaser blocks it.]
				[AttackRunBreakawayDistance:200]
				[AttackRunOverrideWithDistanceAndTimer:true]
				[AttackRunOverrideTimerTrigger:3]
				[AttackRunOverrideDistance:700]
				[OffsetRecalculationTime:35]
				[AttackRunUseSafePlanetPathing:false]
				[AttackRunUseCollisionEvasionPlanet:false]
				[WaypointWaitTimeTrigger:0]
				[WaypointAbandonTimeTrigger:30]
				[RotationMultiplier:0.7]
				[RotationMultiplierPitch:2]
				[RotationMultiplierRoll:2]
				[LimitPitchTurning:false]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[IdealPlanetAltitude:300]
				[MinimumPlanetAltitude:150]
				[AltitudeTolerance:50]
				[WaypointTolerance:200]
				[IdealMinSpeed:80]
				[IdealMaxSpeed:100]
				[OffsetPlanetMinDistFromTarget:1200]
				[OffsetPlanetMaxDistFromTarget:1600]
				[OffsetPlanetMinTargetAltitude:-200]
				[OffsetPlanetMaxTargetAltitude:-50]
				[AngleAllowedForForwardThrust:180]
				[MaxVelocityAngleForSpeedControl:180]
				[UseAircraftFlightModel:true]
				[MaxAngleFromVelocity:60]
				[RollIntoTurnsMultiplier:0.75]
				[//5 above Dogfight's cap, never below it: the break turn lasts a few seconds, so it costs little height.]
				[MaxBankAngle:45]
				[ReturnToLevelMultiplier:0.25]
				[MaxRotationStep:0.5]
				[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- COALITION Unit Patrol/Strike trigger group, does not need KPL -->
		<!-- requires two autopilots: pimary passive and secondary aggressive -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-TriggerGroup-LAVFlyLevelOnJump</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Unit-All-LAVFlyLevelOnJump-Trigger-AboveAltitude]
			[Triggers:GVK-Unit-All-LAVFlyLevelOnJump-Trigger-BelowAltitude]
			</Description>
		</EntityComponent>
		<!-- Check for large altitude gain -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Trigger-AboveAltitude</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:false]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[Actions:GVK-Unit-All-LAVFlyLevelOnJump-Action-AboveAltitude]
			[ToggleWithTriggerProfile:GVK-Unit-All-LAVFlyLevelOnJump-Trigger-BelowAltitude]
			[ToggledProfileResetsCooldown:true]
			[Conditions:GVK-Unit-All-LAVFlyLevelOnJump-Condition-AboveAltitude]
			[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Condition-AboveAltitude</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[AltitudeCheck:true]
			[MinAltitude:21]
			[MaxAltitude:10000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Action-AboveAltitude</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Trigger AboveAltitude]
			[StopAllThrust:true]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Tertiary]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Trigger-BelowAltitude</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[StartsReady:false]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[Actions:GVK-Unit-All-LAVFlyLevelOnJump-Action-BelowAltitude]
			[ToggleWithTriggerProfile:GVK-Unit-All-LAVFlyLevelOnJump-Trigger-AboveAltitude]
			[ToggledProfileResetsCooldown:true]
			[Conditions:GVK-Unit-All-LAVFlyLevelOnJump-Condition-BelowAltitude]
			[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Condition-BelowAltitude</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[AltitudeCheck:true]
			[MinAltitude:0]
			[MaxAltitude:20]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Action-BelowAltitude</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Trigger BelowAltitude]
			[StopAllThrust:false]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
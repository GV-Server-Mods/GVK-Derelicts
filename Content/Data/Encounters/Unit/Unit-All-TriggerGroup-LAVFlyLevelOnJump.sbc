<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LAV jumps: above 21 m cut thrust and fly level (GVK-Unit-All-Autopilot-LAV-BigAirTime) so it lands on its wheels.
		     The Tertiary slot normally holds GVK-Unit-All-Autopilot-LAVWing (the peer-wing autopilot), so the jump loads BigAirTime into it with
		     OverwriteAutopilotProfile and the landing puts LAVWing back, then returns to the autopilot of the LAV's role:
		     Tertiary as a wing, Secondary in combat (GVK_InCombat), Primary on patrol. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-TriggerGroup-LAVFlyLevelOnJump</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Unit-All-LAVFlyLevelOnJump-Trigger-AboveAltitude]
			[Triggers:GVK-Unit-All-LAVFlyLevelOnJump-Trigger-BelowAltitude]
			[Triggers:GVK-Unit-All-LAVFlyLevelOnJump-ManualTrigger-LandAsWing]
			[Triggers:GVK-Unit-All-LAVFlyLevelOnJump-ManualTrigger-LandInCombat]
			[Triggers:GVK-Unit-All-LAVFlyLevelOnJump-ManualTrigger-LandOnPatrol]
			</Description>
		</EntityComponent>
		<!-- Check for large altitude gain -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Trigger-AboveAltitude</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:false]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[Actions:GVK-Unit-All-LAVFlyLevelOnJump-Action-AboveAltitude]
			[ToggleWithTriggerProfile:GVK-Unit-All-LAVFlyLevelOnJump-Trigger-BelowAltitude]
			[ToggledProfileResetsCooldown:true]
			[Conditions:GVK-Unit-All-LAVFlyLevelOnJump-Condition-AboveAltitude]
			[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Condition-AboveAltitude</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[AltitudeCheck:true]
			[MinAltitude:21]
			[MaxAltitude:10000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Action-AboveAltitude</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[StopAllThrust:true]
			[OverwriteAutopilotProfile:true]
			[OverwriteAutopilotMode:Tertiary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-LAV-BigAirTime]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Tertiary]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Trigger-BelowAltitude</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[StartsReady:false]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[Actions:GVK-Unit-All-LAVFlyLevelOnJump-Action-BelowAltitude]
			[ToggleWithTriggerProfile:GVK-Unit-All-LAVFlyLevelOnJump-Trigger-AboveAltitude]
			[ToggledProfileResetsCooldown:true]
			[Conditions:GVK-Unit-All-LAVFlyLevelOnJump-Condition-BelowAltitude]
			[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Condition-BelowAltitude</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[AltitudeCheck:true]
			[MinAltitude:0]
			[MaxAltitude:20]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Action-BelowAltitude</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[StopAllThrust:false]
			[OverwriteAutopilotProfile:true]
			[OverwriteAutopilotMode:Tertiary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-LAVWing]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerTags:GVK-TriggerTags-LAVLanded]
			</Description>
		</EntityComponent>
		<!-- Landed: exactly one of these three passes its condition -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-ManualTrigger-LandAsWing</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:GVK-TriggerTags-LAVLanded]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:GVK-Unit-All-LAVFlyLevelOnJump-Condition-Wing]
			[Actions:GVK-Unit-All-LAVFlyLevelOnJump-Action-LandAsWing]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Condition-Wing</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_Role_Escort]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Action-LandAsWing</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Tertiary]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-ManualTrigger-LandInCombat</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:GVK-TriggerTags-LAVLanded]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:GVK-Unit-All-LAVFlyLevelOnJump-Condition-InCombat]
			[Actions:GVK-Unit-All-LAVFlyLevelOnJump-Action-LandInCombat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Condition-InCombat</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_InCombat]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_Role_Escort]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Action-LandInCombat</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-ManualTrigger-LandOnPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:GVK-TriggerTags-LAVLanded]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:GVK-Unit-All-LAVFlyLevelOnJump-Condition-OnPatrol]
			[Actions:GVK-Unit-All-LAVFlyLevelOnJump-Action-LandOnPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Condition-OnPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_InCombat]
			[FalseBooleans:GVK_Role_Escort]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LAVFlyLevelOnJump-Action-LandOnPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- GAALSIEN and KHAANEPH Salvagers share the autopilot and triggers; each has its own behavior only for its dialogue bank -->
		<!-- Salvager Hover Unit Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Behavior-Salvager-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[DialogueBanks:GVK-Units-GAALSIEN-Medium.xml]
			[UsePlayerDistanceTimer:false]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:true]
			[RetreatTimerTrigger:1800]
			[RetreatDespawnDistance:2000]
			[AutopilotData:GVK-Unit-Encounter-Autopilot-Salvager-GAALSIEN]
			[SecondaryAutopilotData:GVK-Unit-Encounter-Autopilot-Salvager-GAALSIEN-Secondary]
			[TargetData:GVK-Universal-Target-EnemyGrids2km-GAALSIEN]
			[Triggers:GVK-Universal-Trigger-TargetAttacker]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-SalvagerDefeated]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-SalvagerRetreat]
			[TriggerGroups:GVK-ConvoySystem-Escort-TriggerGroup]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-SalvagerEscortHooks]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
			[Triggers:GVK-Unit-Encounter-Salvager-GAALSIEN-Trigger-EncounterInit]
			[TriggerGroups:GVK-Universal-TriggerGroup-DespawnInKOTH]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Behavior-Salvager-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[DialogueBanks:GVK-Units-KHAANEPH-Medium.xml]
			[//CopyOf:GVK-Unit-Encounter-Behavior-Salvager-GAALSIEN]
			[UsePlayerDistanceTimer:false]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:true]
			[RetreatTimerTrigger:1800]
			[RetreatDespawnDistance:2000]
			[AutopilotData:GVK-Unit-Encounter-Autopilot-Salvager-GAALSIEN]
			[SecondaryAutopilotData:GVK-Unit-Encounter-Autopilot-Salvager-GAALSIEN-Secondary]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[Triggers:GVK-Universal-Trigger-TargetAttacker]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-SalvagerDefeated]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-SalvagerRetreat]
			[TriggerGroups:GVK-ConvoySystem-Escort-TriggerGroup]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-SalvagerEscortHooks]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
			[Triggers:GVK-Unit-Encounter-Salvager-GAALSIEN-Trigger-EncounterInit]
			[TriggerGroups:GVK-Universal-TriggerGroup-DespawnInKOTH]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
		<!-- Salvager Patrol Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Autopilot-Salvager-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[RotationMultiplier:0.5]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[AltitudeTolerance:5000]
			[WaypointAbandonTimeTrigger:60]
			[WaypointTolerance:100]
			[IdealMinSpeed:25]
			[IdealMaxSpeed:30]
			[MaxSpeedTolerance:5]
			[WaypointWaitTimeTrigger:10]
			[OffsetPlanetMinDistFromTarget:200]
			[OffsetPlanetMaxDistFromTarget:500]
			[OffsetPlanetMinTargetAltitude:0]
			[OffsetPlanetMaxTargetAltitude:10]
			[AngleAllowedForForwardThrust:120]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Autopilot-Salvager-GAALSIEN-Secondary</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[RotationMultiplier:0.5]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[AltitudeTolerance:5000]
			[WaypointAbandonTimeTrigger:60]
			[WaypointTolerance:100]
			[IdealMinSpeed:25]
			[IdealMaxSpeed:60]
			[MaxSpeedTolerance:10]
			[WaypointWaitTimeTrigger:10]
			[OffsetPlanetMinDistFromTarget:200]
			[OffsetPlanetMaxDistFromTarget:500]
			[OffsetPlanetMinTargetAltitude:0]
			[OffsetPlanetMaxTargetAltitude:10]
			[AngleAllowedForForwardThrust:120]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Salvager-GAALSIEN-Trigger-EncounterInit</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Session]
				[StartsReady:true]
				[MaxActions:-1]
				[ActionExecution:All]
				[Actions:GVK-Unit-Encounter-Salvager-GAALSIEN-Action-EncounterInit]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Salvager-GAALSIEN-Action-EncounterInit</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[SetCustomStrings:true]
				[CustomStrings:EncounterType,UnitMedium]
				[CustomStrings:EncounterDisplayName,Salvager]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
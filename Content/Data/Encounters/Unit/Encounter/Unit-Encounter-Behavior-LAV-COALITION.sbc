<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LAV Hover Unit Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Behavior-LAV-COALITION</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[DialogueBanks:GVK-Units-COALITION-Small.xml]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:240]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGAALSIENBeacon]
			[OverrideTargetData:GVK-Universal-Target-Override-COALITION]
			[AutopilotData:GVK-Unit-All-Autopilot-LAV-Passive]
			[SecondaryAutopilotData:GVK-Unit-All-Autopilot-LAV-Aggressive]
			[TertiaryAutopilotData:GVK-Unit-All-Autopilot-LAVWing]
			[Triggers:GVK-Unit-All-Trigger-Init-SmallVehicle]
			[Triggers:GVK-Unit-Encounter-LAV-COALITION-Trigger-PlayerNear]
			[TriggerGroups:GVK-Universal-TriggerGroup-CombatDefaults]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-SmallUnit-COALITION]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-PatrolHorsefly]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-LeashGround]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-PeerEscort-Land]
			[//Two slots, as the air pairs: 30 m out, so the wings fly 60 m apart, and 10 m ahead (-Z). The wing holds the leader's speed within 20 m of its slot (LandWing), so it settles about level with the leader.]
			[EscortOffsets:{X:30 Y:0 Z:-10}]
			[EscortOffsets:{X:-30 Y:0 Z:-10}]
			[TriggerGroups:GVK-Universal-TriggerGroup-DespawnInKOTH]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for LAV to spawn enemies when player is near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-LAV-COALITION-Trigger-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:PlayerNear]
			[UseTrigger:true]
			[StartsReady:true]
			[TargetDistance:2500]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Unit-Encounter-LAV-COALITION-Action-PlayerNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-LAV-COALITION-Action-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SpawnEncounter:true]
			[Spawner:GVK-Unit-Encounter-LAV-COALITION-Spawner-PlayerNear]
			[UseChatBroadcast:false]
			[ChatData:GVK-Unit-Encounter-LAV-COALITION-Chat-PlayerNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-LAV-COALITION-Chat-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:{Faction} LAV]
			[Color:White]
			[ChatMessages:Enemies detected, requesting assistance!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-LAV-COALITION-Spawner-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:1]
			[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-LightSandskimmerSquad]
			[MinDistance:500]
			[MaxDistance:750]
			[MinAltitude:20]
			[MaxAltitude:21]
			[InheritNpcAltitude:true]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
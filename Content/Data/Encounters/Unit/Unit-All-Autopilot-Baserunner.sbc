<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Baserunner Patrol Autopilot -->
		<!-- Steering: the LAVWing recipe (Unit-All-Autopilot-LandWing.sbc explains it). MaxRotationStep 0.5 keeps the gyros at full strength; MaxRotationMagnitude sets the turn rate -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-Baserunner-Passive</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:false]
				[UseProjectileLeadPrediction:false]
				[RotationMultiplierPitch:3]
				[RotationMultiplierYaw:3]
				[RotationMultiplierRoll:1.5]
				[LimitRotationSpeed:false]
				[MaxRotationMagnitude:1]
				[UseAircraftFlightModel:true]
				[MaxRotationStep:0.5]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[WaypointTolerance:75]
				[UseSurfaceHoverThrustMode:true]
				[HoverPathStepDistance:76]
				[IdealPlanetAltitude:7.25]
				[AltitudeTolerance:75]
				[WaypointAbandonTimeTrigger:15]
				[WaypointWaitTimeTrigger:0]
				[IdealMinSpeed:25]
				[IdealMaxSpeed:35]
				[MaxSpeedTolerance:5]
				[OffsetPlanetMinDistFromTarget:500]
				[OffsetPlanetMaxDistFromTarget:701]
				[OffsetPlanetMinTargetAltitude:5]
				[OffsetPlanetMaxTargetAltitude:7]
				[OffsetMaxAngleFromTarget:90]
				[DisableInertiaDampeners:false]
				[MinimumPlanetAltitude:-100]
				[AngleAllowedForForwardThrust:120]
				[MaxVelocityAngleForSpeedControl:180]
				[//Off: MES never clears relative dampening when a unit leaves an escort, so it drifts with its old lead.]
				[EscortUsesRelativeDampening:false]
				[EscortSpeedMatchMinDistance:10]
				[EscortSpeedMatchMaxDistance:400]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-Baserunner-Aggressive</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:false]
				[UseProjectileLeadPrediction:false]
				[RotationMultiplierPitch:3]
				[RotationMultiplierYaw:3]
				[RotationMultiplierRoll:1.5]
				[LimitRotationSpeed:false]
				[MaxRotationMagnitude:1]
				[UseAircraftFlightModel:true]
				[MaxRotationStep:0.5]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[WaypointTolerance:100]
				[UseSurfaceHoverThrustMode:true]
				[HoverPathStepDistance:101]
				[IdealPlanetAltitude:7.25]
				[AltitudeTolerance:100]
				[WaypointAbandonTimeTrigger:15]
				[WaypointWaitTimeTrigger:0]
				[IdealMinSpeed:25]
				[IdealMaxSpeed:50]
				[MaxSpeedTolerance:5]
				[OffsetPlanetMinDistFromTarget:500]
				[OffsetPlanetMaxDistFromTarget:701]
				[OffsetPlanetMinTargetAltitude:5]
				[OffsetPlanetMaxTargetAltitude:7]
				[OffsetMaxAngleFromTarget:90]
				[DisableInertiaDampeners:false]
				[MinimumPlanetAltitude:-100]
				[AngleAllowedForForwardThrust:120]
				[MaxVelocityAngleForSpeedControl:180]
				[//Off: MES never clears relative dampening when a unit leaves an escort, so it drifts with its old lead.]
				[EscortUsesRelativeDampening:false]
				[EscortSpeedMatchMinDistance:10]
				[EscortSpeedMatchMaxDistance:400]
			</Description>
		</EntityComponent>
		<!-- Escort (Tertiary): the Passive profile with an 80 m/s catch-up max, so a cruiser escort outruns a leader in combat (cruisers 55 m/s).
		     Swapped in by GVK-Unit-All-TriggerGroup-EscortAutopilot when it asks for a slot; the escort triggers put Primary back.
		     Keep its WaypointWaitTimeTrigger at 5 s or more: MES Escort.cs uses it as the wait for the leader before a one-way Retreat. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-Baserunner-Escort</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:false]
				[UseProjectileLeadPrediction:false]
				[RotationMultiplierPitch:3]
				[RotationMultiplierYaw:3]
				[RotationMultiplierRoll:1.5]
				[LimitRotationSpeed:false]
				[MaxRotationMagnitude:1]
				[UseAircraftFlightModel:true]
				[MaxRotationStep:0.5]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[WaypointTolerance:75]
				[UseSurfaceHoverThrustMode:true]
				[HoverPathStepDistance:76]
				[IdealPlanetAltitude:7.25]
				[AltitudeTolerance:75]
				[WaypointAbandonTimeTrigger:15]
				[WaypointWaitTimeTrigger:5]
				[IdealMinSpeed:5]
				[IdealMaxSpeed:80]
				[MaxSpeedTolerance:5]
				[OffsetPlanetMinDistFromTarget:500]
				[OffsetPlanetMaxDistFromTarget:701]
				[OffsetPlanetMinTargetAltitude:5]
				[OffsetPlanetMaxTargetAltitude:7]
				[OffsetMaxAngleFromTarget:180]
				[DisableInertiaDampeners:false]
				[MinimumPlanetAltitude:-100]
				[AngleAllowedForForwardThrust:45]
				[MaxVelocityAngleForSpeedControl:180]
				[//Off: MES never clears relative dampening when a unit leaves an escort, so it drifts with its old lead.]
				[EscortUsesRelativeDampening:false]
				[EscortSpeedMatchMinDistance:10]
				[EscortSpeedMatchMaxDistance:400]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
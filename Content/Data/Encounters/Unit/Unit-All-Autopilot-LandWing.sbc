<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Land peer Wing autopilots (Tertiary): faster than the leader's combat profile so the wing keeps up, speed matched near the slot; see README note 41 -->
		<!-- DisableInertiaDampeners only takes effect at spawn, from the Primary profile; a swap to these never changes it. It matches each Primary here (all on). With dampeners off the LAV never fired its side or down thrusters;
		     on, it floated off bumps on its upward thruster, so that thruster is saved turned off in the LAV prefabs -->
		<!-- AngleAllowedForForwardThrust never above 90: past that, forward thrust pushes the wing away from its slot.
		     The LAV uses 45: with dampeners off, at 90 it thrusted toward a slot beside it and orbited the slot at full speed. Try 90 with dampeners on -->
		<!-- EscortSpeedMatchMinDistance 20 (both wings, the same speed-match setup): inside it the wing holds the leader's speed, so it doesn't overshoot its slot and turn back. At 10 the air wing still overshot -->
		<!-- LAVWing steering: LimitRotationSpeed caps the turn rate at the heading error in radians per second (before the yaw multiplier) and cuts the gyro when it's exceeded,
		     so a higher RotationMultiplierYaw only made it jerk. It's off here; MaxRotationStep (read only with UseAircraftFlightModel, which does nothing else on a ground unit
		     without the other flight model tags) smooths the turn instead. MaxRotationMagnitude isn't a cap on the request: once an axis already turns faster than it, MES asks for 0 on that axis.
		     MES re-aims every 15 ticks (0.25 s), and MaxRotationStep caps the gap between the commanded and actual turn rate. Each new command restarts Keen's gyro
		     ramp (MyGridGyroSystem.UpdateOverrideAccelerationRampFrames): the gyros close the gap over 48 x gap² + 1 frames, or 120 frames above 1.57, and push
		     with torque in proportion to gap / frames. 0.5 closes in 13 frames, inside one update. 2 took 120 frames, so the gyros pushed at ~1/10 strength
		     and doubling them changed nothing; 1.5 is nearly as bad (109 frames). Lower turns harder against friction but changes the rate less per update.
		     Braking is capped the same way, so it sheds at most ~0.5 rad/s per update (2 rad/s²) and needs ω²/4 radians to stop, plus ω x 0.25 s before it reacts.
		     At MaxRotationMagnitude 4 that was over 180°, so it spun in circles. 1 rad/s stops in ~30°; yaw 3 starts braking at 1/3 rad (19°) from the heading.
		     Yaw 10 was only needed while step 2 starved the gyros; if it now stalls on friction near the heading, raise yaw a little before raising the cap.
		     IdealMinSpeed 5: the autopilot only brakes for a waypoint above this speed, so at 30 the wing reached its slot at 30 m/s -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-LAVWing</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:false]
				[RotationMultiplierPitch:3]
				[RotationMultiplierYaw:3]
				[RotationMultiplierRoll:3]
				[LimitPitchTurning:true]
				[LimitRotationSpeed:false]
				[MaxRotationMagnitude:1]
				[UseAircraftFlightModel:true]
				[MaxRotationStep:0.5]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[DisableInertiaDampeners:false]
				[UseSurfaceHoverThrustMode:true]
				[HoverPathStepDistance:76]
				[IdealPlanetAltitude:2.75]
				[MinimumPlanetAltitude:-100]
				[AltitudeTolerance:100]
				[WaypointTolerance:15]
				[WaypointAbandonTimeTrigger:30]
				[WaypointWaitTimeTrigger:30]
				[IdealMinSpeed:5]
				[IdealMaxSpeed:70]
				[//2: MES brakes only above the speed cap plus this, so at 5 the wing could reach its slot 5 m/s faster than the leader.]
				[MaxSpeedTolerance:2]
				[AngleAllowedForForwardThrust:45]
				[MaxVelocityAngleForSpeedControl:180]
				[EscortUsesRelativeDampening:false]
				[EscortSpeedMatchMinDistance:20]
				[EscortSpeedMatchMaxDistance:200]
				[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Hovers: Sandskimmers, Dragoon, Pollux, Stryker -->
		<!-- Steering: the hover cruiser recipe (Unit-All-Autopilot-HoverCruiserHorsefly.sbc explains it). LimitPitchTurning so it does not backflip toward a waypoint behind it; MaxRotationStep 0.5 keeps the gyros at full strength; MaxRotationMagnitude sets the turn rate; banks up to 15 degrees into turns for looks -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-HoverWing</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:false]
				[RotationMultiplierPitch:3]
				[RotationMultiplierYaw:3]
				[RotationMultiplierRoll:3]
				[LimitPitchTurning:true]
				[LimitRotationSpeed:false]
				[MaxRotationMagnitude:1]
				[UseAircraftFlightModel:true]
				[MaxRotationStep:0.5]
				[RollIntoTurnsMultiplier:0.25]
				[MaxBankAngle:15]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[DisableInertiaDampeners:false]
				[UseSurfaceHoverThrustMode:true]
				[HoverPathStepDistance:76]
				[IdealPlanetAltitude:10]
				[MinimumPlanetAltitude:3]
				[AltitudeTolerance:10]
				[WaypointTolerance:25]
				[WaypointAbandonTimeTrigger:30]
				[WaypointWaitTimeTrigger:30]
				[IdealMinSpeed:10]
				[IdealMaxSpeed:140]
				[//2: MES brakes only above the speed cap plus this, so at 5 the wing could reach its slot 5 m/s faster than the leader.]
				[MaxSpeedTolerance:2]
				[AngleAllowedForForwardThrust:90]
				[MaxVelocityAngleForSpeedControl:180]
				[EscortUsesRelativeDampening:false]
				[EscortSpeedMatchMinDistance:20]
				[EscortSpeedMatchMaxDistance:200]
				[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
			GENERATED by tools/New-DogfightGroup.ps1 (group SmallFlyerPatrolHorseFighter). Do not edit by hand; change the table in the script and rerun it.
			Dogfight switch: Small flyers with forward guns.
			Against a target more than 100 m above the surface, swap GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-HorseFighter in the Secondary slot for GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-Dogfight and FighterPlane for Strike; swap back once the target is under 60 m.
			FighterPlane lines up its next run straight ahead of the plane, so a chased plane keeps flying away from the fight; Strike picks a line-up point around the target, and the Dogfight profile keeps it close and level.
			Needs MES with the OverwriteAutopilotProfile fix (MeridiusIX/Modular-Encounters-Systems#464): without it the swap undoes itself.
			Chased: a Strike line-up point keeps its direction from the target, so when the target chases the plane the point can run ahead of it at the target's speed. With the target behind and flying at it, switching to FighterPlane and back restarts Strike, which picks a new point.
			Break: a new point still moves with a target that follows the plane, and Strike starts no run with the target inside the breakaway distance, so Chased loads GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-Break instead: it starts the run at once and turns the plane at its chaser. BreakEnd puts the Dogfight profile back when the run ends.
			ToDogfight checks the subclass, not GVK_Dogfight: a plane that loses its target and picks up a new one before Reset runs is back in FighterPlane with the Dogfight profile still loaded, and this puts it in Strike.
			Behavior: [TriggerGroups:GVK-Unit-All-TriggerGroup-SmallFlyerPatrolHorseFighterDogfight] after GVK-Unit-All-TriggerGroup-PatrolStrike, with [SecondaryAutopilotData:GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-HorseFighter].
			Booleans: GVK_Dogfight (the Secondary slot holds the Dogfight profile), GVK_Break (the Secondary slot holds the Break profile).
		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-TriggerGroup-SmallFlyerPatrolHorseFighterDogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Trigger-ToDogfight]
			[Triggers:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Trigger-ToStrike]
			[Triggers:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Trigger-Reset]
			[Triggers:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Trigger-Chased]
			[Triggers:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Trigger-BreakEnd]
			</Description>
		</EntityComponent>
		<!-- In combat on FighterPlane, not a wing, target more than 100 m up -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Trigger-ToDogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:3000]
			[MaxCooldownMs:3001]
			[Conditions:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Condition-ToDogfight]
			[Actions:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Action-ToDogfight]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Condition-ToDogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_InCombat]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_Role_Escort]
			[BehaviorSubclassCheck:true]
			[BehaviorSubclass:FighterPlane]
			[TargetAltitudeCheck:true]
			[MinTargetAltitude:100]
			[MaxTargetAltitude:-1]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Action-ToDogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Dogfight on]
			[OverwriteAutopilotProfile:true]
			[OverwriteAutopilotMode:Secondary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-Dogfight]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Strike]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[SetBooleansTrue:GVK_Dogfight]
			</Description>
		</EntityComponent>
		<!-- In combat, not a wing, target back under 60 m -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Trigger-ToStrike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:3000]
			[MaxCooldownMs:3001]
			[Conditions:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Condition-ToStrike]
			[Actions:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Action-ToStrike]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Condition-ToStrike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_InCombat]
			[TrueBooleans:GVK_Dogfight]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_Role_Escort]
			[TargetAltitudeCheck:true]
			[MinTargetAltitude:-1]
			[MaxTargetAltitude:60]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Action-ToStrike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Dogfight off]
			[OverwriteAutopilotProfile:true]
			[OverwriteAutopilotMode:Secondary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-HorseFighter]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:FighterPlane]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[SetBooleansFalse:GVK_Dogfight]
			[SetBooleansFalse:GVK_Break]
			</Description>
		</EntityComponent>
		<!-- Combat over (Patrol already set by the PatrolStrike group): put the attack-run profile back so the next fight starts with attack runs -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Trigger-Reset</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:3000]
			[MaxCooldownMs:3001]
			[Conditions:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Condition-Reset]
			[Actions:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Action-Reset]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Condition-Reset</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_Dogfight]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_InCombat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Action-Reset</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Dogfight reset]
			[OverwriteAutopilotProfile:true]
			[OverwriteAutopilotMode:Secondary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-HorseFighter]
			[SetBooleansFalse:GVK_Dogfight]
			[SetBooleansFalse:GVK_Break]
			</Description>
		</EntityComponent>
		<!-- In a dogfight with the target behind and flying at the plane: restart Strike for a new line-up point instead of fleeing -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Trigger-Chased</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Conditions:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Condition-Chased]
			[Actions:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Action-ChasedLeaveStrike]
			[Actions:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Action-ChasedBackToStrike]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Condition-Chased</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_InCombat]
			[TrueBooleans:GVK_Dogfight]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_Role_Escort]
			[FalseBooleans:GVK_Break]
			[BehaviorSubclassCheck:true]
			[BehaviorSubclass:Strike]
			[CheckTargetAngleFromForward:true]
			[MinTargetAngle:120]
			[MaxTargetAngle:-1]
			[CheckIfTargetIsChasing:true]
			[MinTargetChaseAngle:-1]
			[MaxTargetChaseAngle:45]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Action-ChasedLeaveStrike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Chased: break turn]
			[OverwriteAutopilotProfile:true]
			[OverwriteAutopilotMode:Secondary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-Break]
			[SetBooleansTrue:GVK_Break]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:FighterPlane]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Action-ChasedBackToStrike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Strike]
			</Description>
		</EntityComponent>
		<!-- The break turn's attack run is over (Strike raises BehaviorTriggerA when a run ends): put the Dogfight profile back -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Trigger-BreakEnd</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:BehaviorTriggerA]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Condition-BreakEnd]
			[Actions:GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Action-BreakEnd]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Condition-BreakEnd</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_Break]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-SmallFlyerPatrolHorseFighterDogfight-Action-BreakEnd</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Break turn over]
			[OverwriteAutopilotProfile:true]
			[OverwriteAutopilotMode:Secondary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-Dogfight]
			[SetBooleansFalse:GVK_Break]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>

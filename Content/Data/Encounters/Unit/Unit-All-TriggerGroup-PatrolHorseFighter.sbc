<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
			GENERATED by tools/New-PatrolSwitchGroup.ps1 (group HorseFighter). Do not edit by hand; change the table in the script and rerun it.
			Patrol <-> HorseFighter. Circles, then makes gun runs; for hover Units with forward guns.
			Behavior: [TriggerGroups:GVK-Unit-All-TriggerGroup-PatrolHorseFighter], Primary autopilot for Patrol, Secondary for HorseFighter.
			Add [TriggerGroups:GVK-Unit-All-TriggerGroup-CombatKPL] for every faction except COALITION.
			Switches at 2000 m (TargetNear), back to Patrol beyond 2000 m (TargetFar) or after 5 s with no target.
			Booleans: GVK_InCombat (on HorseFighter).
		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-TriggerGroup-PatrolHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Unit-All-PatrolHorseFighter-ManualTrigger-SwitchToHorseFighter]
			[Triggers:GVK-Unit-All-PatrolHorseFighter-ManualTrigger-SwitchToPatrol]
			[Triggers:GVK-Unit-All-PatrolHorseFighter-Trigger-TargetNear]
			[Triggers:GVK-Unit-All-PatrolHorseFighter-Trigger-NoTarget]
			[Triggers:GVK-Unit-All-PatrolHorseFighter-Trigger-TargetFar]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolHorseFighter-ManualTrigger-SwitchToHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:GVK-TriggerTags-LeaderDead]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[Conditions:GVK-Unit-All-Condition-CanStartCombat]
			[Actions:GVK-Unit-All-PatrolHorseFighter-Action-SwitchToHorseFighter]
			[ToggleWithTriggerProfile:GVK-Unit-All-PatrolHorseFighter-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolHorseFighter-Action-SwitchToHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:HorseFighter]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[SetBooleansTrue:GVK_InCombat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolHorseFighter-ManualTrigger-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Manual]
			[Tags:GVK-TriggerTags-LeaderDead]
			[Tags:GVK-TriggerTags-SwitchToPatrol]
			[StartsReady:true]
			[Conditions:GVK-Unit-All-Condition-NotEscortRole]
			[Actions:GVK-Unit-All-PatrolHorseFighter-Action-SwitchToPatrol]
			[ToggleWithTriggerProfile:GVK-Unit-All-PatrolHorseFighter-ManualTrigger-SwitchToHorseFighter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolHorseFighter-Action-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Patrol]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			[SetBooleansFalse:GVK_InCombat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolHorseFighter-Trigger-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[Actions:GVK-Unit-All-PatrolHorseFighter-Action-TargetNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolHorseFighter-Action-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Unit-All-PatrolHorseFighter-ManualTrigger-SwitchToHorseFighter]
			[ManuallyActivatedTriggerTags:GVK-TriggerTags-CombatStarted]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolHorseFighter-Trigger-NoTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[Conditions:GVK-Universal-Condition-NoTarget]
			[Actions:GVK-Unit-All-PatrolHorseFighter-Action-ReturnToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolHorseFighter-Trigger-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetFar]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[Actions:GVK-Unit-All-PatrolHorseFighter-Action-ReturnToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolHorseFighter-Action-ReturnToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Unit-All-PatrolHorseFighter-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>

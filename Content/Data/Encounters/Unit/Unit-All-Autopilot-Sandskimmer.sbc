<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallHoverHorseFighter Autopilot -->
		<!-- Steering: the hover cruiser recipe (Unit-All-Autopilot-HoverCruiserHorsefly.sbc explains it). LimitPitchTurning so it does not backflip toward a waypoint behind it; MaxRotationStep 0.5 keeps the gyros at full strength; MaxRotationMagnitude sets the turn rate; banks up to 15 degrees into turns for looks -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-Sandskimmer-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[UseProjectileLeadPrediction:false]
			[RotationMultiplierPitch:3]
			[RotationMultiplierYaw:3]
			[RotationMultiplierRoll:3]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[RollIntoTurnsMultiplier:0.25]
			[MaxBankAngle:15]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[WaypointTolerance:75]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:76]
			[IdealPlanetAltitude:10]
			[MinimumPlanetAltitude:3]
			[AltitudeTolerance:10]
			[RamMinDurationMs:0]
			[RamMaxDurationMs:0]
			[IdealMinSpeed:39]
			[IdealMaxSpeed:40]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:200]
			[OffsetPlanetMinDistFromTarget:400]
			[OffsetPlanetMaxDistFromTarget:700]
			[OffsetPlanetMinTargetAltitude:3]
			[OffsetPlanetMaxTargetAltitude:4]
			[OffsetMaxAngleFromTarget:90]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:10]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1500]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:0]
			[StrafeMaxCooldownMs:1]
			[StrafeSpeedCutOff:75]	
			[StrafeMinimumTargetDistance:500]
			[StrafeMinimumSafeAngleFromTarget:25]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- SmallHoverHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-Sandskimmer-HorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[UseProjectileLeadPrediction:false]
			[RotationMultiplierPitch:3]
			[RotationMultiplierYaw:3]
			[RotationMultiplierRoll:3]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[RollIntoTurnsMultiplier:0.25]
			[MaxBankAngle:15]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[WaypointTolerance:100]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:101]
			[IdealPlanetAltitude:10]
			[MinimumPlanetAltitude:3]
			[AltitudeTolerance:10]
			[RamMinDurationMs:6000]
			[RamMaxDurationMs:6001]
			[IdealMinSpeed:40]
			[//110: 30 m/s under the HoverWing (140), so a peer wing has room to catch up.]
			[IdealMaxSpeed:110]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:200]
			[OffsetPlanetMinDistFromTarget:400]
			[OffsetPlanetMaxDistFromTarget:700]
			[OffsetPlanetMinTargetAltitude:3]
			[OffsetPlanetMaxTargetAltitude:4]
			[OffsetMaxAngleFromTarget:90]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:30]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1500]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:0]
			[StrafeMaxCooldownMs:1]
			[StrafeSpeedCutOff:75]	
			[StrafeMinimumTargetDistance:500]
			[StrafeMinimumSafeAngleFromTarget:25]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
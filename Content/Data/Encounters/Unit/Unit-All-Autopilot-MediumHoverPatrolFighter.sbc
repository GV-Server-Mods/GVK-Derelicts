<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Medium Hover Fighter Autopilot Primary Passive for Patrol behavior -->
		<!-- Steering: MaxRotationStep 0.5 keeps the gyros at full strength (Unit-All-Autopilot-HoverCruiserHorsefly.sbc explains it); MaxRotationMagnitude sets the turn rate. FlyLevelWithGravity already stops backflips, so pitch stays 1. Banks up to 15 degrees into turns for looks -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-MediumHoverPatrolFighter-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplierPitch:1]
			[RotationMultiplierYaw:3]
			[RotationMultiplierRoll:2]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:0.75]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[RollIntoTurnsMultiplier:0.25]
			[MaxBankAngle:15]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:15]
			[AltitudeTolerance:500]
			[WaypointTolerance:50]
			[WaypointWaitTimeTrigger:0]
			[IdealMinSpeed:29]
			[IdealMaxSpeed:30]
			[MaxSpeedTolerance:10]
			[WaypointAbandonTimeTrigger:6]
			[OffsetPlanetMinDistFromTarget:500]
			[OffsetPlanetMaxDistFromTarget:501]
			[OffsetPlanetMinTargetAltitude:15]
			[OffsetPlanetMaxTargetAltitude:16]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Medium Hover Fighter Autopilot Secondary -->
		<!-- Steering: MaxRotationStep 0.5 keeps the gyros at full strength (Unit-All-Autopilot-HoverCruiserHorsefly.sbc explains it); MaxRotationMagnitude sets the turn rate. FlyLevelWithGravity already stops backflips, so pitch stays 1. Banks up to 15 degrees into turns for looks. MaxRotationMagnitude 1, not 4: the step also caps braking (~2 rad/s per second), and from 4 rad/s it would spin far past its heading -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-MediumHoverPatrolFighter-Fighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[UseProjectileLeadPrediction:false]
			[RotationMultiplierPitch:1]
			[RotationMultiplierYaw:3]
			[RotationMultiplierRoll:2]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[RollIntoTurnsMultiplier:0.25]
			[MaxBankAngle:15]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:15]
			[AltitudeTolerance:20]
			[WaypointWaitTimeTrigger:0]
			[IdealMinSpeed:30]
			[IdealMaxSpeed:100]
			[MaxSpeedTolerance:10]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1000]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:1]
			[StrafeMaxCooldownMs:2]
			[StrafeSpeedCutOff:50]
			[StrafeDistanceCutOff:500]	
			[StrafeMinimumTargetDistance:400]
			[StrafeMinimumSafeAngleFromTarget:25]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Medium Hover Fighter Autopilot Tertiary: AimAtTargetAngle swaps it in while the nose is within 15 degrees of the target, and back once it's more than 30 off (combat only) -->
		<!-- Steering: MaxRotationStep 0.5 keeps the gyros at full strength (Unit-All-Autopilot-HoverCruiserHorsefly.sbc explains it); MaxRotationMagnitude sets the turn rate. Pitch 1: this is the aim profile, used only while the target is ahead. Banks up to 15 degrees into turns for looks. MaxRotationMagnitude 1, not 4: the step also caps braking (~2 rad/s per second), and from 4 rad/s it would spin far past its heading -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-MediumHoverPatrolFighter-Tertiary</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[UseProjectileLeadPrediction:false]
			[RotationMultiplierPitch:1]
			[RotationMultiplierYaw:3]
			[RotationMultiplierRoll:2]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[RollIntoTurnsMultiplier:0.25]
			[MaxBankAngle:15]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:15]
			[AltitudeTolerance:20]
			[WaypointWaitTimeTrigger:0]
			[IdealMinSpeed:30]
			[IdealMaxSpeed:100]
			[MaxSpeedTolerance:10]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1000]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:1]
			[StrafeMaxCooldownMs:2]
			[StrafeSpeedCutOff:50]
			[StrafeDistanceCutOff:500]	
			[StrafeMinimumTargetDistance:400]
			[StrafeMinimumSafeAngleFromTarget:25]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
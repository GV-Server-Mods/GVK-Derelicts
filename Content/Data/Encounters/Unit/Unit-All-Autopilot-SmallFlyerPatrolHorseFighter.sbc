<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallFlyerHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[WaypointAbandonTimeTrigger:10]
			[RotationMultiplier:0.5]
			[RotationMultiplierPitch:2]
			[RotationMultiplierRoll:2]
			[LimitPitchTurning:true]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[MaxVerticalSpeed:20]
			[IdealPlanetAltitude:400]
			[MinimumPlanetAltitude:150]
			[AltitudeTolerance:50]
			[WaypointTolerance:150]
			[RamMinDurationMs:0]
			[RamMaxDurationMs:0]
			[WaypointWaitTimeTrigger:0]
			[IdealMinSpeed:49]
			[IdealMaxSpeed:50]
			[OffsetPlanetMinDistFromTarget:500]
			[OffsetPlanetMaxDistFromTarget:501]
			[OffsetPlanetMinTargetAltitude:-100]
			[OffsetPlanetMaxTargetAltitude:100]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1500]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:0]
			[StrafeMaxCooldownMs:1]
			[StrafeSpeedCutOff:45]	
			[StrafeMinimumTargetDistance:400]
			[StrafeMinimumSafeAngleFromTarget:30]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[MaxAngleFromVelocity:60]
			[RollIntoTurnsMultiplier:0.8]
			[MaxBankAngle:60]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- SmallFlyerHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-HorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[AttackRunDistancePlanet:450]
			[AttackRunBreakawayDistance:600]
			[AttackRunOverrideWithDistanceAndTimer:true]
			[AttackRunOverrideTimerTrigger:6]
			[AttackRunOverrideDistance:650]
			[OffsetRecalculationTime:30]
			[AttackRunUseSafePlanetPathing:false]
			[AttackRunUseCollisionEvasionPlanet:false]
			[WaypointAbandonTimeTrigger:30]
			[WaypointWaitTimeTrigger:0]
			[RotationMultiplierPitch:2]
			[RotationMultiplierYaw:1]
			[RotationMultiplierRoll:2]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:400]
			[MinimumPlanetAltitude:75]
			[AltitudeTolerance:30]
			[WaypointTolerance:150]
			[IdealMinSpeed:70]
			[IdealMaxSpeed:120]
			[OffsetPlanetMinDistFromTarget:1200]
			[OffsetPlanetMaxDistFromTarget:1500]
			[OffsetPlanetMinTargetAltitude:300]
			[OffsetPlanetMaxTargetAltitude:400]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[MaxAngleFromVelocity:60]
			[RollIntoTurnsMultiplier:1]
			[MaxBankAngle:45]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Dogfight: swapped into the Secondary slot against a target more than 100 m up (GVK-Unit-All-TriggerGroup-SmallFlyerPatrolHorseFighterDogfight). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-Dogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[AttackRunDistancePlanet:250]
			[AttackRunBreakawayDistance:250]
			[AttackRunOverrideWithDistanceAndTimer:true]
			[//A chased plane may never reach its line-up point: within 500 m of it for 3 s, it turns in anyway.]
			[AttackRunOverrideTimerTrigger:3]
			[AttackRunOverrideDistance:500]
			[//The line-up point moves with the target and is only re-rolled after this many seconds; reaching one up to ~1.3 km away after a pass, with the turn, takes ~18 s at 70-120 m/s.]
			[OffsetRecalculationTime:20]
			[AttackRunUseSafePlanetPathing:false]
			[AttackRunUseCollisionEvasionPlanet:false]
			[WaypointAbandonTimeTrigger:30]
			[WaypointWaitTimeTrigger:0]
			[RotationMultiplierPitch:2]
			[RotationMultiplierYaw:1]
			[RotationMultiplierRoll:2]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[//A line-up point under the minimum altitude is moved up to halfway between it and the ideal one, so keep the ideal low.]
			[IdealPlanetAltitude:200]
			[//120 (75 until GVK-Settings#730): a fight near the ground lines up no lower than this.]
			[MinimumPlanetAltitude:120]
			[AltitudeTolerance:30]
			[WaypointTolerance:150]
			[IdealMinSpeed:70]
			[IdealMaxSpeed:120]
			[//Line-up points 600-900 m out, 50-200 m below the target, instead of the attack runs' 300-400 m above it, which climbed with an aircraft. Two NPC planes fighting each other only have each other's height to go by, so points above the target let the pair climb together, and points up to 150 m below still let it drift up (a plane can only pitch nose-up toward a point behind it; GVK-Settings#742, 2026-11-09). 150-300 m below sometimes flew planes into the ground (owner, 2026-11-09).]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:900]
			[OffsetPlanetMinTargetAltitude:-200]
			[OffsetPlanetMaxTargetAltitude:-50]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[MaxAngleFromVelocity:60]
			[RollIntoTurnsMultiplier:1]
			[//Dogfight turns run far off heading, so they bank at this cap (45 until GVK-Settings#730). If a plane dives in a turn, raise MaxAngleFromVelocity first, then lower this.]
			[MaxBankAngle:55]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Break: loaded by the dogfight group's Chased trigger when the target chases the plane, and swapped back for Dogfight when the run ends. The Dogfight profile with only the run distances and bank cap changed (tools/Test-Docs.ps1 checks). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-SmallFlyerPatrolHorseFighter-Break</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[//Wider than any line-up distance, so the run starts at once and the plane turns at its chaser instead of flying to a line-up point that moves with it.]
			[AttackRunDistancePlanet:5000]
			[//Strike starts no run with the target inside this distance; at Dogfight's 250 a close chaser blocks it.]
			[AttackRunBreakawayDistance:200]
			[AttackRunOverrideWithDistanceAndTimer:true]
			[AttackRunOverrideTimerTrigger:3]
			[AttackRunOverrideDistance:500]
			[OffsetRecalculationTime:20]
			[AttackRunUseSafePlanetPathing:false]
			[AttackRunUseCollisionEvasionPlanet:false]
			[WaypointAbandonTimeTrigger:30]
			[WaypointWaitTimeTrigger:0]
			[RotationMultiplierPitch:2]
			[RotationMultiplierYaw:1]
			[RotationMultiplierRoll:2]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:200]
			[MinimumPlanetAltitude:120]
			[AltitudeTolerance:30]
			[WaypointTolerance:150]
			[IdealMinSpeed:70]
			[IdealMaxSpeed:120]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:900]
			[OffsetPlanetMinTargetAltitude:-200]
			[OffsetPlanetMaxTargetAltitude:-50]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[MaxAngleFromVelocity:60]
			[RollIntoTurnsMultiplier:1]
			[//5 above Dogfight's cap, never below it: the break turn lasts a few seconds, so it costs little height.]
			[MaxBankAngle:60]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
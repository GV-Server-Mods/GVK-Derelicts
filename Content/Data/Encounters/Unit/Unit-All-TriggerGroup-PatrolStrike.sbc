<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
			GENERATED by tools/New-PatrolSwitchGroup.ps1 (group Strike). Do not edit by hand; change the table in the script and rerun it.
			Patrol <-> FighterPlane. Attack runs from a line-up point; Strike Fighters (4 km target profile).
			Behavior: [TriggerGroups:GVK-Unit-All-TriggerGroup-PatrolStrike], Primary autopilot for Patrol, Secondary for FighterPlane.
			Add [TriggerGroups:GVK-Unit-All-TriggerGroup-CombatKPL] for every faction except COALITION.
			Switches at 4000 m (TargetNear), back to Patrol beyond 5500 m (TargetFar) or after 5 s with no target.
			Booleans: GVK_InCombat (on FighterPlane).
		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-TriggerGroup-PatrolStrike</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Unit-All-PatrolStrike-ManualTrigger-SwitchToFighterPlane]
			[Triggers:GVK-Unit-All-PatrolStrike-ManualTrigger-SwitchToPatrol]
			[Triggers:GVK-Unit-All-PatrolStrike-Trigger-TargetNear]
			[Triggers:GVK-Unit-All-PatrolStrike-Trigger-NoTarget]
			[Triggers:GVK-Unit-All-PatrolStrike-Trigger-TargetFar]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrike-ManualTrigger-SwitchToFighterPlane</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:GVK-TriggerTags-LeaderDead]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[Conditions:GVK-Unit-All-Condition-CanStartCombat]
			[Actions:GVK-Unit-All-PatrolStrike-Action-SwitchToFighterPlane]
			[ToggleWithTriggerProfile:GVK-Unit-All-PatrolStrike-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrike-Action-SwitchToFighterPlane</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:FighterPlane]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[SetBooleansTrue:GVK_InCombat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrike-ManualTrigger-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Manual]
			[Tags:GVK-TriggerTags-LeaderDead]
			[Tags:GVK-TriggerTags-SwitchToPatrol]
			[StartsReady:true]
			[Conditions:GVK-Unit-All-Condition-NotEscortRole]
			[Actions:GVK-Unit-All-PatrolStrike-Action-SwitchToPatrol]
			[ToggleWithTriggerProfile:GVK-Unit-All-PatrolStrike-ManualTrigger-SwitchToFighterPlane]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrike-Action-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Patrol]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			[SetBooleansFalse:GVK_InCombat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrike-Trigger-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:4000]
			[Actions:GVK-Unit-All-PatrolStrike-Action-TargetNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrike-Action-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Unit-All-PatrolStrike-ManualTrigger-SwitchToFighterPlane]
			[ManuallyActivatedTriggerTags:GVK-TriggerTags-CombatStarted]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrike-Trigger-NoTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[Conditions:GVK-Universal-Condition-NoTarget]
			[Actions:GVK-Unit-All-PatrolStrike-Action-ReturnToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrike-Trigger-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetFar]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:5500]
			[Actions:GVK-Unit-All-PatrolStrike-Action-ReturnToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrike-Action-ReturnToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Unit-All-PatrolStrike-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>

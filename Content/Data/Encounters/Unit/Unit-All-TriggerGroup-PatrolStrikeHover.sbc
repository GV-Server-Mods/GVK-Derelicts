<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
			GENERATED by tools/New-PatrolSwitchGroup.ps1 (group StrikeHover). Do not edit by hand; change the table in the script and rerun it.
			Patrol <-> Strike. Attack runs from line-up points picked around the target; for hover Units with forward guns (Sandskimmers).
			Behavior: [TriggerGroups:GVK-Unit-All-TriggerGroup-PatrolStrikeHover], Primary autopilot for Patrol, Secondary for Strike.
			Add [TriggerGroups:GVK-Unit-All-TriggerGroup-CombatKPL] for every faction except COALITION.
			Add [TriggerGroups:GVK-Unit-All-TriggerGroup-LeashGround] or -LeashAir (tools/New-LeashGroup.ps1) to every Unit.
			Switches at 2000 m (TargetNear), back to Patrol beyond 2000 m or with no target (TargetFar).
			Booleans: GVK_InCombat (on Strike).
		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-TriggerGroup-PatrolStrikeHover</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Unit-All-PatrolStrikeHover-ManualTrigger-SwitchToPatrol]
			[Triggers:GVK-Unit-All-PatrolStrikeHover-ManualTrigger-SwitchToStrike]
			[Triggers:GVK-Unit-All-PatrolStrikeHover-Trigger-TargetNear]
			[Triggers:GVK-Unit-All-PatrolStrikeHover-Trigger-TargetFar]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrikeHover-ManualTrigger-SwitchToStrike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:GVK-TriggerTags-LeaderDead]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[Conditions:GVK-Unit-All-Condition-CanStartCombat]
			[Actions:GVK-Unit-All-PatrolStrikeHover-Action-SwitchToStrike]
			[ToggleWithTriggerProfile:GVK-Unit-All-PatrolStrikeHover-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrikeHover-Action-SwitchToStrike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Strike]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[SetBooleansTrue:GVK_InCombat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrikeHover-ManualTrigger-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Manual]
			[Tags:GVK-TriggerTags-LeaderDead]
			[Tags:GVK-TriggerTags-SwitchToPatrol]
			[StartsReady:true]
			[Conditions:GVK-Unit-All-Condition-NotEscortRole]
			[Actions:GVK-Unit-All-PatrolStrikeHover-Action-SwitchToPatrol]
			[ToggleWithTriggerProfile:GVK-Unit-All-PatrolStrikeHover-ManualTrigger-SwitchToStrike]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrikeHover-Action-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Patrol]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			[SetBooleansFalse:GVK_InCombat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrikeHover-Trigger-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[Actions:GVK-Unit-All-PatrolStrikeHover-Action-TargetNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrikeHover-Action-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Unit-All-PatrolStrikeHover-ManualTrigger-SwitchToStrike]
			[ManuallyActivatedTriggerTags:GVK-TriggerTags-CombatStarted]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrikeHover-Trigger-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetFar]
			[AllowTargetFarWithoutTarget:true]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[Actions:GVK-Unit-All-PatrolStrikeHover-Action-ReturnToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-PatrolStrikeHover-Action-ReturnToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Unit-All-PatrolStrikeHover-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>

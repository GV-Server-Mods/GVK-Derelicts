<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LargeRoverHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Behavior-LargeRoverHorsefly-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[DialogueBanks:GVK-Units-SOBAN-Large.xml]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:240]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[OverrideTargetData:GVK-Universal-Target-Override]
			[AutopilotData:GVK-Unit-All-Autopilot-LargeRoverHorsefly-Patrol]
			[SecondaryAutopilotData:GVK-Unit-All-Autopilot-LargeRoverHorsefly-Horsefly]
			[TertiaryAutopilotData:GVK-Unit-All-Autopilot-LargeRoverHorsefly-Tertiary]
			[Triggers:GVK-Unit-All-Trigger-Init-LargeRoverHorsefly-SOBAN]
			[Triggers:GVK-Unit-All-Trigger-SpawnAirSupport]
			[TriggerGroups:GVK-Universal-TriggerGroup-CombatDefaults]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-LargeUnit]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-PatrolHorsefly]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-LeashGround]
			[TriggerGroups:GVK-Universal-TriggerGroup-LeashBeacon]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-CombatKPL]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-FlyAwayFailsafe]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-DespawnInKOTH]
			[TriggerGroups:GVK-ConvoySystem-Leader-TriggerGroup]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			[EscortOffsets:{X:150 Y:0 Z:100}]
			[EscortOffsets:{X:-150 Y:0 Z:100}]
			BountyOnKill=3000000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Trigger-Init-LargeRoverHorsefly-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:true]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-Unit-All-Action-Init-LargeRoverHorsefly-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Action-Init-LargeRoverHorsefly-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,UnitLarge]
			[CustomStrings:EncounterDisplayName,cruiser]
			[CustomStrings:AirSupportSpawnGroup,GVK-Unit-Defense-SpawnGroup-SOBAN-StrikeFighterSingle]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
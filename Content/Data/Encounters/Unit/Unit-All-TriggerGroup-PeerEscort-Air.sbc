<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
			GENERATED by tools/New-PeerEscortPool.ps1 -Pool Air -Radius 3000. Do not edit by hand.
			Peer escorts for the Air pool: Units of this pool pair up with each other, never with another pool or a cruiser.
			Behavior: [TriggerGroups:GVK-Unit-All-TriggerGroup-PeerEscort-Air] and one [EscortOffsets:{X:.. Y:0 Z:..}] line.
			Needs an MES build with MeridiusIX/Modular-Encounters-Systems#386 (MatchReceiverEscort / MatchReceiverLeader).
			Booleans: GVK_Role_Escort (wing), GVK_Role_Leader (has a live wing), GVK_Peer_Requesting (asked, no answer yet),
			GVK_Peer_SlotSpent (the single slot was used; MES never frees it, so this peer can only be a wing from then on).
		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-TriggerGroup-PeerEscort-Air</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Unit-All-PeerEscort-Air-Trigger-Offer]
			[Triggers:GVK-Unit-All-PeerEscort-Air-Trigger-Accept]
			[Triggers:GVK-Unit-All-PeerEscort-Air-Trigger-ProcessRequest]

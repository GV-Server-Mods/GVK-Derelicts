<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- COALITION Strike Fighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Behavior-StrikeFighter-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[DialogueBanks:GVK-Units-SOBAN-Small.xml]
			[WeaponSystem:GVK-Universal-Weapons-Static90]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:240]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-StrikeFighterGrids]
			[OverrideTargetData:GVK-Universal-Target-Override]
			[AutopilotData:GVK-Unit-All-Autopilot-StrikeFighter-Patrol]
			[SecondaryAutopilotData:GVK-Unit-All-Autopilot-StrikeFighter-Strike]
			[TertiaryAutopilotData:GVK-Unit-All-Autopilot-AirWing]
			[Triggers:GVK-Unit-All-Trigger-Init-SmallAircraft]
			[TriggerGroups:GVK-Universal-TriggerGroup-CombatDefaults]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-SmallUnit]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-PeerEscort-Air]
			[//Slots 60 m out, placed 75 m ahead (-Z): an AirWing holds the leader's speed once within 150 m of its slot, so it settles behind it, about even with the leader front to back. Slots at the leader's height: 25 m up put the wings above it, and an enemy plane lining up on a wing then climbed with it.]
			[EscortOffsets:{X:60 Y:0 Z:-75}]
			[EscortOffsets:{X:-60 Y:0 Z:-75}]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-PatrolStrike]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-StrikeFighterDogfight]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-LeashAir]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-CombatKPL]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-DespawnInKOTH]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
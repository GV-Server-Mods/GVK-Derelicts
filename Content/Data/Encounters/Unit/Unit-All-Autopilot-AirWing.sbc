<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Air peer Wing autopilot (Tertiary on Strike Fighters and Interceptors): altitude band under the leaders' patrol altitude; see README note 41 -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-AirWing</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[WaypointAbandonTimeTrigger:30]
			[WaypointWaitTimeTrigger:30]
			[RotationMultiplierPitch:1.5]
			[//Yaw 1, as the Strike Fighter leader: at 0.5 the wing turned half as fast as its leader and fell behind in every turn.]
			[RotationMultiplierYaw:1]
			[RotationMultiplierRoll:2]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:450]
			[//75, under the leader's attack run (its slot is 25 m above the leader): at 250 the wing climbed away instead of following the run down.]
			[MinimumPlanetAltitude:75]
			[AltitudeTolerance:20]
			[WaypointTolerance:25]
			[IdealMinSpeed:20]
			[IdealMaxSpeed:150]
			[MaxSpeedTolerance:5]
			[AngleAllowedForForwardThrust:90]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[//60, as the Strike Fighter: at 35 a plane sinking in a banked turn had its nose pulled down after it.]
			[MaxAngleFromVelocity:60]
			[RollIntoTurnsMultiplier:0.8]
			[MaxBankAngle:60]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[//Never on aircraft: a wing that passes its slot turns around and flies backwards to reach it.]
			[EscortUsesRelativeDampening:false]
			[//MinDistance 170: inside it the wing holds the leader's speed. At 10 it overshot its slot once the leader flew 10 m/s slower; 100-170 tested in game.]
			[EscortSpeedMatchMinDistance:170]
			[//300 with MinDistance 10 and MaxSpeedTolerance 5: the wing trails its slot (about 175 m) but stays steady. Closer settings (200/30/1, 500/30/1) made it overshoot and swing back.]
			[EscortSpeedMatchMaxDistance:300]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>

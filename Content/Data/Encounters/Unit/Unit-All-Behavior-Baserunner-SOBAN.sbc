<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LAV Hover Unit Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Behavior-Baserunner-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[DialogueBanks:GVK-Units-SOBAN-Medium.xml]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:240]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[AutopilotData:GVK-Unit-All-Autopilot-Baserunner-Passive]
			[SecondaryAutopilotData:GVK-Unit-All-Autopilot-Baserunner-Aggressive]
			[TertiaryAutopilotData:GVK-Unit-All-Autopilot-Baserunner-Escort]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[OverrideTargetData:GVK-Universal-Target-Override]
			[Triggers:GVK-Unit-All-Trigger-Init-MediumVehicle]
			[TriggerGroups:GVK-Universal-TriggerGroup-CombatDefaults]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-MediumUnit]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-PatrolHorsefly]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-LeashGround]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-CombatKPL]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-FlyAwayFailsafe]
			[TriggerGroups:GVK-ConvoySystem-Escort-TriggerGroup]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-EscortAutopilot]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-DespawnInKOTH]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			BountyOnKill=1000000;
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
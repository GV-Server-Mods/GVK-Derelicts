<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LAV Patrol Autopilot -->
		<!-- Steering: the LAVWing recipe (Unit-All-Autopilot-LandWing.sbc explains it). MaxRotationStep 0.5 keeps the gyros at full strength; MaxRotationMagnitude sets the turn rate -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-LAV-Passive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[RotationMultiplierPitch:3]
			[RotationMultiplierYaw:3]
			[RotationMultiplierRoll:3]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[WaypointTolerance:75]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:76]
			[IdealPlanetAltitude:2.75]
			[AltitudeTolerance:100]
			[WaypointAbandonTimeTrigger:10]
			[IdealMinSpeed:25]
			[IdealMaxSpeed:35]
			[MaxSpeedTolerance:5]
			[WaypointWaitTimeTrigger:0]
			[OffsetPlanetMinDistFromTarget:300]
			[OffsetPlanetMaxDistFromTarget:301]
			[OffsetPlanetMinTargetAltitude:2]
			[OffsetPlanetMaxTargetAltitude:5]
			[OffsetMaxAngleFromTarget:90]
			[DisableInertiaDampeners:false]
			[MinimumPlanetAltitude:-100]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-LAV-Aggressive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[RotationMultiplierPitch:3]
			[RotationMultiplierYaw:3]
			[RotationMultiplierRoll:3]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[WaypointTolerance:100]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:101]
			[IdealPlanetAltitude:2.75]
			[AltitudeTolerance:100]
			[WaypointAbandonTimeTrigger:10]
			[IdealMinSpeed:25]
			[IdealMaxSpeed:50]
			[MaxSpeedTolerance:5]
			[WaypointWaitTimeTrigger:0]
			[OffsetPlanetMinDistFromTarget:500]
			[OffsetPlanetMaxDistFromTarget:501]
			[OffsetPlanetMinTargetAltitude:2]
			[OffsetPlanetMaxTargetAltitude:5]
			[OffsetMaxAngleFromTarget:90]
			[DisableInertiaDampeners:false]
			[MinimumPlanetAltitude:-100]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
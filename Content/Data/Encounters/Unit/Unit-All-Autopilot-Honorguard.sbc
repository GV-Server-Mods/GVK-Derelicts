<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Honorguard Cruiser Fighter Autopilot (Secondary; Primary is GVK-Unit-All-Autopilot-HoverCruiserHorsefly-Passive) -->
		<!-- Secondary (combat): HoverCruiserHorsefly-Aggressive plus the Fighter strafing tags, so the Honorguard patrols on the cruiser Passive profile and
		     fights like the other cruisers (steering reasoning in Unit-All-Autopilot-HoverCruiserHorsefly.sbc). FlyLevelWithGravity is off: it probably kept
		     the nose level because the old RotationMultiplier 8 pitched as hard as it yawed; LimitPitchTurning now stops the backflip instead.
		     Strafing never used the level-mode thrust routine anyway. Keep this in step with the cruiser profile. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-Honorguard-Aggressive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[RotationMultiplierPitch:3]
			[RotationMultiplierYaw:3]
			[RotationMultiplierRoll:3]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:0.25]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[RollIntoTurnsMultiplier:0.25]
			[MaxBankAngle:15]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[WaypointTolerance:100]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:101]
			[IdealPlanetAltitude:25]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:5000]
			[CollisionEvasionWaypointDistance:300]
			[CollisionEvasionResumeDistance:150]
			[CollisionEvasionResumeTime:10]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointAbandonTimeTrigger:20]
			[WaypointWaitTimeTrigger:0]
			[IdealMinSpeed:35]
			[//MES thrusts only below IdealMaxSpeed - MaxSpeedTolerance and coasts above it, so this cruises at 55 m/s.]
			[IdealMaxSpeed:60]
			[MaxSpeedTolerance:5]
			[OffsetPlanetMinDistFromTarget:1200]
			[OffsetPlanetMaxDistFromTarget:2000]
			[OffsetPlanetMinTargetAltitude:10]
			[OffsetPlanetMaxTargetAltitude:15]
			[OffsetMaxAngleFromTarget:90]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			[UseProjectileLeadPrediction:false]
			[//Fighter strafing (Honorguard only)]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1000]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:1]
			[StrafeMaxCooldownMs:2]
			[StrafeSpeedCutOff:50]
			[StrafeDistanceCutOff:500]
			[//StrafeMinimumTargetDistance is also how close terrain or a grid may be before a strafe direction is reversed or dropped (ThrustSystem.cs:540-680). At 400 dunes and the ground below blocked most directions on a planet, so strafes went up (where the hover engines pull back down) or nowhere]
			[StrafeMinimumTargetDistance:150]
			[StrafeMinimumSafeAngleFromTarget:25]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
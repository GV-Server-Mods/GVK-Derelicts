<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
			GENERATED by tools/New-DogfightGroup.ps1 (group LargeFlyerFighterPlane). Do not edit by hand; change the table in the script and rerun it.
			Dogfight switch: Large flyers with fixed forward guns (Chad Shuttle, GR-650).
			Against a target more than 100 m above the surface, swap GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Strike in the Secondary slot for GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Dogfight and FighterPlane for Strike; swap back once the target is under 60 m.
			FighterPlane lines up its next run straight ahead of the plane, so a chased plane keeps flying away from the fight; Strike picks a line-up point around the target, and the Dogfight profile keeps it close and level.
			Needs MES with the OverwriteAutopilotProfile fix (MeridiusIX/Modular-Encounters-Systems#464): without it the swap undoes itself.
			Chased: a Strike line-up point keeps its direction from the target, so when the target chases the plane the point can run ahead of it at the target's speed. With the target behind and flying at it, switching to FighterPlane and back restarts Strike, which picks a new point.
			Break: a new point still moves with a target that follows the plane, and Strike starts no run with the target inside the breakaway distance, so Chased loads GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Break instead: it starts the run at once and turns the plane at its chaser. BreakEnd puts the Dogfight profile back when the run ends.
			Run limit: a run ends only within the breakaway distance, so two planes on runs at each other at the same speed circle and climb without end. RunStart (BehaviorTriggerB) sets GVK_AttackRun and restarts the RunLimit timer; RunLimit ends a run still going after 10 s; RunEnd (BehaviorTriggerA) clears GVK_AttackRun.
			High: above 1000 m the Secondary slot gets a copy of the loaded profile with LimitPitchTurning off (Unit-All-Autopilot-LargeFlyerFighterPlane-High.sbc), and under 900 m the original goes back: toward a target behind it a plane on LimitPitchTurning can only pitch nose-up, so dogfights drifted up. Other actions load the original and clear GVK_DogfightHigh.
			ToDogfight checks the subclass, not GVK_Dogfight: a plane that loses its target and picks up a new one before Reset runs is back in FighterPlane with the Dogfight profile still loaded, and this puts it in Strike.
			Behavior: [TriggerGroups:GVK-Unit-All-TriggerGroup-LargeFlyerFighterPlaneDogfight] after GVK-Unit-All-TriggerGroup-PatrolFighterPlaneLarge, with [SecondaryAutopilotData:GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Strike].
			Booleans: GVK_Dogfight (the Secondary slot holds the Dogfight profile), GVK_Break (the Secondary slot holds the Break profile), GVK_AttackRun (a dogfight run is going), GVK_DogfightHigh (the Secondary slot holds a copy with LimitPitchTurning off).
		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-TriggerGroup-LargeFlyerFighterPlaneDogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-HighDogfight]
			[Triggers:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-LowDogfight]
			[Triggers:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-HighBreak]
			[Triggers:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-LowBreak]
			[Triggers:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-ToDogfight]
			[Triggers:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-ToStrike]
			[Triggers:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-Reset]
			[Triggers:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-Chased]
			[Triggers:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-BreakEnd]
			[Triggers:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-RunStart]
			[Triggers:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-RunLimit]
			[Triggers:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-RunEnd]
			</Description>
		</EntityComponent>
		<!-- In combat on FighterPlane, not a wing, target more than 100 m up -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-ToDogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:3000]
			[MaxCooldownMs:3001]
			[Conditions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Condition-ToDogfight]
			[Actions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-ToDogfight]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Condition-ToDogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_InCombat]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_Role_Escort]
			[BehaviorSubclassCheck:true]
			[BehaviorSubclass:FighterPlane]
			[TargetAltitudeCheck:true]
			[MinTargetAltitude:100]
			[MaxTargetAltitude:-1]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-ToDogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Dogfight on]
			[OverwriteAutopilotProfile:true]
			[OverwriteAutopilotMode:Secondary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Dogfight]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Strike]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[SetBooleansTrue:GVK_Dogfight]
			[SetBooleansFalse:GVK_AttackRun]
			[SetBooleansFalse:GVK_DogfightHigh]
			</Description>
		</EntityComponent>
		<!-- In combat, not a wing, target back under 60 m -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-ToStrike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:3000]
			[MaxCooldownMs:3001]
			[Conditions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Condition-ToStrike]
			[Actions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-ToStrike]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Condition-ToStrike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_InCombat]
			[TrueBooleans:GVK_Dogfight]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_Role_Escort]
			[TargetAltitudeCheck:true]
			[MinTargetAltitude:-1]
			[MaxTargetAltitude:60]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-ToStrike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Dogfight off]
			[OverwriteAutopilotProfile:true]
			[OverwriteAutopilotMode:Secondary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Strike]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:FighterPlane]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[SetBooleansFalse:GVK_Dogfight]
			[SetBooleansFalse:GVK_Break]
			[SetBooleansFalse:GVK_AttackRun]
			[SetBooleansFalse:GVK_DogfightHigh]
			</Description>
		</EntityComponent>
		<!-- Combat over (Patrol already set by the PatrolFighterPlaneLarge group): put the attack-run profile back so the next fight starts with attack runs -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-Reset</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]

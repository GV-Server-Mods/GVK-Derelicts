			[FalseBooleans:GVK_InCombat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-Reset</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Dogfight reset]
			[OverwriteAutopilotProfile:true]
			[OverwriteAutopilotMode:Secondary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Strike]
			[SetBooleansFalse:GVK_Dogfight]
			[SetBooleansFalse:GVK_Break]
			[SetBooleansFalse:GVK_AttackRun]
			[SetBooleansFalse:GVK_DogfightHigh]
			</Description>
		</EntityComponent>
		<!-- In a dogfight with the target behind and flying at the plane: restart Strike for a new line-up point instead of fleeing -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-Chased</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Conditions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Condition-Chased]
			[Actions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-ChasedLeaveStrike]
			[Actions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-ChasedBackToStrike]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Condition-Chased</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_InCombat]
			[TrueBooleans:GVK_Dogfight]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_Role_Escort]
			[FalseBooleans:GVK_Break]
			[BehaviorSubclassCheck:true]
			[BehaviorSubclass:Strike]
			[CheckTargetAngleFromForward:true]
			[MinTargetAngle:120]
			[MaxTargetAngle:-1]
			[CheckIfTargetIsChasing:true]
			[MinTargetChaseAngle:-1]
			[MaxTargetChaseAngle:45]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-ChasedLeaveStrike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Chased: break turn]
			[OverwriteAutopilotProfile:true]
			[OverwriteAutopilotMode:Secondary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Break]
			[SetBooleansTrue:GVK_Break]
			[SetBooleansFalse:GVK_AttackRun]
			[SetBooleansFalse:GVK_DogfightHigh]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:FighterPlane]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>

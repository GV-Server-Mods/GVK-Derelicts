			[OverwriteAutopilotMode:Secondary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-Dogfight]
			[SetBooleansFalse:GVK_Break]
			[SetBooleansFalse:GVK_DogfightHigh]
			</Description>
		</EntityComponent>
		<!-- A dogfight run started (Strike raises BehaviorTriggerB): restart the RunLimit timer -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-RunStart</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:BehaviorTriggerB]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Condition-RunStart]
			[Actions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-RunStart]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Condition-RunStart</SubtypeId>
			</Id>
			<Description>

			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_Dogfight]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-RunStart</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SetBooleansTrue:GVK_AttackRun]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-RunLimit]
			</Description>
		</EntityComponent>
		<!-- A run still going 10 s after it started: end it (two planes on runs at each other never get inside the breakaway distance) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-RunLimit</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:false]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Conditions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Condition-RunLimit]
			[Actions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-RunLimit]
			</Description>
		</EntityComponent>

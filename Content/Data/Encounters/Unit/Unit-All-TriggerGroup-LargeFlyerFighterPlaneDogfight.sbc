			[SetBooleansFalse:GVK_AttackRun]
			</Description>
		</EntityComponent>
		<!-- Above 1000 m with the Dogfight profile loaded: load its copy with LimitPitchTurning off -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Trigger-HighDogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[Conditions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Condition-HighDogfight]
			[Actions:GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-HighDogfight]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Condition-HighDogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_Dogfight]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_DogfightHigh]
			[FalseBooleans:GVK_Break]
			[AltitudeCheck:true]
			[MinAltitude:1000]
			[MaxAltitude:-1]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-LargeFlyerFighterPlaneDogfight-Action-HighDogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:LimitPitchTurning off]

			[OverwriteAutopilotMode:Secondary]
			[OverwriteAutopilotId:GVK-Unit-All-Autopilot-LargeFlyerFighterPlane-DogfightHigh]
			[SetBooleansTrue:GVK_DogfightHigh]
			</Description>
		</EntityComponent>
		<!-- Under 900 m with the Dogfight copy loaded: put the original back -->

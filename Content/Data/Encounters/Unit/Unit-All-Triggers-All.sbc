<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Barrel roll every 30-60 s for aircraft, except while flying as an escort (a roll stops it turning toward its slot) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Trigger-BarrelRoll</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Timer]
				[DamageTypes:Any]
				[MinCooldownMs:30000]
				[MaxCooldownMs:60000]
				[StartsReady:true]
				[MaxActions:-1]
				[Conditions:GVK-Unit-All-Condition-AircraftNotEscort]
				[Actions:GVK-Unit-All-Action-BarrelRoll]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Action-BarrelRoll</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[BarrelRoll:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Trigger-SpawnAnyCOALITIONAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:PlayerNear]
				[UseTrigger:true]
				[TargetDistance:3000]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:5000]
				[MaxCooldownMs:5001]
				[//Conditions:GVK-Unit-Encounter-Condition-IsUnitEncounter]
				[Actions:GVK-Unit-Encounter-Action-SpawnAnyCOALITIONAttackers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Action-SpawnAnyCOALITIONAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:10]
				[SpawnEncounter:true]
				[Spawner:GVK-Unit-Encounter-Spawner-SpawnAnyCOALITIONAttackers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Spawner-SpawnAnyCOALITIONAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[MinDistance:500]
				[MaxDistance:1000]
				[MinAltitude:25]
				[MaxAltitude:50]
				[InheritNpcAltitude:false]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-COALITION-LAV]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-COALITION-BaserunnerLight]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-COALITION-BaserunnerHeavy]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-COALITION-LargeRover]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-COALITION-StrikeFighter]
				[ProcessAsAdminSpawn:false]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Trigger-SpawnSmallCOALITIONAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:PlayerNear]
				[UseTrigger:true]
				[TargetDistance:3000]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:5000]
				[MaxCooldownMs:5001]
				[//Conditions:GVK-Unit-Encounter-Condition-IsUnitEncounter]
				[Actions:GVK-Unit-Encounter-Action-SpawnSmallCOALITIONAttackers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Action-SpawnSmallCOALITIONAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:10]
				[SpawnEncounter:true]
				[Spawner:GVK-Unit-Encounter-Spawner-SpawnSmallCOALITIONAttackers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Spawner-SpawnSmallCOALITIONAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[MinDistance:500]
				[MaxDistance:1000]
				[MinAltitude:25]
				[MaxAltitude:50]
				[InheritNpcAltitude:false]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-COALITION-StrikeFighter]
				[SpawnGroups:GVK-Unit-Encounter-SpawnGroup-COALITION-LAV]
				[ProcessAsAdminSpawn:false]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<!-- Sequence to spawn enemy GAALSIEN attackers (used by the unit default trigger groups) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Trigger-SpawnAnyGAALSIENAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:PlayerNear]
				[UseTrigger:true]
				[TargetDistance:3000]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:5000]
				[MaxCooldownMs:5001]
				[Conditions:GVK-Unit-Encounter-Condition-IsUnitEncounter]
				[Actions:GVK-Unit-Encounter-Action-SpawnAnyGAALSIENAttackers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Action-SpawnAnyGAALSIENAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:10]
				[SpawnEncounter:true]
				[Spawner:GVK-Unit-Encounter-Spawner-SpawnAnyGAALSIENAttackers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Spawner-SpawnAnyGAALSIENAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[MinDistance:500]
				[MaxDistance:1000]
				[MinAltitude:25]
				[MaxAltitude:50]
				[InheritNpcAltitude:false]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-InterceptorSingle]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-InterceptorSquad]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-LightSandskimmerSquad]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-MediumHoverLight]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-MediumHoverHeavy]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-LargeHover]
				[ProcessAsAdminSpawn:false]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Trigger-SpawnSmallGAALSIENAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:PlayerNear]
				[UseTrigger:true]
				[TargetDistance:3000]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:5000]
				[MaxCooldownMs:5001]
				[Conditions:GVK-Unit-Encounter-Condition-IsUnitEncounter]
				[Actions:GVK-Unit-Encounter-Action-SpawnSmallGAALSIENAttackers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Action-SpawnSmallGAALSIENAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:10]
				[SpawnEncounter:true]
				[Spawner:GVK-Unit-Encounter-Spawner-SpawnSmallGAALSIENAttackers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Encounter-Spawner-SpawnSmallGAALSIENAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[MinDistance:500]
				[MaxDistance:1000]
				[MinAltitude:25]
				[MaxAltitude:50]
				[InheritNpcAltitude:false]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-InterceptorSingle]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-InterceptorSquad]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-LightSandskimmerSquad]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-MediumHoverLight]
				[ProcessAsAdminSpawn:false]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<!-- Air support: a single aircraft of the behavior's own faction. The behavior's init action sets the custom strings
		     AirSupportSpawnGroup (the spawn group) and AirSupportName (the chat author after the faction tag). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Trigger-SpawnAirSupport</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:PlayerNear]
				[UseTrigger:true]
				[TargetDistance:1500]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10001]
				[Actions:GVK-Unit-All-Action-SpawnAirSupport]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Action-SpawnAirSupport</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:50]
				[SpawnEncounter:true]
				[Spawner:GVK-Unit-All-Spawner-SpawnAirSupport]
				[UseChatBroadcast:true]
				[ChatData:GVK-Unit-All-Chat-SpawnAirSupport]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Spawner-SpawnAirSupport</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[MinDistance:600]
				[MaxDistance:800]
				[MinAltitude:50]
				[MaxAltitude:100]
				[InheritNpcAltitude:false]
				[SpawnGroups:{AirSupportSpawnGroup}]
				[ProcessAsAdminSpawn:false]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Chat-SpawnAirSupport</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:50]
				[BroadcastRandomly:false]
				[Author:{Faction} {AirSupportName}]
				[Color:{PlayerRelation}]
				[ChatMessages:Air support inbound.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:false]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Elite Escorts: two of the behavior's own faction. The Elite behavior's init action sets the custom string EliteEscortSpawnGroup. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Elite-Trigger-SpawnMediumEscorts</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:PlayerNear]
				[UseTrigger:true]
				[TargetDistance:3000]
				[StartsReady:false]
				[MaxActions:2]
				[MinCooldownMs:2000]
				[MaxCooldownMs:2001]
				[Actions:GVK-Unit-Elite-Action-SpawnMediumEscorts]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Elite-Action-SpawnMediumEscorts</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SpawnEncounter:true]
				[Spawner:GVK-Unit-Elite-Spawner-SpawnMediumEscorts]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Elite-Spawner-SpawnMediumEscorts</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[MinDistance:200]
				[MaxDistance:201]
				[MinAltitude:25]
				[MaxAltitude:26]
				[InheritNpcAltitude:false]
				[SpawnGroups:{EliteEscortSpawnGroup}]
				[ProcessAsAdminSpawn:false]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<!-- Condition check Unit isn't currently an escort -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Condition-NotEscortRole</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckFalseBooleans:true]
				[FalseBooleans:GVK_Role_Escort]
			</Description>
		</EntityComponent>
		<!-- Patrol<Name> groups: enter combat only while holding a target, and never as a wing -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Condition-CanStartCombat</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[HasTarget:true]
				[CheckFalseBooleans:true]
				[FalseBooleans:GVK_Role_Escort]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Condition-AircraftNotEscort</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_MobilityType_Aircraft]
				[CheckFalseBooleans:true]
				[FalseBooleans:GVK_Role_Escort]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
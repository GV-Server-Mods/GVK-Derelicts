<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Sandskimmer Behavior: Patrol, attack runs on the Strike subclass in combat -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Behavior-Sandskimmer-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[DialogueBanks:GVK-Units-KHAANEPH-Small.xml]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:240]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km-Ground]
			[OverrideTargetData:GVK-Universal-Target-Override-Ground]
			[AutopilotData:GVK-Unit-All-Autopilot-Sandskimmer-Patrol]
			[SecondaryAutopilotData:GVK-Unit-All-Autopilot-Sandskimmer-Strike]
			[TertiaryAutopilotData:GVK-Unit-All-Autopilot-HoverWing]
			[Triggers:GVK-Unit-All-Trigger-Init-SmallCraft]
			[TriggerGroups:GVK-Universal-TriggerGroup-CombatDefaults]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-SmallUnit]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-PatrolStrikeHover]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-LeashGround]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-CombatKPL]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-PeerEscort-Land]
			[//Two slots, 20 m out, so the wings fly 40 m apart, and 10 m ahead (-Z). A slot swings at the leader's turn rate times its distance out, so at 30 m the wing fell behind on the Strike turns (C6 2026-11-11). The wing holds the leader's speed within 20 m of its slot (LandWing), so it settles about level with the leader.]
			[EscortOffsets:{X:20 Y:0 Z:-10}]
			[EscortOffsets:{X:-20 Y:0 Z:-10}]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-FlyAwayFailsafe]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-DespawnInKOTH]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
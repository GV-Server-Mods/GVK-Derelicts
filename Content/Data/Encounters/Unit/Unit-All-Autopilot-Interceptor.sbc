<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallFlyer-Interceptor Passive Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Autopilot-Interceptor-Passive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[//Steering as the Strike Fighter (Unit-All-Autopilot-StrikeFighter.sbc explains bank, pitch and MaxAngleFromVelocity); yaw 1 matches the AirWing it pairs with.]
			[RotationMultiplierPitch:1.5]
			[RotationMultiplierYaw:1]
			[RotationMultiplierRoll:1]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:300]
			[MinimumPlanetAltitude:200]
			[AltitudeTolerance:20]
			[WaypointTolerance:100]
			[BarrelRollMinDurationMs:0]
			[BarrelRollMaxDurationMs:0]
			[RamMinDurationMs:0]
			[RamMaxDurationMs:0]
			[IdealMinSpeed:39]
			[IdealMaxSpeed:40]
			[SlowDownOnWaypointApproach:true]
			[WaypointWaitTimeTrigger:0]
			[MaxSpeedTolerance:10]
			[WaypointAbandonTimeTrigger:6]
			[OffsetPlanetMinDistFromTarget:400]
			[OffsetPlanetMaxDistFromTarget:500]
			[OffsetPlanetMinTargetAltitude:300]
			[OffsetPlanetMaxTargetAltitude:400]
			[OffsetMaxAngleFromTarget:90]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[MaxAngleFromVelocity:60]
			[RollIntoTurnsMultiplier:0.8]
			[MaxBankAngle:60]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- SmallFlyer-Interceptor Aggressive Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Autopilot-Interceptor-Aggressive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[//Steering as the Strike Fighter (Unit-All-Autopilot-StrikeFighter.sbc explains bank, pitch and MaxAngleFromVelocity); yaw 1 matches the AirWing it pairs with.]
			[RotationMultiplierPitch:2.5]
			[RotationMultiplierYaw:1]
			[RotationMultiplierRoll:1]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:400]
			[MinimumPlanetAltitude:250]
			[AltitudeTolerance:30]
			[WaypointTolerance:200]
			[BarrelRollMinDurationMs:2000]
			[BarrelRollMaxDurationMs:2500]
			[RamMinDurationMs:6000]
			[RamMaxDurationMs:6001]
			[IdealMinSpeed:70]
			[IdealMaxSpeed:120]
			[MaxSpeedTolerance:20]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:30]
			[OffsetPlanetMinDistFromTarget:500]
			[OffsetPlanetMaxDistFromTarget:1500]
			[OffsetPlanetMinTargetAltitude:-100]
			[OffsetPlanetMaxTargetAltitude:100]
			[OffsetMaxAngleFromTarget:90]
			[MaxVerticalSpeed:-1]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[MaxAngleFromVelocity:60]
			[RollIntoTurnsMultiplier:0.8]
			[MaxBankAngle:45]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Elite Variant -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Elite-Behavior-HoverCruiserHorsefly-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[DialogueBanks:GVK-Units-SOBAN-Large.xml]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:2400]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[OverrideTargetData:GVK-Universal-Target-Override]
			[AutopilotData:GVK-Unit-All-Autopilot-HoverCruiserHorsefly-Passive]
			[SecondaryAutopilotData:GVK-Unit-All-Autopilot-HoverCruiserHorsefly-Aggressive]
			[TertiaryAutopilotData:GVK-Unit-All-Autopilot-HoverCruiserHorsefly-Stop]
			[Triggers:GVK-Unit-Elite-Trigger-Init-HoverCruiserHorsefly-SOBAN]
			[Triggers:GVK-Unit-Elite-Trigger-SpawnMediumEscorts]
			[Triggers:GVK-Unit-All-Trigger-SpawnAirSupport]
			[TriggerGroups:GVK-Universal-TriggerGroup-CombatDefaults]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-UnitDefaults-LargeUnit]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-PatrolHorsefly]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-LeashGround]
			[TriggerGroups:GVK-Universal-TriggerGroup-LeashBeacon]
			[TriggerGroups:GVK-Unit-All-TriggerGroup-CombatKPL]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-ConvoySystem-Leader-TriggerGroup]
			[TriggerGroups:GVK-Universal-TriggerGroup-DespawnInKOTH]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			[EscortOffsets:{X:150 Y:0 Z:100}]
			[EscortOffsets:{X:-150 Y:0 Z:100}]
			[RemoteControlCode:GVK-Elite]
			BountyOnKill=50000000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Elite-Trigger-Init-HoverCruiserHorsefly-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:true]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-Unit-Elite-Action-Init-HoverCruiserHorsefly-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-Elite-Action-Init-HoverCruiserHorsefly-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,UnitElite]
			[CustomStrings:EncounterDisplayName,Elite Cruiser]
			[CustomStrings:AirSupportSpawnGroup,GVK-Unit-Defense-SpawnGroup-SOBAN-StrikeFighterSingle]
			[CustomStrings:EliteEscortSpawnGroup,GVK-Unit-Defense-SpawnGroup-SOBAN-BaserunnerHeavy]
			[UseChatBroadcast:true]
			[ChatData:GVK-Unit-Elite-Chat-Spawned]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
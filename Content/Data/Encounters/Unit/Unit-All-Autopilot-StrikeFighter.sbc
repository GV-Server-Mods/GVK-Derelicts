<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallFlyerHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-StrikeFighter-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[WaypointAbandonTimeTrigger:15]
			[WaypointWaitTimeTrigger:0]
			[RotationMultiplierPitch:1.5]
			[RotationMultiplierYaw:1]
			[RotationMultiplierRoll:2]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:1]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:500]
			[MinimumPlanetAltitude:400]
			[AltitudeTolerance:50]
			[WaypointTolerance:150]
			[RamMinDurationMs:0]
			[RamMaxDurationMs:0]
			[IdealMinSpeed:39]
			[IdealMaxSpeed:40]
			[BarrelRollMinDurationMs:0]
			[BarrelRollMaxDurationMs:0]
			[OffsetPlanetMinDistFromTarget:1000]
			[OffsetPlanetMaxDistFromTarget:1001]
			[OffsetPlanetMinTargetAltitude:350]
			[OffsetPlanetMaxTargetAltitude:400]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[//60, as the attack profile: at 35 a plane sinking in a banked turn had its nose pulled down after it.]
			[MaxAngleFromVelocity:60]
			[RollIntoTurnsMultiplier:0.8]
			[MaxBankAngle:60]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-StrikeFighter-Strike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[AttackRunDistancePlanet:500]
			[AttackRunBreakawayDistance:700]
			[AttackRunOverrideWithDistanceAndTimer:true]
			[//The override starts the run once the plane has been within AttackRunOverrideDistance of its line-up point for this many seconds, for a plane circling just outside AttackRunDistancePlanet.]
			[//At 1500 m and 3 s it turned in ~1100 m short of the point (130 m/s). 800 m takes ~6 s to cross, so after 8 s it is only still inside if it's circling.]
			[AttackRunOverrideTimerTrigger:8]
			[AttackRunOverrideDistance:800]
			[OffsetRecalculationTime:40]
			[AttackRunUseSafePlanetPathing:false]
			[AttackRunUseCollisionEvasionPlanet:false]
			[WaypointAbandonTimeTrigger:30]
			[WaypointWaitTimeTrigger:0]
			[RotationMultiplierPitch:2.5]
			[RotationMultiplierYaw:1]
			[RotationMultiplierRoll:2]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[//The run aims straight at the target and ignores the floor. Below MinimumPlanetAltitude afterwards, planet pathing climbs toward a point 50 m ahead at IdealPlanetAltitude until within AltitudeTolerance of it, so 150 and 30 end the climb back at the 120 m floor: a short pull-up (owner, 2026-11-11; GVK-Settings#730).]
			[//75 and 600 until then: the climb back went nearly straight up to 600, and with a 350 floor every breakaway did it.]
			[IdealPlanetAltitude:150]
			[MinimumPlanetAltitude:120]
			[AltitudeTolerance:30]
			[WaypointTolerance:200]
			[RamMinDurationMs:6000]
			[RamMaxDurationMs:6001]
			[IdealMinSpeed:80]
			[//Patrol and Strike top speeds are 10 m/s lower than before, so a peer wing (AirWing, 150) has room to catch up.]
			[IdealMaxSpeed:120]
			[BarrelRollMinDurationMs:1500]
			[BarrelRollMaxDurationMs:2500]
			[OffsetPlanetMinDistFromTarget:2400]
			[OffsetPlanetMaxDistFromTarget:2800]
			[//The line-up point sits 550-650 m above the target, so the run dives at it (~13 degrees from 2400-2800 m out) instead of skimming in. 300-400 still started too low.]
			[OffsetPlanetMinTargetAltitude:550]
			[OffsetPlanetMaxTargetAltitude:650]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[//60: MES keeps the nose within this angle of the flight path, so at 35 a plane sinking in a banked turn had its nose pulled down after it.]
			[MaxAngleFromVelocity:60]
			[//Roll-in 1 (0.8 until GVK-Settings#730): on a run as low as 75 m small corrections stay under the bank cap, so this banks the plane sooner on them but no further.]
			[RollIntoTurnsMultiplier:1]
			[//45: banked, yaw also swings the nose down, and turning for a run behind it the plane turns mostly by yaw (LimitPitchTurning keeps pitch small); at 60 it dove.]
			[//Pitch 2.5 (above) gives the pull toward the inside of the turn more weight against that.]
			[MaxBankAngle:45]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Against aircraft (GVK-Unit-All-TriggerGroup-StrikeFighterDogfight swaps it into the Strike slot, with the Strike subclass): Strike's flight model, with runs lined up close and level with the target. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-StrikeFighter-Dogfight</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[AttackRunDistancePlanet:250]
			[AttackRunBreakawayDistance:200]
			[AttackRunOverrideWithDistanceAndTimer:true]
			[//A chased plane may never reach its line-up point: within 500 m of it for 3 s, it turns in anyway.]
			[AttackRunOverrideTimerTrigger:3]
			[AttackRunOverrideDistance:500]
			[//The line-up point moves with the target and is only re-rolled after this many seconds; reaching one up to ~1.3 km away after a pass, with the turn, takes ~18 s at 80-120 m/s.]
			[OffsetRecalculationTime:20]
			[AttackRunUseSafePlanetPathing:false]
			[AttackRunUseCollisionEvasionPlanet:false]
			[WaypointAbandonTimeTrigger:30]
			[WaypointWaitTimeTrigger:0]
			[RotationMultiplierPitch:2.5]
			[RotationMultiplierYaw:1]
			[RotationMultiplierRoll:2]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[//A line-up point under the minimum altitude is moved up to halfway between it and the ideal one (here about 210 m). 300 m keeps that lift small and still leaves room to dive.]
			[IdealPlanetAltitude:300]
			[//120 (75 until GVK-Settings#730): a fight near the ground lines up no lower than this.]
			[MinimumPlanetAltitude:120]
			[AltitudeTolerance:10]
			[WaypointTolerance:200]
			[RamMinDurationMs:6000]
			[RamMaxDurationMs:6001]
			[IdealMinSpeed:80]
			[IdealMaxSpeed:120]
			[BarrelRollMinDurationMs:1500]
			[BarrelRollMaxDurationMs:2500]
			[//Line-up points 600-900 m out, so passes stay inside 1 km instead of Strike's 2.4-2.8 km, and 50-200 m below the target: two NPC planes fighting each other only have each other's height to go by, so with points above the target the pair climbed together, and with points up to 150 m below it the pair still drifted up (a plane can only pitch nose-up toward a point behind it; GVK-Settings#742, 2026-11-09). 150-300 m below sometimes flew planes into the ground (owner, 2026-11-09).]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:900]
			[OffsetPlanetMinTargetAltitude:-200]
			[OffsetPlanetMaxTargetAltitude:-50]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[MaxAngleFromVelocity:60]
			[RollIntoTurnsMultiplier:1]
			[//Dogfight turns run far off heading, so they bank at this cap (45 until GVK-Settings#730). If a plane dives in a turn, raise MaxAngleFromVelocity first, then lower this.]
			[MaxBankAngle:55]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Break: loaded by the dogfight group's Chased trigger when the target chases the plane, and swapped back for Dogfight when the run ends. The Dogfight profile with only the run distances and bank cap changed (tools/Test-Docs.ps1 checks). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-StrikeFighter-Break</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[//Wider than any line-up distance, so the run starts at once and the plane turns at its chaser instead of flying to a line-up point that moves with it.]
			[AttackRunDistancePlanet:5000]
			[AttackRunBreakawayDistance:200]
			[AttackRunOverrideWithDistanceAndTimer:true]
			[AttackRunOverrideTimerTrigger:3]
			[AttackRunOverrideDistance:500]
			[OffsetRecalculationTime:20]
			[AttackRunUseSafePlanetPathing:false]
			[AttackRunUseCollisionEvasionPlanet:false]
			[WaypointAbandonTimeTrigger:30]
			[WaypointWaitTimeTrigger:0]
			[RotationMultiplierPitch:2.5]
			[RotationMultiplierYaw:1]
			[RotationMultiplierRoll:2]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:300]
			[MinimumPlanetAltitude:120]
			[AltitudeTolerance:10]
			[WaypointTolerance:200]
			[RamMinDurationMs:6000]
			[RamMaxDurationMs:6001]
			[IdealMinSpeed:80]
			[IdealMaxSpeed:120]
			[BarrelRollMinDurationMs:1500]
			[BarrelRollMaxDurationMs:2500]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:900]
			[OffsetPlanetMinTargetAltitude:-200]
			[OffsetPlanetMaxTargetAltitude:-50]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[MaxAngleFromVelocity:60]
			[RollIntoTurnsMultiplier:1]
			[//5 above Dogfight's cap, never below it: the break turn lasts a few seconds, so it costs little height.]
			[MaxBankAngle:60]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallFlyerHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-StrikeFighter-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[WaypointAbandonTimeTrigger:15]
			[WaypointWaitTimeTrigger:0]
			[RotationMultiplierPitch:1.5]
			[RotationMultiplierYaw:1]
			[RotationMultiplierRoll:2]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:1]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:500]
			[MinimumPlanetAltitude:400]
			[AltitudeTolerance:50]
			[WaypointTolerance:150]
			[RamMinDurationMs:0]
			[RamMaxDurationMs:0]
			[IdealMinSpeed:39]
			[IdealMaxSpeed:40]
			[BarrelRollMinDurationMs:0]
			[BarrelRollMaxDurationMs:0]
			[OffsetPlanetMinDistFromTarget:1000]
			[OffsetPlanetMaxDistFromTarget:1001]
			[OffsetPlanetMinTargetAltitude:350]
			[OffsetPlanetMaxTargetAltitude:400]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[//60, as the attack profile: at 35 a plane sinking in a banked turn had its nose pulled down after it.]
			[MaxAngleFromVelocity:60]
			[RollIntoTurnsMultiplier:0.8]
			[MaxBankAngle:60]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-StrikeFighter-Strike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[AttackRunDistancePlanet:500]
			[AttackRunBreakawayDistance:700]
			[AttackRunOverrideWithDistanceAndTimer:true]
			[//The override starts the run once the plane has been within AttackRunOverrideDistance of its line-up point for this many seconds, for a plane circling just outside AttackRunDistancePlanet.]
			[//At 1500 m and 3 s it turned in ~1100 m short of the point (130 m/s). 800 m takes ~6 s to cross, so after 8 s it is only still inside if it's circling.]
			[AttackRunOverrideTimerTrigger:8]
			[AttackRunOverrideDistance:800]
			[OffsetRecalculationTime:40]
			[AttackRunUseSafePlanetPathing:false]
			[AttackRunUseCollisionEvasionPlanet:false]
			[WaypointAbandonTimeTrigger:30]
			[WaypointWaitTimeTrigger:0]
			[RotationMultiplierPitch:2.5]
			[RotationMultiplierYaw:1]
			[RotationMultiplierRoll:2]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:600]
			[//The run aims straight at the target and ignores this floor; below it on the way out, planet pathing climbs nearly straight up to IdealPlanetAltitude.]
			[//At 350 a run from the line-up point ended below it, so every breakaway climbed vertically over the target. 75 is only a terrain floor.]
			[MinimumPlanetAltitude:75]
			[AltitudeTolerance:10]
			[WaypointTolerance:200]
			[RamMinDurationMs:6000]
			[RamMaxDurationMs:6001]
			[IdealMinSpeed:80]
			[//Patrol and Strike top speeds are 10 m/s lower than before, so a peer wing (AirWing, 150) has room to catch up.]
			[IdealMaxSpeed:120]
			[BarrelRollMinDurationMs:1500]
			[BarrelRollMaxDurationMs:2500]
			[OffsetPlanetMinDistFromTarget:2400]
			[OffsetPlanetMaxDistFromTarget:2800]
			[//The line-up point sits 550-650 m above the target, so the run dives at it (~13 degrees from 2400-2800 m out) instead of skimming in. 300-400 still started too low.]
			[OffsetPlanetMinTargetAltitude:550]
			[OffsetPlanetMaxTargetAltitude:650]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			[UseAircraftFlightModel:true]
			[//60: MES keeps the nose within this angle of the flight path, so at 35 a plane sinking in a banked turn had its nose pulled down after it.]
			[MaxAngleFromVelocity:60]
			[RollIntoTurnsMultiplier:0.8]
			[//45: banked, yaw also swings the nose down, and turning for a run behind it the plane turns mostly by yaw (LimitPitchTurning keeps pitch small); at 60 it dove.]
			[//Pitch 2.5 (above) gives the pull toward the inside of the turn more weight against that.]
			[MaxBankAngle:45]
			[ReturnToLevelMultiplier:0.25]
			[MaxRotationStep:0.5]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
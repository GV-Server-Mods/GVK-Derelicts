<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- HoverCruiserHorsefly Autopilot -->
		<!-- Steering (Passive and Aggressive; se-dev-mes behaviors_and_autopilot.md section 3G): MaxRotationStep 0.5 (read only with UseAircraftFlightModel) keeps every gyro command
		     inside Keen's fast gyro ramp, so the gyros push at full strength on all axes, even mid-turn. Without it a turn asked for yaw 5 x up to pi rad/s, and that big
		     combined gap put the gyros on their slow 2 s ramp, leaving little strength to resist players flipping the cruiser.
		     LimitPitchTurning (MES PR #453, not merged yet) stops the backflip toward a waypoint behind, where pitch and yaw both asked for the full rate. That had kept
		     pitch at 0.05-0.1, too weak to level the nose after a bump; with the tag pitch and roll are 3 like yaw (field-tested 2026-10-25).
		     FlyLevelWithGravity would stop the backflip too but drives the nose into rising ground on hills. Resisting a tip doesn't need a high multiplier: the step makes the gyros
		     stop any rotation a player starts at full strength. Roll also pushes back toward level (roll never aims at the waypoint);
		     roll 5 rocked the hull: above ~3 (MaxRotationMagnitude 0.25 / (stop angle + 0.25 s reaction)) it overshoots level on every 0.25 s update.
		     Yaw 3 at MaxRotationMagnitude 0.25 turns without overshoot (stops in ~1 degree after a 0.25 s reaction). LimitRotationSpeed off: it zeroed the request mid-turn.
		     RollIntoTurns: banks 0.25 degree per degree of heading error, up to 15, for looks (halved from 0.5) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-HoverCruiserHorsefly-Passive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[RotationMultiplierPitch:3]
			[RotationMultiplierYaw:3]
			[RotationMultiplierRoll:3]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:0.25]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[RollIntoTurnsMultiplier:0.25]
			[MaxBankAngle:15]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[WaypointTolerance:75]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:76]
			[IdealPlanetAltitude:25]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:5000]
			[WaypointAbandonTimeTrigger:15]
			[WaypointWaitTimeTrigger:0]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:20]
			[MaxSpeedTolerance:5]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:601]
			[OffsetPlanetMinTargetAltitude:10]
			[OffsetPlanetMaxTargetAltitude:15]
			[OffsetMaxAngleFromTarget:90]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-HoverCruiserHorsefly-Aggressive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[RotationMultiplierPitch:3]
			[RotationMultiplierYaw:3]
			[RotationMultiplierRoll:3]
			[LimitPitchTurning:true]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:0.25]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[RollIntoTurnsMultiplier:0.25]
			[MaxBankAngle:15]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[WaypointTolerance:100]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:101]
			[IdealPlanetAltitude:25]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:5000]
			[CollisionEvasionWaypointDistance:300]
			[CollisionEvasionResumeDistance:150]
			[CollisionEvasionResumeTime:10]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointAbandonTimeTrigger:20]
			[WaypointWaitTimeTrigger:0]
			[IdealMinSpeed:35]
			[//MES thrusts only below IdealMaxSpeed - MaxSpeedTolerance and coasts above it, so this cruises at 55 m/s.]
			[IdealMaxSpeed:60]
			[MaxSpeedTolerance:5]
			[OffsetPlanetMinDistFromTarget:1200]
			[OffsetPlanetMaxDistFromTarget:2000]
			[OffsetPlanetMinTargetAltitude:10]
			[OffsetPlanetMaxTargetAltitude:15]
			[OffsetMaxAngleFromTarget:90]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Full stop tertiary autopilot mode -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Unit-All-Autopilot-HoverCruiserHorsefly-Stop</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[RotationMultiplier:0]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:5000]
			[WaypointAbandonTimeTrigger:15]
			[WaypointTolerance:1]
			[IdealMinSpeed:0]
			[IdealMaxSpeed:0]
			[MaxSpeedTolerance:1]
			[OffsetPlanetMinDistFromTarget:0]
			[OffsetPlanetMaxDistFromTarget:1]
			[OffsetPlanetMinTargetAltitude:14]
			[OffsetPlanetMaxTargetAltitude:15]
			[AngleAllowedForForwardThrust:0]
			[MaxVelocityAngleForSpeedControl:180]
			[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
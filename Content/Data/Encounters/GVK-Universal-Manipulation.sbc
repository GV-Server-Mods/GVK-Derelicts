<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- TargetWhitlist blocks must be Public -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-Large3x3StandardTurrets</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:100]
				[RandomizeWeapons:true]
				[IgnoreWeaponRandomizerTargetGlobalBlacklist:true]
				[IgnoreWeaponRandomizerTargetGlobalWhitelist:true]
				[WeaponRandomizerWhitelist:MyObjectBuilder_LargeGatlingTurret/LargeGatlingTurretReskin_NPC,MyObjectBuilder_LargeMissileTurret/LargeCalibreTurretType2_NPC,MyObjectBuilder_LargeMissileTurret/KhopeshTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeBlockMediumCalibreTurretType2_NPC,MyObjectBuilder_LargeMissileTurret/SentinelTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeMissileTurretReskin_NPC,MyObjectBuilder_LargeMissileTurret/ARYXCycloneCannon_NPC]
				[WeaponRandomizerTargetWhitelist:MyObjectBuilder_LargeGatlingTurret/LargeGatlingTurret_NPC,MyObjectBuilder_LargeGatlingTurret/LargeGatlingTurretReskin_NPC,MyObjectBuilder_LargeMissileTurret/LargeCalibreTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeCalibreTurretType2_NPC,MyObjectBuilder_LargeMissileTurret/KhopeshTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeBlockMediumCalibreTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeBlockMediumCalibreTurretType2_NPC,MyObjectBuilder_LargeMissileTurret/SentinelTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeMissileTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeMissileTurretReskin_NPC,MyObjectBuilder_LargeMissileTurret/ARYXCycloneCannon_NPC]
			</Description>
		</EntityComponent>
		<!-- TargetWhitlist blocks must be Public -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-Large3x3HeavyTurrets</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:100]
				[RandomizeWeapons:true]
				[IgnoreWeaponRandomizerTargetGlobalBlacklist:true]
				[IgnoreWeaponRandomizerTargetGlobalWhitelist:true]
				[WeaponRandomizerWhitelist:MyObjectBuilder_LargeMissileTurret/ARYXSpartanTurret_NPC,MyObjectBuilder_LargeMissileTurret/GVK_AvengerGatlingTurret_NPC,MyObjectBuilder_LargeMissileTurret/ARYXHeavyFlakTurret_NPC,MyObjectBuilder_ConveyorSorter/missileBattery01_NPC,MyObjectBuilder_LargeMissileTurret/GVK_CycloneCannonTurret_NPC,MyObjectBuilder_ConveyorSorter/ARYXHydraTurret_NPC,MyObjectBuilder_ConveyorSorter/GVK_GriffinMissileTurret_NPC]
				[WeaponRandomizerTargetWhitelist:MyObjectBuilder_LargeMissileTurret/ARYXSpartanTurret_NPC,MyObjectBuilder_LargeMissileTurret/GVK_AvengerGatlingTurret_NPC,MyObjectBuilder_LargeMissileTurret/ARYXHeavyFlakTurret_NPC,MyObjectBuilder_ConveyorSorter/missileBattery01_NPC,MyObjectBuilder_LargeMissileTurret/GVK_CycloneCannonTurret_NPC,MyObjectBuilder_ConveyorSorter/ARYXHydraTurret_NPC,MyObjectBuilder_ConveyorSorter/GVK_GriffinMissileTurret_NPC]
				[//Only the first pool runs on a prefab: the convoy escort Light Baserunner skips this one for the Standard pool]
				[ManipulationRestrictedPrefabNames:NUN [GAAL] Light Baserunner]
			</Description>
		</EntityComponent>
		<!-- TargetWhitlist blocks must be Public -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-Small5x5StandardTurrets</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:100]
				[RandomizeWeapons:true]
				[IgnoreWeaponRandomizerTargetGlobalBlacklist:true]
				[IgnoreWeaponRandomizerTargetGlobalWhitelist:true]
				[WeaponRandomizerWhitelist:MyObjectBuilder_LargeGatlingTurret/SmallGatlingTurretReskin_NPC,MyObjectBuilder_LargeMissileTurret/ReceptorTurret_NPC,MyObjectBuilder_LargeMissileTurret/SmallMissileTurretReskin_NPC,MyObjectBuilder_LargeGatlingTurret/AutoCannonTurretType2_NPC]
				[WeaponRandomizerTargetWhitelist:MyObjectBuilder_LargeGatlingTurret/SmallGatlingTurret_NPC,MyObjectBuilder_LargeGatlingTurret/SmallGatlingTurretReskin_NPC,MyObjectBuilder_LargeMissileTurret/ReceptorTurret_NPC,MyObjectBuilder_LargeMissileTurret/SmallMissileTurret_NPC,MyObjectBuilder_LargeMissileTurret/SmallMissileTurretReskin_NPC,MyObjectBuilder_LargeMissileTurret/AutoCannonTurret_NPC,MyObjectBuilder_LargeGatlingTurret/AutoCannonTurretType2_NPC]
			</Description>
		</EntityComponent>
		<!-- Damage Reduction 0.25x -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-DamageModifier25</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:100]
				[OverrideBlockDamageModifier:true]
				[BlockDamageModifier:25]
			</Description>
		</EntityComponent>
		<!-- Damage Reduction 0.5x -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-DamageModifier50</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:100]
				[OverrideBlockDamageModifier:true]
				[BlockDamageModifier:50]
			</Description>
		</EntityComponent>
		<!-- Damage Reduction 0.75x -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-DamageModifier75</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:100]
				[OverrideBlockDamageModifier:true]
				[BlockDamageModifier:75]
			</Description>
		</EntityComponent>
		<!-- Random Color Hue Shift -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-ShiftColorHue</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:100]
				[ShiftBlockColorsHue:true]
				[RandomHueShift:true]
			</Description>
		</EntityComponent>
		<!-- Type I to Type II look swap (same stats), half the grids; GVK-Settings#813 -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-TypeIIChance</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:50]
				[UseBlockReplacerProfile:true]
				[BlockReplacerProfileNames:GVK-Replacer-NPCTypeII]
			</Description>
		</EntityComponent>
		<!-- Large Type I to Type II look swap (same stats), half the grids; only for groups without a turret pool (GVK-Settings#813) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-TypeIIChanceLarge</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:50]
				[UseBlockReplacerProfile:true]
				[BlockReplacerProfileNames:GVK-Replacer-NPCTypeIILarge]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
			[CommandCode:GVK_LeashRelease]
			[SingleRecipient:false]
			[MatchSenderReceiverOwners:false]
			[MatchReceiverChild:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:15000]
			[CommandDelayTicks:0]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>

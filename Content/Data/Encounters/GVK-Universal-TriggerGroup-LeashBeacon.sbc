			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-LeashBeacon-Waypoint-Self</SubtypeId>
			</Id>
			<Description>
			[RivalAI Waypoint]
			[Waypoint:RelativeOffset]
			[RelativeEntity:Self]
			[Offset:{X:0 Y:0 Z:0}]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-LeashBeacon-Trigger-Release</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:GVK-Universal-TriggerTags-Compromised]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Universal-LeashBeacon-Action-Release]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-LeashBeacon-Action-Release</SubtypeId>

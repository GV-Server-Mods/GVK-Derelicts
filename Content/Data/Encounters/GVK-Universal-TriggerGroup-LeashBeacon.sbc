<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
			GENERATED by tools/New-LeashGroup.ps1. Do not edit by hand; change the table in the script and rerun it.
			Parent side of the leash (README note 46). Add [TriggerGroups:GVK-Universal-TriggerGroup-LeashBeacon] to every
			behavior whose [RivalAI Spawn] spawns Units of its own side: Defense waves, air support, Elite escorts.
			Every 5 s it sends one home signal per leash kind (Ground 3000 m, Air 5000 m) to the Units it spawned,
			carrying its position so they patrol around it as it moves; when Compromised it sends GVK_LeashRelease.
			Needs MES with MeridiusIX/Modular-Encounters-Systems#441 (UseCommandWaypointAsPatrolReference).
		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-TriggerGroup-LeashBeacon</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Universal-LeashBeacon-Trigger-Broadcast]
			[Triggers:GVK-Universal-LeashBeacon-Trigger-Release]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-LeashBeacon-Trigger-Broadcast</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[MaxActions:-1]
			[Actions:GVK-Universal-LeashBeacon-Action-Broadcast]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-LeashBeacon-Action-Broadcast</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-Universal-LeashBeacon-Command-Ground]
			[CommandProfileIds:GVK-Universal-LeashBeacon-Command-Air]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-LeashBeacon-Command-Ground</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:GVK_LeashGround]
			[SingleRecipient:false]
			[MatchSenderReceiverOwners:false]
			[MatchReceiverChild:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:3000]
			[CommandDelayTicks:0]
			[SendWaypoint:true]
			[Waypoint:GVK-Universal-LeashBeacon-Waypoint-Self]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-LeashBeacon-Command-Air</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:GVK_LeashAir]
			[SingleRecipient:false]
			[MatchSenderReceiverOwners:false]
			[MatchReceiverChild:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:5000]
			[CommandDelayTicks:0]
			[SendWaypoint:true]
			[Waypoint:GVK-Universal-LeashBeacon-Waypoint-Self]
			</Description>
		</EntityComponent>

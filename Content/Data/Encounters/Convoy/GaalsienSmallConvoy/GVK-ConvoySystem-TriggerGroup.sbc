<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
		
		Trigger Groups for behaviors:
			[TriggerGroups:GVK-ConvoySystem-Leader-TriggerGroup]
			[TriggerGroups:GVK-ConvoySystem-Escort-TriggerGroup]
		
		Trigger Tags available for use elsewhere:
			GVK-TriggerTags-LeaderDead
			
		Trigger Tags used here:
			GVK-Universal-TriggerTags-Compromised

		Leader tasks:
			Send periodic command alerting nearby drones of potential leader
			Receive and process escort slot request
				Send escort status CustomCountersVariables EscortStatus=1 to escort (since commands can't send bools)
			Send leader compromised command
				Send escort status EscortStatus=0 to escort
			
		Escort tasks:
			Receive command alert of nearby potential Leader
			Change behavior to escort
			Send escort request
			Receive escort assignment status command from leader
			Receive leader compromised Command
			Receive escort status from leader
		
		-->
		<!-- TriggerGroups - choose one -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-TriggerGroup</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-ConvoySystem-Leader-Trigger-AlertPotentialEscorts]
			[Triggers:GVK-ConvoySystem-Leader-Trigger-ProcessEscortRequest]
			[Triggers:GVK-ConvoySystem-Leader-ManualTrigger-Compromised]
			[Triggers:GVK-ConvoySystem-Leader-Trigger-UnderFire]
			[Triggers:GVK-ConvoySystem-Leader-Trigger-EscortUnderFire]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-TriggerGroup</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-ConvoySystem-Escort-Trigger-AvailableToEscort]
			[Triggers:GVK-ConvoySystem-Escort-Trigger-ReceiveEscortSlot]
			[Triggers:GVK-ConvoySystem-Escort-Trigger-LeaderDead]
			[Triggers:GVK-ConvoySystem-Escort-ManualTrigger-ReturnToPatrol]
			[Triggers:GVK-ConvoySystem-Escort-Trigger-LeaderLost]
			[Triggers:GVK-ConvoySystem-Escort-Trigger-DefendLeader]
			[Triggers:GVK-ConvoySystem-Escort-Trigger-UnderFire]
			</Description>
		</EntityComponent>
		<!-- Leader ================================================================================ -->
		<!-- Alert nearby drones of available escort slots -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Trigger-AlertPotentialEscorts</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Actions:GVK-ConvoySystem-Leader-Action-AlertPotentialEscorts]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Action-AlertPotentialEscorts</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Alerting potential escorts]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-ConvoySystem-Leader-Command-AlertPotentialEscorts]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Command-AlertPotentialEscorts</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:GVK_EscortReady]
			[MatchSenderReceiverOwners:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:5000]
			[CommandDelayTicks:60]
			</Description>
		</EntityComponent>
		<!-- ProcessEscortRequest -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Trigger-ProcessEscortRequest</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:CommandReceived]
			[CommandReceiveCode:GVK_EscortRequest]
			[StartsReady:true]
			[Actions:GVK-ConvoySystem-Leader-Action-ProcessEscortRequest]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Action-ProcessEscortRequest</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Assigning escorts]
			[AssignEscortFromCommand:true]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-ConvoySystem-Leader-Command-ProcessEscortRequest]
			[SetBooleansTrue:GVK_Role_Leader]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Command-ProcessEscortRequest</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:GVK_EscortAssigned]
			[ReturnToSender:true]
			[MatchReceiverEscort:true]
			[MatchSenderReceiverOwners:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:5000]
			[CommandDelayTicks:60]
			</Description>
		</EntityComponent>
		<!-- Compromised -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-ManualTrigger-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:GVK-Universal-TriggerTags-Compromised]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-ConvoySystem-Leader-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Action-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:sending command GVK_LeaderDead]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-ConvoySystem-Leader-Command-Compromised]
			[SetBooleansFalse:GVK_Role_Leader]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Command-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:GVK_LeaderDead]
			[MatchSenderReceiverOwners:true]
			[MatchReceiverEscort:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:5000]
			[CommandDelayTicks:0]
			</Description>
		</EntityComponent>
		<!-- Leader under fire: its own escorts turn on the attacker -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Trigger-UnderFire</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[StartsReady:true]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[DamageTypes:Any]
			[ExcludedDamageTypes:Environment]
			[ExcludedDamageTypes:Deformation]
			[ExcludedDamageTypes:Fire]
			[ExcludedDamageTypes:Fall]
			[ExcludedDamageTypes:Thruster]
			[MaxActions:-1]
			[Conditions:GVK-Universal-Condition-SendHighPriorityTarget]
			[ConditionCheckResetsTimer:true]
			[Actions:GVK-ConvoySystem-Leader-Action-UnderFire]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Action-UnderFire</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Leader under fire; calling escorts]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-ConvoySystem-Leader-Command-UnderFire]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Command-UnderFire</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:GVK_LeaderUnderFire]
			[MatchSenderReceiverOwners:true]
			[MatchReceiverEscort:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:5000]
			[SendDamagerEntityId:true]
			[CommandDelayTicks:60]
			</Description>
		</EntityComponent>
		<!-- An escort reports its attacker: the leader takes it on if it has nothing else to shoot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Trigger-EscortUnderFire</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:CommandReceived]
			[CommandReceiveCode:GVK_EscortUnderFire]
			[StartsReady:true]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[MaxActions:-1]
			[Conditions:GVK-Universal-Condition-NoTarget]
			[Actions:GVK-ConvoySystem-Leader-Action-EscortUnderFire]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Leader-Action-EscortUnderFire</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Escort under fire; taking its attacker]
			[SwitchToReceivedTarget:true]
			[InheritLastAttackerFromCommand:true]
			</Description>
		</EntityComponent>
		<!-- Escort ================================================================================ -->
		<!-- Receive alert from potential leader -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Trigger-AvailableToEscort</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Tags:GVK-TriggerTags-InactiveEscortTasks]
			[Type:CommandReceived]
			[CommandReceiveCode:GVK_EscortReady]
			[Tags:GVK-TriggerTags-AvailableToEscort]
			[StartsReady:false]
			[Actions:GVK-ConvoySystem-Escort-Action-AvailableToEscort]
			</Description>
		</EntityComponent>
		<!-- set to escort and prepare to receive slot, and set timer to return to patrol if none received. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Action-AvailableToEscort</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Leader available; attempting to request escort slot]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Escort]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-ConvoySystem-Escort-Command-RequestEscortSlot]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:GVK-ConvoySystem-Escort-ManualTrigger-ReturnToPatrol]
			[EnableTriggers:true]
			[EnableTriggerNames:GVK-ConvoySystem-Escort-ManualTrigger-ReturnToPatrol]
			</Description>
		</EntityComponent>
		<!-- RequestEscortSlot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Command-RequestEscortSlot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:GVK_EscortRequest]
			[ReturnToSender:true]
			[MatchSenderReceiverOwners:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:5000]
			[RequestEscortSlot:true]
			[CommandDelayTicks:60]
			</Description>
		</EntityComponent>
		<!-- No escort slot received in time: revert to Patrol. Enabled by AvailableToEscort, disabled by ReceiveEscortSlot.
		     The request and the reply each wait 60 ticks (about 2 s together). This has to fire before MES Escort.cs gives up waiting for a
		     leader (the autopilot's WaypointWaitTimeTrigger, 5 s or more on every escort-capable profile) and switches the grid to Retreat. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-ManualTrigger-ReturnToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[StartsReady:false]
			[MinCooldownMs:4000]
			[MaxCooldownMs:4001]
			[MaxActions:-1]
			[Actions:GVK-ConvoySystem-Escort-Action-ReturnToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Action-ReturnToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:No escort slot received; returning to patrol]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Patrol]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-ConvoySystem-Escort-ManualTrigger-ReturnToPatrol]
			</Description>
		</EntityComponent>
		<!-- Receive Escort Slot and enable ActiveEscortTasks tags -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Trigger-ReceiveEscortSlot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Tags:GVK-TriggerTags-InactiveEscortTasks]
			[Type:CommandReceived]
			[CommandReceiveCode:GVK_EscortAssigned]
			[StartsReady:false]
			[Actions:GVK-ConvoySystem-Escort-Action-ReceiveEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Action-ReceiveEscortSlot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Received escort slot]
			[SetBooleansTrue:GVK_Role_Escort]
			[DisableTriggers:true]
			[DisableTriggerTags:GVK-TriggerTags-InactiveEscortTasks]
			[DisableTriggerNames:GVK-ConvoySystem-Escort-ManualTrigger-ReturnToPatrol]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownTags:GVK-TriggerTags-ActiveEscortTasks]
			[EnableTriggers:true]
			[EnableTriggerTags:GVK-TriggerTags-ActiveEscortTasks]
			</Description>
		</EntityComponent>
		<!-- Leader gone (destroyed, crippled, despawned or deleted): MES raises BehaviorTriggerB on an escort whose leader stops being valid.
		     No cooldown, because MES clears the flag at the end of every trigger pass. Only active while the escort holds a slot (ActiveEscortTasks). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Trigger-LeaderLost</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Tags:GVK-TriggerTags-ActiveEscortTasks]
			[Type:BehaviorTriggerB]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:GVK-ConvoySystem-Escort-Action-LeaderDead]
			</Description>
		</EntityComponent>
		<!-- LeaderDead command received -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Trigger-LeaderDead</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Tags:GVK-TriggerTags-ActiveEscortTasks]
			[Type:CommandReceived]
			[CommandReceiveCode:GVK_LeaderDead]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:GVK-ConvoySystem-Escort-Action-LeaderDead]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Action-LeaderDead</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Leader is dead]
			[SetBooleansFalse:GVK_Role_Escort]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownTags:GVK-TriggerTags-InactiveEscortTasks]
			[EnableTriggers:true]
			[EnableTriggerTags:GVK-TriggerTags-InactiveEscortTasks]
			[DisableTriggers:true]
			[DisableTriggerTags:GVK-TriggerTags-ActiveEscortTasks]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerTags:GVK-TriggerTags-LeaderDead]
			[ForceManualTriggerActivation:false]
			</Description>
		</EntityComponent>
		<!-- Leader reports its attacker: turn on it ([MatchReceiverEscort] on the command means only this leader's escorts hear it) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Trigger-DefendLeader</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:CommandReceived]
			[CommandReceiveCode:GVK_LeaderUnderFire]
			[StartsReady:true]
			[MinCooldownMs:15000]
			[MaxCooldownMs:15001]
			[MaxActions:-1]
			[Actions:GVK-ConvoySystem-Escort-Action-DefendLeader]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Action-DefendLeader</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Leader under fire; engaging its attacker]
			[SwitchToReceivedTarget:true]
			[InheritLastAttackerFromCommand:true]
			</Description>
		</EntityComponent>
		<!-- Escort under fire: report the attacker to its own leader only -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Trigger-UnderFire</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[StartsReady:true]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[DamageTypes:Any]
			[ExcludedDamageTypes:Environment]
			[ExcludedDamageTypes:Deformation]
			[ExcludedDamageTypes:Fire]
			[ExcludedDamageTypes:Fall]
			[ExcludedDamageTypes:Thruster]
			[MaxActions:-1]
			[Conditions:GVK-Universal-Condition-SendHighPriorityTarget]
			[ConditionCheckResetsTimer:true]
			[Actions:GVK-ConvoySystem-Escort-Action-UnderFire]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Action-UnderFire</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Escort under fire; reporting to leader]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-ConvoySystem-Escort-Command-UnderFire]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoySystem-Escort-Command-UnderFire</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:GVK_EscortUnderFire]
			[MatchSenderReceiverOwners:true]
			[MatchReceiverLeader:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:5000]
			[SendDamagerEntityId:true]
			[CommandDelayTicks:60]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
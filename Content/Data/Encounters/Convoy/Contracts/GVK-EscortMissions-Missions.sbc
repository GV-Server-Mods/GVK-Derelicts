<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- ================================================================= -->
		<!-- GVK ESCORT CONTRACT MISSIONS                                      -->
		<!-- MES-native player-initiated Convoy Contracts (Routes A, B, E).     -->
		<!-- MES adds these to the Coalition contract block as real contracts   -->
		<!-- (MyContractCustom, MESContract type) and spawns the convoy on      -->
		<!-- accept via the mission's InstanceEventGroupId. No C# required.     -->
		<!-- Board: GVK-EscortContracts-Trigger-RefreshBoard on                 -->
		<!-- GVK-Static-TradeStation-Behavior -> NTS [COAL] Base.               -->
		<!-- Files: Board, Missions, EventTemplates, Signals in this folder;    -->
		<!-- Transport behaviors in Encounters/PlanetaryCargoShip/.             -->
		<!-- Remaining work: GV-Server-Mods/GVK-Settings#675.                   -->
		<!-- ================================================================= -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMission-RouteA</SubtypeId>
			</Id>
			<Description>
				[MES Mission]
				[MissionType:Custom]
				[Title:Convoy Contract - Sevastopol (Land)]
				[Description:A Coalition land convoy is waiting at Crossroads for an escort to Sevastopol. Gaalsien raiders will harass it en route. Guard the Transport until it arrives. Primary
				payout is the cargo itself. This is a test contract description with no special characters.]
				[Reward:8000]
				[Collateral:8000]
				[ReputationReward:0]
				[FailReputationPrice:0]
				[Duration:180]
				[Exclusive:true]
				[OverrideFaction:COALITION]
				[InstanceEventGroupId:GVK-EscortMissions-Group-A]
				[ActivateBooleanNameOnSucces:GVK_EscortMissionDone_A]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMission-RouteB</SubtypeId>
			</Id>
			<Description>
				[MES Mission]
				[MissionType:Custom]
				[Title:Convoy Contract - Mastodon (Land)]
				[Description:A Coalition land convoy is waiting at Crossroads for an escort to the Mastodon station. Gaalsien raiders will harass it en route. Guard the Transport until it arrives.
				Primary payout is the cargo itself. This is a test contract description with no special characters.]
				[Reward:6000]
				[Collateral:6000]
				[ReputationReward:0]
				[FailReputationPrice:0]
				[Duration:180]
				[Exclusive:true]
				[OverrideFaction:COALITION]
				[InstanceEventGroupId:GVK-EscortMissions-Group-B]
				[ActivateBooleanNameOnSucces:GVK_EscortMissionDone_B]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMission-RouteE</SubtypeId>
			</Id>
			<Description>
				[MES Mission]
				[MissionType:Custom]
				[Title:Convoy Contract - Sevastopol (Air)]
				[Description:A Coalition air Transport is waiting at the Skyport for an escort to Sevastopol. Watch the refuel stops - grounded Transports are vulnerable. Guard it until it arrives.
				Primary payout is the cargo itself. This is a test contract description with no special characters.]
				[Reward:10000]
				[Collateral:10000]
				[ReputationReward:0]
				[FailReputationPrice:0]
				[Duration:180]
				[Exclusive:true]
				[OverrideFaction:COALITION]
				[InstanceEventGroupId:GVK-EscortMissions-Group-E]
				[ActivateBooleanNameOnSucces:GVK_EscortMissionDone_E]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
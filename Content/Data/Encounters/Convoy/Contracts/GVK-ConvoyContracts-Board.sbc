<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- ================================================================= -->
		<!-- GVK CONVOY CONTRACT BOARD                                         -->
		<!-- Contract Block profile: the list of missions MES publishes onto the -->
		<!-- Coalition contract block. Applied by the board behavior below.     -->
		<!-- ================================================================= -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Board</SubtypeId>
			</Id>
			<Description>
				[MES Contract Block]
				[MissionIds:GVK-ConvoyContract-RouteA]
				[MissionIds:GVK-ConvoyContract-RouteA-Double]
				[MissionIds:GVK-ConvoyContract-RouteB]
				[MissionIds:GVK-ConvoyContract-RouteE]
			</Description>
		</EntityComponent>
		<!-- Trigger to refresh the convoy contract board, place on appropriate grid behaviors only -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Trigger-RefreshBoard</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:true]
				[MinCooldownMs:600000]
				[MaxCooldownMs:600001]
				[Conditions:GVK-ConvoyContracts-Condition-NoActiveContract]
				[Actions:GVK-ConvoyContracts-Action-RefreshBoard]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Condition-NoActiveContract</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[NoActiveContracts:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Action-RefreshBoard</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[ApplyContractProfiles:true]
				[ClearContractContentsFirst:true]
				[ContractBlocks:NPC Contracts]
				[ContractBlockProfiles:GVK-ConvoyContracts-Board]
				[SetSandboxBooleansFalse:GVK_ConvoyContractActive]
				[SetSandboxBooleansFalse:GVK_TransportArrived_A]
				[SetSandboxBooleansFalse:GVK_TransportLost_A]
				[SetSandboxBooleansFalse:GVK_TransportArrived_A_Double]
				[SetSandboxBooleansFalse:GVK_TransportLost_A_Lead]
				[SetSandboxBooleansFalse:GVK_TransportLost_A_Tail]
				[SetSandboxBooleansFalse:GVK_TransportArrived_B]
				[SetSandboxBooleansFalse:GVK_TransportLost_B]
				[SetSandboxBooleansFalse:GVK_TransportArrived_E]
				[SetSandboxBooleansFalse:GVK_TransportLost_E]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
				[ActionExecution:All]
				[ActionIds:GVK-EscortMissions-EventAction-Lost-B]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-Template-Watchdog-B</SubtypeId>
			</Id>
			<Description>
				[MES Event Template]
				[UseEvent:true]
				[UniqueEvent:true]
				[StartsReady:false]
				[MinCooldownMs:180000]
				[MaxCooldownMs:180001]
				[Tags:GVK_EscortWatchdog_B]
				[ActionExecution:All]
				[ActionIds:GVK-EscortMissions-EventAction-Watchdog-B]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-Group-B</SubtypeId>
			</Id>
			<Description>
				[MES Event TemplateGroup]
				[TemplateEventIds:GVK-EscortMissions-Template-Spawn-B]
				[TemplateEventIds:GVK-EscortMissions-Template-Arrived-B]
				[TemplateEventIds:GVK-EscortMissions-Template-Lost-B]
				[TemplateEventIds:GVK-EscortMissions-Template-Watchdog-B]
			</Description>
		</EntityComponent>
		<!-- ================= ROUTE E (Air, Sevastopol) ================= -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-Template-Spawn-E</SubtypeId>
			</Id>
			<Description>
				[MES Event Template]
				[UseEvent:true]

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- ================================================================= -->
		<!-- GVK ESCORT CONTRACT SIGNALS                                        -->
		<!-- Per-route outcome flags set by the convoy behaviors, plus the MES   -->
		<!-- event conditions/actions that turn those flags into contract        -->
		<!-- completion or failure (TryContractSuccess / TryContractFail use the -->
		<!-- contract id that MES seeds into each instance event).               -->
		<!-- Flags: GVK_EscortArrived_X (transport reached destination)          -->
		<!--        GVK_EscortLost_X    (transport destroyed / compromised)      -->
		<!-- Reset by GVK-EscortContracts-Action-RefreshBoard.                   -->
		<!-- ================================================================= -->

		<!-- ================= ROUTE A (Land, Sevastopol) ================= -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-Action-ConvoyLost-A</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetSandboxBooleansTrue:GVK_EscortLost_A]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-EventCondition-Arrived-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_EscortArrived_A]
				[UseAnyPassingCondition:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-EventCondition-Lost-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_EscortLost_A]
				[CheckFalseBooleans:true]
				[FalseBooleans:GVK_EscortArrived_A]
				[UseAnyPassingCondition:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-EventAction-Arrived-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[TryContractSuccess:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-EventAction-Lost-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[TryContractFail:true]
			</Description>
		</EntityComponent>
		<!-- ================= ROUTE B (Land, Mastodon) ================= -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-Action-ConvoyLost-B</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetSandboxBooleansTrue:GVK_EscortLost_B]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-EventCondition-Arrived-B</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_EscortArrived_B]
				[UseAnyPassingCondition:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-EventCondition-Lost-B</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_EscortLost_B]
				[CheckFalseBooleans:true]
				[FalseBooleans:GVK_EscortArrived_B]
				[UseAnyPassingCondition:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-EventAction-Arrived-B</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[TryContractSuccess:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-EventAction-Lost-B</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[TryContractFail:true]
			</Description>
		</EntityComponent>
		<!-- ================= ROUTE E (Air, Sevastopol) ================= -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-Action-ConvoyLost-E</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetSandboxBooleansTrue:GVK_EscortLost_E]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-EventCondition-Arrived-E</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_EscortArrived_E]
				[UseAnyPassingCondition:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-EventCondition-Lost-E</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_EscortLost_E]
				[CheckFalseBooleans:true]
				[FalseBooleans:GVK_EscortArrived_E]
				[UseAnyPassingCondition:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-EventAction-Arrived-E</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[TryContractSuccess:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-EscortMissions-EventAction-Lost-E</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[TryContractFail:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
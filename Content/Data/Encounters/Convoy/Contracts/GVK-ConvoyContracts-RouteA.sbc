<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- ================================================================= -->
		<!-- GVK ESCORT CONTRACTS - ROUTE A (Crossroads to Sevastopol, Land)  -->
		<!-- Consolidated event groups, templates, conditions, and actions.    -->
		<!-- Contains both Single Transport and Double Transport variants.     -->
		<!-- ================================================================= -->

		<!-- ================= ROUTE A SINGLE ================= -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Group-A</SubtypeId>
			</Id>
			<Description>
				[MES Event TemplateGroup]
				[TemplateEventIds:GVK-ConvoyContracts-Template-Spawn-A]
				[TemplateEventIds:GVK-ConvoyContracts-Template-Arrived-A]
				[TemplateEventIds:GVK-ConvoyContracts-Template-Lost-A]
				[TemplateEventIds:GVK-ConvoyContracts-Template-Watchdog-A]
				[TemplateEventIds:GVK-ConvoyContracts-Template-Abandoned-A]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Template-Spawn-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Template]
				[UseEvent:true]
				[UniqueEvent:true]
				[StartsReady:true]
				[MinCooldownMs:0]
				[MaxCooldownMs:1]
				[ActionExecution:All]
				[ActionIds:GVK-Convoy-EventAction-CoalitionA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Template-Arrived-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Template]
				[UseEvent:true]
				[UniqueEvent:true]
				[StartsReady:true]
				[MinCooldownMs:1000]
				[MaxCooldownMs:2000]
				[UseAnyPassingCondition:false]
				[ConditionIds:GVK-ConvoyContracts-EventCondition-Arrived-A]
				[ActionExecution:All]
				[ActionIds:GVK-ConvoyContracts-EventAction-Arrived-A]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Template-Lost-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Template]
				[UseEvent:true]
				[UniqueEvent:true]
				[StartsReady:true]
				[MinCooldownMs:1000]
				[MaxCooldownMs:2000]
				[UseAnyPassingCondition:false]
				[ConditionIds:GVK-ConvoyContracts-EventCondition-Lost-A]
				[ActionExecution:All]
				[ActionIds:GVK-ConvoyContracts-EventAction-Lost-A]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Template-Watchdog-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Template]
				[UseEvent:true]
				[UniqueEvent:true]
				[StartsReady:false]
				[MinCooldownMs:180000]
				[MaxCooldownMs:180001]
				[Tags:GVK_ConvoyContractWatchdog_A]
				[ActionExecution:All]
				[ActionIds:GVK-ConvoyContracts-EventAction-Watchdog-A]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Action-ConvoyLost-A</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetSandboxBooleansTrue:GVK_TransportLost_A]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-EventCondition-Arrived-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_TransportArrived_A]
				[UseAnyPassingCondition:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-EventCondition-Lost-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_TransportLost_A]
				[CheckFalseBooleans:true]
				[FalseBooleans:GVK_TransportArrived_A]
				[UseAnyPassingCondition:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-EventAction-Arrived-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[TryContractSuccess:true]
				[ChangeBooleans:true]
				[SetBooleansFalse:GVK_ConvoyContractActive]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-EventAction-Lost-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[TryContractFail:true]
				[ChangeBooleans:true]
				[SetBooleansFalse:GVK_ConvoyContractActive]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-EventAction-Watchdog-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[TryContractFail:true]
				[ChangeBooleans:true]
				[SetBooleansFalse:GVK_ConvoyContractActive]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Template-Abandoned-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Template]
				[UseEvent:true]
				[Tags:Abandoned@{InstanceId}]
				[Tags:Failed@{InstanceId}]
				[ActionExecution:All]
				[ActionIds:GVK-ConvoyContracts-EventAction-Abandoned-A]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-EventAction-Abandoned-A</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[RemoveThisInstanceGroup:true]
				[ChangeBooleans:true]
				[SetBooleansFalse:GVK_ConvoyContractActive]
			</Description>
		</EntityComponent>

		<!-- ================= ROUTE A DOUBLE ================= -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Group-A-Double</SubtypeId>
			</Id>
			<Description>
				[MES Event TemplateGroup]
				[TemplateEventIds:GVK-ConvoyContracts-Template-Spawn-A-Double]
				[TemplateEventIds:GVK-ConvoyContracts-Template-Arrived-A-Double]
				[TemplateEventIds:GVK-ConvoyContracts-Template-Lost-A-Double]
				[TemplateEventIds:GVK-ConvoyContracts-Template-Watchdog-A-Double]
				[TemplateEventIds:GVK-ConvoyContracts-Template-Abandoned-A-Double]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Template-Spawn-A-Double</SubtypeId>
			</Id>
			<Description>
				[MES Event Template]
				[UseEvent:true]
				[UniqueEvent:true]
				[StartsReady:true]
				[MinCooldownMs:0]
				[MaxCooldownMs:1]
				[ActionExecution:All]
				[ActionIds:GVK-Convoy-EventAction-CoalitionA-Double]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Template-Arrived-A-Double</SubtypeId>
			</Id>
			<Description>
				[MES Event Template]
				[UseEvent:true]
				[UniqueEvent:true]
				[StartsReady:true]
				[MinCooldownMs:1000]
				[MaxCooldownMs:2000]
				[UseAnyPassingCondition:false]
				[ConditionIds:GVK-ConvoyContracts-EventCondition-Arrived-A-Double]
				[ActionExecution:All]
				[ActionIds:GVK-ConvoyContracts-EventAction-Arrived-A-Double]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Template-Lost-A-Double</SubtypeId>
			</Id>
			<Description>
				[MES Event Template]
				[UseEvent:true]
				[UniqueEvent:true]
				[StartsReady:true]
				[MinCooldownMs:1000]
				[MaxCooldownMs:2000]
				[UseAnyPassingCondition:false]
				[ConditionIds:GVK-ConvoyContracts-EventCondition-Lost-A-Double]
				[ActionExecution:All]
				[ActionIds:GVK-ConvoyContracts-EventAction-Lost-A-Double]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Template-Watchdog-A-Double</SubtypeId>
			</Id>
			<Description>
				[MES Event Template]
				[UseEvent:true]
				[UniqueEvent:true]
				[StartsReady:false]
				[MinCooldownMs:180000]
				[MaxCooldownMs:180001]
				[Tags:GVK_ConvoyContractWatchdog_A_Double]
				[ActionExecution:All]
				[ActionIds:GVK-ConvoyContracts-EventAction-Watchdog-A-Double]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Action-ConvoyLost-A-Lead</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetSandboxBooleansTrue:GVK_TransportLost_A_Lead]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Action-ConvoyLost-A-Tail</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetSandboxBooleansTrue:GVK_TransportLost_A_Tail]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-EventCondition-Arrived-A-Double</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_TransportArrived_A_Double]
				[UseAnyPassingCondition:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-EventCondition-Lost-A-Double</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_TransportLost_A_Lead]
				[TrueBooleans:GVK_TransportLost_A_Tail]
				[CheckFalseBooleans:true]
				[FalseBooleans:GVK_TransportArrived_A_Double]
				[UseAnyPassingCondition:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-EventAction-Arrived-A-Double</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[TryContractSuccess:true]
				[ChangeBooleans:true]
				[SetBooleansFalse:GVK_ConvoyContractActive]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-EventAction-Lost-A-Double</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[TryContractFail:true]
				[ChangeBooleans:true]
				[SetBooleansFalse:GVK_ConvoyContractActive]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-EventAction-Watchdog-A-Double</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[TryContractFail:true]
				[ChangeBooleans:true]
				[SetBooleansFalse:GVK_ConvoyContractActive]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-Template-Abandoned-A-Double</SubtypeId>
			</Id>
			<Description>
				[MES Event Template]
				[UseEvent:true]
				[Tags:Abandoned@{InstanceId}]
				[Tags:Failed@{InstanceId}]
				[ActionExecution:All]
				[ActionIds:GVK-ConvoyContracts-EventAction-Abandoned-A-Double]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-ConvoyContracts-EventAction-Abandoned-A-Double</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[RemoveThisInstanceGroup:true]
				[ChangeBooleans:true]
				[SetBooleansFalse:GVK_ConvoyContractActive]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>

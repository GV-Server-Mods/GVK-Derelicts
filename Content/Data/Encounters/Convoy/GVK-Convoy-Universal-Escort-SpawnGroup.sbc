<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>
		<!-- NDR Medium Hovers -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Convoy-Escort-SpawnGroup-MediumHovers</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:MES-Manipulation-RivalAi]
				[ManipulationProfiles:GVK-Drone-All-Manipulation-Hover]
				[ManipulationProfiles:GVK-Universal-Manipulation-Large3x3HeavyTurrets]
				[//ManipulationProfiles:GVK-Universal-Manipulation-Large3x3StandardTurrets]
				[SpawnConditionsProfiles:GVK-Convoy-Escort-SpawnCondition-LargeHoverDrones]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>0.2</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NDR [GAAL] Light Baserunner">
					<Position>
						<X>0.0</X>
						<Y>10.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Light Baserunner</BeaconText>
					<Behaviour>GVK-Convoy-Escort-Behavior-MediumHover</Behaviour>
				</Prefab>
				<Prefab SubtypeId="NDR [GAAL] Heavy Baserunner">
					<Position>
						<X>0.0</X>
						<Y>10.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Heavy Baserunner</BeaconText>
					<Behaviour>GVK-Convoy-Escort-Behavior-MediumHover</Behaviour>
				</Prefab>
				<Prefab SubtypeId="NDR [GAAL] Heavy Assault Platform">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Heavy Assault Ship</BeaconText>
					<Behaviour>GVK-Convoy-Escort-Behavior-MediumHover</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

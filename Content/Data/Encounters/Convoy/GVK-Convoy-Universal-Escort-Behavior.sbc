<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Medium Escort Unit Rover Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Behavior-MediumHover</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:Escort]
				[DialogueBanks:GVK-Units-GAALSIEN-Medium.xml]
				[WeaponSystem:GVK-Universal-Weapons-All]
				[UsePlayerDistanceTimer:true]
				[PlayerDistanceTimerTrigger:1800]
				[PlayerDistanceTrigger:5000]
				[UseNoTargetTimer:false]
				[UseRetreatTimer:false]
				[TargetData:GVK-Universal-Target-EnemyGrids2km-Ground-GAALSIEN]
				[OverrideTargetData:GVK-Universal-Target-Override-Ground]
				[AutopilotData:GVK-Convoy-Escort-PrimaryAutopilot]
				[SecondaryAutopilotData:GVK-Unit-All-Autopilot-MediumHoverPatrolHorsefly-Aggressive]
				[Triggers:GVK-Universal-Trigger-TargetAttacker]
				[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-Convoy-Escort-Trigger-RequestEscortSlot]
				[Triggers:GVK-Convoy-Escort-Trigger-ReceiveScatterCommand]
					[Triggers:GVK-Convoy-Escort-Trigger-LeaderLost]
					[Triggers:GVK-Convoy-Escort-Trigger-LeaderFound]
					[Triggers:GVK-Convoy-Escort-Trigger-NoLeader]
				[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
				[Triggers:GVK-Convoy-Escort-Trigger-EncounterInit-UnitMedium]
				BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<!-- Large Escort Unit Rover Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Behavior-LargeHover</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:Escort]
				[DialogueBanks:GVK-Units-GAALSIEN-Large.xml]
				[WeaponSystem:GVK-Universal-Weapons-All]
				[UsePlayerDistanceTimer:true]
				[PlayerDistanceTimerTrigger:1800]
				[PlayerDistanceTrigger:5000]
				[UseNoTargetTimer:false]
				[UseRetreatTimer:false]
				[TargetData:GVK-Universal-Target-EnemyGrids2km-Ground-GAALSIEN]
				[OverrideTargetData:GVK-Universal-Target-Override-Ground]
				[AutopilotData:GVK-Convoy-Escort-PrimaryAutopilot]
				[SecondaryAutopilotData:GVK-Unit-All-Autopilot-MediumHoverPatrolHorsefly-Aggressive]
				[Triggers:GVK-Universal-Trigger-TargetAttacker]
				[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-Convoy-Escort-Trigger-RequestEscortSlot]
				[Triggers:GVK-Convoy-Escort-Trigger-ReceiveScatterCommand]
					[Triggers:GVK-Convoy-Escort-Trigger-LeaderLost]
					[Triggers:GVK-Convoy-Escort-Trigger-LeaderFound]
					[Triggers:GVK-Convoy-Escort-Trigger-NoLeader]
				[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
				[Triggers:GVK-Convoy-Escort-Trigger-EncounterInit-UnitLarge]
				BountyOnKill=3000000;
			</Description>
		</EntityComponent>
		<!-- Convoy Salvager: escorts like the others, but when the convoy ends (Scatter, leader lost, no leader) it patrols where it is, like a Unit Salvager.
		     Primary keeps the slot, Secondary is the Unit Salvager's retreat profile (GVK-Unit-All-Action-SalvagerRetreat sets it), Tertiary its patrol profile.
		     Its retreat detectors and 30 min lifetime start only once it patrols: MES's own retreat timer counts from spawn and Escort never acts on it. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Behavior-Salvager-GAALSIEN</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:Escort]
				[DialogueBanks:GVK-Units-GAALSIEN-Medium.xml]
				[WeaponSystem:GVK-Universal-Weapons-All]
				[UsePlayerDistanceTimer:true]
				[PlayerDistanceTimerTrigger:1800]
				[PlayerDistanceTrigger:5000]
				[UseNoTargetTimer:false]
				[UseRetreatTimer:false]
				[RetreatDespawnDistance:2000]
				[TargetData:GVK-Universal-Target-EnemyGrids2km-Ground-GAALSIEN]
				[OverrideTargetData:GVK-Universal-Target-Override-Ground]
				[AutopilotData:GVK-Convoy-Escort-PrimaryAutopilot]
				[SecondaryAutopilotData:GVK-Unit-Encounter-Autopilot-Salvager-GAALSIEN-Secondary]
				[TertiaryAutopilotData:GVK-Unit-Encounter-Autopilot-Salvager-GAALSIEN]
				[Triggers:GVK-Universal-Trigger-TargetAttacker]
				[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-Convoy-Escort-Trigger-RequestEscortSlot]
				[Triggers:GVK-Convoy-Escort-Salvager-Trigger-Scatter]
				[Triggers:GVK-Convoy-Escort-Salvager-Trigger-LeaderLost]
				[Triggers:GVK-Convoy-Escort-Salvager-Trigger-LeaderFound]
				[Triggers:GVK-Convoy-Escort-Salvager-Trigger-NoLeader]
				[Triggers:GVK-Convoy-Escort-Salvager-Trigger-PlayerNear]
				[Triggers:GVK-Convoy-Escort-Salvager-Trigger-TargetNear]
				[Triggers:GVK-Convoy-Escort-Salvager-Trigger-Damage]
				[Triggers:GVK-Unit-All-ManualTrigger-SalvagerRetreat]
				[Triggers:GVK-Convoy-Escort-Salvager-Trigger-Lifetime]
				[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
				[Triggers:GVK-Convoy-Escort-Trigger-EncounterInit-UnitMedium]
				BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<!-- Escort Unit Rover Autopilot -->
		<!-- Steering: MaxRotationStep 0.5 keeps the gyros at full strength (Unit-All-Autopilot-HoverCruiserHorsefly.sbc explains it); MaxRotationMagnitude sets the turn rate. FlyLevelWithGravity already stops backflips, so pitch stays 1. Banks up to 15 degrees into turns for looks -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-PrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:false]
				[RotationMultiplierPitch:1]
				[RotationMultiplierYaw:3]
				[RotationMultiplierRoll:2]
				[LimitRotationSpeed:false]
				[MaxRotationMagnitude:0.5]
				[UseAircraftFlightModel:true]
				[MaxRotationStep:0.5]
				[RollIntoTurnsMultiplier:0.25]
				[MaxBankAngle:15]
				[//25, not the default 10: in level mode MES cuts up and forward thrust once the grid tilts past this, a bank into a turn or a nose-up lean on a slope alike (ThrustSystem.CalculateHoverThrust), so it coasted through sharp turns and paused on hills]
				[HoverUpAngle:25]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:true]
				[LevelWithGravityWhenIdle:true]
				[IdealPlanetAltitude:30]
				[MinimumPlanetAltitude:0]
				[AltitudeTolerance:60]
				[WaypointAbandonTimeTrigger:30]
				[WaypointWaitTimeTrigger:30]
				[WaypointTolerance:10]
				[SlowDownOnWaypointApproach:true]
				[ExtraSlowDownDistance:50]
				[IdealMinSpeed:30]
				[IdealMaxSpeed:75]
				[MaxSpeedTolerance:5]
				[AngleAllowedForForwardThrust:70]
				[MaxVelocityAngleForSpeedControl:180]
				[EscortUsesRelativeDampening:true]
				[EscortSpeedMatchMinDistance:10]
				[EscortSpeedMatchMaxDistance:200]
				[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Unit to request an escort slot from Convoy Lead -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-RequestEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:2000]
				[MaxCooldownMs:5000]
				[StartsReady:false]
				[MaxActions:1]
				[Actions:GVK-Convoy-Escort-Action-RequestEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Action-RequestEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[BroadcastCommandProfiles:true]
				[CommandProfileIds:GVK-Convoy-Escort-Command-RequestEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Command-RequestEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Command]
				[SingleRecipient:true]
				[MatchSenderReceiverOwners:true]
				[IgnoreAntennaRequirement:true]
				[IgnoreReceiverAntennaRequirement:true]
				[Radius:5000]
				[CommandCode:GVK_Command_Lead_RequestEscortSlot]
				[RequestEscortSlot:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Escorts to switch behaviors after Convoy Lead is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-ReceiveScatterCommand</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:CommandReceived]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:-1]
				[CommandReceiveCode:GVK_Command_Escort_Scatter]
				[Actions:GVK-Convoy-Escort-Action-ReceiveScatterCommand]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Action-ReceiveScatterCommand</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[ChangeBehaviorSubclass:true]
				[NewBehaviorSubclass:Horsefly]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[ChangeAutopilotSpeed:true]
				[NewAutopilotSpeed:70]
			</Description>
		</EntityComponent>
		<!-- An escort must never sit in Escort until MES Escort.cs retreats it (it waits WaypointWaitTimeTrigger, 30 s, for a leader and then retreats).
		     LeaderLost: the leader stopped being valid while this escort was approaching it. NoLeader: no leader accepted this escort in time.
		     LeaderFound (leader valid) cancels NoLeader. Both fall back to the same hunt as the scatter command. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-LeaderLost</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:BehaviorTriggerB]
				[StartsReady:true]
				[MaxActions:-1]
				[Actions:GVK-Convoy-Escort-Action-NoLeader]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-LeaderFound</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:BehaviorTriggerA]
				[StartsReady:true]
				[MaxActions:-1]
				[Actions:GVK-Convoy-Escort-Action-LeaderFound]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-NoLeader</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Timer]
				[StartsReady:false]
				[MinCooldownMs:15000]
				[MaxCooldownMs:15001]
				[MaxActions:1]
				[Actions:GVK-Convoy-Escort-Action-NoLeader]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Action-LeaderFound</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-Convoy-Escort-Trigger-NoLeader]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Action-NoLeader</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[ChangeBehaviorSubclass:true]
				[NewBehaviorSubclass:Horsefly]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[ChangeAutopilotSpeed:true]
				[NewAutopilotSpeed:70]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-Convoy-Escort-Trigger-NoLeader]
			</Description>
		</EntityComponent>
		<!-- Convoy Salvager: the same three ways out of Escort, all to ToPatrol -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Salvager-Trigger-Scatter</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:CommandReceived]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[CommandReceiveCode:GVK_Command_Escort_Scatter]
				[Actions:GVK-Convoy-Escort-Salvager-Action-ToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Salvager-Trigger-LeaderLost</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:BehaviorTriggerB]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-Convoy-Escort-Salvager-Action-ToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Salvager-Trigger-LeaderFound</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:BehaviorTriggerA]
				[StartsReady:true]
				[MaxActions:-1]
				[Actions:GVK-Convoy-Escort-Salvager-Action-LeaderFound]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Salvager-Trigger-NoLeader</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Timer]
				[StartsReady:false]
				[MinCooldownMs:15000]
				[MaxCooldownMs:15001]
				[MaxActions:1]
				[Actions:GVK-Convoy-Escort-Salvager-Action-ToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Salvager-Action-LeaderFound</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-Convoy-Escort-Salvager-Trigger-NoLeader]
			</Description>
		</EntityComponent>
		<!-- Patrol around where the convoy ended, at the patrol profile's own speed, and start the Salvager's retreat detectors and lifetime -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Salvager-Action-ToPatrol</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[LeaveEscortSlot:true]
				[ChangeBehaviorSubclass:true]
				[NewBehaviorSubclass:Patrol]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Tertiary]
				[//Lifts the leader-speed cap Escort.cs set near the slot (escorts-and-peer-wings.md, Speed cap)]
				[ChangeAutopilotSpeed:true]
				[NewAutopilotSpeed:-1]
				[UseCurrentPositionAsPatrolReference:true]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-Convoy-Escort-Salvager-Trigger-Scatter]
				[DisableTriggerNames:GVK-Convoy-Escort-Salvager-Trigger-LeaderLost]
				[DisableTriggerNames:GVK-Convoy-Escort-Salvager-Trigger-LeaderFound]
				[DisableTriggerNames:GVK-Convoy-Escort-Salvager-Trigger-NoLeader]
				[EnableTriggers:true]
				[EnableTriggerNames:GVK-Convoy-Escort-Salvager-Trigger-PlayerNear]
				[EnableTriggerNames:GVK-Convoy-Escort-Salvager-Trigger-TargetNear]
				[EnableTriggerNames:GVK-Convoy-Escort-Salvager-Trigger-Damage]
				[EnableTriggerNames:GVK-Convoy-Escort-Salvager-Trigger-Lifetime]
				[//Timer cooldowns run from spawn, so restart them here]
				[ResetCooldownTimeOfTriggers:true]
				[ResetTriggerCooldownNames:GVK-Convoy-Escort-Salvager-Trigger-PlayerNear]
				[ResetTriggerCooldownNames:GVK-Convoy-Escort-Salvager-Trigger-TargetNear]
				[ResetTriggerCooldownNames:GVK-Convoy-Escort-Salvager-Trigger-Damage]
				[ResetTriggerCooldownNames:GVK-Convoy-Escort-Salvager-Trigger-Lifetime]
			</Description>
		</EntityComponent>
		<!-- Copies of the Unit Salvager's retreat detectors (Unit-All-TriggerGroup-SalvagerRetreat.sbc), off until ToPatrol -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Salvager-Trigger-PlayerNear</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:PlayerNear]
				[UseTrigger:false]
				[StartsReady:false]
				[MinCooldownMs:2000]
				[MaxCooldownMs:2001]
				[TargetDistance:500]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-Unit-All-Action-ManualTriggerSalvagerRetreat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Salvager-Trigger-TargetNear</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:TargetNear]
				[UseTrigger:false]
				[StartsReady:false]
				[MinCooldownMs:2000]
				[MaxCooldownMs:2001]
				[TargetDistance:500]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-Unit-All-Action-ManualTriggerSalvagerRetreat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Salvager-Trigger-Damage</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Damage]
				[UseTrigger:false]
				[StartsReady:false]
				[MinCooldownMs:2000]
				[MaxCooldownMs:2001]
				[DamageTypes:Any]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-Unit-All-Action-ManualTriggerSalvagerRetreat]
			</Description>
		</EntityComponent>
		<!-- Lifetime: retreats 30 min after it starts patrolling (the Unit Salvager's RetreatTimerTrigger 1800) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Salvager-Trigger-Lifetime</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:false]
				[StartsReady:false]
				[MinCooldownMs:1800000]
				[MaxCooldownMs:1800001]
				[MaxActions:1]
				[Actions:GVK-Convoy-Escort-Salvager-Action-Lifetime]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Salvager-Action-Lifetime</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[Retreat:true]
			</Description>
		</EntityComponent>		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-EncounterInit-UnitLarge</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Session]
				[StartsReady:true]
				[MaxActions:-1]
				[ActionExecution:All]
				[Actions:GVK-Convoy-Escort-Action-EncounterInit-UnitLarge]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Action-EncounterInit-UnitLarge</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[SetCustomStrings:true]
				[CustomStrings:EncounterType,UnitLarge]
				[CustomStrings:EncounterDisplayName,Escort]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-EncounterInit-UnitMedium</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Session]
				[StartsReady:true]
				[MaxActions:-1]
				[ActionExecution:All]
				[Actions:GVK-Convoy-Escort-Action-EncounterInit-UnitMedium]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Action-EncounterInit-UnitMedium</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[SetCustomStrings:true]
				[CustomStrings:EncounterType,UnitMedium]
				[CustomStrings:EncounterDisplayName,Escort]
			</Description>

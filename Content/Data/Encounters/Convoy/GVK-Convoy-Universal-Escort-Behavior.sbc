<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Medium Escort Unit Rover Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Behavior-MediumHover</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:Escort]
				[DialogueBanks:GVK-Units-GAALSIEN-Medium.xml]
				[WeaponSystem:GVK-Universal-Weapons-All]
				[UsePlayerDistanceTimer:true]
				[PlayerDistanceTimerTrigger:1800]
				[PlayerDistanceTrigger:5000]
				[UseNoTargetTimer:false]
				[UseRetreatTimer:false]
				[TargetData:GVK-Universal-Target-EnemyGrids2km-GAALSIEN]
				[AutopilotData:GVK-Convoy-Escort-PrimaryAutopilot]
				[SecondaryAutopilotData:GVK-Unit-All-Autopilot-MediumHoverPatrolHorsefly-Aggressive]
				[Triggers:GVK-Universal-Trigger-TargetAttacker]
				[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-Convoy-Escort-Trigger-RequestEscortSlot]
				[Triggers:GVK-Convoy-Escort-Trigger-ReceiveScatterCommand]
					[Triggers:GVK-Convoy-Escort-Trigger-LeaderLost]
					[Triggers:GVK-Convoy-Escort-Trigger-LeaderFound]
					[Triggers:GVK-Convoy-Escort-Trigger-NoLeader]
				[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
				[Triggers:GVK-Convoy-Escort-Trigger-EncounterInit-UnitMedium]
				BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<!-- Large Escort Unit Rover Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Behavior-LargeHover</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:Escort]
				[DialogueBanks:GVK-Units-GAALSIEN-Large.xml]
				[WeaponSystem:GVK-Universal-Weapons-All]
				[UsePlayerDistanceTimer:true]
				[PlayerDistanceTimerTrigger:1800]
				[PlayerDistanceTrigger:5000]
				[UseNoTargetTimer:false]
				[UseRetreatTimer:false]
				[TargetData:GVK-Universal-Target-EnemyGrids2km-GAALSIEN]
				[AutopilotData:GVK-Convoy-Escort-PrimaryAutopilot]
				[SecondaryAutopilotData:GVK-Unit-All-Autopilot-MediumHoverPatrolHorsefly-Aggressive]
				[Triggers:GVK-Universal-Trigger-TargetAttacker]
				[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-Convoy-Escort-Trigger-RequestEscortSlot]
				[Triggers:GVK-Convoy-Escort-Trigger-ReceiveScatterCommand]
					[Triggers:GVK-Convoy-Escort-Trigger-LeaderLost]
					[Triggers:GVK-Convoy-Escort-Trigger-LeaderFound]
					[Triggers:GVK-Convoy-Escort-Trigger-NoLeader]
				[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
				[Triggers:GVK-Convoy-Escort-Trigger-EncounterInit-UnitLarge]
				BountyOnKill=3000000;
			</Description>
		</EntityComponent>
		<!-- Escort Unit Rover Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-PrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:false]
				[RotationMultiplier:1]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:true]
				[LevelWithGravityWhenIdle:true]
				[IdealPlanetAltitude:30]
				[MinimumPlanetAltitude:0]
				[AltitudeTolerance:60]
				[WaypointAbandonTimeTrigger:30]
				[WaypointWaitTimeTrigger:30]
				[WaypointTolerance:10]
				[SlowDownOnWaypointApproach:true]
				[ExtraSlowDownDistance:50]
				[IdealMinSpeed:30]
				[IdealMaxSpeed:75]
				[MaxSpeedTolerance:5]
				[AngleAllowedForForwardThrust:70]
				[MaxVelocityAngleForSpeedControl:180]
				[EscortUsesRelativeDampening:true]
				[EscortSpeedMatchMinDistance:0]
				[EscortSpeedMatchMaxDistance:25]
				[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Unit to request an escort slot from Convoy Lead -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-RequestEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:2000]
				[MaxCooldownMs:5000]
				[StartsReady:false]
				[MaxActions:1]
				[Actions:GVK-Convoy-Escort-Action-RequestEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Action-RequestEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[BroadcastCommandProfiles:true]
				[CommandProfileIds:GVK-Convoy-Escort-Command-RequestEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Command-RequestEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Command]
				[SingleRecipient:true]
				[MatchSenderReceiverOwners:true]
				[IgnoreAntennaRequirement:true]
				[IgnoreReceiverAntennaRequirement:true]
				[Radius:5000]
				[CommandCode:GVK_Command_Lead_RequestEscortSlot]
				[RequestEscortSlot:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Escorts to switch behaviors after Convoy Lead is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-ReceiveScatterCommand</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:CommandReceived]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:-1]
				[CommandReceiveCode:GVK_Command_Escort_Scatter]
				[Actions:GVK-Convoy-Escort-Action-ReceiveScatterCommand]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Action-ReceiveScatterCommand</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[ChangeBehaviorSubclass:true]
				[NewBehaviorSubclass:Horsefly]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[ChangeAutopilotSpeed:true]
				[NewAutopilotSpeed:70]
			</Description>
		</EntityComponent>
		<!-- An escort must never sit in Escort until MES Escort.cs retreats it (it waits WaypointWaitTimeTrigger, 30 s, for a leader and then retreats).
		     LeaderLost: the leader stopped being valid while this escort was approaching it. NoLeader: no leader accepted this escort in time.
		     LeaderFound (leader valid) cancels NoLeader. Both fall back to the same hunt as the scatter command. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-LeaderLost</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:BehaviorTriggerB]
				[StartsReady:true]
				[MaxActions:-1]
				[Actions:GVK-Convoy-Escort-Action-NoLeader]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-LeaderFound</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:BehaviorTriggerA]
				[StartsReady:true]
				[MaxActions:-1]
				[Actions:GVK-Convoy-Escort-Action-LeaderFound]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-NoLeader</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Timer]
				[StartsReady:false]
				[MinCooldownMs:15000]
				[MaxCooldownMs:15001]
				[MaxActions:1]
				[Actions:GVK-Convoy-Escort-Action-NoLeader]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Action-LeaderFound</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-Convoy-Escort-Trigger-NoLeader]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Action-NoLeader</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[ChangeBehaviorSubclass:true]
				[NewBehaviorSubclass:Horsefly]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[ChangeAutopilotSpeed:true]
				[NewAutopilotSpeed:70]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-Convoy-Escort-Trigger-NoLeader]
			</Description>
		</EntityComponent>		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-EncounterInit-UnitLarge</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Session]
				[StartsReady:true]
				[MaxActions:-1]
				[ActionExecution:All]
				[Actions:GVK-Convoy-Escort-Action-EncounterInit-UnitLarge]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Action-EncounterInit-UnitLarge</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[SetCustomStrings:true]
				[CustomStrings:EncounterType,UnitLarge]
				[CustomStrings:EncounterDisplayName,Escort]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Trigger-EncounterInit-UnitMedium</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Session]
				[StartsReady:true]
				[MaxActions:-1]
				[ActionExecution:All]
				[Actions:GVK-Convoy-Escort-Action-EncounterInit-UnitMedium]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Escort-Action-EncounterInit-UnitMedium</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[SetCustomStrings:true]
				[CustomStrings:EncounterType,UnitMedium]
				[CustomStrings:EncounterDisplayName,Escort]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
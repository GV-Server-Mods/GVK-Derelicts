<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
		
			Universal system to spawn defenses. Requires a trigger/tag + action + spawner for encounter type.
			This creates and adds to DefenseSpawn_Counter for each defense spawn, up to the encounter's DefenseSpawn_Limit
			CustomCountersVariable set in it's behavior init.
					
			- WreckLarge
			- WreckMedium
			- WreckSmall

			- AllianceBase
			- AllianceOutpost

			- DroneLarge
			
			Notes: 
				- Alliance structures reset DefenseSpawn_Counter after 60 minutes so they can spawn defenses indefinitely
				- Universal and Alliance have different TriggerGroups because the trigger distance, reset timer, and drone
					spawn distance are different.
				- Chance of COALITION attackers is built into the GAALSIEN Drone default triggers (10%) so it isn't 
					needed here.

		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-TriggerGroup-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
				[RivalAI TriggerGroup]
				[Triggers:GVK-Universal-Trigger-DefensesInit]
				[Triggers:GVK-Universal-Trigger-DefensesPlayerNear-500]
				[Triggers:GVK-Universal-Trigger-DefensesPlayerNear-2000]
				[Triggers:GVK-Universal-Trigger-DefensesTargetNear-500]
				[Triggers:GVK-Universal-Trigger-DefensesTargetNear-2000]
				[Triggers:GVK-Universal-Trigger-DefensesDamage]
				[Triggers:GVK-Universal-Trigger-DefensesRefundCounter]
				[Triggers:GVK-Universal-Trigger-DefensesResetCounter]
				[Triggers:GVK-Universal-Trigger-DefensesTriggerDelay]
				[Triggers:GVK-Universal-Trigger-DefensesManual]
				[Triggers:GVK-Universal-Trigger-DefensesManualSpawn-WreckLarge]
				[Triggers:GVK-Universal-Trigger-DefensesManualSpawn-WreckMedium]
				[Triggers:GVK-Universal-Trigger-DefensesManualSpawn-WreckSmall]
				[Triggers:GVK-Universal-Trigger-DefensesManualSpawn-AllianceBase]
				[Triggers:GVK-Universal-Trigger-DefensesManualSpawn-AllianceOutpost]
			</Description>
		</EntityComponent>
		<!-- 
		
			Universal structure defense systems that spawn GAALSIEN drones
			
		-->
		<!-- The offsets and random values in the waypoint override those in the spawner -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Waypoint-DefensesManualSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Waypoint]
				[Waypoint:EntityRandom]
				[RelativeEntity:Target]
				[MinDistance:800]
				[MaxDistance:1200]
				[MinAltitude:30]
				[MaxAltitude:31]
				[InheritRelativeAltitude:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesInit</SubtypeId>
			</Id>
			<Description>
				[MES AI Trigger]
				[UseTrigger:true]
				[Type:Timer]
				[StartsReady:true]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesInit]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesInit</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:DefensesInit]
				[ResetCounters:DefenseSpawn_Counter]
				[EnableTriggers:true]
				[EnableTriggerTags:GVK-Universal-TriggerTags-{EncounterType}]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesPlayerNear-500</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Tags:GVK-Universal-TriggerTags-WreckLarge]
				[Tags:GVK-Universal-TriggerTags-WreckMedium]
				[Tags:GVK-Universal-TriggerTags-WreckSmall]
				[UseTrigger:false]
				[Type:PlayerNear]
				[TargetDistance:500]
				[MinPlayerReputation:-1500]
				[MaxPlayerReputation:0]
				[StartsReady:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10001]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesTrigger]
				[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesPlayerNear-2000</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Tags:GVK-Universal-TriggerTags-AllianceBase]
				[Tags:GVK-Universal-TriggerTags-AllianceOutpost]
				[Tags:GVK-Universal-TriggerTags-DroneLarge]
				[UseTrigger:false]
				[Type:PlayerNear]
				[TargetDistance:2000]
				[MinPlayerReputation:-1500]
				[MaxPlayerReputation:0]
				[StartsReady:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10001]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesTrigger]
				[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesTargetNear-500</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Tags:GVK-Universal-TriggerTags-WreckLarge]
				[Tags:GVK-Universal-TriggerTags-WreckMedium]
				[Tags:GVK-Universal-TriggerTags-WreckSmall]
				[UseTrigger:false]
				[Type:TargetNear]
				[TargetDistance:500]
				[MinPlayerReputation:-1500]
				[MaxPlayerReputation:0]
				[StartsReady:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10001]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesTrigger]
				[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesTargetNear-2000</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Tags:GVK-Universal-TriggerTags-AllianceBase]
				[Tags:GVK-Universal-TriggerTags-AllianceOutpost]
				[Tags:GVK-Universal-TriggerTags-DroneLarge]
				[UseTrigger:false]
				[Type:TargetNear]
				[TargetDistance:2000]
				[MinPlayerReputation:-1500]
				[MaxPlayerReputation:0]
				[StartsReady:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10001]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesTrigger]
				[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesDamage</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Damage]
				[DamageTypes:Any]
				[StartsReady:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10001]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesTrigger]
			</Description>
		</EntityComponent>
		<!-- above triggers activate DefensesTriggerDelay which adds a slight delay to ensure Target profile has a target in time -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesTrigger</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:DefensesTrigger]
				[ResetCooldownTimeOfTriggers:true]
				[ResetTriggerCooldownNames:GVK-Universal-Trigger-DefensesTriggerDelay]
				[EnableTriggers:true]
				[EnableTriggerNames:GVK-Universal-Trigger-DefensesTriggerDelay]
			</Description>
		</EntityComponent>
		<!-- This adds a slight delay to ensure target profile has a target for the Waypoint spawning -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesTriggerDelay</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:false]
				[Type:Timer]
				[StartsReady:false]
				[MinCooldownMs:5000]
				[MaxCooldownMs:5001]
				[MaxActions:-1]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesTriggerDelay]
			</Description>
		</EntityComponent>
		<!-- Activate DefensesManual which then checks the counter and increments the counter -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesTriggerDelay</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:DefensesTriggerDelay]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-Universal-Trigger-DefensesTriggerDelay]
				[ManuallyActivateTrigger:true]
				[ManuallyActivatedTriggerNames:GVK-Universal-Trigger-DefensesManual]
			</Description>
		</EntityComponent>
		<!-- decrease DefenseSpawn_Counter if received drone despawn command -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesRefundCounter</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:CommandReceived]
				[StartsReady:false]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1001]
				[CommandReceiveCode:DefensesRefundCounter]
				[MaxActions:-1]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesRefundCounter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesRefundCounter</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:DefensesRefundCounter]
				[DecreaseCounters:DefenseSpawn_Counter]
			</Description>
		</EntityComponent>
		<!-- Reset spawn counter every 60 minutes. This gets enabled only when the right trigger tags turn on during init -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesResetCounter</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Tags:GVK-Universal-TriggerTags-AllianceBase]
				[Tags:GVK-Universal-TriggerTags-AllianceOutpost]
				[UseTrigger:false]
				[Type:Timer]
				[StartsReady:false]
				[MinCooldownMs:3600001]
				[MaxCooldownMs:3600002]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesResetCounter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesResetCounter</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:DefensesResetCounter]
				[ResetCounters:DefenseSpawn_Counter]
			</Description>
		</EntityComponent>
		<!-- check if DefenseSpawn_Counter is under DefenseSpawn_Limit and activate manual trigger tags -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesManual</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Manual]
				[StartsReady:true]
				[MinCooldownMs:25000]
				[MaxCooldownMs:25001]
				[ActionExecution:All]
				[Conditions:GVK-Universal-Condition-DefensesManual]
				[ConditionCheckResetsTimer:true]
				[Actions:GVK-Universal-Action-DefensesManual]
			</Description>
		</EntityComponent>
		<!-- use "Less" compare because DefenseSpawn_Counter starts at 0 and is not incremented until after this check -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-DefensesManual</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckCustomCounters:true]
				[CustomCounters:DefenseSpawn_Counter]
				[CustomCountersVariables:{DefenseSpawn_Limit}]
				[CounterCompareTypes:Less]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesManual</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:DefensesManual DefenseSpawn_Counter passed]
				[IncreaseCounters:DefenseSpawn_Counter]
				[ManuallyActivateTrigger:true]
				[ManuallyActivatedTriggerNames:GVK-Universal-Trigger-DefensesManualSpawn-{EncounterType}]
				[UseChatBroadcast:true]
				[ChatData:GVK-Universal-Chat-DefensesManual]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Chat-DefensesManual</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[MinTime:1800]
				[MaxTime:1801]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[Author:Sensors]
				[Color:Blue]
				[ChatMessages:Enemy forces in-bound.]
				[ChatAudio:ArcHudSensors]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:false]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:6000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesManualSpawn-WreckLarge</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Manual]
				[StartsReady:true]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesManualSpawn-WreckLarge]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesManualSpawn-WreckLarge</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:DefensesManualSpawn-WreckLarge]
				[SpawnEncounter:true]
				[Spawner:GVK-Universal-Spawner-Defenses-WreckLarge]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Spawner-Defenses-WreckLarge</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[ProcessAsAdminSpawn:true]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-LargeHover]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-LargeHover]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-InterceptorSquad]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-MediumHoverHeavy]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-MediumFlyer]
				[MinDistance:1500]
				[MaxDistance:1700]
				[MinAltitude:50]
				[MaxAltitude:51]
				[InheritNpcAltitude:false]
				[IgnoreSafetyChecks:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesManualSpawn-WreckMedium</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Manual]
				[StartsReady:false]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesManualSpawn-WreckMedium]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesManualSpawn-WreckMedium</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:DefensesManualSpawn-WreckMedium]
				[SpawnEncounter:true]
				[Spawner:GVK-Universal-Spawner-Defenses-WreckMedium]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Spawner-Defenses-WreckMedium</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[ProcessAsAdminSpawn:true]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-InterceptorSingle]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-LightSandskimmerSquad]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-MediumHoverLight]
				[MinDistance:1500]
				[MaxDistance:1700]
				[MinAltitude:50]
				[MaxAltitude:51]
				[InheritNpcAltitude:false]
				[IgnoreSafetyChecks:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesManualSpawn-WreckSmall</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Manual]
				[StartsReady:false]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesManualSpawn-WreckSmall]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesManualSpawn-WreckSmall</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:DefensesManualSpawn-WreckSmall]
				[SpawnEncounter:true]
				[Spawner:GVK-Universal-Spawner-Defenses-WreckSmall]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Spawner-Defenses-WreckSmall</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[ProcessAsAdminSpawn:true]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-LightSandskimmerSquad]
				[MinDistance:500]
				[MaxDistance:700]
				[MinAltitude:50]
				[MaxAltitude:51]
				[InheritNpcAltitude:false]
				[IgnoreSafetyChecks:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesManualSpawn-AllianceBase</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Manual]
				[StartsReady:false]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefensesManualSpawn-AllianceBase]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesManualSpawn-AllianceBase</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:DefensesManualSpawn-AllianceBase]
				[SpawnEncounter:true]
				[Spawner:GVK-Universal-Spawner-Defenses-AllianceBase]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Spawner-Defenses-AllianceBase</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[UseWaypoint:true]
				[Waypoint:GVK-Universal-Waypoint-DefensesManualSpawn]
				[ProcessAsAdminSpawn:true]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-BaserunnerHeavy]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-LargeHover]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-LargeRover]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-InterceptorSquad]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-MediumHoverHeavy]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-LargeHover]
				[MinDistance:500]
				[MaxDistance:700]
				[MinAltitude:50]
				[MaxAltitude:51]
				[InheritNpcAltitude:false]
				[IgnoreSafetyChecks:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesManualSpawn-AllianceOutpost</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Manual]

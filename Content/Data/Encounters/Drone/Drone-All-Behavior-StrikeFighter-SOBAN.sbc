<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- COALITION Strike Fighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-StrikeFighter-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[WeaponSystem:GVK-Universal-Weapons-Static90]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:240]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[AutopilotData:GVK-Drone-All-Autopilot-StrikeFighter-Patrol]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-StrikeFighter-Strike]
			[Triggers:GVK-Drone-All-Trigger-Init-StrikeFighter-SOBAN]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-DroneDefaults-SmallDrone]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolStrike]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-Init-StrikeFighter-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:true]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-Init-StrikeFighter-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-Init-StrikeFighter-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,DroneSmall]
			[CustomStrings:EncounterDisplayName,aircraft]
			[SetBooleansTrue:GVK_MobilityType_Aircraft]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Peer escort state checks, shared by every pool (see tools/New-PeerEscortPool.ps1) -->
		<!-- A free peer: not a wing, not leading a wing, not waiting on a request, slot still unused -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-PeerCanOffer</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_Role_Escort]
			[FalseBooleans:GVK_Role_Leader]
			[FalseBooleans:GVK_Peer_Requesting]
			[FalseBooleans:GVK_Peer_SlotSpent]
			</Description>
		</EntityComponent>
		<!-- May become a wing: a former leader whose wing died still qualifies -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-PeerCanAccept</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_Role_Escort]
			[FalseBooleans:GVK_Role_Leader]
			[FalseBooleans:GVK_Peer_Requesting]
			</Description>
		</EntityComponent>
		<!-- May hand out the single slot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-PeerCanLead</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_Role_Escort]
			[FalseBooleans:GVK_Peer_Requesting]
			[FalseBooleans:GVK_Peer_SlotSpent]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-PeerIsRequesting</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:GVK_Peer_Requesting]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
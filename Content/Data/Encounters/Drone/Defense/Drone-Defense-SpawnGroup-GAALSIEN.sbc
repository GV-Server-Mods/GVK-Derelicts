	<SpawnGroups>
		<!-- These are separate from Drone Encounters since spawn groups are called directly by the spawner -->
		<!-- NUN Small Flyers Single -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Drone-Defense-SpawnGroup-GAALSIEN-SmallFlyerSingle</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:GVK-Drone-All-Manipulation-Flyer]
				[SpawnConditionsProfiles:GVK-Drone-Defense-SpawnCondition-GAALSIEN-SmallFlyerSingle]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>0.1</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NUN Foxhound">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Foxhound</BeaconText>
					<Behaviour>GVK-Drone-All-Behavior-SmallFlyerPatrolHorseFighter</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

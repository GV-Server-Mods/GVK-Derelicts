<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Drone Patrol/HorseFighter trigger group with 5km KPL and 2km targeting -->
		<!-- requires two autopilots: pimary passive and secondary aggressive -->
		<!-- Known issue with KPLs disappearing without explaination, so KPL creation cooldown is lower -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-TriggerGroup-PatrolHorseFighterKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-SwitchToHorseFighter]
			[Triggers:GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-SwitchToPatrol]
			[Triggers:GVK-Drone-All-PatrolHorseFighterKPL-Trigger-TargetNear]
			[Triggers:GVK-Drone-All-PatrolHorseFighterKPL-Trigger-LostTarget]
			[Triggers:GVK-Drone-All-PatrolHorseFighterKPL-Trigger-TargetFar]
			[Triggers:GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-CreateKPL]
			[Triggers:GVK-Drone-All-PatrolHorseFighterKPL-Trigger-CheckforKPL]
			[Triggers:GVK-Drone-All-PatrolHorseFighterKPL-Trigger-KPLStatusBool]
			</Description>
		</EntityComponent>
		<!-- manual triggers so multiple triggers can reference it without complications -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-SwitchToHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[Actions:GVK-Drone-All-PatrolHorseFighterKPL-Action-SwitchToHorseFighter]
			[ToggleWithTriggerProfile:GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Action-SwitchToHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:HorseFighter]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			</Description>
		</EntityComponent>
		<!-- should start false since it already spawns in Patrol mode -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Manual]
			[StartsReady:true]
			[Actions:GVK-Drone-All-PatrolHorseFighterKPL-Action-SwitchToPatrol]
			[ToggleWithTriggerProfile:GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-SwitchToHorseFighter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Action-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Patrol]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			</Description>
		</EntityComponent>
		<!-- When target in 2km, become aggressive and create KPL if not in KPL -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Trigger-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[Actions:GVK-Drone-All-PatrolHorseFighterKPL-Action-TargetNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Action-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[EnableTriggers:true]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-SwitchToHorseFighter]
			[ManuallyActivatedTriggerNames:GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-CreateKPL]
			</Description>
		</EntityComponent>
		<!-- Check if still in KPL -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Trigger-KPLStatusBool</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:PlayerKnownLocation]
			[StartsReady:true]
			[MinCooldownMs:2000]
			[MaxCooldownMs:2001]
			[Actions:GVK-Drone-All-PatrolHorseFighterKPL-Action-InKPL]
			[UseElseActions:true]
			[ElseActions:GVK-Drone-All-PatrolHorseFighterKPL-Action-NotInKPL]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Action-InKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SetBooleansTrue:NPCInKPL]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Action-NotInKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SetBooleansFalse:NPCInKPL]
			</Description>
		</EntityComponent>
		<!-- Create conditions for KPL status -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Condition-NPCInKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckTrueBooleans:true]
			[TrueBooleans:NPCInKPL]
			[UseFailCondition:true]
			</Description>
		</EntityComponent>
		<!-- Create new KPL (if not already in KPL) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-CreateKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[StartsReady:false]
			[MinCooldownMs:20000]
			[MaxCooldownMs:20001]
			[Conditions:GVK-Drone-All-PatrolHorseFighterKPL-Condition-NPCInKPL]
			[Actions:GVK-Drone-All-PatrolHorseFighterKPL-Action-CreateKPL]
			[ToggleWithTriggerProfile:GVK-Drone-All-PatrolHorseFighterKPL-Trigger-CheckforKPL]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Action-CreateKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[CreateKnownPlayerArea:true]
			[KnownPlayerAreaRadius:3000]
			[KnownPlayerAreaTimer:5]
			[KnownPlayerAreaMaxSpawns:5]
			</Description>
		</EntityComponent>
		<!-- Check if still in KPL -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Trigger-CheckforKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:PlayerKnownLocation]
			[StartsReady:true]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Actions:GVK-Drone-All-PatrolHorseFighterKPL-Action-StillinKPL]
			[UseElseActions:true]
			[ElseActions:GVK-Drone-All-PatrolHorseFighterKPL-Action-NotinKPL]
			</Description>
		</EntityComponent>
		<!-- If still in KPL then reset CreateKPL cooldown -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Action-StillinKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-CreateKPL]
			</Description>
		</EntityComponent>
		<!-- If not in KPL, switch to patrol and return to origin -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Action-NotinKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-SwitchToPatrol]
			[EnableTriggers:true]
			[EnableTriggerNames:GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-CreateKPL]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-PatrolHorseFighterKPL-Trigger-CheckforKPL]
			</Description>
		</EntityComponent>
		<!-- If no/lost target, switch to patrol and return to origin -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Trigger-LostTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:LostTarget]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[AllowTargetFarWithoutTarget:true]
			[Actions:GVK-Drone-All-PatrolHorseFighterKPL-Action-TargetFar]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Trigger-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetFar]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[AllowTargetFarWithoutTarget:true]
			[Actions:GVK-Drone-All-PatrolHorseFighterKPL-Action-TargetFar]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighterKPL-Action-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[EnableTriggers:true]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-All-PatrolHorseFighterKPL-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
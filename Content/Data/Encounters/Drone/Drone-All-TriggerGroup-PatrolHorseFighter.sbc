<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Drone Patrol/HorseFighter trigger group without KPL (Soban and Khaaneph) -->
		<!-- requires two autopilots: pimary passive and secondary aggressive -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-TriggerGroup-PatrolHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Drone-All-PatrolHorseFighter-ManualTrigger-SwitchToHorseFighter]
			[Triggers:GVK-Drone-All-PatrolHorseFighter-ManualTrigger-SwitchToPatrol]
			[Triggers:GVK-Drone-All-PatrolHorseFighter-Trigger-TargetNear]
			[Triggers:GVK-Drone-All-PatrolHorseFighter-Trigger-LostTarget]
			[Triggers:GVK-Drone-All-PatrolHorseFighter-Trigger-TargetFar]
			</Description>
		</EntityComponent>
		<!-- manual triggers so multiple triggers can reference it without complications -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighter-ManualTrigger-SwitchToHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[Actions:GVK-Drone-All-PatrolHorseFighter-Action-SwitchToHorseFighter]
			[ToggleWithTriggerProfile:GVK-Drone-All-PatrolHorseFighter-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighter-Action-SwitchToHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:HorseFighter]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			</Description>
		</EntityComponent>
		<!-- should start false since it already spawns in Patrol mode -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighter-ManualTrigger-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Manual]
			[StartsReady:true]
			[Actions:GVK-Drone-All-PatrolHorseFighter-Action-SwitchToPatrol]
			[ToggleWithTriggerProfile:GVK-Drone-All-PatrolHorseFighter-ManualTrigger-SwitchToHorseFighter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighter-Action-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Patrol]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			</Description>
		</EntityComponent>
		<!-- When target in 2km, become aggressive -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighter-Trigger-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[Actions:GVK-Drone-All-PatrolHorseFighter-Action-TargetNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighter-Action-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[EnableTriggers:true]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-All-PatrolHorseFighter-ManualTrigger-SwitchToHorseFighter]
			</Description>
		</EntityComponent>
		<!-- If no/lost target, switch to patrol and return to origin -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighter-Trigger-LostTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:LostTarget]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[AllowTargetFarWithoutTarget:true]
			[Actions:GVK-Drone-All-PatrolHorseFighter-Action-TargetFar]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighter-Trigger-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetFar]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[AllowTargetFarWithoutTarget:true]
			[Actions:GVK-Drone-All-PatrolHorseFighter-Action-TargetFar]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorseFighter-Action-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[EnableTriggers:true]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-All-PatrolHorseFighter-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Action group to do a barrel roll if GVK_MobilityType_Aircraft is true-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-BarrelRoll</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Timer]
				[DamageTypes:Any]
				[MinCooldownMs:30000]
				[MaxCooldownMs:60000]
				[StartsReady:true]
				[MaxActions:-1]
				[Conditions:GVK-Universal-Condition-IsAircraftMobilityType]
				[Actions:GVK-Drone-All-Action-BarrelRoll]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-BarrelRoll</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[BarrelRoll:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Trigger-SpawnAnyCOALITIONAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:PlayerNear]
				[UseTrigger:true]
				[TargetDistance:3000]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:5000]
				[MaxCooldownMs:5001]
				[//Conditions:GVK-Drone-Encounter-Condition-IsDroneEncounter]
				[Actions:GVK-Drone-Encounter-Action-SpawnAnyCOALITIONAttackers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Action-SpawnAnyCOALITIONAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:10]
				[SpawnEncounter:true]
				[Spawner:GVK-Drone-Encounter-Spawner-SpawnAnyCOALITIONAttackers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Spawner-SpawnAnyCOALITIONAttackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[MinDistance:500]
				[MaxDistance:1000]
				[MinAltitude:25]
				[MaxAltitude:50]
				[InheritNpcAltitude:false]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-COALITION-LAV]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-COALITION-BaserunnerLight]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-COALITION-BaserunnerHeavy]
				[SpawnGroups:GVK-Drone-Defense-SpawnGroup-COALITION-LargeRover]

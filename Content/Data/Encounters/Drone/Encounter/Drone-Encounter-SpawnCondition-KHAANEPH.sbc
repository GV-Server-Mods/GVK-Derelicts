<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Update GVK-Drone-Encounter-Condition-IsDroneEncounter when making changes here -->
		<!-- This spawns 1 Hover Salvager in Z1 thru Z3-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-SpawnCondition-KHAANEPH-Salvager</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[DroneEncounter:true]
			[FailedDroneSpawnResetsPlayerTime:false]
			[MinDroneDistance:2000]
			[MaxDroneDistance:4500]
			[MinDroneAltitude:30]
			[MaxDroneAltitude:40]
			[FactionOwner:KHAANEPH]
			[ReactorsOn:true]
			[ForceStaticGrid:false]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:false]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH-10000]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH-20000]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH-30000]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH-40000]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH-50000]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH-55000]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-SpawnCondition-KHAANEPH-Salvager-WreckSpawn</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[RivalAiAtmosphericSpawn:true]
			[FactionOwner:KHAANEPH]
			[ReactorsOn:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:false]
 			[PrefabSpawningMode:Random]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH-10000]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH-20000]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH-30000]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH-40000]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH-50000]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH-55000]
			[ZoneConditions:GVK-Alliance-ZoneConditions-KHAANEPH]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
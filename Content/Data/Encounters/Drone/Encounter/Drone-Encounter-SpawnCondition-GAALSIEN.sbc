<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Update GVK-Drone-Encounter-Condition-IsDroneEncounter when making changes here -->
		<!-- Route A canyon ambush profiles (Single + Squad): spawn inside RouteASpawnZones only -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-SpawnCondition-GAALSIEN-Single-RouteAZone</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[PlanetaryInstallation:true]
			[PlanetaryInstallationType:Small]
			[FactionOwner:GAALSIEN]
			[ReactorsOn:true]
			[ForceStaticGrid:false]
			[DoNotForceStaticGrid:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:false]
			[ZoneConditions:GVK-Universal-ZoneConditions-RouteAZone]
 			[PrefabSpawningMode:Random]
			[PrefabOffsetOverrides:{X:0 Y:35 Z:0}]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-SpawnCondition-GAALSIEN-Squad-RouteAZone</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[PlanetaryInstallation:true]
			[PlanetaryInstallationType:Small]
			[FactionOwner:GAALSIEN]
			[ReactorsOn:true]
			[ForceStaticGrid:false]
			[DoNotForceStaticGrid:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:false]
			[ZoneConditions:GVK-Universal-ZoneConditions-RouteAZone]
 			[PrefabSpawningMode:RandomFixedCount]
			[PrefabFixedCount:2]
			[PrefabOffsetOverrides:{X:25 Y:35 Z:0}]
			[PrefabOffsetOverrides:{X:-25 Y:35 Z:0}]
			</Description>
		</EntityComponent>

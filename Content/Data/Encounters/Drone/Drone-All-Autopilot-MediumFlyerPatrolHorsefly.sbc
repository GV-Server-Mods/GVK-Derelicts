<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallFlyer-Interceptor Passive Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Autopilot-MediumFlyerPatrolHorsefly-Passive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0.5]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:400]
			[MinimumPlanetAltitude:250]
			[AltitudeTolerance:50]
			[WaypointTolerance:100]
			[IdealMinSpeed:39]
			[IdealMaxSpeed:50]
			[SlowDownOnWaypointApproach:false]
			[WaypointWaitTimeTrigger:0]
			[MaxSpeedTolerance:10]
			[WaypointAbandonTimeTrigger:6]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:601]
			[OffsetPlanetMinTargetAltitude:500]
			[OffsetPlanetMaxTargetAltitude:600]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:1000]
			</Description>
		</EntityComponent>
		<!-- MediumFlyerHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Autopilot-MediumFlyerPatrolHorsefly-Aggressive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:true]
			[RotationMultiplier:2]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:500]
			[MinimumPlanetAltitude:400]
			[AltitudeTolerance:50]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointTolerance:250]
			[IdealMinSpeed:50]
			[IdealMaxSpeed:100]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:60]
			[OffsetSpaceMinDistFromTarget:900]
			[OffsetSpaceMaxDistFromTarget:1200]
			[OffsetPlanetMinDistFromTarget:800]
			[OffsetPlanetMaxDistFromTarget:1200]
			[OffsetPlanetMinTargetAltitude:-100]
			[OffsetPlanetMaxTargetAltitude:100]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:1000]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
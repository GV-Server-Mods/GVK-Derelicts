<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Baserunner Patrol Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-Baserunner-Passive</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:false]
				[UseProjectileLeadPrediction:false]
				[RotationMultiplierPitch:0.5]
				[RotationMultiplierYaw:4]
				[RotationMultiplierRoll:2]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:1.5]
				[DisableInertiaDampeners:true]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[WaypointTolerance:75]
				[UseSurfaceHoverThrustMode:true]
				[HoverPathStepDistance:76]
				[IdealPlanetAltitude:7.25]
				[AltitudeTolerance:75]
				[WaypointWaitTimeTrigger:1]
				[WaypointAbandonTimeTrigger:15]
				[IdealMinSpeed:25]
				[IdealMaxSpeed:35]
				[MaxSpeedTolerance:5]
				[WaypointWaitTimeTrigger:5]
				[OffsetPlanetMinDistFromTarget:500]
				[OffsetPlanetMaxDistFromTarget:701]
				[OffsetPlanetMinTargetAltitude:5]
				[OffsetPlanetMaxTargetAltitude:7]
				[OffsetMaxAngleFromTarget:90]
				[DisableInertiaDampeners:true]
				[MinimumPlanetAltitude:-100]
				[AngleAllowedForForwardThrust:120]
				[MaxVelocityAngleForSpeedControl:1000]
				[EscortUsesRelativeDampening:true]
				[EscortSpeedMatchMinDistance:0]
				[EscortSpeedMatchMaxDistance:25]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-Baserunner-Aggressive</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:false]
				[UseProjectileLeadPrediction:false]
				[RotationMultiplierPitch:0.5]
				[RotationMultiplierYaw:4]
				[RotationMultiplierRoll:2]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:1.5]
				[DisableInertiaDampeners:true]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[WaypointTolerance:100]
				[UseSurfaceHoverThrustMode:true]
				[HoverPathStepDistance:101]
				[IdealPlanetAltitude:7.25]
				[AltitudeTolerance:100]
				[WaypointWaitTimeTrigger:1]
				[WaypointAbandonTimeTrigger:15]
				[IdealMinSpeed:25]
				[IdealMaxSpeed:50]
				[MaxSpeedTolerance:5]
				[WaypointWaitTimeTrigger:5]
				[OffsetPlanetMinDistFromTarget:500]
				[OffsetPlanetMaxDistFromTarget:701]
				[OffsetPlanetMinTargetAltitude:5]
				[OffsetPlanetMaxTargetAltitude:7]
				[OffsetMaxAngleFromTarget:90]
				[DisableInertiaDampeners:true]
				[MinimumPlanetAltitude:-100]
				[AngleAllowedForForwardThrust:120]
				[MaxVelocityAngleForSpeedControl:1000]
				[EscortUsesRelativeDampening:true]
				[EscortSpeedMatchMinDistance:0]
				[EscortSpeedMatchMaxDistance:25]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
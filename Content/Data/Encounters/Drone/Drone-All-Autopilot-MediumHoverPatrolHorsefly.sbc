<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- MediumHoverHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-MediumHoverPatrolHorsefly-Passive</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:false]
				[UseProjectileLeadPrediction:false]
				[RotationMultiplierPitch:0.05]
				[RotationMultiplierYaw:2]
				[RotationMultiplierRoll:1]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.5]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[WaypointTolerance:75]
				[UseSurfaceHoverThrustMode:true]
				[HoverPathStepDistance:76]
				[IdealPlanetAltitude:17]
				[MinimumPlanetAltitude:0]
				[AltitudeTolerance:5000]
				[WaypointWaitTimeTrigger:10]
				[WaypointAbandonTimeTrigger:20]
				[IdealMinSpeed:35]
				[IdealMaxSpeed:40]
				[MaxSpeedTolerance:10]
				[OffsetPlanetMinDistFromTarget:500]
				[OffsetPlanetMaxDistFromTarget:501]
				[OffsetPlanetMinTargetAltitude:0]
				[OffsetPlanetMaxTargetAltitude:1]
				[OffsetMaxAngleFromTarget:90]
				[AngleAllowedForForwardThrust:120]
				[MaxVelocityAngleForSpeedControl:1000]
				[EscortUsesRelativeDampening:true]
				[EscortSpeedMatchMinDistance:0]
				[EscortSpeedMatchMaxDistance:25]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>

			[RemoteControlCode:GVK-Static]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence for Medium Defenses every 15 mins while players are near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site02-Trigger-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[TargetDistance:2000]
			[StartsReady:true]
			[MinCooldownMs:1800000]
			[MaxCooldownMs:1800001]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-Static-KOTH-Site02-Action-SpawnDefenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site02-Action-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SpawnEncounter:true]
			[Spawner:GVK-Static-KOTH-Site02-Spawner-Defenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site02-Spawner-Defenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:-1]
			[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-LightSandskimmerSquad]
			[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-SmallFlyerSingle]
			[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-SmallFlyerSquad]
			[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-InterceptorSingle]
			[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-InterceptorSquad]
			[MinDistance:1500]
			[MaxDistance:1750]
			[MinAltitude:40]
			[MaxAltitude:41]
			[InheritNpcAltitude:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<!-- Crashed Starship, Z2 small grid rovers only -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site03-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:false]
			[Triggers:GVK-Static-KOTH-Site03-Trigger-PlayerNear]
			[RemoteControlCode:GVK-Static]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence for Medium Defenses every 15 mins while players are near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site03-Trigger-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[TargetDistance:2000]
			[StartsReady:true]
			[MinCooldownMs:1800000]
			[MaxCooldownMs:1800001]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-Static-KOTH-Site03-Action-SpawnDefenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site03-Action-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SpawnEncounter:true]
			[Spawner:GVK-Static-KOTH-Site03-Spawner-Defenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site03-Spawner-Defenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:-1]
			[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-LightSandskimmerSquad]
			[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-SmallFlyerSingle]
			[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-InterceptorSingle]
			[MinDistance:1500]
			[MaxDistance:1750]
			[MinAltitude:40]
			[MaxAltitude:41]
			[InheritNpcAltitude:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<!-- Scraptown, Z3, captured on foot. Same defenders as Khar Toba (owner, 2026-11-14: keep them), plus the store
		     refresh: Store-Scraptown gets the ScrapTownKoth profile (it buys Smuggled Goods) and Store-VendingMachine the
		     VendingMachine one. The stores are saved off; each Respawn_N room's sensor switches its store on after 30 s. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site04-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:false]
			[Triggers:GVK-Static-KOTH-Site01-Trigger-PlayerNear]
			[Triggers:GVK-Static-KOTH-Site04-Trigger-ShareSpawnPoints]
			[TriggerGroups:GVK-Store-TriggerGroup-UpdateStores]
			[RemoteControlCode:GVK-Static]
			</Description>
		</EntityComponent>
		<!-- A prefab spawn sets every block to faction share, so the town's spawn points are set to share with all
		     after the spawn (owner, 2026-11-14); the 10-minute repeat covers a rebuilt block. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site04-Trigger-ShareSpawnPoints</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:600000]
			[MaxCooldownMs:600001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:GVK-Static-KOTH-Site04-Action-ShareSpawnPoints]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site04-Action-ShareSpawnPoints</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ChangeBlocksShareModeAll:true]
			[BlockNamesShareModeAll:Spawn_Point_IR - Respawn_1,Spawn_Point_IR - Respawn_2,Spawn_Point_IR - Respawn_3,Spawn_Point_IR - Respawn_4,Spawn_Point_IR - Respawn_5]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
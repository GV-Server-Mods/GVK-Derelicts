<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Khar Toba, Z3 all grids permitted -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site01-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:false]
			[Triggers:GVK-Static-KOTH-Site01-Trigger-PlayerNear]
			[RemoteControlCode:GVK-Static]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence for Medium Defenses every 15 mins while players are near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site01-Trigger-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[TargetDistance:2000]
			[StartsReady:true]
			[MinCooldownMs:800000]
			[MaxCooldownMs:800001]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-Static-KOTH-Site01-Action-SpawnDefenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site01-Action-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SpawnEncounter:true]
			[Spawner:GVK-Static-KOTH-Site01-Spawner-Defenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site01-Spawner-Defenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:-1]
			[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-MediumHoverHeavy]
			[SpawnGroups:GVK-Unit-Defense-SpawnGroup-GAALSIEN-LargeHover]
			[MinDistance:1500]
			[MaxDistance:1750]
			[MinAltitude:40]
			[MaxAltitude:41]
			[InheritNpcAltitude:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<!-- Kalash Site, Z3 small grids only -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-KOTH-Site02-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:false]

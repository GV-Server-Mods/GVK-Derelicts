<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--=== Target Profiles
		===-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Target-EnemyPlayerAndGrid2km</SubtypeId>
			</Id>
			<Description>
				[RivalAI Target]
				[UseCustomTargeting:true]
				[Target:PlayerAndGrid]
				[UseTargetRefresh:false]
				[TimeUntilNextRefresh:60]
				[TimeUntilNextEvaluation:15]
				[MaxDistance:2000]
				[MaxExistingTargetDistance:4000]
				[GetTargetBy:ClosestDistance]
				[MatchAllFilters:Relation]
				[MatchAllFilters:OutsideOfSafezone]
				[MatchAllFilters:Powered]
				[MatchNoneFilters:Name]
				[MatchNoneFilters:Faction]
				[Relations:Enemy]
				[Names:NPC Static]
				[Names:NPC Trade Station]
				[Names:NPC KOTH]
				[Names:Signpost]
				[Names:Base Site Tower]
				[UsePartialNameMatching:true]
				[FactionTargets:COALITION]
				[FactionTargets:UNKN]
				[FactionTargets:KOTH]
				[FactionTargets:DERELICT]
			</Description>
		</EntityComponent>

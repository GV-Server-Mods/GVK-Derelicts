				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-Universal-Action-IndestructibleOnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-IndestructibleOnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[GridDestructible:No]
				[SubGridsDestructible:No]
			</Description>
		</EntityComponent>
		<!-- Trigger Make non-editable on spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-UneditableOnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-Universal-Action-UneditableOnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-UneditableOnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[GridEditable:No]
				[SubGridsEditable:No]
			</Description>
		</EntityComponent>
		<!-- Trigger Make editable on defeat -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-EditableOnCompromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Compromised]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-Universal-Action-EditableOnCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-EditableOnCompromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[GridEditable:Yes]
				[SubGridsEditable:Yes]
			</Description>
		</EntityComponent>
		<!-- === Chat === -->
		<!-- NPC chatter voices. Dialogue banks (generated by Docs/dialogue/scripts/build_banks.py) point here for author, colour,
		     chance and range. Range by tier: Small 5 km, Medium 15 km, Large (big, rare and unique encounters) server-wide. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Chat-Voice-Small</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:20]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:false]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:5000]
				[Author:{GridName}]
				[Color:White]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Chat-Voice-GAALSIEN-Small</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:20]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:false]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:5000]
				[Author:{GridName}]
				[Color:Red]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Chat-Voice-Medium</SubtypeId>
			</Id>
			<Description>

			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-JetpackInhibitor</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Session]
				[UseTrigger:false]
				[StartsReady:false]
				[MaxActions:-1]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10001]
				[Actions:GVK-Universal-Action-JetpackInhibitor]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-JetpackInhibitor</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[UseJetpackInhibitorEffect:true]
			</Description>
		</EntityComponent>
		<!-- Trigger Make indestructable on spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-IndestructibleOnSpawn</SubtypeId>
			</Id>
			<Description>

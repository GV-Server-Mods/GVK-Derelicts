		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-MediumBlueExplosionEffects</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:MediumBlueExplosionEffects]
				[PlayParticleEffectAtRemote:true]
				[ParticleEffectId:Explosion_Warhead_30_Blue]
				[ParticleEffectOffset:{X:0.0 Y:0.0 Z:0.0}]
				[ParticleEffectScale:1.0]
				[ParticleEffectMaxTime:1000]
				[ParticleEffectColor:{X:1.0 Y:1.0 Z:1.0}]
				[PlaySoundAtPosition:true]
				[SoundAtPosition:HWR_LargeExplosion]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-LargeBlueExplosionEffects</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:LargeBlueExplosionEffects]
				[PlayParticleEffectAtRemote:true]
				[ParticleEffectId:Explosion_Warhead_50_Blue]
				[ParticleEffectOffset:{X:0.0 Y:0.0 Z:0.0}]
				[ParticleEffectScale:1.0]
				[ParticleEffectMaxTime:1000]
				[ParticleEffectColor:{X:1.0 Y:1.0 Z:1.0}]
				[PlaySoundAtPosition:true]
				[SoundAtPosition:Cruiser_Explosion]
			</Description>
		</EntityComponent>
		<!-- Shared disabled action for most NPCs that do not despawn on death, also shut off power producers on lg -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-Disabled</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:Universal-Action-Disabled]
				[EnableBlocks:true]
				[EnableBlockNames:Magnetic Plate]
				[EnableBlockStates:On]
				[EnableBlockNames:NPC Beacon]
				[EnableBlockStates:Off]
				[StopAllRotation:true]
				[StopAllThrust:true]
				[ChangeInertiaDampeners:true]
				[InertiaDampenersEnable:false]
				[RazeBlocksOfType:true]
				[RazeBlocksTypes:MyObjectBuilder_Beacon/ZoneBlock]
				[//RazeBlocksTypes:MyObjectBuilder_Beacon/SmallBlockBeacon]
				[//RazeBlocksTypes:MyObjectBuilder_Beacon/LargeBlockBeacon]
				[//RazeBlocksTypes:MyObjectBuilder_Beacon/SmallBlockBeacon_NPC]
				[//RazeBlocksTypes:MyObjectBuilder_Beacon/LargeBlockBeacon_NPC]
				[//RazeBlocksTypes:MyObjectBuilder_Beacon/SmallBlockBeacon_NPCNoConceal]
				[//RazeBlocksTypes:MyObjectBuilder_Beacon/LargeBlockBeacon_NPCNoConceal]
				[ToggleBlocksOfType:true]
				[BlockTypesToToggle:MyObjectBuilder_Parachute/LgParachute]
				[BlockTypeToggles:On]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconSmall]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconLarge]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_BatteryBlock/LargeBlockBatteryBlock]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_BatteryBlock/LargeBlockPrototechBattery]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_BatteryBlock/LargeBlockBatteryBlockWarfare2]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Reactor/ProprietaryLargeBlockSmallGenerator]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Reactor/ProprietaryLargeBlockLargeGenerator]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_HydrogenEngine/LargeHydrogenEngine]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_WindTurbine/LargeBlockWindTurbine]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_WindTurbine/LargeBlockWindTurbineReskin]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_SolarPanel/LargeBlockSolarPanel]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_SolarPanel/LargeBlockColorableSolarPanel]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_SolarPanel/LargeBlockColorableSolarPanelCorner]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_SolarPanel/LargeBlockColorableSolarPanelCornerInverted]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/SmallBlockBeacon]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/LargeBlockBeacon]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/SmallBlockBeacon_NPC]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/LargeBlockBeacon_NPC]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/SmallBlockBeacon_NPCNoConceal]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/LargeBlockBeacon_NPCNoConceal]
				[BlockTypeToggles:Off]
				[GridEditable:Yes]
				[SubGridsEditable:Yes]
				[ForceDespawn:false]
			</Description>
		</EntityComponent>
		<!-- Shared action to shut off thrusters and other blocks on large wrecks -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DisableVanillaBlocks</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:Universal-Action-DisableVanillaBlocks]
				[ToggleBlocksOfType:true]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-Ion-LargeGrid-Large]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-Ion-LargeGrid-Small]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-IonSciFi-LargeGrid-Large]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-IonSciFi-LargeGrid-Small]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-WarfareIon-LargeGrid-Large]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-WarfareIon-LargeGrid-Small]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-Atmo-LargeGrid-Large]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-Atmo-LargeGrid-Small]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-AtmoSciFi-LargeGrid-Large]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-AtmoSciFi-LargeGrid-Small]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-Hydro-LargeGrid-Large]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-Hydro-LargeGrid-Small]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-IndustryHydro-LargeGrid-Large]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Thrust/MES-NPC-Thrust-IndustryHydro-LargeGrid-Small]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_OffensiveCombatBlock/LargeOffensiveCombat]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_DefensiveCombatBlock/LargeDefensiveCombat]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_BasicMissionBlock/LargeBasicMission]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_PathRecorderBlock/LargePathRecorderBlock]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_FlightMovementBlock/LargeFlightMovement]
				[BlockTypeToggles:Off]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-PublicSpawnPoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Timer]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1001]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-Universal-Action-PublicSpawnPoint]
			</Description>
		</EntityComponent>
		<!-- ChangeBlocksShareModeAll needs MES 2.74.04+ (fixed upstream in MES #369) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-PublicSpawnPoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:PublicSpawnPoint]
				[ChangeBlocksShareModeAll:true]
				[BlockNamesShareModeAll:PublicSpawnPoint]
			</Description>
		</EntityComponent>
		<!-- Generic conditions -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-Crashed</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckGridSpeed:true]
				[MinGridSpeed:0]
				[MaxGridSpeed:10]
				[AltitudeCheck:true]
				[MinAltitude:-999999]
				[MaxAltitude:7]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_MobilityType_Aircraft]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-IsAircraftMobilityType</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckTrueBooleans:true]
				[TrueBooleans:GVK_MobilityType_Aircraft]
			</Description>
		</EntityComponent>
		<!-- Action group to set turrets to max range to work around the MES WeaponCore range bug (GVK-Settings#681) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-WeaponsToMaxRange</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Timer]
				[StartsReady:false]
				[MinCooldownMs:5000]
				[MaxCooldownMs:5001]
				[MaxActions:3]
				[Actions:GVK-Universal-Action-WeaponsToMaxRange]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-WeaponsToMaxRange</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:WeaponsToMaxRange]
				[SetWeaponsToMaxRange:true]
			</Description>
		</EntityComponent>
		<!-- Action group to engage enemy upon taking damage -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-TargetAttacker</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Damage]
				[StartsReady:true]
				[MinCooldownMs:30000]
				[MaxCooldownMs:30001]
				[DamageTypes:Any]
				[MaxActions:-1]
				[Actions:GVK-Universal-Action-TargetAttacker]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-TargetAttacker</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:TargetAttacker]
				[SwitchToReceivedTarget:true]
			</Description>
		</EntityComponent>
		<!-- Action group to engage enemy when turret has a target -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-TurretTarget</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:TurretTarget]
				[StartsReady:true]
				[MinCooldownMs:30000]
				[MaxCooldownMs:30001]
				[MaxActions:-1]
				[Actions:GVK-Universal-Action-TurretTarget]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-TurretTarget</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:TurretTarget]
				[SwitchToReceivedTarget:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
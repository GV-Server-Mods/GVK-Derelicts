			<Description>
				[RivalAI Action]
				[//DebugMessage:SmallBlueExplosionEffects]
				[PlayParticleEffectAtRemote:true]
				[ParticleEffectId:BlockDestroyedExplosion_Large3X_Blue]
				[ParticleEffectOffset:{X:0.0 Y:0.0 Z:0.0}]
				[ParticleEffectScale:1.0]
				[ParticleEffectMaxTime:1000]
				[ParticleEffectColor:{X:1.0 Y:1.0 Z:1.0}]

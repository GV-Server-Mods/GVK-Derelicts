<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- =================================================== -->
		<!-- COALITION CONVOY A (Land)                           -->
		<!-- =================================================== -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Event-CoalitionA</SubtypeId>
			</Id>
			<!-- Ambient spawn disabled: this convoy now spawns only via escort contract missions
			     (GVK-EscortMission-RouteA -> GVK-EscortMissions-Template-Spawn-A). Its condition,
			     action and spawner profiles are reused by those template events.
			     Set UseEvent:true to restore the ambient spawn as well. -->
			<Description>
				[MES Event]
				[UseEvent:false]
				[UniqueEvent:false]
				[StartsReady:true]
				[MinCooldownMs:4800000]
				[MaxCooldownMs:7200000]
				[//ConditionIds:GVK-Convoy-EventCondition-CoalitionA]
				[//ActionIds:GVK-Convoy-EventAction-CoalitionA]
				[ActionExecution:All]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-EventCondition-CoalitionA</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckPlayerNear:true]
				[PlayerNearCoords:{X:60487.1180668017 Y:32965.0642252912 Z:44090.2929086085}]
				[PlayerNearDistanceFromCoords:10000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-EventAction-CoalitionA</SubtypeId>
			</Id>
			<Description>
				[MES Event Action]
				[SpawnEncounter:true]
				[SpawnCoords:{X:60487.1180668017 Y:32965.0642252912 Z:44090.2929086085}]
				[SpawnFactionTags:COALITION]
				[SpawnData:GVK-Convoy-EventSpawner-CoalitionA]
				[ChangeBooleans:true]
				[SetBooleansFalse:GVK_EscortArrived_A]
				[SetBooleansFalse:GVK_EscortLost_A]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-EventSpawner-CoalitionA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[ProcessAsAdminSpawn:true]
				[SpawnGroups:GVK-PlanetaryCargoShip-Land-COALITION-SpawnGroup-ConvoyEscortA]
				[SpawnGroups:GVK-PlanetaryCargoShip-Land-COALITION-SpawnGroup-EscortA]
				[MinDistance:200]
				[MaxDistance:500]
				[MinAltitude:40]
				[MaxAltitude:50]
				[InheritNpcAltitude:false]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>


				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ2Canyon]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportInsideZ3]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ3]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ3Canyon]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportAttacked]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportBeaconDisabled-A-Lead]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportCompromised-A-Lead]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportDespawn-A-Lead]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportBeaconDisabled-A-Tail]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportCompromised-A-Tail]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportDespawn-A-Tail]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-HeartbeatA-Double]
				[PlayParticleEffectAtRemote:true]
				[ParticleEffectId:CruiserPoofSmoke]
				[ParticleEffectOffset:{X:0.0 Y:0.0 Z:0.0}]
				[ParticleEffectScale:3.0]
				[ParticleEffectMaxTime:2000]
				[ParticleEffectColor:{X:1.0 Y:1.0 Z:1.0}]
				[PlaySoundAtPosition:true]
				[SoundAtPosition:Cruiser_Explosion]
				[ForceDespawn:true]
			</Description>

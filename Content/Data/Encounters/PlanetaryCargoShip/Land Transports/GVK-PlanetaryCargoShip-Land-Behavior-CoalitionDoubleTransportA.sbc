		<!-- Arrival and Heartbeat for Double Escort A -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportSuccessTargetA-Double</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:TargetNear]
				[UseTrigger:true]
				[StartsReady:false]
				[TargetDistance:500]
				[ActionExecution:All]
				[MinCooldownMs:9998]
				[MaxCooldownMs:9999]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportSuccessA-Double]
			</Description>
		</EntityComponent>

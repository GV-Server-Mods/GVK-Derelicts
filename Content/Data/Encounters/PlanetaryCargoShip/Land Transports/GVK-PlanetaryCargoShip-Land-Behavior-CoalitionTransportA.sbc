		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-TransportAddWaypointsA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:false]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:Transport]
				[Color:White]
				[ChatMessages:Adding waypoints.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger to fly level with gravity when horizon angle is high -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportHorizonAngleHigh</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:-1]
				[ActionExecution:All]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1001]
				[Conditions:GVK-CargoShip-Land-COALITION-Condition-TransportHorizonAngleHigh]
				[ConditionCheckResetsTimer:true]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportHorizonAngleHigh]
				[UseElseActions:true]
				[ElseActions:GVK-CargoShip-Land-COALITION-Action-TransportHorizonAngleLow]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Condition-TransportHorizonAngleHigh</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:true]
				[CheckHorizonAngle:true]
				[MinHorizonAngle:16]
				[MaxHorizonAngle:90]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TransportHorizonAngleHigh</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:EscortHorizonAngleHigh]
				[Chance:100]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Tertiary]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TransportHorizonAngleLow</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:EscortHorizonAngleLow]
				[Chance:100]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Primary]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Transport to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportBeaconDisabled-A</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:true]
				[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefeatedCompromised]
				[Actions:GVK-ConvoyContracts-Action-ConvoyLost-A]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportCompromised]
				[Actions:GVK-Universal-Action-EditableOnCompromised]
				[Actions:GVK-Universal-Action-Disabled]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportCompromised-A</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Compromised]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-Universal-Action-DefeatedCompromised]
				[Actions:GVK-ConvoyContracts-Action-ConvoyLost-A]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportCompromised]
				[Actions:GVK-Universal-Action-EditableOnCompromised]
				[Actions:GVK-Universal-Action-Disabled]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>

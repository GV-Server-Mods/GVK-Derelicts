<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- 
		
			Route A, Crossroads to Sevastapol
			Transport Behavior for land rover following roads
			Use alternate spawning method in Canyon Route Zone
				GPS:Canyon Route:32649.04:36654.43:62459.73:#FF75C9F1:
				26.45km

		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Behavior-TransportA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:CargoShip]
				[DialogueBanks:GVK-Travellers-COALITION-Medium.xml]
				[WeaponSystem:GVK-Universal-Weapons-All]
				[UsePlayerDistanceTimer:false]
				[PlayerDistanceTimerTrigger:3600]
				[PlayerDistanceTrigger:4000]
				[UseRetreatTimer:false]
				[RetreatTimerTrigger:3600]
				[UseNoTargetTimer:false]
				[RetreatDespawnDistance:3000]
				[AutopilotData:GVK-CargoShip-Land-COALITION-TransportPrimaryAutopilot]
				[SecondaryAutopilotData:GVK-CargoShip-Land-COALITION-TransportSecondaryAutopilot]
				[TertiaryAutopilotData:GVK-CargoShip-Land-COALITION-TransportTertiaryAutopilot]
				[TargetData:GVK-Universal-Target-COALITIONTradeStation]
				[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
				[Triggers:GVK-Universal-Trigger-EditableOnCompromised]
				[Triggers:GVK-Universal-Trigger-TargetAttacker]
				[Triggers:GVK-Universal-Trigger-TurretTarget]
				[//Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportOnSpawnA]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportAddWaypointsA]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportHorizonAngleHigh]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportArriveAtWaypoint]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportLeaveWaypoint]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportBeaconDisabled-A]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportCompromised-A]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportDespawn-A]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportAttacked]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportPlayerNear]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportPlayerStillNear]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportPlayerNotNear]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportInsideCanyonZone]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportOutsideCanyonZone]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportInsideZ1]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ1]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ1Canyon]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportInsideZ2]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ2]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ2Canyon]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportInsideZ3]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ3]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ3Canyon]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportSuccessTargetA]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportSuccessCounterA]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-HeartbeatA]
				[Triggers:GVK-CargoShip-Land-COALITION-TransportA-Trigger-EncounterInit]
				[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
				[RemoteControlCode:COALITIONRouteA]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Primary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-TransportPrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[RotationMultiplier:1.25]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.50]
				[DisableInertiaDampeners:true]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[IdealPlanetAltitude:22.5]
				[MinimumPlanetAltitude:0]
				[AltitudeTolerance:40]
				[UseSurfaceHoverThrustMode:true]
				[HoverPathStepDistance:100]
				[UseVelocityCollisionEvasion:false]
				[CollisionEvasionWaypointDistance:200]
				[CollisionEvasionResumeDistance:100]
				[CollisionEvasionResumeTime:10]
				[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
				[CollisionEvasionWaypointFromEntityMaxAngle:90]
				[WaypointAbandonTimeTrigger:9999999]
				[WaypointTolerance:95]
				[IdealMinSpeed:35]
				[IdealMaxSpeed:40]
				[MaxSpeedTolerance:5]
				[SlowDownOnWaypointApproach:true]
				[WaypointWaitTimeTrigger:120]
				[ExtraSlowDownDistance:300]
				[AngleAllowedForForwardThrust:45]
				[MaxVelocityAngleForSpeedControl:89]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Secondary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-TransportSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[RotationMultiplier:0.75]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.20]
				[IdealPlanetAltitude:22.5]
				[WaypointTolerance:95]
				[IdealMinSpeed:0]
				[IdealMaxSpeed:0]
				[MaxSpeedTolerance:2]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Tertiary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-TransportTertiaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[RotationMultiplier:1.25]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.20]
				[DisableInertiaDampeners:true]
				[FlyLevelWithGravity:true]
				[LevelWithGravityWhenIdle:false]
				[IdealPlanetAltitude:22.5]
				[MinimumPlanetAltitude:0]
				[AltitudeTolerance:40]
				[UseSurfaceHoverThrustMode:false]
				[HoverPathStepDistance:100]
				[UseVelocityCollisionEvasion:false]
				[CollisionEvasionWaypointDistance:200]
				[CollisionEvasionResumeDistance:100]
				[CollisionEvasionResumeTime:10]
				[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
				[CollisionEvasionWaypointFromEntityMaxAngle:90]
				[WaypointAbandonTimeTrigger:9999999]
				[WaypointTolerance:95]
				[IdealMinSpeed:35]
				[IdealMaxSpeed:50]
				[MaxSpeedTolerance:10]
				[SlowDownOnWaypointApproach:true]
				[WaypointWaitTimeTrigger:120]
				[ExtraSlowDownDistance:300]
				[AngleAllowedForForwardThrust:90]
				[MaxVelocityAngleForSpeedControl:89]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Waypoint-TransportEnemySpawnsCanyon</SubtypeId>
			</Id>
			<Description>
				[RivalAI Waypoint]
				[Waypoint:RelativeOffset]
				[RelativeEntity:Self]
				[Offset:{X:700 Y:50 Z:-700}]
				[MinDistance:0]
				[MaxDistance:300]
				[MinAltitude:30]
				[MaxAltitude:40]
				[InheritRelativeAltitude:true]
			</Description>
		</EntityComponent>
		<!-- Trigger when Transport Spawns -->
		<!-- Escort chat when spawned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportOnSpawnA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1000]
				[ActionExecution:All]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportOnSpawnA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TransportOnSpawnA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:EscortOnSpawnA]
				[Chance:100]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[ResetCounters:WaypointCounter]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportHorizonAngleHigh]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-Land-COALITION-Chat-TransportOnSpawnA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-TransportOnSpawnA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:{Faction}]
				[Color:{PlayerRelation}]
				[ChatMessages:A transport is ready for escort from Crossroads to Sevastopol (Difficult).]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:999999]
			</Description>
		</EntityComponent>
		<!-- Trigger to add waypoints after spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportAddWaypointsA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:2]
				[MinCooldownMs:3000]
				[MaxCooldownMs:3001]
				[ActionExecution:All]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportAddWaypointsA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">

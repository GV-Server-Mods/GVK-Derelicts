<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Route B, Crossroads to Mastodon -->
		<!-- Transport Behavior for land rover following roads -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Behavior-TransportB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:CargoShip]
				[DialogueBanks:GVK-Travellers-COALITION-Medium.xml]
				[WeaponSystem:GVK-Universal-Weapons-All]
				[UsePlayerDistanceTimer:false]
				[PlayerDistanceTimerTrigger:3600]
				[PlayerDistanceTrigger:4000]
				[UseRetreatTimer:false]
				[RetreatTimerTrigger:3600]
				[UseNoTargetTimer:false]
				[RetreatDespawnDistance:3000]
				[AutopilotData:GVK-CargoShip-Land-COALITION-TransportPrimaryAutopilot]
				[SecondaryAutopilotData:GVK-CargoShip-Land-COALITION-TransportSecondaryAutopilot]
				[TertiaryAutopilotData:GVK-CargoShip-Land-COALITION-TransportTertiaryAutopilot]
				[TargetData:GVK-Universal-Target-COALITIONTradeStation]
				[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
				[Triggers:GVK-Universal-Trigger-EditableOnCompromised]
				[Triggers:GVK-Universal-Trigger-TargetAttacker]
				[Triggers:GVK-Universal-Trigger-TurretTarget]
				[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportOnSpawnB]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportAddWaypointsB]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportHorizonAngleHigh]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportArriveAtWaypoint]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportLeaveWaypoint]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportBeaconDisabled-B]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportCompromised-B]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportDespawn-B]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportAttacked]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportPlayerNear]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportPlayerStillNear]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportPlayerNotNear]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportInsideZ1]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ1]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportInsideZ2]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ2]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportInsideZ3]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ3]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportSuccessTargetB]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportSuccessCounterB]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-HeartbeatB]
				[Triggers:GVK-CargoShip-Land-COALITION-TransportB-Trigger-EncounterInit]
				[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
				[RemoteControlCode:COALITIONRouteB]
			</Description>
		</EntityComponent>
		<!-- Escort chat when spawned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportOnSpawnB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1000]
				[ActionExecution:All]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportOnSpawnB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TransportOnSpawnB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[SetWeaponsToMaxRange:true]
				[ResetCounters:WaypointCounter]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportHorizonAngleHigh]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-Land-COALITION-Chat-TransportOnSpawnB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-TransportOnSpawnB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:{Faction}]
				[Color:{PlayerRelation}]
				[ChatMessages:A Transport is ready for escort from Crossroads to Mastodon (Moderate).]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:999999]
			</Description>
		</EntityComponent>
		<!-- Trigger to add waypoints after spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportAddWaypointsB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:2]
				[MinCooldownMs:3000]
				[MaxCooldownMs:3001]
				[ActionExecution:All]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportAddWaypointsB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TransportAddWaypointsB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[AddWaypoints:true]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB01]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB02]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB03]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB04]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB05]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB06]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB07]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB08]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB09]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB10]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB11]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB12]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB13]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB14]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB15]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB16]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB17]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB18]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB19]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB20]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB21]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB22]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB23]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB24]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB25]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB26]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB27]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB28]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB29]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB30]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB31]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB32]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB33]

				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB64]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB65]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB66]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB67]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB68]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB69]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB70]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Transport to die, borrows most from EscortA -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportBeaconDisabled-B</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:true]
				[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefeatedCompromised]
				[Actions:GVK-ConvoyContracts-Action-ConvoyLost-B]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportCompromised]
				[Actions:GVK-Universal-Action-EditableOnCompromised]
				[Actions:GVK-Universal-Action-Disabled]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportCompromised-B</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Compromised]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-Universal-Action-DefeatedCompromised]
				[Actions:GVK-ConvoyContracts-Action-ConvoyLost-B]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportCompromised]
				[Actions:GVK-Universal-Action-EditableOnCompromised]
				[Actions:GVK-Universal-Action-Disabled]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportDespawn-B</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:DespawnMES]
				[DespawnTypeFromSpawner:Any]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-ConvoyContracts-Action-ConvoyLost-B]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportCompromised]
			</Description>
		</EntityComponent>
		<!-- Trigger when it reaches Sevastapol to spawn reward -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportSuccessTargetB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:TargetNear]
				[UseTrigger:true]
				[StartsReady:false]
				[TargetDistance:250]
				[ActionExecution:All]
				[MinCooldownMs:9998]
				[MaxCooldownMs:9999]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportSuccessB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportSuccessCounterB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[ActionExecution:All]
				[MinCooldownMs:5000]
				[MaxCooldownMs:5001]
				[Conditions:GVK-CargoShip-Land-COALITION-Condition-TransportSuccessB]
				[ConditionCheckResetsTimer:true]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportSuccessB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Condition-TransportSuccessB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:true]
				[CheckCustomCounters:true]
				[CustomCounters:WaypointCounter]
				[CustomCountersTargets:69]
				[CounterCompareTypes:GreaterOrEqual]
				[AllowAnyValidCounter:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TransportSuccessB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetSandboxBooleansTrue:GVK_TransportArrived_B]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-Land-COALITION-Chat-TransportSuccessB]
				[SpawnEncounter:true]
				[Spawner:GVK-CargoShip-Land-COALITION-Spawner-TransportSuccessB]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportSuccessTargetB]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportSuccessCounterB]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportHorizonAngleHigh]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportPlayerNear]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportPlayerNotNear]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportInsideZ1]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ1]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportInsideZ2]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ2]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportInsideZ3]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportEnemySpawnsZ3]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportAttacked]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportBeaconDisabled-B]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportCompromised-B]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportDespawn-B]
				[PlayParticleEffectAtRemote:true]
				[ParticleEffectId:CruiserPoofSmoke]
				[ParticleEffectOffset:{X:0.0 Y:0.0 Z:0.0}]
				[ParticleEffectScale:3.0]
				[ParticleEffectMaxTime:2000]
				[ParticleEffectColor:{X:1.0 Y:1.0 Z:1.0}]
				[PlaySoundAtPosition:true]
				[SoundAtPosition:Cruiser_Explosion]
				[ForceDespawn:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-TransportSuccessB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:{Faction}]
				[Color:{PlayerRelation}]
				[ChatMessages:Cargo Transport arrived safely at Mastodon.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Spawner-TransportSuccessB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[ProcessAsAdminSpawn:true]
				[MaxSpawns:1]
				[SpawnGroups:GVK-Other-Loot-SpawnGroup-COALITION-CargoCache2x]
				[MinDistance:300]
				[MaxDistance:400]
				[MinAltitude:300]
				[MaxAltitude:301]
				[InheritNpcAltitude:false]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-HeartbeatB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:true]
				[MinCooldownMs:30000]
				[MaxCooldownMs:30001]
				[Actions:GVK-CargoShip-Land-COALITION-Action-HeartbeatB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-HeartbeatB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[ResetCooldownTimeOfEvents:true]
				[ResetEventCooldownTags:GVK_ConvoyContractWatchdog_B]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-TransportB-Trigger-EncounterInit</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Session]
				[StartsReady:true]
				[MaxActions:-1]
				[ActionExecution:All]
				[Actions:GVK-CargoShip-Land-COALITION-TransportB-Action-EncounterInit]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-TransportB-Action-EncounterInit</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[SetCustomStrings:true]
				[CustomStrings:EncounterType,CargoShip]
				[CustomStrings:EncounterDisplayName,Transport]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
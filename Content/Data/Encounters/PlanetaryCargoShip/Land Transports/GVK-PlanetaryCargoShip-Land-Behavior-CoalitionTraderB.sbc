<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Route B, Crossroads to Mastodon -->
		<!-- Transport Behavior for land rover following roads -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Land-COALITION-Behavior-TraderB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:CargoShip]
				[DialogueBanks:GVK-Travellers-COALITION-Medium.xml]
				[WeaponSystem:GVK-Universal-Weapons-All]
				[UsePlayerDistanceTimer:false]
				[PlayerDistanceTimerTrigger:3600]
				[PlayerDistanceTrigger:4000]
				[UseRetreatTimer:false]
				[RetreatTimerTrigger:3600]
				[UseNoTargetTimer:false]
				[RetreatDespawnDistance:3000]
				[AutopilotData:GVK-Transport-Land-COALITION-TraderPrimaryAutopilot]
				[SecondaryAutopilotData:GVK-Transport-Land-COALITION-TraderSecondaryAutopilot]
				[TertiaryAutopilotData:GVK-Transport-Land-COALITION-TransportTertiaryAutopilot]
				[TargetData:GVK-Universal-Target-COALITIONTradeStation]
				[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
				[Triggers:GVK-Universal-Trigger-IndestructibleOnSpawn]
				[Triggers:GVK-Universal-Trigger-TargetAttacker]
				[Triggers:GVK-Universal-Trigger-TurretTarget]
				[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TraderOnSpawnB]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TransportAddWaypointsB]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TransportHorizonAngleHigh]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TransportArriveAtWaypoint]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TransportLeaveWaypoint]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TraderHeadToDespawn]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TransportBeaconDisabled]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TransportCompromised]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TransportDespawn]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TransportAttacked]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TraderPlayerNear]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TraderPlayerStillNear]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TraderPlayerNotNear]
				[Triggers:GVK-Transport-Land-COALITION-Trigger-TraderOutsideZone0]
				[Triggers:GVK-Transport-Land-COALITION-TraderB-Trigger-EncounterInit]
				[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
				[RemoteControlCode:COALITIONRouteB]
			</Description>
		</EntityComponent>
		<!-- Trigger when Transport Spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Land-COALITION-Trigger-TraderOnSpawnB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1000]
				[Actions:GVK-Transport-Land-COALITION-Action-TraderOnSpawnB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Land-COALITION-Action-TraderOnSpawnB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Primary]
				[SetWeaponsToMaxRange:true]
				[UseChatBroadcast:true]
				[ChatData:GVK-Transport-Land-COALITION-Chat-TraderOnSpawnB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Land-COALITION-Chat-TraderOnSpawnB</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:{Faction}]
				[Color:{PlayerRelation}]
				[ChatMessages:A Trader is en route from Crossroads to Mastodon.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:999999]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Land-COALITION-TraderB-Trigger-EncounterInit</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Session]
				[StartsReady:true]
				[MaxActions:-1]
				[ActionExecution:All]
				[Actions:GVK-Transport-Land-COALITION-TraderB-Action-EncounterInit]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Land-COALITION-TraderB-Action-EncounterInit</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[SetCustomStrings:true]
				[CustomStrings:EncounterType,Traveller]
				[CustomStrings:EncounterDisplayName,Trader]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
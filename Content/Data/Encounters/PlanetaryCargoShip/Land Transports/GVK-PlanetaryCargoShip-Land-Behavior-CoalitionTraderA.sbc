<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Route A, Crossroads to Sevastopol -->
		<!-- Transport Behavior for land rover following roads 
		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Behavior-TraderA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:CargoShip]
				[DialogueBanks:GVK-Travellers-COALITION-Medium.xml]
				[WeaponSystem:GVK-Universal-Weapons-All]
				[UsePlayerDistanceTimer:false]
				[PlayerDistanceTimerTrigger:3600]
				[PlayerDistanceTrigger:4000]
				[UseRetreatTimer:false]
				[RetreatTimerTrigger:3600]
				[UseNoTargetTimer:false]
				[RetreatDespawnDistance:3000]
				[AutopilotData:GVK-CargoShip-Land-COALITION-TraderPrimaryAutopilot]
				[SecondaryAutopilotData:GVK-CargoShip-Land-COALITION-TraderSecondaryAutopilot]
				[TertiaryAutopilotData:GVK-CargoShip-Land-COALITION-TransportTertiaryAutopilot]
				[TargetData:GVK-Universal-Target-COALITIONTradeStation]
				[OverrideTargetData:GVK-Universal-Target-Override]
				[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
				[Triggers:GVK-Universal-Trigger-IndestructibleOnSpawn]
				[Triggers:GVK-Universal-Trigger-TargetAttacker]
				[Triggers:GVK-Universal-Trigger-TurretTarget]
				[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TraderOnSpawn]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportAddWaypointsA]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportHorizonAngleHigh]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportArriveAtWaypoint]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportLeaveWaypoint]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TraderHeadToDespawn]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportBeaconDisabled]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportCompromised]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportDespawn]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TransportAttacked]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNear]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerStillNear]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TraderOutsideZone0]
				[Triggers:GVK-CargoShip-Land-COALITION-TraderA-Trigger-EncounterInit]
				[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
				[RemoteControlCode:COALITIONRouteA]
			</Description>
		</EntityComponent>
		<!-- Trader Transport Ship Autopilot-->
		<!-- Steering: the LAVWing recipe (Unit-All-Autopilot-LandWing.sbc explains it). MaxRotationStep 0.5 keeps the gyros at full strength; MaxRotationMagnitude sets the turn rate -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-TraderPrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[RotationMultiplierPitch:1]
				[RotationMultiplierYaw:3]
				[RotationMultiplierRoll:1.5]
				[LimitRotationSpeed:false]
				[MaxRotationMagnitude:0.5]
				[UseAircraftFlightModel:true]
				[MaxRotationStep:0.5]
				[DisableInertiaDampeners:true]
				[FlyLevelWithGravity:false]
				[LevelWithGravityWhenIdle:false]
				[IdealPlanetAltitude:17.5]
				[MinimumPlanetAltitude:0]
				[AltitudeTolerance:30]
				[UseSurfaceHoverThrustMode:true]
				[HoverPathStepDistance:100]
				[UseVelocityCollisionEvasion:false]
				[CollisionEvasionWaypointDistance:200]
				[CollisionEvasionResumeDistance:100]
				[CollisionEvasionResumeTime:10]
				[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
				[CollisionEvasionWaypointFromEntityMaxAngle:90]
				[WaypointAbandonTimeTrigger:60]
				[WaypointTolerance:95]
				[IdealMinSpeed:35]
				[IdealMaxSpeed:50]
				[MaxSpeedTolerance:10]
				[SlowDownOnWaypointApproach:true]
				[WaypointWaitTimeTrigger:120]
				[ExtraSlowDownDistance:300]
				[AngleAllowedForForwardThrust:45]
				[MaxVelocityAngleForSpeedControl:180]
				[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Secondary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-TraderSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[RotationMultiplier:0]
				[IdealPlanetAltitude:17.5]
				[WaypointTolerance:95]
				[IdealMinSpeed:0]
				[IdealMaxSpeed:0]
				[MaxSpeedTolerance:2]
				[UseProjectileLeadPrediction:false]
			</Description>
		</EntityComponent>
		<!-- Spawn announcement, shared by the Route A and Route B Traders. TraderDestination is set by each route's EncounterInit action. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TraderOnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1000]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TraderOnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TraderOnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Primary]
				[SetWeaponsToMaxRange:true]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-Land-COALITION-Chat-TraderOnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-TraderOnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:{Faction}]
				[Color:{PlayerRelation}]
				[ChatMessages:A Trader is en route from Crossroads to {TraderDestination}.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:999999]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to stop moving when player is near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNear</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:PlayerNear]
				[TargetDistance:300]
				[StartsReady:false]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10001]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TraderPlayerNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TraderPlayerNear</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[EnableBlocks:false]
				[EnableBlockNames:NPC Suspension]
				[EnableBlockStates:On]
				[TriggerTimerBlocks:true]
				[TimerBlockNames:NPC Timer E-brake]
				[EnableTriggers:true]
				[EnableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNear]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportHorizonAngleHigh]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-Land-COALITION-Chat-TraderPlayerNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-TraderPlayerNear</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:{Faction} Trader]
				[Color:{PlayerRelation}]
				[ChatMessages:Stopping for trade.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:false]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:1000]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to check if the player is still near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerStillNear</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:PlayerNear]
				[TargetDistance:300]
				[StartsReady:false]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10001]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TraderPlayerStillNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TraderPlayerStillNear</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[EnableTriggers:true]
				[EnableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear]
				[ResetCooldownTimeOfTriggers:true]
				[ResetTriggerCooldownNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to start moving when player is no longer near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Timer]
				[StartsReady:false]
				[MinCooldownMs:11000]
				[MaxCooldownMs:11001]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TraderPlayerNotNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TraderPlayerNotNear</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Primary]
				[EnableBlocks:true]
				[EnableBlockNames:NPC Suspension]
				[EnableBlockStates:Off]
				[TriggerTimerBlocks:true]
				[TimerBlockNames:NPC Timer Resume Cruise]
				[EnableTriggers:true]
				[EnableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportHorizonAngleHigh]
				[EnableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNear]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-Land-COALITION-Chat-TraderPlayerNotNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-TraderPlayerNotNear</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:{Faction} Trader]
				[Color:{PlayerRelation}]
				[ChatMessages:Resuming Route.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:false]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:1000]
			</Description>
		</EntityComponent>
		<!-- sequence to turn on weapons when leaving Z0 -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TraderOutsideZone0</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:OutsideZone]
				[ZoneName:Zone 0]
				[StartsReady:false]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10001]
				[MaxActions:2]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TraderOutsideZone0]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TraderOutsideZone0</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[EnableBlocks:true]
				[EnableBlockNames:NPC Weapon]
				[EnableBlockStates:On]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Transport to die, borrows most from EscortA -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportBeaconDisabled</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:true]
				[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefeatedCompromised]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportCompromised]
				[Actions:GVK-Universal-Action-EditableOnCompromised]
				[Actions:GVK-Universal-Action-Disabled]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportCompromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Compromised]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-Universal-Action-DefeatedCompromised]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportCompromised]
				[Actions:GVK-Universal-Action-EditableOnCompromised]
				[Actions:GVK-Universal-Action-Disabled]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TransportDespawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:DespawnMES]
				[DespawnTypeFromSpawner:Any]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TransportCompromised]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Transport departs to despawn waypoint (completed route) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TraderHeadToDespawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:BehaviorTriggerD]
				[MinCooldownMs:30000]
				[MaxCooldownMs:30000]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-CargoShip-Land-COALITION-Action-TraderHeadToDespawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TraderHeadToDespawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[RecalculateDespawnCoords:true]
				[TriggerTimerBlocks:true]
				[TimerBlockNames:NPC Timer E-brake]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-Land-COALITION-Chat-TraderHeadToDespawn]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportHorizonAngleHigh]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNear]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerStillNear]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportCompromised]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TransportDespawn]
				[EnableBlocks:true]
				[EnableBlockNames:NPC Beacon]
				[EnableBlockStates:Off]
				[StopAllRotation:true]
				[StopAllThrust:false]
				[RazeBlocksOfType:true]
				[RazeBlocksTypes:MyObjectBuilder_Beacon/SmallBlockBeacon]
				[RazeBlocksTypes:MyObjectBuilder_Beacon/LargeBlockBeacon]
				[RazeBlocksTypes:MyObjectBuilder_Beacon/SmallBlockBeacon_NPC]
				[RazeBlocksTypes:MyObjectBuilder_Beacon/LargeBlockBeacon_NPC]
				[RazeBlocksTypes:MyObjectBuilder_Beacon/SmallBlockBeacon_NPCNoConceal]
				[RazeBlocksTypes:MyObjectBuilder_Beacon/LargeBlockBeacon_NPCNoConceal]
				[ToggleBlocksOfType:true]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconSmall]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconLarge]
				[BlockTypeToggles:Off]
				[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-TraderHeadToDespawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:{Faction} Trader]
				[Color:{PlayerRelation}]
				[ChatMessages:Trade route complete.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:false]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-TraderA-Trigger-EncounterInit</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Session]
				[StartsReady:true]
				[MaxActions:-1]
				[ActionExecution:All]
				[Actions:GVK-CargoShip-Land-COALITION-TraderA-Action-EncounterInit]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-TraderA-Action-EncounterInit</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[SetCustomStrings:true]
				[CustomStrings:EncounterType,CargoShip]
				[CustomStrings:EncounterDisplayName,Trader]
				[CustomStrings:TraderDestination,Sevastopol]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[ActionExecution:All]
				[MinCooldownMs:5000]
				[MaxCooldownMs:5001]
				[Conditions:GVK-CargoShip-Land-COALITION-Condition-EscortSuccessA]
				[ConditionCheckResetsTimer:true]
				[Actions:GVK-CargoShip-Land-COALITION-Action-EscortSuccessA-Double]
			</Description>
		</EntityComponent>

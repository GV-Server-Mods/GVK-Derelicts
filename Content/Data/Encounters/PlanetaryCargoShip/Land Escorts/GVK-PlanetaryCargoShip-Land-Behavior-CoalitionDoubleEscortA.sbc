				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortAttacked]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortBeaconDisabled-A-Lead]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortCompromised-A-Lead]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortDespawn-A-Lead]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortDespawnMES-A-Lead]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortBeaconDisabled-A-Tail]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortCompromised-A-Tail]

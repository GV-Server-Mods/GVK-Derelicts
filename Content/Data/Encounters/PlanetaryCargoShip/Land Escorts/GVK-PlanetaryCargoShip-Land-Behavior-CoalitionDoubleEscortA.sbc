				[TertiaryAutopilotData:GVK-CargoShip-Land-COALITION-EscortTertiaryAutopilot]
				[TargetData:GVK-Universal-Target-COALITIONTradeStation]
				[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
				[Triggers:GVK-Universal-Trigger-EditableOnCompromised]
				[Triggers:GVK-Universal-Trigger-TargetAttacker]
				[Triggers:GVK-Universal-Trigger-TurretTarget]
				[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-ConvoyTailEscortOnSpawnA]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortAddWaypointsA]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortArriveAtWaypoint]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortLeaveWaypoint]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortBeaconDisabled-A]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortCompromised-A]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortDespawn-A]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortDespawnMES-A]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortAttacked]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerNear]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerStillNear]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerNotNear]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideCanyonZone]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortOutsideCanyonZone]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideZ1]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ1]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ1Canyon]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideZ2]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ2]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ2Canyon]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideZ3]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ3]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ3Canyon]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessTargetA]
				[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessCounterA]
				[RemoteControlCode:COALITIONRouteA]
			</Description>
		</EntityComponent>
		<!-- Escort chat when spawned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-ConvoyTailEscortOnSpawnA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1000]
				[ActionExecution:All]
				[Actions:GVK-CargoShip-Land-COALITION-Action-ConvoyTailEscortOnSpawnA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-ConvoyTailEscortOnSpawnA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[SetWeaponsToMaxRange:true]
				[ResetCounters:WaypointCounter]

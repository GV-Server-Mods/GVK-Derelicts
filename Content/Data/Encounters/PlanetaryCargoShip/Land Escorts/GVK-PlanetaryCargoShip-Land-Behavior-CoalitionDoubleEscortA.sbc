			</Description>
		</EntityComponent>
		<!-- Escort chat when spawned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-ConvoyLeadEscortOnSpawnA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1000]
				[ActionExecution:All]
				[Actions:GVK-CargoShip-Land-COALITION-Action-ConvoyLeadEscortOnSpawnA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-ConvoyLeadEscortOnSpawnA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[SetWeaponsToMaxRange:true]
				[ResetCounters:WaypointCounter]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-Land-COALITION-Chat-ConvoyLeadEscortOnSpawnA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-ConvoyLeadEscortOnSpawnA</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:{Faction}]
				[Color:{PlayerRelation}]
				[ChatMessages:A Convoy is ready for escort to Sevastopol (Very Difficult).]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:999999]
			</Description>
		</EntityComponent>

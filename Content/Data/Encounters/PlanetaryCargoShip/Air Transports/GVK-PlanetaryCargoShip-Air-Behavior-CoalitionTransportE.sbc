<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Route E, Aerial Crossroads to Skyport to Sevastapol -->
		<!-- This uses a SandboxCounter for its waypoint tracking. Only one of this behavior should ever be active at a time. 
		 	-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Behavior-TransportE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:CargoShip]
				[DialogueBanks:GVK-Travellers-COALITION-Medium.xml]
				[WeaponSystem:GVK-Universal-Weapons-All]
				[UsePlayerDistanceTimer:false]
				[PlayerDistanceTimerTrigger:3600]
				[PlayerDistanceTrigger:4000]
				[UseRetreatTimer:false]
				[RetreatTimerTrigger:3600]
				[UseNoTargetTimer:false]
				[RetreatDespawnDistance:3000]
				[AutopilotData:GVK-Transport-Air-COALITION-TransportPrimaryAutopilot]
				[SecondaryAutopilotData:GVK-Transport-Air-COALITION-TransportSecondaryAutopilot]
				[TargetData:GVK-Universal-Target-Sevastapol]
				[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
				[Triggers:GVK-Universal-Trigger-EditableOnCompromised]
				[Triggers:GVK-Universal-Trigger-TargetAttacker]
				[Triggers:GVK-Universal-Trigger-TurretTarget]
				[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportOnSpawnE]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportAddWaypointsE]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportArriveAtSkyport]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportArriveAtWaypoint]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportLeaveWaypoint]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportBeaconDisabled-E]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportCompromised-E]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportDespawn-E]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportAttacked]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportPlayerNear]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportPlayerStillNear]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportPlayerNotNear]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportInsideZ1]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportEnemySpawnsZ1]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportInsideZ2]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportEnemySpawnsZ2]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportInsideZ3]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportEnemySpawnsZ3]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportSuccessTargetE]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-TransportSuccessCounterE]
				[Triggers:GVK-Transport-Air-COALITION-Trigger-HeartbeatE]
				[Triggers:GVK-Transport-Air-COALITION-TransportE-Trigger-EncounterInit]
				[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
				[RemoteControlCode:COALITIONRouteE]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Primary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-TransportPrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[RotationMultiplier:0.75]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.25]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:true]
				[LevelWithGravityWhenIdle:true]
				[IdealPlanetAltitude:500]
				[MinimumPlanetAltitude:50]
				[AltitudeTolerance:100]
				[UseSurfaceHoverThrustMode:false]
				[HoverPathStepDistance:100]
				[UseVelocityCollisionEvasion:false]
				[CollisionEvasionWaypointDistance:200]
				[CollisionEvasionResumeDistance:100]
				[CollisionEvasionResumeTime:10]
				[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
				[CollisionEvasionWaypointFromEntityMaxAngle:90]
				[WaypointAbandonTimeTrigger:9999999]
				[WaypointTolerance:95]
				[IdealMinSpeed:35]
				[IdealMaxSpeed:50]
				[MaxSpeedTolerance:5]
				[SlowDownOnWaypointApproach:true]
				[WaypointWaitTimeTrigger:60]
				[ExtraSlowDownDistance:500]
				[AngleAllowedForForwardThrust:90]
				[MaxVelocityAngleForSpeedControl:1000]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Secondary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-TransportSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[RotationMultiplier:0.75]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.25]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:true]
				[LevelWithGravityWhenIdle:true]
				[IdealPlanetAltitude:500]
				[MinimumPlanetAltitude:50]
				[AltitudeTolerance:100]
				[UseSurfaceHoverThrustMode:false]
				[HoverPathStepDistance:100]
				[UseVelocityCollisionEvasion:false]
				[CollisionEvasionWaypointDistance:200]
				[CollisionEvasionResumeDistance:100]
				[CollisionEvasionResumeTime:10]
				[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
				[CollisionEvasionWaypointFromEntityMaxAngle:90]
				[WaypointAbandonTimeTrigger:9999999]
				[WaypointTolerance:95]
				[IdealMinSpeed:0]
				[IdealMaxSpeed:0]
				[MaxSpeedTolerance:0.25]
				[SlowDownOnWaypointApproach:true]
				[WaypointWaitTimeTrigger:9999999]
				[ExtraSlowDownDistance:500]
				[AngleAllowedForForwardThrust:90]
				[MaxVelocityAngleForSpeedControl:1000]
			</Description>
		</EntityComponent>
		<!-- Escort chat when spawned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Trigger-TransportOnSpawnE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1000]
				[ActionExecution:All]
				[Actions:GVK-Transport-Air-COALITION-Action-TransportOnSpawnE]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Action-TransportOnSpawnE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[SetWeaponsToMaxRange:true]
				[UseChatBroadcast:true]
				[ChatData:GVK-Transport-Air-COALITION-Chat-TransportOnSpawnE]
				[ResetSandboxCounters:SandboxCounter_WaypointRouteE]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Chat-TransportOnSpawnE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:{Faction}]
				[Color:{PlayerRelation}]
				[ChatMessages:An aerial transport is ready for escort to Skyport and Sevastapol (Difficult).]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:999999]
			</Description>
		</EntityComponent>
		<!-- Trigger to add waypoints after spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Trigger-TransportAddWaypointsE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:2]
				[MinCooldownMs:3000]
				[MaxCooldownMs:3001]
				[ActionExecution:All]
				[Actions:GVK-Transport-Air-COALITION-Action-TransportAddWaypointsE]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Action-TransportAddWaypointsE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[AddWaypoints:true]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE00]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE01]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE02]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE03]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE04]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE05]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE06]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE07]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE08]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE09]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE10]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE11]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE12]
				[UseChatBroadcast:true]
				[ChatData:GVK-Transport-Air-COALITION-Chat-TransportAddWaypointsE]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Chat-TransportAddWaypointsE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:false]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:Transport]
				[Color:White]
				[ChatMessages:Adding waypoints.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Transport to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Trigger-TransportBeaconDisabled-E</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:true]
				[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefeatedCompromised]
				[Actions:GVK-ConvoyContracts-Action-ConvoyLost-E]
				[Actions:GVK-Transport-Air-COALITION-Action-TransportCompromised]
				[Actions:GVK-Universal-Action-EditableOnCompromised]
				[Actions:GVK-Universal-Action-Disabled]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Trigger-TransportCompromised-E</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Compromised]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-Universal-Action-DefeatedCompromised]
				[Actions:GVK-ConvoyContracts-Action-ConvoyLost-E]
				[Actions:GVK-Transport-Air-COALITION-Action-TransportCompromised]
				[Actions:GVK-Universal-Action-EditableOnCompromised]
				[Actions:GVK-Universal-Action-Disabled]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Trigger-TransportDespawn-E</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:DespawnMES]
				[DespawnTypeFromSpawner:Any]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-ConvoyContracts-Action-ConvoyLost-E]
				[Actions:GVK-Transport-Air-COALITION-Action-TransportCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Action-TransportCompromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[TriggerTimerBlocks:true]
				[TimerBlockNames:NPC Timer E-brake]
				[EnableBlocks:true]
				[EnableBlockNames:NPC Suspension]
				[EnableBlockStates:Off]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportBeaconDisabled-E]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportCompromised-E]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportSuccessTargetE]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportSuccessCounterE]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportPlayerNear]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportPlayerNotNear]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportInsideZ1]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportEnemySpawnsZ1]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportInsideZ2]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportEnemySpawnsZ2]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportInsideZ3]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportEnemySpawnsZ3]
				[DisableTriggerNames:GVK-Transport-Air-COALITION-Trigger-TransportAttacked]
				[UseChatBroadcast:true]
				[ChatData:GVK-Transport-Air-COALITION-Chat-TransportCompromised]
				[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Chat-TransportCompromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:{Faction}]
				[Color:{PlayerRelation}]
				[ChatMessages:An air Transport has been Lost!]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Transport arrives at Skyport -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Trigger-TransportArriveAtSkyport</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:BehaviorTriggerA]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Conditions:GVK-Transport-Air-COALITION-Condition-TransportArriveAtSkyport]
				[Actions:GVK-Transport-Air-COALITION-Action-TransportArriveAtSkyport]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Condition-TransportArriveAtSkyport</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[CheckCustomSandboxCounters:true]
				[CustomSandboxCounters:SandboxCounter_WaypointRouteE]
				[CustomSandboxCountersTargets:5]
				[SandboxCounterCompareTypes:Equal]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Action-TransportArriveAtSkyport</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[CancelWaitingAtWaypoint:false]
				[SwitchToNextWaypoint:false]
				[IncreaseSandboxCounters:SandboxCounter_WaypointRouteE]
				[UseChatBroadcast:true]
				[ChatData:GVK-Transport-Air-COALITION-Chat-TransportArriveAtSkyport]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Chat-TransportArriveAtSkyport</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:{Faction} Aerial Escort]
				[Color:{PlayerRelation}]
				[ChatMessages:Arrived at Skyport. Heading to Sevastapol in 1 minute.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:false]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:5000]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Transport arrives at a Waypoint (except skyport) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Trigger-TransportArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:BehaviorTriggerA]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:-1]
				[Conditions:GVK-Transport-Air-COALITION-Condition-TransportArriveAtWaypoint]
				[Actions:GVK-Transport-Air-COALITION-Action-TransportArriveAtWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Condition-TransportArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[CheckCustomSandboxCounters:true]
				[CustomSandboxCounters:SandboxCounter_WaypointRouteE]
				[CustomSandboxCountersTargets:5]
				[SandboxCounterCompareTypes:NotEqual]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Action-TransportArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:EscortArriveAtWaypoint]
				[CancelWaitingAtWaypoint:true]
				[SwitchToNextWaypoint:false]
				[IncreaseSandboxCounters:SandboxCounter_WaypointRouteE]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Transport leaves a waypoint -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Trigger-TransportLeaveWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:BehaviorTriggerB]
				[UseTrigger:false]
				[StartsReady:true]
				[MaxActions:-1]
				[Actions:GVK-Transport-Air-COALITION-Action-TransportLeaveWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Action-TransportLeaveWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:EscortLeaveWaypoint]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when attacked -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Trigger-TransportAttacked</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Damage]
				[MinCooldownMs:120000]
				[MaxCooldownMs:240000]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:-1]
				[DamageTypes:Any]
				[ActionExecution:All]
				[Actions:GVK-Transport-Air-COALITION-Action-TransportAttacked]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Action-TransportAttacked</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[UseChatBroadcast:true]
				[ChatData:GVK-Transport-Air-COALITION-Chat-TransportAttacked]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Transport-Air-COALITION-Chat-TransportAttacked</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:{Faction}]
				[Color:{PlayerRelation}]
				[ChatMessages:Escort is under attack!]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence enemy spawns Zone 1-->

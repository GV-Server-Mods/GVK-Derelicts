<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Route E, Aerial Crossroads to Skyport to Sevastapol -->
		<!-- This uses a SandboxCounter for its waypoint tracking. Only one of this behavior should ever be active at a time. 
		 	TODO: This use of sandbox counter may no longer be needed since Tinsoldier fixed behavior counters not saving-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Behavior-EscortE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:CargoShip]
				[WeaponSystem:GVK-Universal-Weapons-All]
				[UsePlayerDistanceTimer:false]
				[PlayerDistanceTimerTrigger:3600]
				[PlayerDistanceTrigger:4000]
				[UseRetreatTimer:false]
				[RetreatTimerTrigger:3600]
				[UseNoTargetTimer:false]
				[RetreatDespawnDistance:3000]
				[AutopilotData:GVK-CargoShip-Air-COALITION-EscortPrimaryAutopilot]
				[SecondaryAutopilotData:GVK-CargoShip-Air-COALITION-EscortSecondaryAutopilot]
				[TargetData:GVK-Universal-Target-Sevastapol]
				[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
				[Triggers:GVK-Universal-Trigger-EditableOnCompromised]
				[Triggers:GVK-Universal-Trigger-TargetAttacker]
				[Triggers:GVK-Universal-Trigger-TurretTarget]
				[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortOnSpawnE]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortAddWaypointsE]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortArriveAtSkyport]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortArriveAtWaypoint]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortLeaveWaypoint]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortBeaconDisabled]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortCompromised]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortDespawn]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortDespawnMES]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortLostE]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortAttacked]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortPlayerNear]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortPlayerStillNear]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortPlayerNotNear]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortInsideZ1]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortEnemySpawnsZ1]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortInsideZ2]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortEnemySpawnsZ2]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortInsideZ3]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortEnemySpawnsZ3]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortSuccessTargetE]
				[Triggers:GVK-CargoShip-Air-COALITION-Trigger-EscortSuccessCounterE]
				[RemoteControlCode:COALITIONRouteE]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Primary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-EscortPrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[RotationMultiplier:0.75]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.25]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:true]
				[LevelWithGravityWhenIdle:true]
				[IdealPlanetAltitude:500]
				[MinimumPlanetAltitude:50]
				[AltitudeTolerance:100]
				[UseSurfaceHoverThrustMode:false]
				[HoverPathStepDistance:100]
				[UseVelocityCollisionEvasion:false]
				[CollisionEvasionWaypointDistance:200]
				[CollisionEvasionResumeDistance:100]
				[CollisionEvasionResumeTime:10]
				[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
				[CollisionEvasionWaypointFromEntityMaxAngle:90]
				[WaypointAbandonTimeTrigger:9999999]
				[WaypointTolerance:95]
				[IdealMinSpeed:35]
				[IdealMaxSpeed:50]
				[MaxSpeedTolerance:5]
				[SlowDownOnWaypointApproach:true]
				[WaypointWaitTimeTrigger:60]
				[ExtraSlowDownDistance:500]
				[AngleAllowedForForwardThrust:90]
				[MaxVelocityAngleForSpeedControl:1000]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Secondary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-EscortSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[RotationMultiplier:0.75]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.25]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:true]
				[LevelWithGravityWhenIdle:true]
				[IdealPlanetAltitude:500]
				[MinimumPlanetAltitude:50]
				[AltitudeTolerance:100]
				[UseSurfaceHoverThrustMode:false]
				[HoverPathStepDistance:100]
				[UseVelocityCollisionEvasion:false]
				[CollisionEvasionWaypointDistance:200]
				[CollisionEvasionResumeDistance:100]
				[CollisionEvasionResumeTime:10]
				[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
				[CollisionEvasionWaypointFromEntityMaxAngle:90]
				[WaypointAbandonTimeTrigger:9999999]
				[WaypointTolerance:95]
				[IdealMinSpeed:0]
				[IdealMaxSpeed:0]
				[MaxSpeedTolerance:0.25]
				[SlowDownOnWaypointApproach:true]
				[WaypointWaitTimeTrigger:9999999]
				[ExtraSlowDownDistance:500]
				[AngleAllowedForForwardThrust:90]
				[MaxVelocityAngleForSpeedControl:1000]
			</Description>
		</EntityComponent>
		<!-- Escort chat when spawned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Trigger-EscortOnSpawnE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1000]
				[ActionExecution:All]
				[Actions:GVK-CargoShip-Air-COALITION-Action-EscortOnSpawnE]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Action-EscortOnSpawnE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
				[SetWeaponsToMaxRange:true]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-Air-COALITION-Chat-EscortOnSpawnE]
				[ResetSandboxCounters:SandboxCounter_WaypointRouteE]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Chat-EscortOnSpawnE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:{Faction}]
				[Color:{PlayerRelation}]
				[ChatMessages:An aerial transport is ready for escort to Skyport and Sevastapol (Difficult).]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:999999]
			</Description>
		</EntityComponent>
		<!-- Trigger to add waypoints after spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Trigger-EscortAddWaypointsE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:2]
				[MinCooldownMs:3000]
				[MaxCooldownMs:3001]
				[ActionExecution:All]
				[Actions:GVK-CargoShip-Air-COALITION-Action-EscortAddWaypointsE]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Action-EscortAddWaypointsE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[AddWaypoints:true]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE00]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE01]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE02]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE03]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE04]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE05]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE06]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE07]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE08]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE09]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE10]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE11]
				[WaypointsToAdd:GVK-Convoy-WaypointStatic-AirRouteE12]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-Air-COALITION-Chat-EscortAddWaypointsE]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Chat-EscortAddWaypointsE</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:false]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:Cargo Ship]
				[Color:White]
				[ChatMessages:Adding waypoints.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Cargo Ship to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Trigger-EscortBeaconDisabled</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:true]
				[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-EscortMissions-Action-ConvoyLost-E]
				[Actions:GVK-CargoShip-Air-COALITION-Action-EscortCompromised]
				[Actions:GVK-Universal-Action-EditableOnCompromised]
				[Actions:GVK-Universal-Action-Disabled]
				[Actions:GVK-Universal-Action-LargeExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Trigger-EscortCompromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Compromised]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-EscortMissions-Action-ConvoyLost-E]
				[Actions:GVK-CargoShip-Air-COALITION-Action-EscortCompromised]
				[Actions:GVK-Universal-Action-EditableOnCompromised]
				[Actions:GVK-Universal-Action-Disabled]
				[Actions:GVK-Universal-Action-LargeExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Trigger-EscortDespawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Despawn]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-EscortMissions-Action-ConvoyLost-E]
				[Actions:GVK-CargoShip-Air-COALITION-Action-EscortCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Trigger-EscortDespawnMES</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:DespawnMES]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[ActionExecution:All]
				[Actions:GVK-EscortMissions-Action-ConvoyLost-E]
				[Actions:GVK-CargoShip-Air-COALITION-Action-EscortCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Action-EscortCompromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[TriggerTimerBlocks:true]
				[TimerBlockNames:NPC Timer E-brake]
				[EnableBlocks:true]
				[EnableBlockNames:NPC Suspension]
				[EnableBlockStates:Off]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortBeaconDisabled]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortCompromised]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortSuccessTargetE]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortSuccessCounterE]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortPlayerNear]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortPlayerNotNear]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortInsideZ1]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortEnemySpawnsZ1]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortInsideZ2]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortEnemySpawnsZ2]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortInsideZ3]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortEnemySpawnsZ3]
				[DisableTriggerNames:GVK-CargoShip-Air-COALITION-Trigger-EscortAttacked]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-Air-COALITION-Chat-EscortCompromised]
				[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Chat-EscortCompromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:{Faction}]
				[Color:{PlayerRelation}]
				[ChatMessages:Aerial escort has been Lost!]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship arrives at Skyport -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Trigger-EscortArriveAtSkyport</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:BehaviorTriggerA]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Conditions:GVK-CargoShip-Air-COALITION-Condition-EscortArriveAtSkyport]
				[Actions:GVK-CargoShip-Air-COALITION-Action-EscortArriveAtSkyport]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Condition-EscortArriveAtSkyport</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[CheckCustomSandboxCounters:true]
				[CustomSandboxCounters:SandboxCounter_WaypointRouteE]
				[CustomSandboxCountersTargets:5]
				[SandboxCounterCompareTypes:Equal]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Action-EscortArriveAtSkyport</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[CancelWaitingAtWaypoint:false]
				[SwitchToNextWaypoint:false]
				[IncreaseSandboxCounters:SandboxCounter_WaypointRouteE]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-Air-COALITION-Chat-EscortArriveAtSkyport]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Chat-EscortArriveAtSkyport</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:{Faction} Aerial Escort]
				[Color:{PlayerRelation}]
				[ChatMessages:Arrived at Skyport. Heading to Sevastapol in 1 minute.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:false]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:5000]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship arrives at a Waypoint (except skyport) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Trigger-EscortArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:BehaviorTriggerA]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:-1]
				[Conditions:GVK-CargoShip-Air-COALITION-Condition-EscortArriveAtWaypoint]
				[Actions:GVK-CargoShip-Air-COALITION-Action-EscortArriveAtWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Condition-EscortArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[CheckCustomSandboxCounters:true]
				[CustomSandboxCounters:SandboxCounter_WaypointRouteE]
				[CustomSandboxCountersTargets:5]
				[SandboxCounterCompareTypes:NotEqual]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Action-EscortArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:EscortArriveAtWaypoint]
				[CancelWaitingAtWaypoint:true]
				[SwitchToNextWaypoint:false]
				[IncreaseSandboxCounters:SandboxCounter_WaypointRouteE]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship leaves a waypoint -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Trigger-EscortLeaveWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:BehaviorTriggerB]
				[UseTrigger:false]
				[StartsReady:true]
				[MaxActions:-1]
				[Actions:GVK-CargoShip-Air-COALITION-Action-EscortLeaveWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Action-EscortLeaveWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:EscortLeaveWaypoint]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when attacked -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Air-COALITION-Trigger-EscortAttacked</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Damage]
				[MinCooldownMs:120000]
				[MaxCooldownMs:240000]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:-1]
				[DamageTypes:Any]
				[ActionExecution:All]

				[DisableTriggers:true]
				[DisableTriggerNames:GVK-Alliance-SupplyDepot-ManualTrigger-OwnerChangeChat-SOBAN]
				[UseChatBroadcast:true]
				[ChatData:GVK-Alliance-SupplyDepot-Chat-OwnerChangeChat]
			</Description>
		</EntityComponent>
		<!-- trigger to reset ownership to neutral if not in any Zone -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Trigger-ResetOwnership</SubtypeId>
			</Id>
			<Description>
				[MES AI Trigger]
				[UseTrigger:false]
				[Type:Timer]
				[MinCooldownMs:60000]
				[MaxCooldownMs:60001]
				[StartsReady:false]
				[Actions:GVK-Alliance-SupplyDepot-Action-OutsideAllZones]
				[Actions:GVK-Universal-Action-LargeExplosionEffects]
			</Description>
		</EntityComponent>
		<!-- Action for outside all zones to set color and ownership to neutral -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Action-OutsideAllZones</SubtypeId>
			</Id>
			<Description>
				[MES AI Action]
				[//DebugMessage:OutsideAllZones]
				[EnableTriggers:true]
				[EnableTriggerNames:GVK-Alliance-SupplyDepot-ManualTrigger-InsideZone-KHAANEPH]
				[EnableTriggerNames:GVK-Alliance-SupplyDepot-ManualTrigger-InsideZone-SOBAN]
				[EnableTriggerNames:GVK-Alliance-SupplyDepot-ManualTrigger-OwnerChangeChat-KHAANEPH]
				[EnableTriggerNames:GVK-Alliance-SupplyDepot-ManualTrigger-OwnerChangeChat-SOBAN]
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-Alliance-SupplyDepot-Trigger-ResetOwnership]
				[DisableTriggerNames:GVK-Alliance-SupplyDepot-Trigger-RequestFreighter-KHAANEPH]
				[DisableTriggerNames:GVK-Alliance-SupplyDepot-Trigger-RequestFreighter-SOBAN]
				[ManuallyActivateTrigger:true]
				[ManuallyActivatedTriggerNames:GVK-Alliance-SupplyDepot-ManualTrigger-DemandLost-KHAANEPH]
				[ManuallyActivatedTriggerNames:GVK-Alliance-SupplyDepot-ManualTrigger-DemandLost-SOBAN]
				[ChangeBlockOwnership:true]
				[OwnershipBlockNames:NPC Block]
				[OwnershipBlockFactions:UNKN]
				[OwnershipBlockNames:NPC Beacon]
				[OwnershipBlockFactions:UNKN]
				[OwnershipBlockNames:Supply Depot]
				[OwnershipBlockFactions:UNKN]
				[RecolorGrid:true]
				[OldBlockColors:{X:0.0583333336 Y:0.2 Z:-0.2}]
				[NewBlockColors:{X:0.0195 Y:-0.8 Z:-0.15}]
				[OldBlockColors:{X:0.158333331 Y:-0.48 Z:0.12}]
				[NewBlockColors:{X:0.075 Y:-0.8 Z:-0.02}]
				[OldBlockColors:{X:0.05 Y:0.1 Z:0.11}]
				[NewBlockColors:{X:0.803 Y:-0.8 Z:-0.3}]
				[OldBlockColors:{X:0.0194444451 Y:0.04 Z:0.38}]
				[NewBlockColors:{X:0.0195 Y:-0.8 Z:-0.15}]
				[OldBlockColors:{X:0.075 Y:-0.8 Z:0.32}]
				[NewBlockColors:{X:0.075 Y:-0.8 Z:-0.02}]
				[OldBlockColors:{X:0 Y:-0.8 Z:-0.3}]
				[NewBlockColors:{X:0.803 Y:-0.8 Z:-0.3}]
				[NewBlockSkins:Battered_Armor]
				[UseChatBroadcast:true]
				[ChatData:GVK-Alliance-SupplyDepot-Chat-OwnerLostChat]
			</Description>
		</EntityComponent>
		<!-- Freighter demand. A sandbox counter per faction, <FACTION>_DepotDemand, counts that faction's owned Supply Depots whose restock is due.
		     An owned depot adds 1 when it is captured and every 3 hours (10,800,000 ms) after its last restock, unless it already counted itself (grid boolean DemandRaised<FACTION>).
		     It takes its 1 back when a Freighter restocks it, when it changes hands or leaves every zone, or when it is destroyed or removed.
		     The Freighter dispatch event (GVK-Alliance-Events-Freighter.sbc) spawns a Freighter only while the counter is at least 1.
		     Owner<FACTION> are grid booleans: the zone currently covering this depot is that faction's. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Condition-OwnerKHAANEPH</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckTrueBooleans:true]
				[TrueBooleans:OwnerKHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Condition-DemandRaised-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckTrueBooleans:true]
				[TrueBooleans:DemandRaisedKHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Condition-DemandNotRaised-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckFalseBooleans:true]
				[FalseBooleans:DemandRaisedKHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Trigger-RequestFreighter-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[MinCooldownMs:10800000]
				[MaxCooldownMs:10800001]
				[UseTrigger:false]
				[StartsReady:true]
				[MaxActions:-1]
				[ActionExecution:All]
				[Conditions:GVK-Alliance-SupplyDepot-Condition-DemandNotRaised-KHAANEPH]
				[Actions:GVK-Alliance-SupplyDepot-Action-RequestFreighter-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Action-RequestFreighter-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:RequestFreighter-KHAANEPH]
				[SetBooleansTrue:DemandRaisedKHAANEPH]
				[IncreaseSandboxCounters:KHAANEPH_DepotDemand]
				[IncreaseSandboxCountersAmount:1]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Trigger-RestockClear-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:CommandReceived]
				[MinCooldownMs:30000]
				[MaxCooldownMs:30001]
				[UseTrigger:true]
				[StartsReady:true]
				[CommandReceiveCode:Freighter_RestockSupplyDepot]
				[MaxActions:-1]
				[ActionExecution:All]
				[Conditions:GVK-Alliance-SupplyDepot-Condition-OwnerKHAANEPH]
				[Actions:GVK-Alliance-SupplyDepot-Action-RestockClear-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Action-RestockClear-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:RestockClear-KHAANEPH]
				[ResetCooldownTimeOfTriggers:true]
				[ResetTriggerCooldownNames:GVK-Alliance-SupplyDepot-Trigger-RequestFreighter-KHAANEPH]
				[ManuallyActivateTrigger:true]
				[ManuallyActivatedTriggerNames:GVK-Alliance-SupplyDepot-ManualTrigger-DemandRelease-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-ManualTrigger-DemandRelease-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Manual]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:-1]
				[ActionExecution:All]
				[Conditions:GVK-Alliance-SupplyDepot-Condition-DemandRaised-KHAANEPH]
				[Actions:GVK-Alliance-SupplyDepot-Action-DemandRelease-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">

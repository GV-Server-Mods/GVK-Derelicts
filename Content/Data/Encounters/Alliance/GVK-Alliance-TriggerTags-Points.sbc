<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
		
		EncounterTypes:
		- Base:				50 points
		- Outpost:			10 points
		- Turret:			2 points
		- Cargo Ship:		10 points
		- Research Lab:		3 points
		- Elite Drones: 	15 points
		- Large Drones: 	4 points
		- Medium Drones: 	2 points
		- Small Drones: 	1 point
		
		Factions:
		- KHAANEPH
		- SOBAN
		
		IdsReplacer status (MES):
		- {Faction} IS supported in SandboxCounters (own faction) - Despawned/Awarded are consolidated.
		- Compromised still needs one pair per faction: SetSandboxCounter only substitutes {Faction},
		  there is no rival/opposing-faction token, so the transfer to the rival counter cannot be
		  expressed in a single faction-agnostic action. Revisit (GVK-Settings#665) when MES adds full IdsReplacer
		  (or {OpposingFaction}/CustomStrings support) to SetSandboxCounter.
		
		[Tags:GVK-Alliance-TriggerTags-PointsCompromised-{EncounterType}-{Faction}]
		[Tags:GVK-Alliance-TriggerTags-PointsDespawned-{EncounterType}]
		[Tags:GVK-Alliance-TriggerTags-PointsAwarded-{EncounterType}]
		
		Notes:
			- Drones don't have deduct points on despawn.
			- ResearchLab only has PointsAwarded
			- All check if previously damaged by an enemy or neutral player.

		-->

		<!-- Base -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-TriggerTags-PointsCompromised-AllianceBase-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Tags:GVK-Alliance-TriggerTags-PointsCompromised-AllianceBase-KHAANEPH]
				[Type:Manual]
				[StartsReady:true]
				[Conditions:GVK-Universal-Condition-DamagedByNonFriendlyPlayer]
				[ActionExecution:All]
				[Actions:GVK-Alliance-Action-PointsCompromised-AllianceBase-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Action-PointsCompromised-AllianceBase-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[MES AI Action]
				[//DebugMessage:PointsCompromised-AllianceBase-KHAANEPH]
				[SetCustomStrings:true]
				[CustomStrings:DecreaseFactionName,KHAANEPH]
				[CustomStrings:IncreaseFactionName,SOBAN]
				[CustomStrings:DecreaseFactionAmount,50]
				[CustomStrings:IncreaseFactionAmount,50]
				[DecreaseSandboxCounters:KHAANEPH_Points]
				[DecreaseSandboxCountersAmount:50]
				[IncreaseSandboxCounters:SOBAN_Points]
				[IncreaseSandboxCountersAmount:50]
				[UseChatBroadcast:true]
				[ChatData:GVK-Alliance-Chat-PointsAdjustCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-TriggerTags-PointsDespawned-AllianceBase</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]

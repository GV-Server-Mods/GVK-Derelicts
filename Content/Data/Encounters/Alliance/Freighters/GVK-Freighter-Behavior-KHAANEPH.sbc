<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Freighter Behavior for trade station routes-->
		<!-- 
		
		1. An owned Supply Depot that is due a restock adds 1 to <FACTION>_DepotDemand (GVK-Alliance-TriggerGroup-SupplyDepotZone.sbc)
2. The dispatch event (GVK-Alliance-Events-Freighter.sbc) spawns one Freighter every 3 hours while that counter is at least 1
3. Freighter asks for waypoints, close range then long range; every depot that is due answers with its waypoint, and up to 4 are queued
4. Freighter visits them in the order they answered, announces itself, and at each one sends a command that restocks that depot
5. A restocked depot takes its 1 off the counter; after the last depot the Freighter returns to HQ, then despawns

Notes:
		 - Only 1 Freighter per faction at a time (spawn condition: remote control code Freighter_<FACTION> with an unlimited minimum distance)
		 - Cargo ship spawns enemies based on nearby player rep. If allied then spawn opposite enemies.
		 - WaypointNear and WaypointFar are broken and break all other triggers (GVK-Settings#450). Workaround is to use 
		   TargetNear and TargetFar with a target profile for Supply Depots. This inhibits the use of 
		   SendTargets trigger groups and targeting of player grids.
		
		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Behavior</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:CargoShip]
				[DialogueBanks:GVK-Travellers-KHAANEPH-Medium.xml]
				[UsePlayerDistanceTimer:false]
				[UseRetreatTimer:false]
				[UseNoTargetTimer:false]
				[RetreatDespawnDistance:4000]
				[AutopilotData:GVK-Freighter-KHAANEPH-PrimaryAutopilot]
				[SecondaryAutopilotData:GVK-Freighter-KHAANEPH-SecondaryAutopilot]
				[TargetData:GVK-Universal-Target-SupplyDepot]
				[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
				[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
				[Triggers:GVK-Universal-Trigger-EditableOnCompromised]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-Init]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-RequestNearWaypoint]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-RequestFarWaypoint]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-AddHQWaypoint]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-ReceiveWaypoint]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-ArriveAtWaypoint]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-LeaveWaypoint]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-HeadToDespawn]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-Defenses]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-Attackers]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-LongWait]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-CargoCache]
				[//Triggers:GVK-Freighter-KHAANEPH-Trigger-WaypointNear]
				[//Triggers:GVK-Freighter-KHAANEPH-Trigger-WaypointFar]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-TargetNear]
				[Triggers:GVK-Freighter-KHAANEPH-Trigger-TargetFar]
				[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
				[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
				[RemoteControlCode:Freighter_KHAANEPH]
			</Description>
		</EntityComponent>
		<!-- Freighter Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-PrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:true]
				[RotationMultiplier:0.3]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:true]
				[LevelWithGravityWhenIdle:true]
				[IdealPlanetAltitude:2000]
				[MinimumPlanetAltitude:1500]
				[AltitudeTolerance:100]
				[MinAngleForLeveledDescent:150]
				[MaxAngleForLeveledAscent:180]
				[MaxVerticalSpeed:20]
				[IdealMinSpeed:50]
				[IdealMaxSpeed:60]
				[MaxSpeedTolerance:10]
				[SlowDownOnWaypointApproach:true]
				[WaypointWaitTimeTrigger:30]
				[ExtraSlowDownDistance:1000]
				[WaypointTolerance:100]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.5]
				[ReverseOffsetDistAltAboveHeight:false]
				[ReverseOffsetHeight:0]
				[AngleAllowedForForwardThrust:45]
				[MaxVelocityAngleForSpeedControl:89]
			</Description>
		</EntityComponent>
		<!-- Freighter Autopilot Secondary -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-SecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:true]
				[RotationMultiplier:0.3]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:true]
				[LevelWithGravityWhenIdle:true]
				[IdealPlanetAltitude:100]
				[MinimumPlanetAltitude:50]
				[AltitudeTolerance:20]
				[MinAngleForLeveledDescent:0]
				[MaxAngleForLeveledAscent:180]
				[MaxVerticalSpeed:20]
				[IdealMinSpeed:20]
				[IdealMaxSpeed:50]
				[MaxSpeedTolerance:5]
				[SlowDownOnWaypointApproach:true]
				[WaypointWaitTimeTrigger:30]
				[ExtraSlowDownDistance:500]
				[WaypointTolerance:100]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.5]
				[ReverseOffsetDistAltAboveHeight:false]
				[ReverseOffsetHeight:0]
				[AngleAllowedForForwardThrust:30]
				[MaxVelocityAngleForSpeedControl:89]
			</Description>
		</EntityComponent>
		<!-- Trigger when Freighter Spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Trigger-Init</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1000]
				[Actions:GVK-Freighter-KHAANEPH-Action-Init]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Action-Init</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetCustomStrings:true]
				[CustomStrings:EncounterType,CargoShip]
				[CustomStrings:EncounterDisplayName,Freighter]
				[SetBooleansTrue:GVK_MobilityType_Aircraft]
				[UseChatBroadcast:true]
				[ChatData:GVK-Freighter-KHAANEPH-Chat-Init]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Chat-Init</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:KHAANEPH]
				[Color:{PlayerRelation}]
				[ChatMessages:A Supply Depot shipment is en route.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Freighter Spawns to request near waypoint -->

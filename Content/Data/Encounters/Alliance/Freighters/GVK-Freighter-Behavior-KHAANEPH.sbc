		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Spawner-Attackers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[ProcessAsAdminSpawn:false]
				[MaxSpawns:6]
				[SpawnGroups:GVK-Unit-Defense-SpawnGroup-SOBAN-StrikeFighterSquad]
				[MinDistance:500]
				[MaxDistance:700]
				[MinAltitude:50]
				[MaxAltitude:200]
				[InheritNpcAltitude:true]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<!-- Just in case it gets stuck somewhere, should be longer than the autopilot waypoint wait time -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Trigger-LongWait</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:-1]
				[MinCooldownMs:120000]
				[MaxCooldownMs:120000]
				[Conditions:GVK-Freighter-KHAANEPH-Condition-LongWait]
				[ConditionCheckResetsTimer:true]
				[Actions:GVK-Freighter-KHAANEPH-Action-LongWait]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Condition-LongWait</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckGridSpeed:true]
				[MinGridSpeed:0]
				[MaxGridSpeed:5]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Action-LongWait</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:LongWait HeadToDespawn]
				[Chance:100]
				[Retreat:true]
				[RecalculateDespawnCoords:true]
				[UseChatBroadcast:true]
				[ChatData:GVK-Freighter-KHAANEPH-Chat-HeadToDespawn]
			</Description>
		</EntityComponent>
		<!-- WaypointNear/WaypointFar trigger types are broken (crash CargoShipWaypoints indexing; GVK-Settings#450) -->
		<!-- Using Supply Depot as target since WaypointNear/Far are broken (GVK-Settings#450) -->
		<!-- Trigger sequence when Freighter is near the Target to switch to secondary autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Trigger-TargetNear</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:TargetNear]
				[TargetDistance:2999]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10001]
				[StartsReady:true]
				[MaxActions:-1]
				[Actions:GVK-Freighter-KHAANEPH-Action-TargetNear]
				[ToggleWithTriggerProfile:GVK-Freighter-KHAANEPH-Trigger-TargetFar]
				[ToggledProfileResetsCooldown:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Action-TargetNear</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:TargetNear]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Secondary]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Freighter is far from the Target to switch to Primary autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Trigger-TargetFar</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:TargetFar]
				[TargetDistance:3000]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10001]
				[StartsReady:true]
				[MaxActions:-1]
				[Actions:GVK-Freighter-KHAANEPH-Action-TargetFar]
				[ToggleWithTriggerProfile:GVK-Freighter-KHAANEPH-Trigger-TargetNear]
				[ToggledProfileResetsCooldown:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Action-TargetFar</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:TargetFar]
				[ChangeAutopilotProfile:true]
				[AutopilotProfile:Primary]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence to deploy CargoCache2x if compromised -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Trigger-CargoCache</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Tags:GVK-Universal-TriggerTags-Compromised]
				[Type:Manual]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-Freighter-KHAANEPH-Action-CargoCache]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Action-CargoCache</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[//DebugMessage:CargoCache]
				[SpawnEncounter:true]
				[Spawner:GVK-Freighter-KHAANEPH-Spawner-CargoCache]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Spawner-CargoCache</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[ProcessAsAdminSpawn:false]
				[MaxSpawns:1]
				[ForceSameFactionOwnership:true]
				[SpawnGroups:GVK-Other-Loot-SpawnGroup-COALITION-CargoCache2x]
				[SpawnGroups:GVK-Other-Loot-SpawnGroup-COALITION-AmmoCache]
				[MinDistance:50]
				[MaxDistance:100]
				[MinAltitude:10]
				[MaxAltitude:50]
				[InheritNpcAltitude:true]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Trigger-ArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:BehaviorTriggerA]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:-1]
				[Actions:GVK-Freighter-KHAANEPH-Action-ArriveAtWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Freighter-KHAANEPH-Action-ArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>

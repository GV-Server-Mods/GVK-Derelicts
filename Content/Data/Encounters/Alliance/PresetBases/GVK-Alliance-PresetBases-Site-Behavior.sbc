<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
		Base Site grid (NST [UNKN] Base Site): runs the site's contract board (GVK-Settings#653, contracts in GVK-Alliance-PresetBases-Contracts.sbc).
		State is local to each Base Site: which alliance's Base stands here, the 2-hour lock after a kill, the 20-minute turret
		and 2-hour restore cooldowns, a Turret being placed, the standing Defense Turret count (re-counted by a roll call every
		minute), whether players hostile to each alliance are within 2 km, and whether the site is inside each alliance's
		Territory (an alliance's Claim shows only while it is).
		Every change re-applies the one board profile that matches the new state. A contract the state blocks shows as a
		stand-in that names the reason and can't be accepted.
		The Base reports to its Base Site with commands (GVK-Alliance-PresetBases-BaseSite.sbc). Design: Docs/design/preset-bases.md.
		-->
		<!-- =================================================== -->
		<!-- BASE SITE BEHAVIOR                                  -->
		<!-- =================================================== -->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Site-Behavior</SubtypeId>
			</Id>
			<Description>
				[MES AI Behavior]
				[BehaviorName:Passive]
				[UseRetreatTimer:false]
				[UseNoTargetTimer:false]
				[UsePlayerDistanceTimer:false]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-Session]

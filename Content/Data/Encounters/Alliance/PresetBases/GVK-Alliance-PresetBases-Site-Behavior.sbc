		<!-- =================================================== -->
		<!-- CONTRACTS ACCEPTED ON THIS BASE SITE'S BOARD        -->
		<!-- =================================================== -->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Site-Trigger-Claim-SOBAN</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:CommandReceived]
				[StartsReady:true]
				[CommandReceiveCode:GVK-BaseSite-Board-Claim-SOBAN]
				[MaxActions:-1]
				[Conditions:GVK-Alliance-PresetBases-Site-Condition-CanClaim-SOBAN]
				[ActionExecution:All]
				[Actions:GVK-Alliance-PresetBases-Site-Action-Claim-SOBAN]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Site-Condition-CanClaim-SOBAN</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckFalseBooleans:true]
				[FalseBooleans:GVK_Site_Base_SOBAN]
				[FalseBooleans:GVK_Site_Base_KHAANEPH]
				[FalseBooleans:GVK_Site_KillLock]
				[FalseBooleans:GVK_Site_ClaimPending]
				[FalseBooleans:GVK_Site_HostileNear_SOBAN]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Site-Action-Claim-SOBAN</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[SpawnEncounter:true]
				[Spawner:GVK-Alliance-PresetBases-Spawner-Base-SOBAN]
				[SetBooleansTrue:GVK_Site_ClaimPending]
				[SetBooleansFalse:GVK_Site_TurretCooling]
				[SetBooleansFalse:GVK_Site_RestoreCooling]
				[ResetCounters:GVK_Site_Turrets]
				[ResetCooldownTimeOfTriggers:true]
				[ResetTriggerCooldownNames:GVK-Alliance-PresetBases-Site-Trigger-ClaimPendingEnd]
				[ManuallyActivateTrigger:true]
				[ManuallyActivatedTriggerTags:GVK-Alliance-PresetBases-TriggerTags-RefreshBoard]
			</Description>
		</EntityComponent>


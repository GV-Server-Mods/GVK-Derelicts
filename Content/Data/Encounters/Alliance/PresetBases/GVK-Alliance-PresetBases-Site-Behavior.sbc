<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
		Base Site grid (NST [UNKN] Base Site): runs the site's contract board (GVK-Settings#653, contracts in GVK-Alliance-PresetBases-Contracts.sbc).
		State is local to each Base Site: which alliance's Base stands here, the 2-hour lock after a kill, the 20-minute turret
		and 2-hour restore cooldowns, the standing Defense Turret count, whether players hostile to each alliance are
		within 5 km, and whether the site is inside each alliance's Territory (an alliance's Claim shows only while it is).
		Every change re-applies the one board profile that matches the new state.
		The Base reports to its Base Site with commands (GVK-Alliance-PresetBases-BaseSite.sbc). Design: Docs/design/preset-bases.md.
		-->
		<!-- =================================================== -->
		<!-- BASE SITE BEHAVIOR                                  -->
		<!-- =================================================== -->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Site-Behavior</SubtypeId>
			</Id>
			<Description>
				[MES AI Behavior]
				[BehaviorName:Passive]
				[UseRetreatTimer:false]
				[UseNoTargetTimer:false]
				[UsePlayerDistanceTimer:false]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-Session]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-PeriodicRefresh]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-BaseKilled]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-BaseGone]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-BaseWatchdog]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-TurretUp]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-TurretLost]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-LockEnd]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-ClaimPendingEnd]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-TurretCoolEnd]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-RestoreCoolEnd]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-Claim-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-Turret-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-Restore-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-BaseUp-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-BaseAlive-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-HostileArrived-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-HostileStillNear-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-HostileClear-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-EnterTerritory-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-LeaveTerritory-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-BoardUsed-Claim-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-BoardUsed-Turret-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-BoardUsed-Restore-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-Claim-KHAANEPH]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-Turret-KHAANEPH]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-Restore-KHAANEPH]
				[Triggers:GVK-Alliance-PresetBases-Site-Trigger-BaseUp-KHAANEPH]

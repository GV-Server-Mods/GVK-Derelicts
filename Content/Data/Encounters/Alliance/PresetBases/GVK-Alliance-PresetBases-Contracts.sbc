<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
		Alliance Base Site contract board (GVK-Settings#653).
		The Base Site's contract block (named "NPC Contracts") shows free contracts: Claim Base Site, Deploy Defense Turret and
		Restore Base. Accepting one sends a command to that Base Site, which does the work and keeps the site's state; the
		contract then succeeds. The Base Site picks which board profile to show (GVK-Alliance-PresetBases-Site-Behavior.sbc).
		Design and reasons: Docs/design/preset-bases.md.
		-->
		<!-- =================================================== -->
		<!-- PLAYER CONDITIONS                                   -->
		<!-- =================================================== -->

		<!-- Friendly standing with SOBAN: the only players who can accept its contracts -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-PlayerCondition-FriendlySOBAN</SubtypeId>
			</Id>
			<Description>
				[MES Player Condition]
				[CheckPlayerReputation:true]
				[CheckReputationwithFaction:SOBAN]
				[MinPlayerReputation:500]
				[MaxPlayerReputation:1500]
			</Description>
		</EntityComponent>

		<!-- Hostile to SOBAN (reputation below 0): blocks SOBAN contracts within 2 km -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-PlayerCondition-HostileSOBAN</SubtypeId>
			</Id>
			<Description>
				[MES Player Condition]
				[CheckPlayerReputation:true]
				[CheckReputationwithFaction:SOBAN]
				[MinPlayerReputation:-1500]
				[MaxPlayerReputation:-1]
			</Description>
		</EntityComponent>

		<!-- Friendly standing with KHAANEPH: the only players who can accept its contracts -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-PlayerCondition-FriendlyKHAANEPH</SubtypeId>
			</Id>
			<Description>
				[MES Player Condition]
				[CheckPlayerReputation:true]
				[CheckReputationwithFaction:KHAANEPH]
				[MinPlayerReputation:500]
				[MaxPlayerReputation:1500]
			</Description>
		</EntityComponent>

		<!-- Hostile to KHAANEPH (reputation below 0): blocks KHAANEPH contracts within 2 km -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-PlayerCondition-HostileKHAANEPH</SubtypeId>
			</Id>
			<Description>
				[MES Player Condition]
				[CheckPlayerReputation:true]
				[CheckReputationwithFaction:KHAANEPH]
				[MinPlayerReputation:-1500]
				[MaxPlayerReputation:-1]
			</Description>
		</EntityComponent>

		<!-- Nobody passes: the condition for stand-in contracts -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-PlayerCondition-Never</SubtypeId>
			</Id>
			<Description>
				[MES Player Condition]
				[CheckPlayerTags:true]
				[IncludedPlayerTags:GVK-BaseSite-StandIn]
			</Description>
		</EntityComponent>

		<!-- =================================================== -->
		<!-- MISSIONS (free: no reward, no collateral)           -->
		<!-- =================================================== -->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Mission-Claim-SOBAN</SubtypeId>
			</Id>
			<Description>
				[MES Mission]
				[MissionType:Custom]
				[Title:Claim Base Site - SOBAN]
				[Description:Deploy a SOBAN Base at this site. Open to players in Friendly standing with SOBAN, while this site is inside SOBAN territory. Adds 50 Influence to SOBAN.]
				[Reward:0]
				[Collateral:0]
				[ReputationReward:0]
				[FailReputationPrice:0]
				[OverrideFaction:SOBAN]
				[SoloMission:true]
				[LeadPlayerConditionIds:GVK-Alliance-PresetBases-PlayerCondition-FriendlySOBAN]
				[InstanceEventGroupId:GVK-Alliance-PresetBases-TemplateGroup-Contract]
				[ReplaceKeys:{BoardCode}]
				[ReplaceValues:GVK-BaseSite-Board-Claim-SOBAN]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Mission-Claim-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[MES Mission]
				[MissionType:Custom]
				[Title:Claim Base Site - KHAANEPH]
				[Description:Deploy a KHAANEPH Base at this site. Open to players in Friendly standing with KHAANEPH, while this site is inside KHAANEPH territory. Adds 50 Influence to KHAANEPH.]
				[Reward:0]
				[Collateral:0]
				[ReputationReward:0]
				[FailReputationPrice:0]
				[OverrideFaction:KHAANEPH]
				[SoloMission:true]
				[LeadPlayerConditionIds:GVK-Alliance-PresetBases-PlayerCondition-FriendlyKHAANEPH]
				[InstanceEventGroupId:GVK-Alliance-PresetBases-TemplateGroup-Contract]
				[ReplaceKeys:{BoardCode}]
				[ReplaceValues:GVK-BaseSite-Board-Claim-KHAANEPH]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Mission-Turret-SOBAN</SubtypeId>
			</Id>
			<Description>
				[MES Mission]
				[MissionType:Custom]
				[Title:Deploy Defense Turret - SOBAN]
				[Description:Places one SOBAN Defense Turret around the Base at this site. One every 20 minutes, counted from when the last one was placed, up to 4 standing.]
				[Reward:0]
				[Collateral:0]
				[ReputationReward:0]
				[FailReputationPrice:0]
				[OverrideFaction:SOBAN]
				[SoloMission:true]
				[LeadPlayerConditionIds:GVK-Alliance-PresetBases-PlayerCondition-FriendlySOBAN]
				[InstanceEventGroupId:GVK-Alliance-PresetBases-TemplateGroup-Contract]
				[ReplaceKeys:{BoardCode}]
				[ReplaceValues:GVK-BaseSite-Board-Turret-SOBAN]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Mission-Turret-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[MES Mission]
				[MissionType:Custom]
				[Title:Deploy Defense Turret - KHAANEPH]
				[Description:Places one KHAANEPH Defense Turret around the Base at this site. One every 20 minutes, counted from when the last one was placed, up to 4 standing.]
				[Reward:0]
				[Collateral:0]
				[ReputationReward:0]
				[FailReputationPrice:0]
				[OverrideFaction:KHAANEPH]
				[SoloMission:true]

				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Mission-ClaimHostile-SOBAN</SubtypeId>
			</Id>
			<Description>
				[MES Mission]
				[MissionType:Custom]
				[Title:Claim Base Site - SOBAN (hostile player nearby)]
				[Description:Unavailable while a player hostile to SOBAN is within 2 km of this site. This contract can't be accepted.]
				[Reward:0]
				[Collateral:0]

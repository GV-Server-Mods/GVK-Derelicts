<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
		Base Site, Base and Defense Turret side (GVK-Settings#653). Each Base behavior adds its alliance's Base trigger group,
		each Turret behavior its Turret trigger group.
		- Base: +50 Influence once when it first spawns, a report to its Base Site every 5 minutes, Defense Turrets and Restore on
		  the Base Site's orders, and a report when it is killed or despawned (its Defense Turrets despawn with it).
		- A kill costs its alliance 50 Influence even when no enemy or neutral player damaged it (closes the claim-and-kill farm).
		- Defense Turret: reports to its parent Base when it spawns, when it is lost and at each roll call; the Base relays all
		  three to the Base Site.
		Base Site side: GVK-Alliance-PresetBases-Site-Behavior.sbc. Design: Docs/design/preset-bases.md.
		-->
		<!-- =================================================== -->
		<!-- BASE TRIGGER GROUPS (one per alliance)              -->
		<!-- =================================================== -->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-TriggerGroup-SOBAN</SubtypeId>
			</Id>
			<Description>
				[RivalAI TriggerGroup]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-Claimed-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-Heartbeat-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-SpawnDefenseTurret-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-Killed-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-FriendlyKill-SOBAN]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-Restore]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-Gone]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-RelayTurretUp]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-RelayTurretLost]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-RelayTurretHere]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-RollCall]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-TriggerGroup-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[RivalAI TriggerGroup]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-Claimed-KHAANEPH]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-Heartbeat-KHAANEPH]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-SpawnDefenseTurret-KHAANEPH]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-Killed-KHAANEPH]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-FriendlyKill-KHAANEPH]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-Restore]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-Gone]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-RelayTurretUp]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-RelayTurretLost]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-RelayTurretHere]
				[Triggers:GVK-Alliance-PresetBases-Base-Trigger-RollCall]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-Condition-NotClaimed</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckFalseBooleans:true]
				[FalseBooleans:GVK_Site_Claimed]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-Condition-Standing</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckFalseBooleans:true]
				[FalseBooleans:GVK_Site_BaseKilled]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-Condition-NotDamagedByNonFriendlyPlayer</SubtypeId>
			</Id>
			<Description>
				[RivalAI Condition]
				[UseConditions:true]
				[MatchAnyCondition:false]
				[CheckFalseBooleans:true]
				[FalseBooleans:DamagedByNeutralPlayer]
				[FalseBooleans:DamagedByEnemyPlayer]
			</Description>
		</EntityComponent>

		<!-- =================================================== -->
		<!-- CLAIM: +50 INFLUENCE ONCE, THEN REPORT EVERY 5 MINUTES -->
		<!-- =================================================== -->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-Trigger-Claimed-SOBAN</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Session]
				[StartsReady:true]
				[MaxActions:-1]
				[Conditions:GVK-Alliance-PresetBases-Base-Condition-NotClaimed]
				[ActionExecution:All]
				[Actions:GVK-Alliance-PresetBases-Base-Action-Claimed-SOBAN]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-Action-Claimed-SOBAN</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[SetBooleansTrue:GVK_Site_Claimed]
				[SetCustomStrings:true]
				[CustomStrings:IncreaseFactionName,SOBAN]
				[CustomStrings:IncreaseFactionAmount,50]
				[IncreaseSandboxCounters:SOBAN_Influence]
				[IncreaseSandboxCountersAmount:50]
				[UseChatBroadcast:true]
				[ChatData:GVK-Alliance-Chat-InfluenceAdjustAwarded]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-Trigger-Heartbeat-SOBAN</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:Timer]
				[StartsReady:true]
				[MinCooldownMs:300000]
				[MaxCooldownMs:300001]
				[MaxActions:-1]
				[Conditions:GVK-Alliance-PresetBases-Base-Condition-Standing]
				[ActionExecution:All]
				[Actions:GVK-Alliance-PresetBases-Base-Action-Heartbeat-SOBAN]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-Action-Heartbeat-SOBAN</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[BroadcastCommandProfiles:true]
				[CommandProfileIds:GVK-Alliance-PresetBases-Base-Command-BaseUp-SOBAN]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-Command-BaseUp-SOBAN</SubtypeId>
			</Id>
			<Description>
				[RivalAI Command]
				[CommandCode:GVK-BaseSite-BaseUp-SOBAN]
				[MatchSenderReceiverOwners:false]
				[IgnoreAntennaRequirement:true]
				[IgnoreReceiverAntennaRequirement:true]
				[Radius:1100]

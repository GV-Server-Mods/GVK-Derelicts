				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-Trigger-Restore</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Type:CommandReceived]
				[StartsReady:true]
				[CommandReceiveCode:GVK-BaseSite-RestoreBase]
				[MaxActions:-1]
				[Conditions:GVK-Alliance-PresetBases-Base-Condition-Standing]
				[ActionExecution:All]
				[Actions:GVK-Alliance-PresetBases-Base-Action-Restore]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-Action-Restore</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[RepairBlocks:true]
				[RepairBlocksIncludeSubgrids:true]
				[MaxProjectedBlocksToBuild:100000]
				[ToggleBlocksOfType:true]
				[BlockTypesToToggle:MyObjectBuilder_SafeZoneBlock/SafeZoneBlockNPC]
				[BlockTypeToggles:On]
				[UseChatBroadcast:true]
				[ChatData:GVK-Alliance-PresetBases-Base-Chat-Restored]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-Chat-Restored</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:Sensors]
				[Color:Blue]
				[ChatMessages:Repair crews have restored the Base. Destroyed blocks stay lost.]
				[ChatAudio:ArcHudSensors]
				[BroadcastChatType:Chat]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:5000]
			</Description>
		</EntityComponent>


<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- =================================================== -->
		<!-- PRESET BASES - COMBAT BASE SPAWN CONDITIONS         -->
		<!-- =================================================== -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-SpawnCondition-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[MES Spawn Conditions]
				[RivalAiAnySpawn:true]
				[FactionOwner:KHAANEPH]
				[ForceStaticGrid:true]
				[SkipVoxelSpawnChecks:true]
				[SkipGridSpawnChecks:true]
				[SkipAirDensityCheck:true]
				[SkipTerrainCheck:true]
				[UseRemoteControlCodeRestrictions:true]
				[RemoteControlCode:GVK-Alliance-Encounter]
				[RemoteControlCodeMinDistance:4500]
				[RemoteControlCodeMaxDistance:-1]
				[SandboxVariables:MediumWrecksEnabled]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-PresetBases-Base-SpawnCondition-SOBAN</SubtypeId>
			</Id>
			<Description>
				[MES Spawn Conditions]
				[RivalAiAnySpawn:true]
				[FactionOwner:SOBAN]
				[ForceStaticGrid:true]
				[SkipVoxelSpawnChecks:true]
				[SkipGridSpawnChecks:true]
				[SkipAirDensityCheck:true]
				[SkipTerrainCheck:true]
				[UseRemoteControlCodeRestrictions:true]
				[RemoteControlCode:GVK-Alliance-Encounter]
				[RemoteControlCodeMinDistance:4500]
				[RemoteControlCodeMaxDistance:-1]
				[SandboxVariables:MediumWrecksEnabled]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
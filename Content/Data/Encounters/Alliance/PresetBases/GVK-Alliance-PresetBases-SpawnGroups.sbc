				[StaticEncounterUp:{X:-0.221920 Y:0.822421 Z:0.523808}]
				[UseRivalAi:true]
				[RivalAiReplaceRemoteControl:true]
				[ManipulationProfiles:GVK-Alliance-PresetBases-Site-Manipulation]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>5.0</Frequency>

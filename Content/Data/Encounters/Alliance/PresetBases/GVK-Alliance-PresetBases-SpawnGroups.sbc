		<!-- =================================================== -->
		<!-- BASE SITES (22)                                  -->
		<!-- StaticEncounterUp points at the planet center: the Base Site's up is its grid -Y, as on the KOTH trade station it was built from. StaticEncounterCoords sit 5.25 m below each GPS point, so the foundation's base is 1 m above it -->
		<!-- =================================================== -->
		<!-- Site01: GPS:BASE BOTH 40-50:39425.55:8162.85:17117.52:#FF75C9F1: -->

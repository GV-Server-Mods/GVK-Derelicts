<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- ======================================================================== -->
		<!-- ALLIANCE ZONE SIZE LADDER (MES Events)                                   -->
		<!-- One event per faction drives the full tier ladder via [ActionExecution:Condition]:  -->
		<!-- MES executes ONLY the action whose index matches the satisfied condition index, so   -->
		<!-- ConditionIds and ActionIds must stay index-aligned and equal in length.              -->
		<!-- Direction is derived from the tier booleans:                                         -->
		<!--   UP   entry: points in range AND this tier false AND every tier above false         -->
		<!--   DOWN entry: points in range AND this tier false AND at least one tier above true   -->
		<!-- Clamps are listed last so a clamp wins the index tie against a tier change in the     -->
		<!-- same cycle; the tier transition then fires on the following cycle (cooldown 5s).      -->
		<!-- Index map: 01=10km down | 02/03=20km up/down | 04/05=30km | 06/07=40km | 08/09=50km  -->
		<!--            10=55km up | 11=points floor | 12=points ceiling                          -->
		<!-- ======================================================================== -->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-EventCondition-ZoneLadder-01-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckCustomCounters:true]
				[CustomCounters:KHAANEPH_Points]
				[CustomCountersTargets:200]
				[CounterCompareTypes:Less]
				[CheckFalseBooleans:true]
				[FalseBooleans:Tier10]
				[CheckTrueBooleans:true]
				[TrueBooleans:Tier20,Tier30,Tier40,Tier50,Tier55]
				[AllowAnyTrueBoolean:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>

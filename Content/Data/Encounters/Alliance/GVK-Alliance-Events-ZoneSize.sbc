<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- ==================================================================== -->
		<!-- ALLIANCE ZONE SIZE LADDER (MES Events) - STATELESS TIER MARKER DESIGN -->
		<!-- One event per faction. State: FACTION_Tier sandbox counter holds the   -->
		<!-- currently-announced radius in km (10/20/30/40/50/55); FACTION_Points   -->
		<!-- holds alliance points. Missing counters read as 0, so fresh worlds     -->
		<!-- need no init event (EventConditions.cs GetVariable default).           -->
		<!-- [ActionExecution:Condition] runs ONLY the action whose index matches   -->
		<!-- the satisfied condition index - ConditionIds/ActionIds stay index      -->
		<!-- aligned. Conditions fire only when points sit in a band AND Tier differs -->
		<!-- from the band marker: Tier < band = up-entry, Tier > band = down-entry, -->
		<!-- so every transition announces once with a truthful direction and same- -->
		<!-- tier re-fires are structurally impossible.                             -->
		<!-- No cross-event state: nothing reads or writes the other faction's      -->
		<!-- counters (sandbox variables are one global namespace - keep it that    -->
		<!-- way; shared bare names caused a KHAANEPH/SOBAN announcement loop).     -->
		<!-- Clamps are listed last (indices 12/13) so a clamp wins the index tie   -->
		<!-- against a tier transition in the same cycle; the transition (zone set, -->
		<!-- chat, tier marker) then fires on the following 5s cycle. Clamps never  -->
		<!-- write the tier marker - the transition action owns it (single writer). -->
		<!-- Index map: 01/02=10km up/down | 03/04=20km | 05/06=30km | 07/08=40km   -->
		<!--            09/10=50km up/down | 11=55km up | 12=floor | 13=ceiling     -->
		<!-- MES quirks relied on: CustomCountersTargets strips 0 values, so the    -->
		<!-- 10km band tests Greater:-1 instead of GreaterOrEqual:0; SetCounters    -->
		<!-- hard-creates counters (EventActionExecution.SetCounter hardSet:true).  -->
		<!-- CRITICAL: a condition referencing a counter that was never written to  -->
		<!-- sandbox storage ALWAYS fails - EventConditions.cs checks the           -->
		<!-- GetVariable success flag, so the 0 default does not help. The          -->
		<!-- Bootstrap event (UniqueEvent:true - RunCount is serialized, so it      -->
		<!-- fires exactly once per world) creates both Tier markers before any     -->
		<!-- band condition can reference them; without it the ladder deadlocks.    -->
		<!-- ==================================================================== -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-EventCondition-ZoneLadder-01-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[MES Event Condition]
				[CheckCustomCounters:true]
				[CustomCounters:KHAANEPH_Points]
				[CustomCountersTargets:-1]
				[CounterCompareTypes:Greater]
				[CustomCounters:KHAANEPH_Points]
				[CustomCountersTargets:200]
				[CounterCompareTypes:Less]
				[CustomCounters:KHAANEPH_Tier]
				[CustomCountersTargets:10]
				[CounterCompareTypes:NotEqual]
				[CustomCounters:KHAANEPH_Tier]
				[CustomCountersTargets:10]
				[CounterCompareTypes:Less]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>

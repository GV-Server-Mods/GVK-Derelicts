<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Behavior for Trade Stations -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Behavior-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:false]
			[TargetData:GVK-Universal-Target-EnemyPlayerAndGrid3km]
			[Triggers:GVK-Alliance-Homebase-Trigger-Init1-KHAANEPH]
			[Triggers:GVK-Alliance-Homebase-Trigger-Init2-KHAANEPH]
			[Triggers:GVK-Alliance-Homebase-Trigger-SpawnCargoShip-KHAANEPH]
			[Triggers:GVK-Alliance-Homebase-Trigger-ReceiveWaypointRequest-KHAANEPH]
			[//Triggers:GVK-Alliance-Homebase-Trigger-CreateSafeZone-KHAANEPH]
			[TriggerGroups:GVK-Alliance-Homebase-TriggerGroup-PointsLimits-KHAANEPH]
			[TriggerGroups:GVK-Alliance-Homebase-TriggerGroup-ZoneSize-KHAANEPH]
			[TriggerGroups:GVK-Universal-TriggerGroup-SpawnDefenses]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
			[RemoteControlCode:GVK-Static]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence to create a the alliance points counter -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Trigger-Init1-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:GVK-Alliance-Homebase-Action-Init1-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Action-Init1-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,AllianceBase]
			[CustomStrings:EncounterDisplayName,HQ]
			[SetCustomCountersVariables:true]
			[CustomCountersVariables:DefenseSpawn_Limit,10]
			</Description>
		</EntityComponent>
		<!-- 
		
			Separate 1-time trigger to reset the sandbox variable since it doesn't need to run every session
			
			Note: this should only be ran at the beginning of the season.
			
		 -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Trigger-Init2-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Alliance-Homebase-Action-Init2-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Action-Init2-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ResetSandboxCounters:KHAANEPH_Points]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence to create a safezone on trade station spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Trigger-CreateSafeZone-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:GVK-Alliance-Homebase-Action-CreateSafeZone-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Action-CreateSafeZone-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[CreateSafeZone:true]
			[SafeZoneProfile:GVK-Alliance-Homebase-SafeZone-KHAANEPH]
			[LinkSafeZoneToRemoteControl:true]
			[SafeZonePositionGridCenter:true]
			[SafeZonePositionTerrainSurface:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-SafeZone-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES SafeZone]
			[Shape:Sphere]
			[Radius:0]
			[RadiusFromParentEntity:true]
			[ParentEntityRadiusMultiplier:10]
			[Enabled:true]
			[LinkToParentEntity:true]
			[IsVisible:false]
			[Color:{X:0 Y:0 Z:0}]
			[Texture:SafeZone_Texture_Restricted]
			[FactionAccess:Whitelist]
			[GridAccess:Whitelist]
			[PlayerAccess:Whitelist]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Trigger-SpawnCargoShip-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:CommandReceived]
			[StartsReady:true]
			[CommandReceiveCode:RequestCargoShip]
			[MinCooldownMs:300000]
			[MaxCooldownMs:300001]
			[MaxActions:-1]
			[Actions:GVK-Alliance-Homebase-Action-SpawnCargoShip-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Action-SpawnCargoShip-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//DebugMessage:SpawnCargoShip]
			[SpawnEncounter:true]
			[Spawner:GVK-Alliance-Homebase-Spawner-SpawnCargoShip-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Spawner-SpawnCargoShip-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:-1]
			[SpawnGroups:GVK-PlanetaryCargoShips-SpawnGroups-KHAANEPH-CargoShip1]
			[MinDistance:300]
			[MaxDistance:600]
			[MinAltitude:100]
			[MaxAltitude:200]
			[InheritNpcAltitude:true]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<!-- Trigger to send waypoint when requested via command from cargo ship -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Trigger-ReceiveWaypointRequest-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:CommandReceived]
			[MinCooldownMs:30000]
			[MaxCooldownMs:30001]
			[UseTrigger:true]
			[StartsReady:true]
			[CommandReceiveCode:CargoShipHQWaypointRequest]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Homebase-Action-ReceiveWaypointRequest-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Action-ReceiveWaypointRequest-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Sending Waypoint]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-Alliance-Homebase-Command-ReceiveWaypointRequest-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Command-ReceiveWaypointRequest-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:SupplyDepotWaypoint]
			[SendWaypoint:true]
			[Waypoint:GVK-Alliance-Waypoint-CargoShip]
			[SingleRecipient:true]
			[MatchSenderReceiverOwners:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:75000]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
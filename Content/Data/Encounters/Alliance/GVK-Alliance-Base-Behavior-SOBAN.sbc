<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Behavior for Trade Stations -->
		<!-- Behavior for Preset Stronghold Bases (SOBAN) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Behavior-SOBAN</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:Passive]
				[UseRetreatTimer:false]
				[UseNoTargetTimer:false]
				[UsePlayerDistanceTimer:false]
				[TargetData:GVK-Universal-Target-EnemyPlayerAndGrid3km]
				[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-Universal-Trigger-DespawnInZ0]
				[Triggers:GVK-Alliance-Base-Trigger-Init-SOBAN]
				[Triggers:GVK-Alliance-Base-Trigger-SpawnTurret-SOBAN]
				[TriggerGroups:GVK-Alliance-TriggerGroup-InsideOutsideZone]
				[TriggerGroups:GVK-Universal-TriggerGroup-SpawnDefenses]
				[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
				[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
				[RemoteControlCode:GVK-Alliance-Base]
				BountyOnKill=20000000;
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Trigger-Init-SOBAN</SubtypeId>
			</Id>
			<Description>
				[MES AI Trigger]
				[UseTrigger:true]
				[Type:Session]
				[StartsReady:true]
				[MaxActions:-1]
				[ActionExecution:All]
				[Actions:GVK-Alliance-Base-Action-Spawned-SOBAN]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Action-Spawned-SOBAN</SubtypeId>
			</Id>
			<Description>
				[MES AI Action]
				[SetCustomStrings:true]
				[CustomStrings:EncounterType,AllianceBase]
				[CustomStrings:EncounterDisplayName,Base]
				[SetCustomCountersVariables:true]
				[CustomCountersVariables:DefenseSpawn_Limit,8]
				[UseChatBroadcast:true]
				[ChatData:GVK-Alliance-EncounterType-Chat-Spawned-Faction]
			</Description>
		</EntityComponent>

		<!-- Trigger to dynamically spawn satellite Turrets (300m - 500m) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Trigger-SpawnTurret-SOBAN</SubtypeId>
			</Id>
			<Description>
				[MES AI Trigger]
				[UseTrigger:true]
				[Type:Timer]
				[MinCooldownMs:1200000]
				[MaxCooldownMs:1800000]
				[StartsReady:true]
				[MaxActions:-1]
				[Conditions:GVK-Alliance-Base-Condition-SpawnTurret-SOBAN]
				[Actions:GVK-Alliance-Base-Action-SpawnTurret-SOBAN]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Condition-SpawnTurret-SOBAN</SubtypeId>
			</Id>
			<Description>
				[MES AI Condition]
				[CheckPlayerNear:true]
				[PlayerNearDistance:15000]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Action-SpawnTurret-SOBAN</SubtypeId>
			</Id>
			<Description>
				[MES AI Action]
				[//DebugMessage:SpawnTurret-SOBAN]
				[SpawnEncounter:true]
				[Spawner:GVK-Alliance-Base-Spawner-Turret-SOBAN]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Spawner-Turret-SOBAN</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[ProcessAsAdminSpawn:true]
				[SpawnGroups:GVK-Alliance-DefenseTurret-SpawnGroup-SOBAN]
				[MinDistance:300]
				[MaxDistance:500]
				[MinAltitude:0]
				[MaxAltitude:1]
				[InheritNpcAltitude:false]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
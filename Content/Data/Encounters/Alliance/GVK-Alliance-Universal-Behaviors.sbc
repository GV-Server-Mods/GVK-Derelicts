<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<!-- 
	
		Chats
	
	-->
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-EncounterType-Chat-Spawned-Faction</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:Sensors]
				[Color:Blue]
				[ChatMessages:New {Faction} {EncounterDisplayName} constructed.]
				[ChatAudio:ArcHudSensors]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-EncounterType-Chat-Attacked-Faction</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[BroadcastRandomly:false]
				[Author:Sensors]
				[Color:Blue]
				[ChatMessages:{Faction} {EncounterDisplayName} under attack.]
				[ChatAudio:ArcHudSensors]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- Spawn chat: off until the init turns it on, so it first runs a trigger pass after the KOTH and Zone 0 despawn checks (Docs/design/koth-despawn.md) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-EncounterType-Trigger-SpawnedChat</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[MaxActions:1]
			[Conditions:GVK-Universal-Condition-NotDespawnedByRule]
			[Actions:GVK-Alliance-EncounterType-Action-SpawnedChat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-EncounterType-Action-SpawnedChat</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-EncounterType-Chat-Spawned-Faction]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
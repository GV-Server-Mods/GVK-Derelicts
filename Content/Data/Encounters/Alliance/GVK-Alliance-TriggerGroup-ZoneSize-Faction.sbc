		<!-- Trigger to check and enable 20000m KHAANEPH Zone -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Trigger-EnableZone20000-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:false]
			[MaxActions:-1]
			[Actions:GVK-Alliance-Homebase-Action-EnableZone20000-Faction]
			[Conditions:GVK-Alliance-Homebase-Condition-EnableZone20000-KHAANEPH]
			[ConditionCheckResetsTimer:true]
			[ToggleWithTriggerProfile:GVK-Alliance-Homebase-Trigger-DisableZone20000-KHAANEPH]
			[ToggledProfileResetsCooldown:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Condition-EnableZone20000-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:KHAANEPH_Points]
			[CustomSandboxCountersTargets:200]
			[SandboxCounterCompareTypes:GreaterOrEqual]
			</Description>
		</EntityComponent>

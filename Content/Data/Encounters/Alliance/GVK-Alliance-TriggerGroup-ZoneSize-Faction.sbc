		<!-- Faction agnostic actions and chat to enable/disable zones -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Action-EnableZone20000-Faction</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//DebugMessage:EnableZone20000]
			[ChangeZoneAtPosition:true]
			[ZoneName:{Faction}_Zone_20000]
			[ZoneToggleActive:true]
			[ZoneToggleActiveMode:true]
			[ZoneRadiusChangeType:Set]
			[ZoneRadiusChangeAmount:20000]
			[SetCustomStrings:true]
			[CustomStrings:FactionZoneRadius,20]
			[CustomStrings:FactionZoneStatus,increased]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Homebase-Chat-FactionZoneStatus]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Action-DisableZone20000-Faction</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//DebugMessage:DisableZone20000]
			[ChangeZoneAtPosition:true]
			[ZoneName:{Faction}_Zone_20000]
			[ZoneToggleActive:true]
			[ZoneToggleActiveMode:false]
			[ZoneRadiusChangeType:Set]
			[ZoneRadiusChangeAmount:1]
			[SetCustomStrings:true]
			[CustomStrings:FactionZoneRadius,10]
			[CustomStrings:FactionZoneStatus,decreased]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Homebase-Chat-FactionZoneStatus]

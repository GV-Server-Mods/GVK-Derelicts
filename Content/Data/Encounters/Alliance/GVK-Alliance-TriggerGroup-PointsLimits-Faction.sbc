<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-TriggerGroup-PointsLimits-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Alliance-Homebase-Trigger-PointsFloor-KHAANEPH]
			[Triggers:GVK-Alliance-Homebase-Trigger-PointsCeiling-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-TriggerGroup-PointsLimits-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Alliance-Homebase-Trigger-PointsFloor-SOBAN]
			[Triggers:GVK-Alliance-Homebase-Trigger-PointsCeiling-SOBAN]
			</Description>
		</EntityComponent>
		<!-- KHAANEPH Section -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Trigger-PointsFloor-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:false]
			[MaxActions:-1]
			[Actions:GVK-Alliance-Homebase-Action-PointsFloor-KHAANEPH]
			[Conditions:GVK-Alliance-Homebase-Condition-PointsFloor-KHAANEPH]
			[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Condition-PointsFloor-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:KHAANEPH_Points]
			[CustomSandboxCountersTargets:-1]
			[SandboxCounterCompareTypes:LessOrEqual]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Action-PointsFloor-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:PointsFloor-KHAANEPH]
			[ResetSandboxCounters:KHAANEPH_Points]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
		
		EncounterTypes:
		- Base:				50 Influence
		- Outpost:			10 Influence
		- Turret:			2 Influence
		- Freighter:		10 Influence
		- Research Lab:		3 Influence
		- Elite Units: 	15 Influence
		- Large Units: 	4 Influence
		- Medium Units: 	2 Influence
		- Small Units: 	1 point
		
		Factions:
		- KHAANEPH
		- SOBAN
		
		IdsReplacer status (MES):
		- {Faction} IS supported in SandboxCounters (own faction) - Despawned/Awarded are consolidated.
		- Compromised still needs one pair per faction: SetSandboxCounter only substitutes {Faction},
		  there is no rival/opposing-faction token, so the transfer to the rival counter cannot be
		  expressed in a single faction-agnostic action. Revisit (GVK-Settings#665) when MES adds full IdsReplacer
		  (or {OpposingFaction}/CustomStrings support) to SetSandboxCounter.
		
		[Tags:GVK-Alliance-TriggerTags-InfluenceCompromised-{EncounterType}-{Faction}]
		[Tags:GVK-Alliance-TriggerTags-InfluenceDespawned-{EncounterType}]
		[Tags:GVK-Alliance-TriggerTags-InfluenceAwarded-{EncounterType}]
		
		Notes:
			- Units don't have deduct Influence on despawn.
			- ResearchLab only has InfluenceAwarded
			- All check if previously damaged by an enemy or neutral player.

		-->

		<!-- Base -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-TriggerTags-InfluenceCompromised-AllianceBase-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Tags:GVK-Alliance-TriggerTags-InfluenceCompromised-AllianceBase-KHAANEPH]
				[Type:Manual]
				[StartsReady:true]
				[Conditions:GVK-Universal-Condition-DamagedByNonFriendlyPlayer]
				[ActionExecution:All]
				[Actions:GVK-Alliance-Action-InfluenceCompromised-AllianceBase-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Action-InfluenceCompromised-AllianceBase-KHAANEPH</SubtypeId>
			</Id>
			<Description>
				[MES AI Action]
				[//DebugMessage:InfluenceCompromised-AllianceBase-KHAANEPH]
				[SetCustomStrings:true]
				[CustomStrings:DecreaseFactionName,KHAANEPH]
				[CustomStrings:IncreaseFactionName,SOBAN]
				[CustomStrings:DecreaseFactionAmount,50]
				[CustomStrings:IncreaseFactionAmount,50]
				[DecreaseSandboxCounters:KHAANEPH_Influence]
				[DecreaseSandboxCountersAmount:50]
				[IncreaseSandboxCounters:SOBAN_Influence]
				[IncreaseSandboxCountersAmount:50]
				[UseChatBroadcast:true]
				[ChatData:GVK-Alliance-Chat-InfluenceAdjustCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-TriggerTags-InfluenceDespawned-AllianceBase</SubtypeId>
			</Id>
			<Description>

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
		
		When called, send the command to refund a defense spawn on parent grid

		Tags used:GVK-Universal-TriggerTags-RefundDefensesCommand-{EncounterType}

		Keep-alive: every 5 minutes a Unit tells its parent it is still alive, so an alliance structure holds off its
		60-minute DefenseSpawn_Counter reset until its last Unit is gone. Only Unit encounter types have the tag, so
		other children (the alliance Defense Turret) never send it.

		Tags used:GVK-Universal-TriggerTags-DefensesKeepAliveCommand-{EncounterType}

		-->
		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-TriggerTags-RefundDefensesCommand</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Tags:GVK-Universal-TriggerTags-RefundDefensesCommand-UnitLarge]
			[Tags:GVK-Universal-TriggerTags-RefundDefensesCommand-UnitMedium]
			[Tags:GVK-Universal-TriggerTags-RefundDefensesCommand-UnitSmall]
			[Type:Manual]
			[StartsReady:true]
			[ActionExecution:All]
			[Actions:GVK-Universal-Action-RefundDefensesCommand]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-RefundDefensesCommand</SubtypeId>
			</Id>
			<Description>
			[//DebugMessage:RefundDefensesCommand]
			[RivalAI Action]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-Universal-Command-RefundDefensesCommand]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Command-RefundDefensesCommand</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:DefensesRefundCounter]
			[SingleRecipient:true]
			[MatchSenderReceiverOwners:true]
			[MatchReceiverParent:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:6000]
			[CommandDelayTicks:0]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesKeepAlive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:300000]
			[MaxCooldownMs:300001]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-Universal-Action-DefensesKeepAlive]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesKeepAlive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerTags:GVK-Universal-TriggerTags-DefensesKeepAliveCommand-{EncounterType}]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-TriggerTags-DefensesKeepAliveCommand</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Tags:GVK-Universal-TriggerTags-DefensesKeepAliveCommand-UnitLarge]
			[Tags:GVK-Universal-TriggerTags-DefensesKeepAliveCommand-UnitMedium]
			[Tags:GVK-Universal-TriggerTags-DefensesKeepAliveCommand-UnitSmall]
			[Type:Manual]
			[StartsReady:true]
			[ActionExecution:All]
			[Actions:GVK-Universal-Action-DefensesKeepAliveCommand]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesKeepAliveCommand</SubtypeId>
			</Id>
			<Description>
			[//DebugMessage:DefensesKeepAliveCommand]
			[RivalAI Action]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-Universal-Command-DefensesKeepAlive]
			</Description>
		</EntityComponent>
		<!-- Units chase targets, so the radius is wider than the refund's; MatchReceiverParent keeps it to the one parent -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Command-DefensesKeepAlive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:DefensesKeepAlive]
			[MatchSenderReceiverOwners:true]
			[MatchReceiverParent:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:15000]
			[CommandDelayTicks:0]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
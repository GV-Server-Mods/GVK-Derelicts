<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- 
		
		This TriggerGroup handles:
			- Alliance points
			- Alliance Reputation
			- Explosions
			- NPC Disable
			- Defeated/Despawned Chats
			- Attacked chatter (NeutralAttacked/EnemyAttacked/FriendlyFire dialogue cues) and last words (Defeated cue), only on behaviors with [DialogueBanks:]
			- Crashed (if GVK_MobilityType_Aircraft true)
			- Instant delete (if small grid true)
			
		Requires:
			- CustomStrings {EncounterType} 
			- CustomStrings {EncounterDisplayName}
			- {Faction}
			
		Example tags for init trigger:
			[CustomStrings:EncounterType,UnitMedium]
			[CustomStrings:EncounterDisplayName,aircraft]
			[SetBooleansTrue:GVK_MobilityType_Aircraft]

		Optional:
			- SetBooleansTrue {GVK_MobilityType_Aircraft}
		
		Tags for use elsewhere:
			- Tags:GVK-Universal-TriggerTags-Compromised
			
		-->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-TriggerGroup-DefeatedAndAttacked</SubtypeId>
			</Id>
			<Description>
				[RivalAI TriggerGroup]
				[Triggers:GVK-Universal-Trigger-AttackerIsNeutralPlayer]
				[Triggers:GVK-Universal-Trigger-AttackerIsEnemyPlayer]
				[Triggers:GVK-Universal-Trigger-NeutralAttackedChatter]
				[Triggers:GVK-Universal-Trigger-EnemyAttackedChatter]
				[Triggers:GVK-Universal-Trigger-FriendlyFireChatter]
				[Triggers:GVK-Universal-Trigger-DefeatedBeaconDisabled]
				[Triggers:GVK-Universal-Trigger-DefeatedCompromised]
				[Triggers:GVK-Universal-Trigger-DefeatedCrashed]
				[Triggers:GVK-Universal-ManualTrigger-DefeatedCompromised]
				[Triggers:GVK-Universal-Trigger-DefeatedDespawn]
				[Triggers:GVK-Universal-ManualTrigger-DefeatedDespawned]
				[Triggers:GVK-Universal-ManualTrigger-DespawnedCounted]
				[Triggers:GVK-Universal-TriggerTags-AttemptSmallDespawn]
				[Triggers:GVK-Universal-TriggerTags-Disabled]
				[Triggers:GVK-Universal-TriggerTags-DefeatedChat-AllianceBase]
				[Triggers:GVK-Universal-TriggerTags-DefeatedChat-AllianceOutpost]
				[Triggers:GVK-Universal-TriggerTags-DefeatedChat-AllianceTurret]
				[Triggers:GVK-Universal-TriggerTags-DefeatedChat-CargoShip]
				[Triggers:GVK-Universal-TriggerTags-DefeatedChat-UnitElite]
				[Triggers:GVK-Universal-TriggerTags-DefeatedChat-UnitLarge]
				[Triggers:GVK-Universal-TriggerTags-DefeatedChat-UnitMedium]
				[Triggers:GVK-Universal-TriggerTags-DefeatedChat-UnitSmall]
				[Triggers:GVK-Universal-TriggerTags-DefeatedChat-WreckLarge]
				[Triggers:GVK-Universal-TriggerTags-DefeatedChat-WreckMedium]
				[Triggers:GVK-Universal-TriggerTags-DefeatedChat-WreckSmall]
				[Triggers:GVK-Universal-TriggerTags-DespawnedChat-AllianceBase]
				[Triggers:GVK-Universal-TriggerTags-DespawnedChat-AllianceOutpost]
				[Triggers:GVK-Universal-TriggerTags-DespawnedChat-AllianceTurret]
				[Triggers:GVK-Universal-TriggerTags-DespawnedChat-WreckLarge]
				[Triggers:GVK-Universal-TriggerTags-DespawnedChat-WreckMedium]
				[Triggers:GVK-Universal-TriggerTags-DespawnedChat-WreckSmall]
				[Triggers:GVK-Universal-TriggerTags-Explosions-AllianceBase-KHAANEPH]
				[Triggers:GVK-Universal-TriggerTags-Explosions-AllianceBase-SOBAN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-AllianceOutpost-KHAANEPH]
				[Triggers:GVK-Universal-TriggerTags-Explosions-AllianceOutpost-SOBAN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-AllianceTurret-KHAANEPH]
				[Triggers:GVK-Universal-TriggerTags-Explosions-AllianceTurret-SOBAN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-CargoShip-KHAANEPH]
				[Triggers:GVK-Universal-TriggerTags-Explosions-CargoShip-SOBAN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-CargoShip-GAALSIEN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-CargoShip-COALITION]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitElite-GAALSIEN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitElite-KHAANEPH]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitElite-SOBAN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitLarge-COALITION]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitLarge-GAALSIEN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitLarge-KHAANEPH]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitLarge-SOBAN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitMedium-COALITION]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitMedium-GAALSIEN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitMedium-KHAANEPH]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitMedium-SOBAN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitSmall-COALITION]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitSmall-GAALSIEN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitSmall-KHAANEPH]
				[Triggers:GVK-Universal-TriggerTags-Explosions-UnitSmall-SOBAN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-WreckLarge-COALITION]
				[Triggers:GVK-Universal-TriggerTags-Explosions-WreckLarge-DERELICT]
				[Triggers:GVK-Universal-TriggerTags-Explosions-WreckLarge-GAALSIEN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-WreckMedium-COALITION]
				[Triggers:GVK-Universal-TriggerTags-Explosions-WreckMedium-DERELICT]
				[Triggers:GVK-Universal-TriggerTags-Explosions-WreckMedium-GAALSIEN]
				[Triggers:GVK-Universal-TriggerTags-Explosions-WreckSmall-COALITION]
				[Triggers:GVK-Universal-TriggerTags-Explosions-WreckSmall-DERELICT]
				[Triggers:GVK-Universal-TriggerTags-Explosions-WreckSmall-GAALSIEN]
				[Triggers:GVK-Universal-TriggerTags-RefundDefensesCommand]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-AllianceBase-KHAANEPH]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-AllianceBase-SOBAN]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-AllianceOutpost-KHAANEPH]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-AllianceOutpost-SOBAN]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-AllianceTurret-KHAANEPH]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-AllianceTurret-SOBAN]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-CargoShip-KHAANEPH]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-CargoShip-SOBAN]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-UnitElite-KHAANEPH]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-UnitElite-SOBAN]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-UnitLarge-KHAANEPH]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-UnitLarge-SOBAN]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-UnitMedium-KHAANEPH]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-UnitMedium-SOBAN]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-UnitSmall-KHAANEPH]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceCompromised-UnitSmall-SOBAN]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceAwarded-AllianceResearchLab]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceDespawned-AllianceBase]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceDespawned-AllianceOutpost]
				[Triggers:GVK-Alliance-TriggerTags-InfluenceDespawned-AllianceTurret]
				[Triggers:GVK-Alliance-Trigger-AttackedReputation-Init]
				[Triggers:GVK-Alliance-TriggerTags-AttackedReputation-KHAANEPH]
				[Triggers:GVK-Alliance-TriggerTags-AttackedReputation-SOBAN]
			</Description>
		</EntityComponent>
		<!-- Check if NPC has been damaged by an neutral player (primarily for alliance point changes) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-AttackerIsNeutralPlayer</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[MaxActions:1]
			[StartsReady:true]
			[DamageTypes:Any]
			[ExcludedDamageTypes:Environment]
			[ExcludedDamageTypes:Fire]
			[ExcludedDamageTypes:Fall]
			[ExcludedDamageTypes:Thruster]
			[Conditions:GVK-Universal-Condition-AttackerIsNeutralPlayer]
			[ActionExecution:All]
			[Actions:GVK-Universal-Action-AttackerIsNeutralPlayer]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-AttackerIsNeutralPlayer</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//DebugMessage:AttackerIsNeutralPlayer]
			[SetBooleansTrue:DamagedByNeutralPlayer]
			</Description>
		</EntityComponent>
		<!-- Check if NPC has been damaged by an enemy player (primarily for alliance point changes) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-AttackerIsEnemyPlayer</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[MaxActions:1]
			[StartsReady:true]
			[DamageTypes:Any]
			[ExcludedDamageTypes:Environment]
			[ExcludedDamageTypes:Fire]
			[ExcludedDamageTypes:Fall]
			[ExcludedDamageTypes:Thruster]
			[Conditions:GVK-Universal-Condition-AttackerIsEnemyPlayer]
			[ActionExecution:All]
			[Actions:GVK-Universal-Action-AttackerIsEnemyPlayer]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-AttackerIsEnemyPlayer</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//DebugMessage:AttackerIsEnemyPlayer]
			[SetBooleansTrue:DamagedByEnemyPlayer]
			</Description>
		</EntityComponent>
		<!-- Attacked chatter. Listed after the Attacker triggers so the first hit has already set the boolean. Cooldowns pace it, not the bank's chat profile (README note 37). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-NeutralAttackedChatter</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[MinCooldownMs:60000]
			[MaxCooldownMs:60001]
			[StartsReady:true]
			[DamageTypes:Any]
			[ExcludedDamageTypes:Environment]
			[ExcludedDamageTypes:Fire]
			[ExcludedDamageTypes:Fall]
			[ExcludedDamageTypes:Thruster]
			[Conditions:GVK-Universal-Condition-DamagedByNeutralPlayer]
			[Actions:GVK-Universal-Action-NeutralAttackedChatter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-NeutralAttackedChatter</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//DebugMessage:NeutralAttackedChatter]
			[PlayDialogueCue:true]
			[DialogueCueId:NeutralAttacked]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-EnemyAttackedChatter</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[MinCooldownMs:30000]
			[MaxCooldownMs:60000]
			[StartsReady:true]
			[DamageTypes:Any]
			[ExcludedDamageTypes:Environment]
			[ExcludedDamageTypes:Fire]
			[ExcludedDamageTypes:Fall]
			[ExcludedDamageTypes:Thruster]
			[Conditions:GVK-Universal-Condition-DamagedByEnemyPlayer]
			[Actions:GVK-Universal-Action-EnemyAttackedChatter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-EnemyAttackedChatter</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[Chance:25]
			[//DebugMessage:EnemyAttackedChatter]
			[PlayDialogueCue:true]
			[DialogueCueId:EnemyAttacked]
			</Description>
		</EntityComponent>
		<!-- Friendly fire is usually an accident, so this checks the current attacker on each hit instead of a sticky boolean. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-FriendlyFireChatter</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[MinCooldownMs:30000]
			[MaxCooldownMs:30001]
			[StartsReady:true]
			[DamageTypes:Any]
			[ExcludedDamageTypes:Environment]
			[ExcludedDamageTypes:Fire]
			[ExcludedDamageTypes:Fall]
			[ExcludedDamageTypes:Thruster]
			[Conditions:GVK-Universal-Condition-AttackerIsFriendlyPlayer]
			[Actions:GVK-Universal-Action-FriendlyFireChatter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-FriendlyFireChatter</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//DebugMessage:FriendlyFireChatter]
			[PlayDialogueCue:true]
			[DialogueCueId:FriendlyFire]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefeatedBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[MinCooldownMs:2000]
			[MaxCooldownMs:2001]
			[StartsReady:false]
			[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
			[ConditionCheckResetsTimer:true]
			[Actions:GVK-Universal-Action-DefeatedCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefeatedCompromised</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Compromised]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Universal-Action-DefeatedCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefeatedCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[MaxActions:1]
			[Conditions:GVK-Universal-Condition-Crashed]
			[ActionExecution:All]
			[Actions:GVK-Universal-Action-DefeatedCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefeatedCompromised</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//DebugMessage:Action-DefeatedCompromised]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerTags:GVK-Universal-TriggerTags-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-ManualTrigger-DefeatedCompromised</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:GVK-Universal-TriggerTags-Compromised]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Universal-Action-DefeatedLastWords]
			[Actions:GVK-Universal-ManualAction-DefeatedCompromised]
			</Description>
		</EntityComponent>
		<!-- Last words: they replace the blue Sensors defeated line, so they always play (the bank's squad throttle can still drop one) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefeatedLastWords</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[PlayDialogueCue:true]
			[DialogueCueId:Defeated]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-ManualAction-DefeatedCompromised</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//DebugMessage:ManualAction-DefeatedCompromised]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerTags:GVK-Alliance-TriggerTags-InfluenceCompromised-{EncounterType}-{Faction}]
			[ManuallyActivatedTriggerTags:GVK-Universal-TriggerTags-Explosions-{EncounterType}-{Faction}]
			[ManuallyActivatedTriggerTags:GVK-Universal-TriggerTags-DefeatedChat-{EncounterType}]
			[ManuallyActivatedTriggerTags:GVK-Universal-TriggerTags-AttemptSmallDespawn]
			[ManuallyActivatedTriggerTags:GVK-Universal-TriggerTags-Disabled]
			[//A defeated grid that MES cleans up later must not also count as Lost (chat, alliance points, Defense refund)]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Universal-Trigger-DefeatedDespawn]
			</Description>
		</EntityComponent>
		<!-- trigger to adjust points if Despawned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefeatedDespawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:DespawnMES]
			[DespawnTypeFromSpawner:Any]
			[UseTrigger:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Universal-Action-DefeatedDespawned]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefeatedDespawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Action-DefeatedDespawned]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Universal-ManualTrigger-DefeatedDespawned]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-ManualTrigger-DefeatedDespawned</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Universal-ManualAction-DefeatedDespawned]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-ManualAction-DefeatedDespawned</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//DebugMessage:ManualAction-DefeatedDespawned]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerTags:GVK-Universal-TriggerTags-RefundDefensesCommand-{EncounterType}]
			[ManuallyActivatedTriggerNames:GVK-Universal-ManualTrigger-DespawnedCounted]
			</Description>
		</EntityComponent>
		<!-- The "lost" chat and the alliance points only count a despawn GVK didn't cause itself. GVK's own placement and
		     territory despawns (KOTH 5 km zone, Zone 0, outside the faction zone) set GVK_DespawnedByRule first: MES
		     placing a spawn badly, or a zone shrinking, isn't a loss for the alliance. The defense refund above still runs. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-ManualTrigger-DespawnedCounted</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[StartsReady:true]
			[MaxActions:1]
			[Conditions:GVK-Universal-Condition-NotDespawnedByRule]
			[Actions:GVK-Universal-ManualAction-DespawnedCounted]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-NotDespawnedByRule</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckFalseBooleans:true]
			[FalseBooleans:GVK_DespawnedByRule]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-ManualAction-DespawnedCounted</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerTags:GVK-Alliance-TriggerTags-InfluenceDespawned-{EncounterType}]
			[ManuallyActivatedTriggerTags:GVK-Universal-TriggerTags-DespawnedChat-{EncounterType}]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
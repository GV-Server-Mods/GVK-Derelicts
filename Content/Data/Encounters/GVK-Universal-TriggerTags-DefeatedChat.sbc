<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
		
		EncounterTypes:
		- Base				Faction Base
		- Outpost			Faction Outpost
		- Turret			Faction Turret
		- CargoShip			Faction Cargo Ship
		- DroneElite		Faction Elite Drone
		- DroneLarge		Faction Large Drone
		- DroneMedium		Faction Medium Drone
		- DroneSmall		Faction Small Drone
		- WreckLarge		Large Signal
		- WreckMedium		Medium Signal
		- WreckSmall		Medium Signal
				
		Tags:GVK-Universal-TriggerTags-DefeatedChat-{EncounterType}
		Tags:GVK-Universal-TriggerTags-DespawnedChat-{EncounterType}
		
		Note: Drones don't have DespawnChat

		-->

		<!-- Defeated Chats -->
		<!-- Base -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-TriggerTags-DefeatedChat-AllianceBase</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[UseTrigger:true]
				[Tags:GVK-Universal-TriggerTags-DefeatedChat-AllianceBase]
				[Type:Manual]
				[StartsReady:true]
				[Actions:GVK-Universal-Action-DefeatedChat-Large]
			</Description>
		</EntityComponent>

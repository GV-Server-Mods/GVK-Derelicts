		<!-- Action and Common Chat messages -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefeatedChat-Small</SubtypeId>
			</Id>
			<Description>
				[MES AI Action]
				[//DebugMessage:DefeatedChat-Small]
				[UseChatBroadcast:true]
				[ChatData:GVK-Universal-Chat-DefeatedChat-Small]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Chat-DefeatedChat-Small</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:Sensors]
				[Color:Blue]
				[ChatMessages:{Faction} {EncounterDisplayName} destroyed.]
				[ChatAudio:ArcHudSensors]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:false]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:6000]
			</Description>
		</EntityComponent>

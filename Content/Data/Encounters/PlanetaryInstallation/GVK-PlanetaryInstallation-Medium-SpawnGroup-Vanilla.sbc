	<SpawnGroups>
		<!--
		
		Vanilla Prefabs
		
		Notes:
		 - CutVoxels does not actually work on SpawnConditions, only on the SpawnGroup.
		 
		-->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-SpawnGroup-Medium-NWM Mobile Utility Platform</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[SpawnConditionsProfiles:GVK-PlanetaryInstallation-Medium-SpawnCondition-Wreck-RANDOM]
				[ManipulationProfiles:GVK-Universal-Manipulation-Large3x3StandardTurrets]
				[ManipulationProfiles:GVK-PlanetaryInstallation-Medium-Manipulation]
				[ManipulationProfiles:GVK-Universal-Manipulation-ShiftColorHue]
				[CutVoxelsAtAirtightCells:true]
				[CutVoxelSize:15]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>0.4</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NWM Mobile Utility Platform">
					<Position>
						<X>0.0</X>
						<Y>-2</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Medium Signal</BeaconText>
					<Behaviour>GVK-PlanetaryInstallation-Medium-Behavior</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

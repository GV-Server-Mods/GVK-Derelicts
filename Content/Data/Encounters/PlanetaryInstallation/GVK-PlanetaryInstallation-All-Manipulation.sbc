<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Manipulation</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[ClearAuthorship:true]
			[EraseIngameScripts:true]
			[UseRivalAi:true]
			[RivalAiReplaceRemoteControl:true]
			[UseBlockReplacer:true]
			[AssignGridSkin:Dust_Armor]
			[SkinRandomBlocks:true]
			[SkinRandomBlocksTextures:Wartorn]
			[SkinRandomBlocksTextures:Heavy_Rust_Armor]
			[MinPercentageSkinRandomBlocks:25]
			[MaxPercentageSkinRandomBlocks:50]
			[ReduceBlockBuildStates:false]
			[MinimumBlocksPercent:10]
			[MaximumBlocksPercent:25]
			[MinimumBuildPercent:50]
			[MaximumBuildPercent:70]
			[IgnoreGlobalBlockReplacer:false]
			[UseBlockReplacerProfile:true]
			[//BlockReplacerProfileNames:GVK-Replacer-NPCWeapons]
			[BlockReplacerProfileNames:GVK-Replacer-NPCHovers]
			[BlockReplacerProfileNames:GVK-Replacer-LargeCockpitToRivalAI]
			[BlockReplacerProfileNames:MES-Armor-LightToHeavy]
			[BlockReplacerProfileNames:GVK-Replacer-ProprietaryReactors]
			[BlockReplacerProfileNames:GVK-Replacer-NPCDisposableBeacons]
			[BlockReplacerProfileNames:GVK-Replacer-ConveyorToCargo]
			[ClearGridInventories:true]
			[UseLootProfiles:true]
			[LootProfiles:GVK-Universal-Loot-Small]
			[LootProfiles:GVK-Universal-Loot-Freight]
			[LootProfiles:GVK-Universal-Loot-H2Generator]
			[LootProfiles:GVK-Universal-Loot-Assembler]
			[LootProfiles:GVK-Universal-Loot-Refinery]
			[LootProfiles:GVK-Universal-Loot-Cockpit]
			[LootProfiles:GVK-Universal-Loot-Armory]
			[LootProfiles:GVK-Universal-Loot-LivingArea]
			[LootProfiles:GVK-Universal-Loot-Beds]
			[LootProfiles:GVK-Universal-Loot-Mission]
			[UseGridDereliction:true]
			[DerelictionProfiles:GVK-Universal-Dereliction-NonArmor-DamageOnly]
			[DerelictionProfiles:GVK-Universal-Dereliction-DerelictTurrets-NonFunctional]
			[DerelictionProfiles:GVK-Universal-Dereliction-ProgrammableBlocks-NonFunctional]
			[DerelictionProfiles:GVK-Universal-Dereliction-RocketLaunchers-NoComps]
			[DerelictionProfiles:GVK-Universal-Dereliction-Vanilla-FullHealth]
			[DerelictionProfiles:GVK-Universal-Dereliction-Wheels-Missing]
			[EnableBlocksWithName:Designator,Turret,turret,interior,Interior,gatling,Gatling,Cannon,cannon,Gun,gun]
			[DisableBlocksWithName:Antenna,Thruster,Survival,Blood,AI Basic,AI Control, AI Flight, AI Offensive]
			[AllowPartialNames:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>

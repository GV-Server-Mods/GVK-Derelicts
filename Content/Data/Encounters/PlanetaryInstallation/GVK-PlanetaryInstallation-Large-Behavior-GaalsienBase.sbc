<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Behavior-GAALSIENBase</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[DialogueBanks:GVK-Units-GAALSIEN.xml]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:3600]
			[PlayerDistanceTrigger:6000]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGridsLongRange]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENBaseInit]
			[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-Universal-Trigger-TargetAcquiredChatter]
			[Triggers:GVK-Universal-Trigger-DespawnInZ0]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-SpawnDefenses]
			[RemoteControlCode:GVK-LargeDerelict]
			BountyOnKill=20000000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-GAALSIENBaseInit</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:true]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Large-Action-GAALSIENBaseInit]
			[Actions:GVK-Universal-Action-DisableVanillaBlocks]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Action-GAALSIENBaseInit</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,WreckLarge]
			[CustomStrings:EncounterDisplayName,Base]
			[SetCustomCountersVariables:true]
			[CustomCountersVariables:DefenseSpawn_Limit,8]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Large-Chat-GAALSIENBaseInit]
			</Description>
		</EntityComponent>
		<!-- Unique chat just for this encounter -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Chat-GAALSIENBaseInit</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:{Faction} {EncounterDisplayName} detected.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
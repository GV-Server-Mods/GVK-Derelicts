<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<!--
	
		Note: These are meant for generic small/med/large wrecks. Not meant for unique encounter or missions.
		
	-->
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Chat-Init</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:{EncounterDisplayName} detected.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:6000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Chat-Init</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:{EncounterDisplayName} detected.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:40000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Chat-Init</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:{EncounterDisplayName} detected.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Spawn chat: off until the init turns it on, so it first runs a trigger pass after the KOTH and Zone 0 despawn checks (Docs/design/koth-despawn.md) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Trigger-InitChat</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[MaxActions:1]
			[Conditions:GVK-Universal-Condition-NotDespawnedByRule]
			[Actions:GVK-PlanetaryInstallation-Small-Action-InitChat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Action-InitChat</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Small-Chat-Init]
			</Description>
		</EntityComponent>
		<!-- Spawn chat: off until the init turns it on, so it first runs a trigger pass after the KOTH and Zone 0 despawn checks (Docs/design/koth-despawn.md) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Trigger-InitChat</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[MaxActions:1]
			[Conditions:GVK-Universal-Condition-NotDespawnedByRule]
			[Actions:GVK-PlanetaryInstallation-Medium-Action-InitChat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Action-InitChat</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Medium-Chat-Init]
			</Description>
		</EntityComponent>
		<!-- Spawn chat: off until the init turns it on, so it first runs a trigger pass after the KOTH and Zone 0 despawn checks (Docs/design/koth-despawn.md) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-InitChat</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[StartsReady:true]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[MaxActions:1]
			[Conditions:GVK-Universal-Condition-NotDespawnedByRule]
			[Actions:GVK-PlanetaryInstallation-Large-Action-InitChat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Action-InitChat</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Large-Chat-Init]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
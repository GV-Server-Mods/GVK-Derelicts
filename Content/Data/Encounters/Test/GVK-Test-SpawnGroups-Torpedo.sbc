<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<!-- Admin test spawn groups for the Torpedo Launcher NPC prefabs (hub GVK-Settings#814). Same rules as GVK-Test-SpawnGroups.sbc: admin spawn only, behind the GVK_TestSpawns switch. -->
	<SpawnGroups>
		<!-- /MES.Spawn.DroneEncounter.GVK-Test-SpawnGroup-Bomber: one GAALSIEN Bomber (1 Torpedo Launcher) -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Test-SpawnGroup-Bomber</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:GVK-Unit-All-Manipulation-Flyer]
				[ManipulationProfiles:GVK-Universal-Manipulation-Large3x3StandardTurrets]
				[SpawnConditionsProfiles:GVK-Test-SpawnCondition-Aircraft]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>0.1</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NUN [GAAL] Bomber">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Bomber</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-Bomber</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>
		<!-- /MES.Spawn.DroneEncounter.GVK-Test-SpawnGroup-TorpedoCruiser: one GAALSIEN Torpedo Cruiser (2 Torpedo Launchers) -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Test-SpawnGroup-TorpedoCruiser</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:GVK-Universal-Manipulation-Large3x3HeavyTurrets]
				[ManipulationProfiles:GVK-Unit-All-Manipulation-Hover]
				[SpawnConditionsProfiles:GVK-Test-SpawnCondition-Cruisers]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>0.1</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NUN [GAAL] Torpedo Cruiser">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Torpedo Cruiser</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-HoverCruiserHorsefly-GAALSIEN</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>
	</SpawnGroups>
</Definitions>

		<!-- /MES.Spawn.PlanetaryInstallation.GVK-Test-SpawnGroup-RecolorWreck: a small wreck, all Dust_Armor, that a RecolorGrid action reskins Frozen_Armor 120 s after spawn -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Test-SpawnGroup-RecolorWreck</SubtypeId>
			</Id>

				<Prefab SubtypeId="NWS Lacewing">
					<Position>
						<X>0.0</X>
						<Y>11</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Recolor Wreck</BeaconText>

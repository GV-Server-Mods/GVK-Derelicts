			[MaxDroneDistance:1000]
			[MinDroneAltitude:75]
			[MaxDroneAltitude:75]
			[FactionOwner:GAALSIEN]
			[ReactorsOn:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:false]
			</Description>
		</EntityComponent>
		<!-- TerrainSkinMedium and TerrainSkinLarge tests -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-SpawnCondition-TerrainSkinMedium</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[PlanetaryInstallation:true]
			[InstallationTerrainValidation:true]
			[DisallowedTerrainTypes:Rock]
			[PlanetaryInstallationType:Medium]
			[AdminSpawnOnly:true]
			[FactionOwner:DERELICT]
			[ForceStaticGrid:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-SpawnCondition-TerrainSkinLarge</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[PlanetaryInstallation:true]
			[InstallationTerrainValidation:true]
			[DisallowedTerrainTypes:Rock]
			[PlanetaryInstallationType:Large]
			[AdminSpawnOnly:true]
			[FactionOwner:DERELICT]
			[ForceStaticGrid:true]
			</Description>
		</EntityComponent>
		<!-- RecolorWreck and RecolorColors tests -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-SpawnCondition-RecolorWreck</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[PlanetaryInstallation:true]
			[InstallationTerrainValidation:true]
			[DisallowedTerrainTypes:Rock]
			[PlanetaryInstallationType:Small]
			[AdminSpawnOnly:true]
			[FactionOwner:DERELICT]
			[ForceStaticGrid:true]
			</Description>
		</EntityComponent>
		<!-- The small wreck manipulation without the random skins and loot, so every block starts Dust_Armor and a block the recolor missed stands out -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Manipulation-RecolorWreck</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[ClearAuthorship:true]
			[EraseIngameScripts:true]
			[UseRivalAi:true]
			[RivalAiReplaceRemoteControl:true]
			[UseBlockReplacer:true]
			[AssignGridSkin:Dust_Armor]
			[IgnoreGlobalBlockReplacer:false]
			[UseBlockReplacerProfile:true]
			[BlockReplacerProfileNames:GVK-Replacer-NPCHovers]
			[BlockReplacerProfileNames:GVK-Replacer-LargeCockpitToRivalAI]
			[BlockReplacerProfileNames:MES-Armor-LightToHeavy]
			[BlockReplacerProfileNames:GVK-Replacer-ProprietaryReactors]
			[BlockReplacerProfileNames:GVK-Replacer-NPCDisposableBeacons]
			[BlockReplacerProfileNames:GVK-Replacer-ConveyorToCargo]
			[ClearGridInventories:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Behavior-RecolorWreck</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[Triggers:GVK-Test-Trigger-RecolorWreckStart]
			[Triggers:GVK-Test-Trigger-RecolorWreck]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Trigger-RecolorWreckStart</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Test-Action-RecolorWreckStart]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Action-RecolorWreckStart</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[DebugMessage:Recolor test started. Cut a chunk off the end away from the remote control. Recolor in 120 s]
			</Description>
		</EntityComponent>
		<!-- One run, 120 s after spawn. The DebugMessage runs after RecolorGrid in the same action, so it only shows if RecolorGrid finished -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Trigger-RecolorWreck</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:false]
			[MinCooldownMs:120000]
			[MaxCooldownMs:120001]
			[MaxActions:1]
			[Actions:GVK-Test-Action-RecolorWreck]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Action-RecolorWreck</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[RecolorGrid:true]
			[RecolorSubGrids:true]
			[OldBlockSkins:Dust_Armor]
			[NewBlockSkins:Frozen_Armor]
			[DebugMessage:Recolor finished]
			</Description>
		</EntityComponent>
		<!-- The Lacewing prefab saves tan as {X:0.08055556 Y:-0.38 Z:0.11} and olive as {X:0.152777776 Y:-0.66 Z:-0.11}; the colors below are those rounded or cut to 3 decimals -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Manipulation-RecolorColors</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[ClearAuthorship:true]
			[EraseIngameScripts:true]
			[UseRivalAi:true]
			[RivalAiReplaceRemoteControl:true]
			[UseBlockReplacer:true]
			[IgnoreGlobalBlockReplacer:false]
			[UseBlockReplacerProfile:true]
			[BlockReplacerProfileNames:GVK-Replacer-NPCHovers]
			[BlockReplacerProfileNames:GVK-Replacer-LargeCockpitToRivalAI]
			[BlockReplacerProfileNames:MES-Armor-LightToHeavy]
			[BlockReplacerProfileNames:GVK-Replacer-ProprietaryReactors]
			[BlockReplacerProfileNames:GVK-Replacer-NPCDisposableBeacons]
			[BlockReplacerProfileNames:GVK-Replacer-ConveyorToCargo]
			[ClearGridInventories:true]
			[RecolorGrid:true]
			[//Tan to red]
			[RecolorOld:{X:0.081 Y:-0.38 Z:0.11}]
			[RecolorNew:{X:0 Y:0.2 Z:0.55}]
			[//Olive to Frozen_Armor]
			[ReskinTarget:{X:0.153 Y:-0.66 Z:-0.11}]
			[ReskinTexture:Frozen_Armor]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Behavior-RecolorColors</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[Triggers:GVK-Test-Trigger-RecolorColors]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Trigger-RecolorColors</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:false]
			[MinCooldownMs:30000]
			[MaxCooldownMs:30001]
			[MaxActions:1]
			[Actions:GVK-Test-Action-RecolorColors]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Action-RecolorColors</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//Olive to blue]
			[RecolorGrid:true]
			[RecolorSubGrids:true]
			[OldBlockColors:{X:0.152 Y:-0.66 Z:-0.11}]
			[NewBlockColors:{X:0.667 Y:0.2 Z:0.55}]
			[DebugMessage:Recolor action ran]
			</Description>
		</EntityComponent>
		<!-- Relation tests -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>

				</Prefab>
			</Prefabs>
		</SpawnGroup>
		<!-- /MES.Spawn.PlanetaryInstallation.GVK-Test-SpawnGroup-RecolorColors: the same wreck; the manipulation turns its tan blocks red and olive blocks Frozen_Armor, and a RecolorGrid action turns the olive blocks blue 30 s after spawn -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Test-SpawnGroup-RecolorColors</SubtypeId>
			</Id>

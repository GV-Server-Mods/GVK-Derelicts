<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<!-- Admin test spawn groups, spawnable anywhere with the /MES.Spawn command above each group. Most run production prefabs on their production behaviors;
	     the GVK-Test-Behavior ones are small test setups. [AdminSpawnOnly:true] keeps them out of natural spawning. -->
	<SpawnGroups>
		<!-- /MES.Spawn.DroneEncounter.GVK-Test-SpawnGroup-LAVTrio: three SOBAN LAVs, so the Land peer pool (1 slot) can pair, lose a wing and pair again (GVK-Settings#699) -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Test-SpawnGroup-LAVTrio</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:GVK-Unit-All-Manipulation-Hover]
				[SpawnConditionsProfiles:GVK-Test-SpawnCondition-LAVTrio]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>1.0</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NUN [SOBA] LAV">
					<Position>
						<X>0.0</X>
						<Y>30</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test LAV A</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-LAV-SOBAN</Behaviour>
				</Prefab>
				<Prefab SubtypeId="NUN [SOBA] LAV">
					<Position>
						<X>25.0</X>
						<Y>30</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test LAV B</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-LAV-SOBAN</Behaviour>
				</Prefab>
				<Prefab SubtypeId="NUN [SOBA] LAV">
					<Position>
						<X>-25.0</X>
						<Y>30</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test LAV C</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-LAV-SOBAN</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>
		<!-- /MES.Spawn.DroneEncounter.GVK-Test-SpawnGroup-Cruisers: a GAALSIEN Honorguard and Assault Cruiser (hover cruiser steering and flip tests) -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Test-SpawnGroup-Cruisers</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:GVK-Universal-Manipulation-Large3x3HeavyTurrets]
				[ManipulationProfiles:GVK-Unit-All-Manipulation-Hover]
				[SpawnConditionsProfiles:GVK-Test-SpawnCondition-Cruisers]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>1.0</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NUN [GAAL] Honorguard Cruiser">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Honorguard</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-Honorguard-GAALSIEN</Behaviour>
				</Prefab>
				<Prefab SubtypeId="NUN [GAAL] Assault Cruiser">
					<Position>
						<X>150.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Assault Cruiser</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-HoverCruiserHorsefly-GAALSIEN</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>
		<!-- /MES.Spawn.DroneEncounter.GVK-Test-SpawnGroup-Rovers: one SOBAN rover per wheeled steering profile (Baserunner, LargeRoverHorsefly, LAV) -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Test-SpawnGroup-Rovers</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:GVK-Unit-All-Manipulation-Hover]
				[ManipulationProfiles:GVK-Universal-Manipulation-Large3x3StandardTurrets]
				[SpawnConditionsProfiles:GVK-Test-SpawnCondition-Rovers]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>1.0</Frequency>
			<Prefabs>
				<!-- The Battlecruiser (45 x 92 m) sits at the spawn centre, where MES measures the drone altitude: at X 80 a rising slope buried half of it.
				     The others sit as close beside it as fits (Baserunner ~18 m wide, LAV ~4 m): 70 m out, the Baserunner still sank into slopes -->
				<Prefab SubtypeId="NUN [SOBA] Light Baserunner">
					<Position>
						<X>40.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Baserunner</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-Baserunner-SOBAN</Behaviour>
				</Prefab>
				<Prefab SubtypeId="NUN [SOBA] Battlecruiser">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Battlecruiser</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-LargeRoverHorsefly-SOBAN</Behaviour>
				</Prefab>
				<Prefab SubtypeId="NUN [SOBA] LAV">
					<Position>
						<X>-35.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test LAV</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-LAV-SOBAN</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>
		<!-- /MES.Spawn.DroneEncounter.GVK-Test-SpawnGroup-Hovers: one GAALSIEN hover per steering profile (Sandskimmer, SmallHoverHorsefly, MediumHoverPatrolHorsefly, MediumHoverPatrolFighter) -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Test-SpawnGroup-Hovers</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:GVK-Unit-All-Manipulation-Hover]
				[ManipulationProfiles:GVK-Universal-Manipulation-Large3x3StandardTurrets]
				[SpawnConditionsProfiles:GVK-Test-SpawnCondition-Hovers]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>1.0</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NUN [GAAL] Sandskimmer">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Sandskimmer</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-Sandskimmer-GAALSIEN</Behaviour>
				</Prefab>
				<Prefab SubtypeId="NUN [GAAL] Stryker Hover">
					<Position>
						<X>40.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Stryker</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-SmallHoverHorsefly-GAALSIEN</Behaviour>
				</Prefab>
				<Prefab SubtypeId="NUN [GAAL] Light Assault Platform">
					<Position>
						<X>100.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Assault Platform</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-MediumHoverPatrolHorsefly-GAALSIEN</Behaviour>
				</Prefab>
				<Prefab SubtypeId="NUN [GAAL] Light Assault Cannon">
					<Position>
						<X>-60.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Assault Cannon</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-MediumHoverPatrolFighter-GAALSIEN</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>
		<!-- /MES.Spawn.DroneEncounter.GVK-Test-SpawnGroup-Aircraft: GAALSIEN Bomber, Orion (MediumFlyer), Chad Shuttle (LargeFlyer) and Foxhound (SmallFlyer) -->
		<SpawnGroup>

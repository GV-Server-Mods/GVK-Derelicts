	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-SpawnCondition-LAVTrio</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[DroneEncounter:true]
			[AdminSpawnOnly:true]
			[MinDroneDistance:300]
			[MaxDroneDistance:400]
			[//MES default drone altitude is 1000 m, measured above the surface at the spawn centre. 50 m keeps a slope under the side LAVs below them]
			[MinDroneAltitude:50]
			[MaxDroneAltitude:50]
			[FactionOwner:SOBAN]
			[ReactorsOn:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-SpawnCondition-Cruisers</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[DroneEncounter:true]
			[AdminSpawnOnly:true]
			[MinDroneDistance:600]
			[MaxDroneDistance:800]
			[//The hulls are ~30 m tall and up to 88 m long, spread over 150 m of terrain: 40 m sank them into dunes, so 75 m]
			[MinDroneAltitude:75]
			[MaxDroneAltitude:75]
			[FactionOwner:GAALSIEN]
			[ReactorsOn:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-SpawnCondition-Rovers</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[DroneEncounter:true]
			[AdminSpawnOnly:true]
			[MinDroneDistance:400]
			[MaxDroneDistance:600]
			[//Battlecruiser is the biggest: 40 m clears a slope under it without a long drop]
			[MinDroneAltitude:40]
			[MaxDroneAltitude:40]
			[FactionOwner:SOBAN]
			[ReactorsOn:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-SpawnCondition-Hovers</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[DroneEncounter:true]
			[AdminSpawnOnly:true]
			[MinDroneDistance:400]
			[MaxDroneDistance:600]
			[//Same as the cruiser test: hover engines pull the hull down onto the terrain below]
			[MinDroneAltitude:75]
			[MaxDroneAltitude:75]
			[FactionOwner:GAALSIEN]
			[ReactorsOn:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:false]
			</Description>
		</EntityComponent>

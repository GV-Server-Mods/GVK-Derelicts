		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Behavior-RelationSOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Test-Target-RelationSOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Behavior-RelationCOALITION</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Test-Target-RelationCOALITION]
			</Description>
		</EntityComponent>
		<!-- The two target profiles are identical; separate names so the log shows which LAV is rating -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Target-RelationSOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Target]
			[UseCustomTargeting:true]
			[Target:PlayerAndGrid]
			[TimeUntilTargetAcquisition:2]
			[TimeUntilNextEvaluation:5]
			[UseTargetRefresh:true]
			[TimeUntilNextRefresh:10]
			[MaxDistance:3000]
			[MatchAnyFilters:Owner]
			[Owners:Player]
			[Owners:NPC]
			[MatchAllFilters:Relation]
			[Relations:Enemy]
			[GetTargetBy:ClosestDistance]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Test-Target-RelationCOALITION</SubtypeId>
			</Id>
			<Description>
			[RivalAI Target]
			[UseCustomTargeting:true]
			[Target:PlayerAndGrid]
			[TimeUntilTargetAcquisition:2]
			[TimeUntilNextEvaluation:5]
			[UseTargetRefresh:true]
			[TimeUntilNextRefresh:10]
			[MaxDistance:3000]
			[MatchAnyFilters:Owner]
			[Owners:Player]
			[Owners:NPC]
			[MatchAllFilters:Relation]
			[Relations:Enemy]
			[GetTargetBy:ClosestDistance]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>

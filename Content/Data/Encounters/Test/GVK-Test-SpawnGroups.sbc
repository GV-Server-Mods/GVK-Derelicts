				</Prefab>
				<Prefab SubtypeId="NUN [GAAL] Orion">
					<Position>
						<X>100.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Orion</BeaconText>
					<Behaviour>GVK-Unit-All-Behavior-MediumFlyerPatrolHorsefly-GAALSIEN</Behaviour>
				</Prefab>
				<Prefab SubtypeId="NUN [GAAL] Chad Shuttle">
					<Position>
						<X>-100.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Test Chad Shuttle</BeaconText>

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Condition for beacon disabled triggers with all known beacon names -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-BeaconDisabled-WIP</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[UseRequiredFunctionalBlocks:true]
			[RequiredNoneFunctionalBlockNames:Proprietary Beacon]
			[RequiredNoneFunctionalBlockNames:Small Signal]
			[RequiredNoneFunctionalBlockNames:Medium Signal]
			[RequiredNoneFunctionalBlockNames:Large Signal]
			[RequiredNoneFunctionalBlockNames:Massive Signal]
			[RequiredNoneFunctionalBlockNames:Disposable Beacon]
			[RequiredNoneFunctionalBlockNames:Fortress]
			[RequiredNoneFunctionalBlockNames:Hangar]
			[RequiredNoneFunctionalBlockNames:Outpost]
			[RequiredNoneFunctionalBlockNames:Player KOTH]
			[RequiredNoneFunctionalBlockNames:Distress Signal]
			[RequiredNoneFunctionalBlockNames:Large Distress Signal]
			[RequiredNoneFunctionalBlockNames:Downed Salvager]
			[RequiredNoneFunctionalBlockNames:Base]
			[MatchAnyCondition:false]
			[CheckForBlocksOfType:true]
			[BlocksOfType:MyObjectBuilder_Beacon]
			[UseFailCondition:true]
			</Description>
		</EntityComponent>
		<!-- Condition to check if attacker is neutral player -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-AttackerIsNeutralPlayer</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[IsAttackerNeutral:true]
			[CheckIfDamagerIsPlayer:true]
			</Description>
		</EntityComponent>
		<!-- Condition to check if attacker is enemy player -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-AttackerIsEnemyPlayer</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[IsAttackerHostile:true]
			[CheckIfDamagerIsPlayer:true]
			</Description>
		</EntityComponent>
		<!-- Condition to check if attacker is friendly player (reputation 501 or higher) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-AttackerIsFriendlyPlayer</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[IsAttackerFriendly:true]
			[CheckIfDamagerIsPlayer:true]
			</Description>
		</EntityComponent>
		<!-- Condition to check if previously damaged by neutral player -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-DamagedByNeutralPlayer</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:DamagedByNeutralPlayer]
			</Description>
		</EntityComponent>
		<!-- Condition to check if previously damaged by enemy player -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-DamagedByEnemyPlayer</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:DamagedByEnemyPlayer]
			</Description>
		</EntityComponent>
		<!-- Condition to check if previously damaged by non-friendly player -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-DamagedByNonFriendlyPlayer</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckTrueBooleans:true]
			[TrueBooleans:DamagedByNeutralPlayer]
			[TrueBooleans:DamagedByEnemyPlayer]
			[AllowAnyTrueBoolean:true]
			</Description>
		</EntityComponent>
		<!-- Condition for no functional beacons, this may be abusable if players place their own beacons first -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-AllBeaconsDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckForBlocksOfType:true]
			[BlocksOfType:MyObjectBuilder_Beacon]
			[UseFailCondition:true]
			</Description>
		</EntityComponent>
		<!-- Condition to check if an NPC received a command from its parent that spawned it -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-ReceiveCommandFromParent</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CommandCheckFromParent:true]
			[CommandFromParent:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
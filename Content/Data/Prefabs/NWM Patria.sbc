scanRadius=20000

[SettingsLifeSupportStatus]
; [ LIFESUPPORT - GENERAL OPTIONS ]
SearchId=*
ExcludeIds=Airlock,
ShowHeader=True
ShowSubgrids=False
SubgridUpdateFrequency=100
; Subgrid scan frequency: 1=fastest (60/sec), 10=normal (6/sec), 100=slowest (0.6/sec)
ShowDocked=False
UseColors=True
; [ LIFESUPPORT - LAYOUT OPTIONS ]
TextSize=0.45
ViewPortOffsetX=12
ViewPortOffsetY=12
TitleFieldWidth=128
RatioFieldWidth=96
; [ LIFESUPPORT - SCREEN OPTIONS ]
ShowBatteries=True
ShowHydrogen=True
ShowOxygen=True
ShowIce=True
ShowVent=True
ShowIntakeVent=True
; [ LIFESUPPORT - ITEM THRESHOLDS ]
IceMinAmount=50000

[SettingsSystemsStatus]
; [ SYSTEMS - GENERAL OPTIONS ]
SearchId=*
ExcludeIds=
ShowHeader=True
ShowSummary=True
ShowRatio=True
ShowBars=True
ShowSubgrids=False
SubgridUpdateFrequency=100
; Subgrid scan frequency: 1=fastest (60/sec), 10=normal (6/sec), 100=slowest (0.6/sec)
ShowDocked=True
UseColors=True
; [ SYSTEMS - LAYOUT OPTIONS ]
TextSize=0.4
ViewPortOffsetX=20
ViewPortOffsetY=10
TitleFieldWidth=96
RatioFieldWidth=128
; [ SYSTEMS - SCREEN OPTIONS ]
ShowIntegrity=True
ShowHealthyCategories=False
ShowMovement=True
ShowCommunications=True
ShowTanks=True
ShowPower=True
ShowProduction=True
ShowContainers=True
ShowDoors=True
ShowControllers=True
ShowGyros=True
ShowMechanical=True
ShowJumpdrives=True
ShowWeapons=True
ShowTools=True
ShowAutomation=True
ShowMedical=True

[SettingsPowerStatus]
; [ POWER - GENERAL OPTIONS ]
SearchId=*
ExcludeIds=
ShowHeader=True
ShowSummary=True
ShowRatio=False
ShowBars=True
ShowSubgrids=False
SubgridUpdateFrequency=100
; Subgrid scan frequency: 1=fastest (60/sec), 10=normal (6/sec), 100=slowest (0.6/sec)
ShowDocked=False
UseColors=True
; [ POWER - LAYOUT OPTIONS ]
TextSize=0.4
ViewPortOffsetX=10
ViewPortOffsetY=10
TitleFieldWidth=140
RatioFieldWidth=104
; [ POWER - SCREEN OPTIONS ]
ShowSolar=True
ShowWind=True
ShowBatteries=True
ShowReactors=True
ShowEngines=True
ShowInactive=True
SummaryOnly=False
; [ POWER - ITEM THRESHOLDS ]
UraniumMinAmount=500
</Value>
                          </item>
                        </dictionary>
                      </Storage>
                    </Component>
                  </ComponentData>
                </Components>
              </ComponentContainer>

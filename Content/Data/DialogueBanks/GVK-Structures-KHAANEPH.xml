<?xml version="1.0" encoding="utf-8"?>
<!-- KHAANEPH Base, Outpost and Turret chatter. Behaviors pick this bank with [DialogueBanks:GVK-Structures-KHAANEPH.xml]; actions play a cue with [PlayDialogueCue:true] + [DialogueCueId:]. -->
<DialogueBank>
	<ChatProfileId>GVK-Universal-Chat-UnitVoice</ChatProfileId>
	<DialogueCue>
		<DialogueCueId>NeutralAttacked</DialogueCueId>
		<Entries>
			<Entry>
				<Message>You fire on our den? Now you're prey.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>This is Khaaneph ground. You'll leave in pieces.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Turncoat. We'll pick your bones clean.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Thought we were friends? Wrong.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
		</Entries>
	</DialogueCue>
	<DialogueCue>
		<DialogueCueId>EnemyAttacked</DialogueCueId>
		<Entries>
			<Entry>
				<Message>They're at the walls! Rip them apart!</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Fresh scrap at the perimeter!</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Nobody takes Khaaneph ground.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Let them come. More salvage for us.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
		</Entries>
	</DialogueCue>
</DialogueBank>

<?xml version="1.0" encoding="utf-8"?>
<!-- COALITION installation, Wreck and Downed Salvager chatter. Behaviors pick this bank with [DialogueBanks:GVK-Installations-COALITION.xml]; actions play a cue with [PlayDialogueCue:true] + [DialogueCueId:]. -->
<DialogueBank>
	<ChatProfileId>GVK-Universal-Chat-UnitVoice</ChatProfileId>
	<DialogueCue>
		<DialogueCueId>NeutralAttacked</DialogueCueId>
		<Entries>
			<Entry>
				<Message>Cease fire! This is a Coalition site.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Check your fire. We're on your side.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Unprovoked attack on Coalition property logged.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Neutral contact firing on us. Requesting Coalition support.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
		</Entries>
	</DialogueCue>
	<DialogueCue>
		<DialogueCueId>EnemyAttacked</DialogueCueId>
		<Entries>
			<Entry>
				<Message>Site under attack! Return fire.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Hostiles at the perimeter.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Taking hits. Hold this position.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>We need support out here!</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
		</Entries>
	</DialogueCue>
</DialogueBank>

<?xml version="1.0" encoding="utf-8"?>
<!-- COALITION Trader and Transport chatter. Behaviors pick this bank with [DialogueBanks:GVK-Travellers-COALITION.xml]; actions play a cue with [PlayDialogueCue:true] + [DialogueCueId:]. -->
<DialogueBank>
	<ChatProfileId>GVK-Universal-Chat-UnitVoice</ChatProfileId>
	<DialogueCue>
		<DialogueCueId>NeutralAttacked</DialogueCueId>
		<Entries>
			<Entry>
				<Message>Cease fire! This is a civilian Coalition vessel.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>We're traders, not targets. Stop shooting!</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Mayday, mayday. A neutral contact is firing on us.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Attack on a Coalition convoy logged. Command has your signature.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
		</Entries>
	</DialogueCue>
	<DialogueCue>
		<DialogueCueId>EnemyAttacked</DialogueCueId>
		<Entries>
			<Entry>
				<Message>Taking fire! Requesting escort support.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Cargo hold breached. Keep moving!</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Hostiles on the route. Push through.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Armor won't hold long. Somebody help!</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
		</Entries>
	</DialogueCue>
</DialogueBank>

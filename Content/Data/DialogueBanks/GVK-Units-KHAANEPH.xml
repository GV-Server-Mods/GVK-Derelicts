<?xml version="1.0" encoding="utf-8"?>
<!-- KHAANEPH Unit chatter. Behaviors pick this bank with [DialogueBanks:GVK-Units-KHAANEPH.xml]; actions play a cue with [PlayDialogueCue:true] + [DialogueCueId:]. -->
<DialogueBank>
	<ChatProfileId>GVK-Universal-Chat-UnitVoice</ChatProfileId>
	<DialogueCue>
		<DialogueCueId>TargetAcquired</DialogueCueId>
		<Entries>
			<Entry>
				<Message>Target acquired.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Target locked.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Don't let them near the carrier.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>We'll handle this.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Engaging enemy.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Enemy detected.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>{Faction} Reinforcements have arrived.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>We're from the {Faction} and we're here to help.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>We must find the primary anomaly.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Protect the Jaraci Object.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>For Kiith {Faction}.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Destroy the zealots.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
		</Entries>
	</DialogueCue>
	<DialogueCue>
		<DialogueCueId>NoTargets</DialogueCueId>
		<Entries>
			<Entry>
				<Message>Sector is Clear.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Searching for targets.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>No enemies detected.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>I think we got them all.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Keep your eyes open for more enemies.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
		</Entries>
	</DialogueCue>
	<DialogueCue>
		<DialogueCueId>NeutralAttacked</DialogueCueId>
		<Entries>
			<Entry>
				<Message>You bite the hand, we take the arm.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Backstab the Khaaneph? Wrong desert.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Turn on us and the sand keeps your bones.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>No more deals. Now you're prey.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
		</Entries>
	</DialogueCue>
	<DialogueCue>
		<DialogueCueId>EnemyAttacked</DialogueCueId>
		<Entries>
			<Entry>
				<Message>It bites back! Good.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Rip them open!</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Their scrap is ours.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Hit me again. I dare you.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
		</Entries>
	</DialogueCue>
	<DialogueCue>
		<DialogueCueId>FriendlyFire</DialogueCueId>
		<Entries>
			<Entry>
				<Message>Hey! Shoot the other ones!</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Aim at the prey, not the pack.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Hit me again and we're not friends anymore.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
			<Entry>
				<Message>Wrong scrap, ally.</Message>
				<AudioId>ArcHudGPSNotification2</AudioId>
				<Weights>1</Weights>
			</Entry>
		</Entries>
	</DialogueCue>
</DialogueBank>

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>
		<!-- AiEnabled Bots -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-NPC-Derelict-GAALSIEN-DefenseBots</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]

				[CreatureSpawn:true]
				[CreatureIds:Police_Bot]
				[AdminSpawnOnly:true]
				[AiEnabledReady:true]
				[AiEnabledModBots:true]
				[AiEnabledRole:SOLDIER]
				[FactionOwner:GAALSIEN]
				[MinCreatureCount:0]
				[MaxCreatureCount:4]
				[MinCreatureDistance:10]
				[MaxCreatureDistance:20]
			</Description>
			<IsPirate>true</IsPirate>
			<!--Do not edit-->
			<Frequency>5.0</Frequency>
			<Prefabs>
				<Prefab SubtypeId="MES-CreaturePrefabDummy">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>25</Speed>
					<Behaviour/>
				</Prefab>
			</Prefabs>
		</SpawnGroup>
	</SpawnGroups>
</Definitions>
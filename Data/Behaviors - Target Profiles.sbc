				[UseTargetRefresh:true]
				[TimeUntilNextRefresh:15]
				[TimeUntilNextEvaluation:10]
				[MaxDistance:800]
				[MaxExistingTargetDistance:1500]
				[GetTargetBy:ClosestDistance]
				[MatchAllFilters:Relation]
				[MatchAllFilters:OutsideOfSafezone]
				[MatchNoneFilters:Name]
				[MatchAllFilters:TargetValue]
				[MatchAllFilters:PlayerControlled]
				[MatchAllFilters:Powered]
				[Relations:Enemy]
				[Names:[NPC] Trade Station Bridge]
				[UsePartialNameMatching:true]
				[MinTargetValue:20]
				[MaxTargetValue:999999]
				[PrioritizePlayerControlled:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>

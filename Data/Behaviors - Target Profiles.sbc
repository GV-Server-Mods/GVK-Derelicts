			</Id>
			<Description>
				[RivalAI Target]
				[UseCustomTargeting:true]
				[Target:Grid]
				[UseTargetRefresh:true]
				[TimeUntilNextRefresh:15]
				[TimeUntilNextEvaluation:10]
				[MaxDistance:3000]

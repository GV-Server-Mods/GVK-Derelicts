    Add("AngleGrinder2Item", "Tool", 0, "* Enh. Grinder");
    Add("AngleGrinder3Item", "Tool", 0, "** Prof. Grinder");
    Add("AngleGrinder4Item", "Tool", 0, "*** Elite Grinder");

                            </MyObjectBuilder_CubeBlock>
                            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_Conveyor">
                              <SubtypeName>LargeBlockConveyor</SubtypeName>
                              <EntityId>108535201725640970</EntityId>
                              <Min x="6" y="4" z="4" />

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Zone for Convoy Spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIEN-Zone</SubtypeId>
			</Id>
			<Description>
				[MES Zone]
				[PublicName:Convoy Encounter]
				[Active:true]
				[Persistent:true]
				[Strict:false]
				[Coordinates:{X:87171 Y:85257 Z:87167}]
				[Radius:15000]
				[UseAllowedSpawnGroups:true]
				[AllowedSpawnGroups:GVK-Mothership-GAALSIEN-Convoy1]
				[AllowedSpawnGroups:GVK-NPC-StaticEncounter-ConvoyOutpost]
				[UseZoneAnnounce:true]
				[ZoneEnterAnnounce:Entering Convoy Zone]
				[ZoneLeaveAnnounce:Leaving Convoy Zone]
			</Description>
		</EntityComponent>

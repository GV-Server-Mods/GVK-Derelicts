		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Manipulation-Derelicts-Small</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:100]
				[ClearAuthorship:true]
				[EraseIngameScripts:true]
				[UseBlockReplacer:true]
				[AssignGridSkin:Dust_Armor]
				[SkinRandomBlocks:true]
				[SkinRandomBlocksTextures:Heavy_Rust_Armor]
				[MinPercentageSkinRandomBlocks:10]
				[MaxPercentageSkinRandomBlocks:25]
				[ReduceBlockBuildStates:true]
				[MinimumBlocksPercent:10]
				[MaximumBlocksPercent:25]
				[MinimumBuildPercent:50]
				[MaximumBuildPercent:70]
				[IgnoreGlobalBlockReplacer:false]
				[ClearGridInventories:true]
				[DisableBlocksWithName:Survival,Blood]
				[AllowPartialNames:true]
				[UseLootProfiles:true]
				[LootProfiles:GVK-Derelict-Loot-Small]
				[UseGridDereliction:true]
				[DerelictionProfiles:GVK-Dereliction-NonArmor-DamageOnly]
				[DerelictionProfiles:GVK-Dereliction-Thrusters-DamageOnly] 
				[DerelictionProfiles:GVK-Dereliction-DerelictTurrets-NoComps]
				[DerelictionProfiles:GVK-Dereliction-RocketLaunchers-NoComps]
				[EnableBlocksWithName:Designator,Turret,turret,interior,Interior,gatling,Gatling]
				[AllowPartialNames:true]
			</Description>
		</EntityComponent>

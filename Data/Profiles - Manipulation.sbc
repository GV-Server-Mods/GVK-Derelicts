				[BlockReplacerProfileNames:GVK-Replacer-LargeCockpitToRivalAI]
				[BlockReplacerProfileNames:MES-Armor-LightToHeavy]
				[ConfigureSpecialNpcThrusters:true]
				[RestrictNpcIonThrust:true]
				[NpcIonThrustForceMultiply:5]
				[NpcIonThrustPowerMultiply:0.0001]
				[RestrictNpcAtmoThrust:true]
				[NpcAtmoThrustForceMultiply:5]
				[NpcAtmoThrustPowerMultiply:0.0001]
				[RestrictNpcHydroThrust:true]
				[NpcHydroThrustForceMultiply:5]

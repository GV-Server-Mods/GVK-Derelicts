<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Manipulation-TradeStationBridge</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:100]
				[ClearAuthorship:true]
				[EraseIngameScripts:true]
				[IgnoreGlobalBlockReplacer:true]
				[UseBlockReplacerProfile:true]
				[BlockReplacerProfileNames:GVK-Replacer-LargeCockpitToRivalAI]
				[BlockReplacerProfileNames:GVK-Replacer-ProprietaryReactors]
				[ClearGridInventories:true]
				[GridsAreEditable:false]
				[GridsAreDestructable:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>

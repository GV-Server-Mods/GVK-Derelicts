		<!-- [NPC Drone] Honorguard MAC Hover -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<!--Do Not Edit-->
				<SubtypeId>GVK-Drone-GAALSIEN-Honorguard</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:MES-Manipulation-RivalAi] 
				[ManipulationProfiles:GVK-Manipulation-DefenseDrones-Hover]
				[SpawnConditionsProfiles:GVK-SpawnConditions-DefenseDrones-IonFlyer]
			</Description>
			<IsPirate>true</IsPirate>
			<!--Do not edit-->
			<Frequency>0.1</Frequency>
			<Prefabs>
				<Prefab SubtypeId="[NPC Drone] Honorguard">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Honorguard</BeaconText>
					<Behaviour>DefenseDrone-HorseFighterHoverMAC-Behavior-Start</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

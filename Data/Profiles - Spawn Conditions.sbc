		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-SpawnConditions-Mothership-Hover</SubtypeId>
			</Id>
			<Description>
				[MES Spawn Conditions]
				[DroneEncounter:true]
				[BossEncounterAny:false]
				[BossCustomAnnounceEnable:true]
				[BossCustomAnnounceAuthor:Coalition]
				[BossCustomAnnounceMessage:Gaalsien convoy has been spotted]
				[BossCustomGPSLabel:Convoy last known location]
				[MinimumPlayerTime:0]
				[MaximumPlayerTime:60]
				[MinDroneDistance:1000]
				[MaxDroneDistance:5000]
				[MinDroneAltitude:10]
				[MaxDroneAltitude:50]
				[SkipAirDensityCheck:true]
				[FactionOwner:GAALSIEN]
				[ReactorsOn:true]
				[ForceStaticGrid:false]
				[MinGravity:0.5]
				[MaxGravity:1.5]
				[MinSpawnFromPlanetSurface:-1]
				[MaxSpawnFromPlanetSurface:2000]
				[UseRemoteControlCodeRestrictions:true]
				[RemoteControlCode:ConvoyEncounter]
				[RemoteControlCodeMinDistance:9999999]
				[ZoneName:Convoy Encounter]
				[MaxDistanceFromZoneCenter:5000]
				[MinSpawnedZoneEncounters:0]
			</Description>

				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-SpawnConditions-Derelicts-Small</SubtypeId>
			</Id>
			<Description>
				[MES Spawn Conditions]
				[PlanetaryInstallation:true]
				[PlanetaryInstallationType:Small]
				[FactionOwner:GAALSIEN]
				[ForceStaticGrid:true]
				[RotateInstallations:{X:100 Y:100 Z:100}]

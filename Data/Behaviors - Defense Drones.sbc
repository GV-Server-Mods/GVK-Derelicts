      [RotationMultiplier:0.7]
	  [DisableInertiaDampeners:false]
      [FlyLevelWithGravity:false]
      [LevelWithGravityWhenIdle:true]
	  [MaxVerticalSpeed:20]
	  [IdealPlanetAltitude:250]
	  [MinimumPlanetAltitude:250]
	  [AltitudeTolerance:50]
	  [CollisionEvasionWaypointCalculatedAwayFromEntity:true]
      [WaypointTolerance:100]
      [IdealMinSpeed:50]
      [IdealMaxSpeed:75]
      [SlowDownOnWaypointApproach:false]
      [ExtraSlowDownDistance:25]

      [OffsetSpaceMinDistFromTarget:600]
      [OffsetSpaceMaxDistFromTarget:1200]
      [OffsetPlanetMinDistFromTarget:600]
      [OffsetPlanetMaxDistFromTarget:1200]
      [OffsetPlanetMinTargetAltitude:-200]
      [OffsetPlanetMaxTargetAltitude:300]
      [AllowStrafing:true]
      [StrafeMinDurationMs:2000]
      [StrafeMaxDurationMs:10000]
	  [StrafeMinCooldownMs:0]
	  [StrafeMaxCooldownMs:1]
      [StrafeSpeedCutOff:45]	  
	  [StrafeMinimumTargetDistance:600]
	  [StrafeMinimumSafeAngleFromTarget:30]

      [ReverseOffsetDistAltAboveHeight:false]
      [ReverseOffsetHeight:0]
	  [AngleAllowedForForwardThrust:90]
      
      </Description>
    </EntityComponent>

	<!-- Horsefly Rover Drone Behavior -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>DefenseDrone-Rover-Behavior-Start</SubtypeId>
      </Id>
      <Description>
	  
      [RivalAI Behavior]
	  
      [BehaviorName:Horsefly]

	  [UseStaticGuns:true]
	  [MaxStaticWeaponRange:1500]
	  [WeaponMaxAngleFromTarget:10]
	  [UseAmmoReplenish:true]
	  [AmmoReplenishClipAmount:10]
	  [MaxAmmoReplenishments:99999999]
	  [UsePlayerDistanceTimer:true]
	  [PlayerDistanceTimerTrigger:0]
	  [PlayerDistanceTrigger:15000]
	  [UseNoTargetTimer:true]
	  [NoTargetTimerTrigger:1800]
	  [UseRetreatTimer:true]
	  [RetreatTimerTrigger:3600]
	  [RetreatDespawnDistance:1500]
	  
	  [AutopilotData:DefenseDrone-Rover-Autopilot]
	  
	  [TargetData:GVK-Generic-TargetProfile-EnemyPlayers]

	  [Triggers:DefenseDrone-Trigger-FireArchers]
	  [Triggers:DefenseDrone-Trigger-StopArchers]
	  [Triggers:DefenseDrone-Trigger-WeaponsToMaxRange]
	  [Triggers:GVK-Generic-Trigger-SPRTTargetAcquiredChatter]
	  [Triggers:DefenseDrone-Trigger-Compromised]
	  [Triggers:GVK-Generic-Trigger-SPRTNoWeapon]
  
      </Description>
    </EntityComponent>

	<!-- Horsefly Rover Autopilot -->
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>DefenseDrone-Rover-Autopilot</SubtypeId>
      </Id>
      <Description>

      [RivalAI Autopilot]
      
	  [UseVelocityCollisionEvasion:true]

      [RotationMultiplier:1]
	  [DisableInertiaDampeners:false]
      [FlyLevelWithGravity:true]
      [LevelWithGravityWhenIdle:true]
	  [IdealPlanetAltitude:3]
	  [MinimumPlanetAltitude:-100]
	  [AltitudeTolerance:5000]
	  [CollisionEvasionWaypointCalculatedAwayFromEntity:true]
	  [WaypointAbandonTimeTrigger:20]
      [WaypointTolerance:100]
      [IdealMinSpeed:35]
      [IdealMaxSpeed:75]
	  [UseSurfaceHoverThrustMode:false]
	  [HoverPathStepDistance:150]

      [OffsetPlanetMinDistFromTarget:500]
      [OffsetPlanetMaxDistFromTarget:800]
      [OffsetPlanetMinTargetAltitude:-50]
      [OffsetPlanetMaxTargetAltitude:50]
	  
      [ReverseOffsetDistAltAboveHeight:false]
      [ReverseOffsetHeight:0]
	  [AngleAllowedForForwardThrust:120]
	  [MaxVelocityAngleForSpeedControl:180]
      
      </Description>
    </EntityComponent>

	<!-- Action group to set turrets to max range because of a bug in MES right now -->

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>DefenseDrone-Trigger-WeaponsToMaxRange</SubtypeId>
      </Id>
      <Description>
	  
      [RivalAI Trigger]
	  
	  [UseTrigger:true]
	  [Type:Timer]
	  [StartsReady:true]
	  [MinCooldownMs:1000000]
	  [MaxCooldownMs:1000000]
	  	  
	  [Actions:DefenseDrone-Action-WeaponsToMaxRange]
	  
      </Description>
    </EntityComponent>

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>DefenseDrone-Action-WeaponsToMaxRange</SubtypeId>
      </Id>
      <Description>
	  
      [RivalAI Action]
	  	  
	  [SetWeaponsToMaxRange:true]
	  
      </Description>
    </EntityComponent>

	<!-- Action group to fire Fixed Rockets because of a bug in WC2 right now -->

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>DefenseDrone-Trigger-FireRockets</SubtypeId>
      </Id>
      <Description>
	  
      [RivalAI Trigger]
	  
	  [UseTrigger:true]
	  [Type:TargetNear]
	  
	  [TargetDistance:1000]
	  
	  [Conditions:DefenseDrone-Condition-FireRockets]
	  
	  [Actions:DefenseDrone-Action-FireRockets]
	  
      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>DefenseDrone-Condition-FireRockets</SubtypeId>
      </Id>
      <Description>

      [RivalAI Condition]
      
      [UseConditions:true]
      [MatchAnyCondition:true]
	  
	  [CheckTargetAngleFromForward:true]
	  [MinTargetAngle:0]
	  [MaxTargetAngle:15]
      
      </Description> 
    </EntityComponent>		

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>DefenseDrone-Action-FireRockets</SubtypeId>
      </Id>
      <Description>
	  
      [RivalAI Action]
	  	  
	  [ToggleBlocksOfType:true]
	  [BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncher/]
	  [BlockTypeToggles:On]
	  [BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncher/null]
	  [BlockTypeToggles:On]
	  [BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncher/LargeMissileLauncher]
	  [BlockTypeToggles:On]
	  
	  [ResetCooldownTimeOfTriggers:true]
	  [ResetTriggerCooldownNames:DefenseDrone-Trigger-StopRockets]
	  
      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>DefenseDrone-Trigger-StopRockets</SubtypeId>
      </Id>
      <Description>
	  
      [RivalAI Trigger]
	  
	  [UseTrigger:true]
	  [Type:Timer]
	  [MinCooldownMs:1000]
	  [MaxCooldownMs:1000]
	  	  
	  [Actions:DefenseDrone-Action-StopRockets]
	  
      </Description>
    </EntityComponent>
		
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>DefenseDrone-Action-StopRockets</SubtypeId>
      </Id>
      <Description>
	  
      [RivalAI Action]
	  
	  [ToggleBlocksOfType:true]
	  [BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncher/]
	  [BlockTypeToggles:Off]
	  [BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncher/null]
	  [BlockTypeToggles:Off]
	  [BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncher/LargeMissileLauncher]
	  [BlockTypeToggles:Off]
	  
      </Description>
    </EntityComponent>
	
	<!-- Action group to fire Archer Pods because of a bug in WC2 right now -->

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>DefenseDrone-Trigger-FireArchers</SubtypeId>
      </Id>
      <Description>
	  
      [RivalAI Trigger]
	  
	  [UseTrigger:true]
	  [Type:TurretTarget]
	  
	  [MinCooldownMs:1000]
	  [MaxCooldownMs:1000]
	  [StartsReady:false]
	  
	  [TargetDistance:2000]
	  	  
	  [Actions:DefenseDrone-Action-FireArchers]
	  
      </Description>
    </EntityComponent>

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>DefenseDrone-Action-FireArchers</SubtypeId>
      </Id>
      <Description>
	  
      [RivalAI Action]
	  	  

	  [ToggleBlocksOfType:true]
	  [BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncherReload/SmallRocketLauncherReload]
	  [BlockTypeToggles:On]
	  [BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncherReload/]
	  [BlockTypeToggles:On]
	  [BlockTypesToToggle:MyObjectBuilder_ConveyorSorter/MXA_ArcherPods]
	  [BlockTypeToggles:On]
	  
	  [ResetCooldownTimeOfTriggers:true]
	  [ResetTriggerCooldownNames:DefenseDrone-Trigger-StopArchers]
	  
      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>DefenseDrone-Trigger-StopArchers</SubtypeId>
      </Id>
      <Description>
	  
      [RivalAI Trigger]
	  
	  [UseTrigger:true]
	  [Type:Timer]
	  [MinCooldownMs:1500]
	  [MaxCooldownMs:1500]
	  	  

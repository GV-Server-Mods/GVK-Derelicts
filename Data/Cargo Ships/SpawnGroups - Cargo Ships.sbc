<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>
		<!-- [NPC CargoShip] Soban Industrial Corvette -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<!--Do Not Edit-->
				<SubtypeId>GVK-CargoShip-SOBAN-IndustrialCorvette</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:MES-Manipulation-RivalAi] 
				[SpawnConditionsProfiles:GVK-SpawnConditions-CargoShip-Soban]
				[ManipulationProfiles:GVK-Manipulation-CargoShip]
			</Description>
			<IsPirate>true</IsPirate>
			<!--Do not edit-->
			<Frequency>0.1</Frequency>
			<Prefabs>
				<Prefab SubtypeId="[NPC CargoShip] Industrial Corvette">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Cargo Ship</BeaconText>
					<Behaviour>GVK-CargoShip-SOBAN-Behavior-Start</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

			[MES AI Trigger]
			[UseTrigger:true]
			[Type:InsideActiveZone]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:false]
			[ZoneName:KHAANEPH_Zone_10000]
			[Actions:GVK-Alliance-SupplyDepot-Action-InsideZonesCheck-KHAANEPH]

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- An MES bug is preventing this from working. InsideZone still succeeds if it is inside an inactive Zone.
			 Also, MES zone radius actions are not functioning at all -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-TriggerGroup-SupplyDepotZone</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Alliance-SupplyDepot-Trigger-Inside10000Check-KHAANEPH]
			[Triggers:GVK-Alliance-SupplyDepot-Trigger-Inside20000Check-KHAANEPH]
			[Triggers:GVK-Alliance-SupplyDepot-Trigger-Inside30000Check-KHAANEPH]
			[Triggers:GVK-Alliance-SupplyDepot-Trigger-Inside40000Check-KHAANEPH]
			[Triggers:GVK-Alliance-SupplyDepot-Trigger-Inside50000Check-KHAANEPH]
			[Triggers:GVK-Alliance-SupplyDepot-ManualTrigger-InsideZone-KHAANEPH]
			[Triggers:GVK-Alliance-SupplyDepot-Trigger-Inside10000Check-SOBAN]
			[Triggers:GVK-Alliance-SupplyDepot-Trigger-Inside20000Check-SOBAN]
			[Triggers:GVK-Alliance-SupplyDepot-Trigger-Inside30000Check-SOBAN]
			[Triggers:GVK-Alliance-SupplyDepot-Trigger-Inside40000Check-SOBAN]
			[Triggers:GVK-Alliance-SupplyDepot-Trigger-Inside50000Check-SOBAN]

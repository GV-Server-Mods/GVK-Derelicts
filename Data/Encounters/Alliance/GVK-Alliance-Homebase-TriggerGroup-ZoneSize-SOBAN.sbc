	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-TriggerGroup-ZoneSize-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Alliance-Homebase-Trigger-EnableZone20000-SOBAN]
			[Triggers:GVK-Alliance-Homebase-Trigger-DisableZone20000-SOBAN]
			[Triggers:GVK-Alliance-Homebase-Trigger-EnableZone30000-SOBAN]
			[Triggers:GVK-Alliance-Homebase-Trigger-DisableZone30000-SOBAN]
			[Triggers:GVK-Alliance-Homebase-Trigger-EnableZone40000-SOBAN]
			[Triggers:GVK-Alliance-Homebase-Trigger-DisableZone40000-SOBAN]
			[Triggers:GVK-Alliance-Homebase-Trigger-EnableZone50000-SOBAN]
			[Triggers:GVK-Alliance-Homebase-Trigger-DisableZone50000-SOBAN]
			</Description>
		</EntityComponent>
		<!-- Trigger to check and enable 2000m Alliance Zone -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Trigger-EnableZone20000-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:false]
			[MaxActions:-1]
			[Actions:GVK-Alliance-Homebase-Action-EnableZone20000-SOBAN]
			[Conditions:GVK-Alliance-Homebase-Condition-EnableZone20000-SOBAN]
			[ConditionCheckResetsTimer:true]
			[ToggleWithTriggerProfile:GVK-Alliance-Homebase-Trigger-DisableZone20000-SOBAN]
			[ToggledProfileResetsCooldown:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Condition-EnableZone20000-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:SOBAN_Points]
			[CustomSandboxCountersTargets:100]
			[SandboxCounterCompareTypes:GreaterOrEqual]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Action-EnableZone20000-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ChangeZoneAtPosition:true]
			[ZoneName:SOBAN_Zone_20000]
			[ZoneToggleActive:true]
			[ZoneToggleActiveMode:true]
			[ZoneRadiusChangeType:Set]
			[ZoneRadiusChangeAmount:20000]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Homebase-Chat-EnableZone20000-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Chat-EnableZone20000-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:SOBAN]
			[Color:White]
			[ChatMessages:Zone 2000 enabled.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]
			</Description>
		</EntityComponent>

		<!-- trigger to check all zone bools for despawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Outpost-Trigger-OutsideAllZones-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:300000]
			[MaxCooldownMs:300001]
			[StartsReady:false]
			[Actions:GVK-Alliance-Outpost-Action-OutsideAllZones-KHAANEPH]
			[Actions:GVK-Universal-Action-MediumExplosionEffects]
			[Conditions:GVK-Alliance-Outpost-Condition-OutsideAllZones-KHAANEPH]
			[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<!-- if Zone bools are all true, then outside all zones, then despawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Outpost-Condition-OutsideAllZones-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:Zone10000Check]
			[TrueBooleans:Zone20000Check]
			[TrueBooleans:Zone30000Check]
			[TrueBooleans:Zone40000Check]
			[TrueBooleans:Zone50000Check]
			[AllowAnyTrueBoolean:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Outpost-Action-OutsideAllZones-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ForceDespawn:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Outpost-Chat-OutsideAllZones-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Outpost-Chat-OutsideAllZones-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:A {Faction} outpost has been lost.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:5000]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Behavior for Trade Stations -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Behavior-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[Triggers:GVK-Alliance-Base-Trigger-Spawned-SOBAN]
			[Triggers:GVK-Alliance-Base-Trigger-BeaconDisabled-SOBAN]
			[Triggers:GVK-Alliance-Base-Trigger-Compromised-SOBAN]
			[Triggers:GVK-Alliance-Base-Trigger-Despawn-SOBAN]
			[Triggers:GVK-Alliance-Base-Trigger-DespawnMES-SOBAN]
			[Triggers:GVK-Alliance-Base-Trigger-Attacked-SOBAN]
			[Triggers:GVK-Alliance-Base-Trigger-DefensesPlayerNear-SOBAN]
			[Triggers:GVK-Alliance-Base-Trigger-DefensesDamage-SOBAN]
			[Triggers:GVK-Alliance-Base-Trigger-DefensesManual-SOBAN]
			[TriggerGroups:GVK-Alliance-TriggerGroup-PointsBase-SOBAN]
			[RemoteControlCode:GVK-Alliance-Base]
			BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<!-- Trigger sequence to create a safezone on trade station spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Trigger-Spawned-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Alliance-Base-Action-Spawned-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Action-Spawned-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Base-Chat-Spawned-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Chat-Spawned-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:New SOBAN Base constructed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Trigger-BeaconDisabled-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10000]
			[StartsReady:false]
			[Conditions:GVK-Alliance-Base-Condition-BeaconDisabled-SOBAN]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Base-Action-Compromised-SOBAN]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-SmallExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Condition-BeaconDisabled-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[UseRequiredFunctionalBlocks:true]
			[RequiredNoneFunctionalBlockNames:Proprietary Beacon]
			[RequiredNoneFunctionalBlockNames:Base]
			[RequiredNoneFunctionalBlockNames:Base]
			</Description>
		</EntityComponent>
		<!-- trigger to adjust points if destroyed -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Trigger-Compromised-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Compromised]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Alliance-Base-Action-Compromised-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Action-Compromised-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[DecreaseSandboxCounters:SOBAN_Points]
			[DecreaseSandboxCountersAmount:50]
			[IncreaseSandboxCounters:KHAANEPH_Points]
			[IncreaseSandboxCountersAmount:50]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Alliance-Base-Trigger-BeaconDisabled-SOBAN]
			[DisableTriggerNames:GVK-Alliance-Base-Trigger-Compromised-SOBAN]
			[DisableTriggerNames:GVK-Alliance-Base-Trigger-Despawn-SOBAN]
			[DisableTriggerNames:GVK-Alliance-Base-Trigger-DespawnMES-SOBAN]
			[TerminateBehavior:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Base-Chat-Compromised-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Chat-Compromised-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:SOBAN Base destroyed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]
			</Description>
		</EntityComponent>
		<!-- trigger to adjust points if destroyed -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Trigger-Despawn-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Despawn]
			[UseTrigger:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Base-Action-Despawned-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Trigger-DespawnMES-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:DespawnMES]
			[UseTrigger:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Base-Action-Despawned-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Action-Despawned-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[DecreaseSandboxCounters:SOBAN_Points]
			[DecreaseSandboxCountersAmount:50]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Base-Chat-Despawned-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Chat-Despawned-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:SOBAN Base lost.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- trigger to adjust reputation when attacked -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Trigger-Attacked-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[StartsReady:true]
			[DamageTypes:Any]
			[Actions:GVK-Alliance-Base-Action-Attacked-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Action-Attacked-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ChangeAttackerReputation:true]
			[ChangeAttackerReputationFaction:SOBAN]
			[ChangeAttackerReputationAmount:-10]
			[ChangeAttackerReputationFaction:KHAANEPH]
			[ChangeAttackerReputationAmount:5]
			[ReputationChangesForAllAttackPlayerFactionMembers:true]
			[UseChatBroadcast:false]
			[ChatData:GVK-Alliance-Base-Chat-Attacked-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Chat-Attacked-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:SOBAN Base under attack.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence for Medium Defenses -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Trigger-DefensesPlayerNear-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:2000]
			[StartsReady:true]
			[MinCooldownMs:300000]
			[MaxCooldownMs:300001]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Base-Action-DefensesTrigger-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Trigger-DefensesDamage-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[DamageTypes:Any]
			[StartsReady:true]
			[MinCooldownMs:300000]
			[MaxCooldownMs:300001]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Base-Action-DefensesTrigger-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Action-DefensesTrigger-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Alliance-Base-Trigger-DefensesManual-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Trigger-DefensesManual-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[StartsReady:true]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Base-Action-DefensesManual-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Action-DefensesManual-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[CreateKnownPlayerArea:true]
			[KnownPlayerAreaRadius:3000]
			[KnownPlayerAreaTimer:300000]
			[KnownPlayerAreaMaxSpawns:5]
			[SpawnEncounter:true]
			[Spawner:GVK-Alliance-Base-Spawner-DefenseDroneMedium-SOBAN]
			[Spawner:GVK-Alliance-Base-Spawner-DefenseDroneLarge-SOBAN]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Base-Chat-Defenses-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Spawner-DefenseDroneMedium-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:true]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-SOBAN-MediumHoverHeavy]
			[MinDistance:300]
			[MaxDistance:500]
			[MinAltitude:50]
			[MaxAltitude:51]
			[InheritNpcAltitude:true]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Spawner-DefenseDroneLarge-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-SOBAN-LargeHover]
			[MinDistance:300]
			[MaxDistance:500]
			[MinAltitude:50]
			[MaxAltitude:51]
			[InheritNpcAltitude:true]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Base-Chat-Defenses-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:false]
			[Author:SOBAN]
			[Color:White]
			[ChatMessages:Enemies detected.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
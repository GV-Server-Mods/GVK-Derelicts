		<!-- Using Supply Depot as target since WaypointNear/Far are broken -->
		<!-- Trigger sequence when Cargo Ship is near the Target to switch to secondary autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[TargetDistance:2999]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:GVK-CargoShip-SOBAN-Action-TargetNear]
			[ToggleWithTriggerProfile:GVK-CargoShip-SOBAN-Trigger-TargetFar]
			[ToggledProfileResetsCooldown:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:TargetNear]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship is far from the Target to switch to Primary autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetFar]
			[TargetDistance:3000]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:GVK-CargoShip-SOBAN-Action-TargetFar]
			[ToggleWithTriggerProfile:GVK-CargoShip-SOBAN-Trigger-TargetNear]
			[ToggledProfileResetsCooldown:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:TargetFar]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence to deploy CargoDrop2x if compromised -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-CargoDrop</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Tags:GVK-Universal-TriggerTags-Compromised]
			[Type:Manual]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-CargoShip-SOBAN-Action-CargoDrop]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-CargoDrop</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:CargoDrop]
			[SpawnEncounter:true]
			[Spawner:GVK-CargoShip-SOBAN-Spawner-CargoDrop]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Spawner-CargoDrop</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:1]
			[ForceSameFactionOwnership:true]
			[SpawnGroups:GVK-Other-Loot-SpawnGroup-COALITION-CargoDrop2x]
			[SpawnGroups:GVK-Other-Loot-SpawnGroup-COALITION-AmmoDrop]
			[MinDistance:50]
			[MaxDistance:100]
			[MinAltitude:10]
			[MaxAltitude:50]
			[InheritNpcAltitude:true]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
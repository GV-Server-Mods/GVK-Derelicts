<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Cargo Ship Behavior for trade station routes-->
		<!-- 
		
		1. Supply Depot sends command for HQ to spawn cargo ship, every 6 hours or so
		2. Cargo Ship calls for available supply depot waypoints, close range, then long range
		3. Supply depot responds with waypoint command
		4. Cargo ship makes its way and announces it global
		5. When it arrives at the supply depot, it sends a command to trigger a restock
		6. Cargo Ship returns back to HQ, and/or goes to another allied base or outpost randomly
		
		Notes:
		 - Only 1 cargo ship at at time (remote control code with long range)
		 - Cargo ship spawns enemies based on nearby player rep. If allied then spawn opposite enemies.
		 - WaypointNear and WaypointFar are broken and break all other triggers. Workaround is to use 
		   TargetNear and TargetFar with a target profile for Supply Depots. This inhibits the use of 
		   SendTargets trigger groups and targeting of player grids.
		 - It might be worth adding the ReturnToSender or similar command tags
		
		-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:CargoShip]
			[UsePlayerDistanceTimer:false]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[RetreatDespawnDistance:4000]
			[AutopilotData:GVK-CargoShip-SOBAN-PrimaryAutopilot]
			[SecondaryAutopilotData:GVK-CargoShip-SOBAN-SecondaryAutopilot]
			[TargetData:GVK-Universal-Target-SupplyDepot]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[Triggers:GVK-Universal-Trigger-EditableOnCompromised]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-Init]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-RequestNearWaypoint]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-RequestFarWaypoint]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-RequestHQWaypoint]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-ReceiveWaypoint]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-ArriveAtWaypoint]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-LeaveWaypoint]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-HeadToDespawn]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-Defenses]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-Attackers]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-LongWait]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-CargoDrop]
			[//Triggers:GVK-CargoShip-SOBAN-Trigger-WaypointNear]
			[//Triggers:GVK-CargoShip-SOBAN-Trigger-WaypointFar]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-TargetNear]
			[Triggers:GVK-CargoShip-SOBAN-Trigger-TargetFar]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			[RemoteControlCode:CargoShip_SOBAN]
			</Description>
		</EntityComponent>
		<!-- Cargo Ship Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-PrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:true]
			[RotationMultiplier:0.3]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:2000]
			[MinimumPlanetAltitude:1500]
			[AltitudeTolerance:100]
			[MinAngleForLeveledDescent:150]
			[MaxAngleForLeveledAscent:180]
			[MaxVerticalSpeed:20]
			[IdealMinSpeed:50]
			[IdealMaxSpeed:60]
			[MaxSpeedTolerance:10]
			[SlowDownOnWaypointApproach:true]
			[WaypointWaitTimeTrigger:30]
			[ExtraSlowDownDistance:1000]
			[WaypointTolerance:100]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.5]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:45]
			[MaxVelocityAngleForSpeedControl:181]
			</Description>
		</EntityComponent>
		<!-- Cargo Ship Autopilot Secondary -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-SecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:true]
			[RotationMultiplier:0.3]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:100]
			[MinimumPlanetAltitude:50]
			[AltitudeTolerance:20]
			[MinAngleForLeveledDescent:0]
			[MaxAngleForLeveledAscent:180]
			[MaxVerticalSpeed:20]
			[IdealMinSpeed:20]
			[IdealMaxSpeed:50]
			[MaxSpeedTolerance:5]
			[SlowDownOnWaypointApproach:true]
			[WaypointWaitTimeTrigger:30]
			[ExtraSlowDownDistance:500]
			[WaypointTolerance:100]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.5]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:30]
			[MaxVelocityAngleForSpeedControl:181]
			</Description>
		</EntityComponent>
		<!-- Trigger when Cargo Ship Spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-Init</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1000]
			[Actions:GVK-CargoShip-SOBAN-Action-Init]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-Init</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,CargoShip]
			[CustomStrings:EncounterDisplayName,Cargo Ship]
			[SetBooleansTrue:GVK_MobilityType_Aircraft]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-SOBAN-Chat-Init]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Chat-Init</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:SOBAN]
			[Color:{PlayerRelation}]
			[ChatMessages:A Supply Depot shipment is en route.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship Spawns to request near waypoint -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-RequestNearWaypoint</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[Actions:GVK-CargoShip-SOBAN-Action-RequestNearWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-RequestNearWaypoint</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:RequestNearWaypoint]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-CargoShip-SOBAN-Command-RequestNearWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Command-RequestNearWaypoint</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:CargoShipWaypointRequest]
			[SingleRecipient:false]
			[MatchSenderReceiverOwners:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:40000]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship Spawns to request far waypoint -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-RequestFarWaypoint</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]

			[BroadcastRandomly:false]
			[Author:SOBAN]
			[Color:{PlayerRelation}]
			[ChatMessages:Cargo Ship heading to next delivery]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship departs to despawn waypoint -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-HeadToDespawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:BehaviorTriggerD]
			[MinCooldownMs:30000]
			[MaxCooldownMs:30000]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:-1]
			[Actions:GVK-CargoShip-SOBAN-Action-HeadToDespawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-HeadToDespawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[RecalculateDespawnCoords:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-SOBAN-Chat-HeadToDespawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Chat-HeadToDespawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]

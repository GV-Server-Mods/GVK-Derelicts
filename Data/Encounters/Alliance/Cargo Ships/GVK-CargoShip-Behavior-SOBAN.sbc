			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Spawn defenses when an enemy player is in range -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-Defenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:1500]
			[MinPlayerReputation:-1500]
			[MaxPlayerReputation:-500]
			[StartsReady:true]
			[MinCooldownMs:120000]
			[MaxCooldownMs:240000]
			[MaxActions:6]
			[Actions:GVK-CargoShip-SOBAN-Action-Defenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-Defenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:Spawn Defenses]
			[SpawnEncounter:true]
			[Spawner:GVK-CargoShip-SOBAN-Spawner-Defenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Spawner-Defenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[ForceSameFactionOwnership:true]
			[MaxSpawns:6]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-SOBAN-InterceptorSquad]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-SOBAN-StrikeFighterSquad]
			[MinDistance:500]
			[MaxDistance:700]
			[MinAltitude:50]
			[MaxAltitude:200]
			[InheritNpcAltitude:true]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<!-- Spawn attackers when an allied player is in range -->

			[MaxDistance:700]
			[MinAltitude:50]
			[MaxAltitude:200]
			[InheritNpcAltitude:true]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<!-- Just in case it gets stuck somewhere, should be longer than the autopilot waypoint wait time -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-LongWait</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:-1]
			[MinCooldownMs:120000]
			[MaxCooldownMs:120000]
			[Conditions:GVK-CargoShip-SOBAN-Condition-LongWait]
			[ConditionCheckResetsTimer:true]
			[Actions:GVK-CargoShip-SOBAN-Action-LongWait]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Condition-LongWait</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckGridSpeed:true]
			[MinGridSpeed:0]
			[MaxGridSpeed:5]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-LongWait</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:LongWait HeadToDespawn]
			[Chance:100]
			[Retreat:true]
			[RecalculateDespawnCoords:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-SOBAN-Chat-HeadToDespawn]
			</Description>
		</EntityComponent>

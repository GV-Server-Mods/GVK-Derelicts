		<!-- Trigger sequence for Cargo Ship to receive waypoints Supply Depot and HQ -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-ReceiveWaypoint</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:CommandReceived]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:4]
			[CommandReceiveCode:SupplyDepotWaypoint]
			[Actions:GVK-CargoShip-SOBAN-Action-ReceiveWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-ReceiveWaypoint</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:ReceiveWaypoint]
			[AddWaypointFromCommand:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship arrives at a waypoint -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-ArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:BehaviorTriggerA]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:GVK-CargoShip-SOBAN-Action-ArriveAtWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-ArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:ArriveAtWaypoint]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-CargoShip-SOBAN-Command-RestockSupplyDepot]
			[//CancelWaitingAtWaypoint:true]
			[//SwitchToNextWaypoint:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-SOBAN-Chat-ArriveAtWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Command-RestockSupplyDepot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:CargoShip_RestockSupplyDepot]
			[SingleRecipient:true]
			[MatchSenderReceiverOwners:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:2000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Chat-ArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:SOBAN]
			[Color:{PlayerRelation}]
			[ChatMessages:Cargo Ship arrived at Supply Depot]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship leaves a waypoint -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-LeaveWaypoint</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:BehaviorTriggerB]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:GVK-CargoShip-SOBAN-Action-LeaveWaypoint]

		<!-- trigger to check all zone bools for despawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Trigger-OutsideAllZones-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:300000]
			[MaxCooldownMs:300001]
			[StartsReady:false]
			[Actions:GVK-Alliance-SupplyDepot-Action-OutsideAllZones-KHAANEPH]
			[Actions:GVK-Universal-Action-MediumExplosionEffects]
			[Conditions:GVK-Alliance-SupplyDepot-Condition-OutsideAllZones-KHAANEPH]
			[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<!-- if Zone bools are all true, then outside all zones, then despawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Condition-OutsideAllZones-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:KHAANEPHZone10000Check]
			[TrueBooleans:KHAANEPHZone20000Check]
			[TrueBooleans:KHAANEPHZone30000Check]
			[TrueBooleans:KHAANEPHZone40000Check]

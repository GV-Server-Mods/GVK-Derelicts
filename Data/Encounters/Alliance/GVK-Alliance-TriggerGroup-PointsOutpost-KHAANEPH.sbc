<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Behavior for Trade Stations -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-TriggerGroup-PointsOutpost-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Alliance-Trigger-PointsOutpost-BeaconDisabled-KHAANEPH]
			[Triggers:GVK-Alliance-Trigger-PointsOutpost-Compromised-KHAANEPH]
			[Triggers:GVK-Alliance-Trigger-PointsOutpost-Despawn-KHAANEPH]
			[Triggers:GVK-Alliance-Trigger-PointsOutpost-DespawnMES-KHAANEPH]
			[Triggers:GVK-Alliance-Trigger-PointsOutpost-Attacked-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Trigger-PointsOutpost-BeaconDisabled-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[StartsReady:false]
			[MaxActions:1]
			[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Action-PointsOutpost-Compromised-KHAANEPH]
			</Description>
		</EntityComponent>
		<!-- trigger to adjust points if destroyed -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Trigger-PointsOutpost-Compromised-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Compromised]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Alliance-Action-PointsOutpost-Compromised-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Action-PointsOutpost-Compromised-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[DecreaseSandboxCounters:KHAANEPH_Points]
			[DecreaseSandboxCountersAmount:3]
			[IncreaseSandboxCounters:SOBAN_Points]
			[IncreaseSandboxCountersAmount:3]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsOutpost-BeaconDisabled-KHAANEPH]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsOutpost-Compromised-KHAANEPH]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsOutpost-Despawn-KHAANEPH]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsOutpost-DespawnMES-KHAANEPH]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsOutpost-Attacked-KHAANEPH]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Chat-Compromised-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Chat-PointsOutpost-Compromised-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:{Faction} -3, SOBAN +3.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]
			</Description>
		</EntityComponent>
		<!-- trigger to adjust points if destroyed -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Trigger-PointsOutpost-Despawn-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Despawn]
			[UseTrigger:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Action-PointsOutpost-Despawned-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Trigger-PointsOutpost-DespawnMES-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:DespawnMES]
			[UseTrigger:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Action-PointsOutpost-Despawned-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Action-PointsOutpost-Despawned-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[DecreaseSandboxCounters:KHAANEPH_Points]
			[DecreaseSandboxCountersAmount:3]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsOutpost-BeaconDisabled-KHAANEPH]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsOutpost-Compromised-KHAANEPH]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsOutpost-Despawn-KHAANEPH]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsOutpost-DespawnMES-KHAANEPH]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsOutpost-Attacked-KHAANEPH]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Chat-PointsOutpost-Despawned-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Chat-PointsOutpost-Despawned-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:{Faction} -3.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- trigger to adjust reputation when attacked -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Trigger-PointsOutpost-Attacked-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[StartsReady:true]
			[DamageTypes:Any]
			[Actions:GVK-Alliance-Action-PointsOutpost-Attacked-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Action-PointsOutpost-Attacked-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ChangeAttackerReputation:true]
			[ChangeAttackerReputationFaction:{Self}]
			[ChangeAttackerReputationAmount:-4]
			[ChangeAttackerReputationFaction:SOBAN]
			[ChangeAttackerReputationAmount:2]
			[ReputationChangesForAllAttackPlayerFactionMembers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
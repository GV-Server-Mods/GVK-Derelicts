		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Trigger-OutsideAllZones-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:300000]
			[MaxCooldownMs:300001]
			[StartsReady:false]
			[Actions:GVK-Alliance-SupplyDepot-Action-OutsideAllZones-SOBAN]
			[Actions:GVK-Universal-Action-MediumExplosionEffects]
			[Conditions:GVK-Alliance-SupplyDepot-Condition-OutsideAllZones-SOBAN]
			[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<!-- if Zone bools are all true, then outside all zones, then despawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Condition-OutsideAllZones-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:SOBANZone10000Check]
			[TrueBooleans:SOBANZone20000Check]
			[TrueBooleans:SOBANZone30000Check]
			[TrueBooleans:SOBANZone40000Check]
			[TrueBooleans:SOBANZone50000Check]
			[AllowAnyTrueBoolean:false]
			</Description>
		</EntityComponent>

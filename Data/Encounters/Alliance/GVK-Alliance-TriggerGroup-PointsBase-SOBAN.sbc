<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Behavior for Trade Stations -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-TriggerGroup-PointsBase-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Alliance-Trigger-PointsBase-BeaconDisabled-SOBAN]
			[Triggers:GVK-Alliance-Trigger-PointsBase-Compromised-SOBAN]
			[Triggers:GVK-Alliance-Trigger-PointsBase-Despawn-SOBAN]
			[Triggers:GVK-Alliance-Trigger-PointsBase-DespawnMES-SOBAN]
			[Triggers:GVK-Alliance-Trigger-PointsBase-Attacked-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Trigger-PointsBase-BeaconDisabled-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[StartsReady:false]
			[MaxActions:1]
			[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Action-PointsBase-Compromised-SOBAN]
			</Description>
		</EntityComponent>
		<!-- trigger to adjust points if destroyed -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Trigger-PointsBase-Compromised-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Compromised]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Alliance-Action-PointsBase-Compromised-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Action-PointsBase-Compromised-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[DecreaseSandboxCounters:SOBAN_Points]
			[DecreaseSandboxCountersAmount:10]
			[IncreaseSandboxCounters:KHAANEPH_Points]
			[IncreaseSandboxCountersAmount:10]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsBase-BeaconDisabled-SOBAN]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsBase-Compromised-SOBAN]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsBase-Despawn-SOBAN]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsBase-DespawnMES-SOBAN]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsBase-Attacked-SOBAN]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Chat-Compromised-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Chat-PointsBase-Compromised-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:{Faction} -10, KHAANEPH +10.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]
			</Description>
		</EntityComponent>
		<!-- trigger to adjust points if destroyed -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Trigger-PointsBase-Despawn-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Despawn]
			[UseTrigger:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Action-PointsBase-Despawned-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Trigger-PointsBase-DespawnMES-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:DespawnMES]
			[UseTrigger:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Action-PointsBase-Despawned-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Action-PointsBase-Despawned-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[DecreaseSandboxCounters:SOBAN_Points]
			[DecreaseSandboxCountersAmount:10]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsBase-BeaconDisabled-SOBAN]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsBase-Compromised-SOBAN]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsBase-Despawn-SOBAN]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsBase-DespawnMES-SOBAN]
			[DisableTriggerNames:GVK-Alliance-Trigger-PointsBase-Attacked-SOBAN]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Chat-PointsBase-Despawned-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Chat-PointsBase-Despawned-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:{Faction} -10.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- trigger to adjust reputation when attacked -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Trigger-PointsBase-Attacked-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[StartsReady:true]
			[DamageTypes:Any]
			[Actions:GVK-Alliance-Action-PointsBase-Attacked-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Action-PointsBase-Attacked-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ChangeAttackerReputation:true]
			[ChangeAttackerReputationFaction:{Self}]
			[ChangeAttackerReputationAmount:-4]
			[ChangeAttackerReputationFaction:KHAANEPH]
			[ChangeAttackerReputationAmount:2]
			[ReputationChangesForAllAttackPlayerFactionMembers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
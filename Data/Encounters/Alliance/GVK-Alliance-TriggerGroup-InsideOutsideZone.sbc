			[UseTrigger:true]
			[Type:OutsideActiveZone]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:false]
			[ZoneName:{Faction}_Zone_10000]
			[Actions:GVK-Alliance-Action-Outside10000Check]
			</Description>
		</EntityComponent>

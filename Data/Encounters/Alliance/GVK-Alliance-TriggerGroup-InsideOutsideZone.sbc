		<!-- trigger to check all zone bools for despawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Trigger-OutsideAllZones</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:PlayerFar]
			[MinCooldownMs:1800000]
			[MaxCooldownMs:1800001]
			[StartsReady:false]
			[TargetDistance:4000]
			[Actions:GVK-Alliance-Action-OutsideAllZones]
			[Actions:GVK-Universal-Action-LargeExplosionEffects]
			[Conditions:GVK-Alliance-Condition-OutsideAllZones]
			[ConditionCheckResetsTimer:true]
			</Description>
		</EntityComponent>
		<!-- if Zone bools are all true, then outside all zones, then despawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Condition-OutsideAllZones</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:Zone10000Check]
			[TrueBooleans:Zone20000Check]
			[TrueBooleans:Zone30000Check]
			[TrueBooleans:Zone40000Check]
			[TrueBooleans:Zone50000Check]
			[AllowAnyTrueBoolean:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Action-OutsideAllZones</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//DebugMessage:Trigger OutsideAllZones]
			[ForceDespawn:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-Chat-OutsideAllZones]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Chat-OutsideAllZones</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:A {Faction} {EncounterDisplayName} was abandoned.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:5000]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
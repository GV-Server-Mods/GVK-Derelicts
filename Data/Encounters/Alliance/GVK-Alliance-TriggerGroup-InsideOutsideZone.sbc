	<EntityComponents>
		<!-- An MES bug is preventing this from working. InsideZone still succeeds if it is inside an inactive Zone.
			 Also, MES zone radius actions are not functioning at all -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-TriggerGroup-InsideOutsideZone</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Alliance-Trigger-Outside10000Check]
			[Triggers:GVK-Alliance-Trigger-Outside20000Check]
			[Triggers:GVK-Alliance-Trigger-Outside30000Check]
			[Triggers:GVK-Alliance-Trigger-Outside40000Check]
			[Triggers:GVK-Alliance-Trigger-Outside50000Check]
			[Triggers:GVK-Alliance-Trigger-Inside10000Check]
			[Triggers:GVK-Alliance-Trigger-Inside20000Check]
			[Triggers:GVK-Alliance-Trigger-Inside30000Check]
			[Triggers:GVK-Alliance-Trigger-Inside40000Check]
			[Triggers:GVK-Alliance-Trigger-Inside50000Check]
			[Triggers:GVK-Alliance-Trigger-OutsideAllZones]
			</Description>
		</EntityComponent>
		<!-- trigger to confirm it is Outside Zone 10000 -->

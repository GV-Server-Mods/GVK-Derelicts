			[Actions:GVK-Universal-Action-DefensesManualSpawn-AllianceBase]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesManualSpawn-AllianceBase</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[DebugMessage:DefensesManualSpawn-AllianceBase]
			[SpawnEncounter:true]
			[Spawner:GVK-Universal-Spawner-Defenses-AllianceBase]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Spawner-Defenses-AllianceBase</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:true]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-BaserunnerHeavy]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-LargeHover]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-LargeRover]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-InterceptorSquad]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-MediumHoverHeavy]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-LargeHover]
			[MinDistance:500]
			[MaxDistance:700]
			[MinAltitude:50]
			[MaxAltitude:51]
			[InheritNpcAltitude:false]
			[IgnoreSafetyChecks:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-DefensesManualSpawn-AllianceOutpost</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]

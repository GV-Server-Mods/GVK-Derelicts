		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-DefensesManualSpawn-AllianceOutpost</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[//DebugMessage:DefensesManualSpawn-AllianceOutpost]
			[SpawnEncounter:true]
			[Spawner:GVK-Universal-Spawner-Defenses-AllianceOutpost]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Spawner-Defenses-AllianceOutpost</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:true]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-InterceptorSingle]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-SandskimmerSquad]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-MediumHoverLight]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-LAVSquad]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-StrikeFighterSingle]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-{Faction}-BaserunnerLight]
			[MinDistance:500]
			[MaxDistance:700]
			[MinAltitude:50]
			[MaxAltitude:51]
			[InheritNpcAltitude:false]
			[IgnoreSafetyChecks:false]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
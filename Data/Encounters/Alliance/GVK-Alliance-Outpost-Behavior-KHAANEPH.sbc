<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Behavior for Trade Stations -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Outpost-Behavior-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-DespawnInZ0]
			[Triggers:GVK-Alliance-Outpost-Trigger-Init-KHAANEPH]
			[TriggerGroups:GVK-Universal-TriggerGroup-SpawnDefenses]
			[TriggerGroups:GVK-Alliance-TriggerGroup-InsideOutsideZone]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			[RemoteControlCode:GVK-Alliance-Outpost]
			BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Outpost-Trigger-Init-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:true]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-Alliance-Outpost-Action-Spawned-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Outpost-Action-Spawned-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[//DebugMessage:Init-Outpost-KHAANEPH]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,AllianceOutpost]
			[CustomStrings:EncounterDisplayName,Outpost]
			[SetCustomCountersVariables:true]
			[CustomCountersVariables:DefenseSpawn_Limit,6]
			[UseChatBroadcast:true]
			[ChatData:GVK-Alliance-EncounterType-Chat-Spawned-Faction]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
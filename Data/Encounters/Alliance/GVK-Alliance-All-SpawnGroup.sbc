<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>
		<!-- these don't use spawn conditions because each has a different static coord, and they can't be split -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-SpawnGroup-KHAANEPH</SubtypeId> <!-- GPS:Khaaneph Base:20802.09:21835.64:57944.6:#FFFFA900: -->
			</Id>
			<Description>
			[Modular Encounters SpawnGroup]
			[StaticEncounter:true]
			[FactionOwner:KHAANEPH]
			[InitializeStoreBlocks:false]
			[ReactorsOn:true]
			[ForceStaticGrid:true]
			[TriggerCoords:{X:20797.4026136076 Y:21816.0775106065 Z:57964.3183518895}]
			[TriggerRadius:10000]
			[IgnoreCleanupRules:true]
			[ReplenishSystems:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:true]
			[ForceExactPositionAndOrientation:true]
			[StaticEncounterCoords:{X:20797.4026136076 Y:21816.0775106065 Z:57964.3183518895}]
			[StaticEncounterForward:{X:0.911941936323143 Y:-0.253667053993175 Z:0.322513457848846}]
			[StaticEncounterUp:{X:-0.398949945286668 Y:-0.364412096437324 Z:0.841452770585443}]
			[ManipulationProfiles:GVK-Alliance-Homebase-Manipulation]
			[UseRivalAi:true]
			[UseRemoteControlCodeRestrictions:true]
			[RemoteControlCode:GVK-Static]
			[RemoteControlCodeMinDistance:500]
			[RemoteControlCodeMaxDistance:-1]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>5.0</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NST [KHAA] Carrier">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Homebase</BeaconText>
					<Behaviour>GVK-Alliance-Homebase-Behavior-KHAANEPH</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

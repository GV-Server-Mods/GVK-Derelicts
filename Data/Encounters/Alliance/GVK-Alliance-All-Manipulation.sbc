<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-Homebase-Manipulation</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[ClearAuthorship:true]
			[EraseIngameScripts:true]
			[IgnoreGlobalBlockReplacer:true]
			[UseBlockReplacerProfile:true]
			[BlockReplacerProfileNames:GVK-Replacer-ProprietaryReactors]
			[BlockReplacerProfileNames:GVK-Replacer-NPCNoConcealBeacons]
			[//BlockReplacerProfileNames:GVK-Replacer-NPCWeapons]
			[UseRivalAi:true]
			[RivalAiReplaceRemoteControl:true]
			[ClearGridInventories:true]
			[GridsAreEditable:false]
			[GridsAreDestructable:false]
			</Description>
		</EntityComponent>

		<!-- 
			Khaaneph Colors:
			Brown (Battered_Armor)
				Hex - #401600
				HSV - {X:0.0583333336 Y:0.2 Z:-0.2}
			Light Green (Battered_Armor)
				Hex - #918F63
				HSV - {X:0.158333331 Y:-0.48 Z:0.12}
			Orange (Battered_Armor)
				Hex - #8F350E
				HSV - {X:0.05 Y:0.1 Z:0.11}
				
			Soban Colors:
			Red (Battered_Armor)
				Hex - #D43722
				HSV - {X:0.0194444451 Y:0.04 Z:0.38}
			White (Battered_Armor)
				Hex - #C4C4C4
				HSV - {X:0.075 Y:-0.8 Z:0.32}
			Dark Grey (SciFi_Armor)
				Hex - #262626
				HSV - {X:0 Y:-0.8 Z:-0.3}
				
			Neutral Colors:
			1 (Battered_Armor)
				Hex - TBD
				HSV - {X:0.0195 Y:-0.8 Z:-0.15}
			2 (Battered_Armor)
				Hex - TBD
				HSV - {X:0.075 Y:-0.8 Z:-0.02}
			3 (Battered_Armor)
				Hex - #262626
				HSV - {X:0.803 Y:-0.8 Z:-0.3}
				
			Color Swaps:
			Khaaneph Brown (Battered_Armor)			<-> Soban Red (Battered_Armor)
			Khaaneph Light Green (Battered_Armor)	<-> Soban White (Battered_Armor)
			Khaaneph Orange (Battered_Armor) 		<-> Soban Dark Grey (SciFi_Armor)
		-->
			
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-SupplyDepot-Manipulation</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[ClearAuthorship:true]
			[EraseIngameScripts:true]
			[IgnoreGlobalBlockReplacer:true]
			[UseBlockReplacerProfile:true]
			[BlockReplacerProfileNames:GVK-Replacer-ProprietaryReactors]
			[BlockReplacerProfileNames:GVK-Replacer-NPCNoConcealBeacons]
			[//BlockReplacerProfileNames:GVK-Replacer-NPCWeapons]
			[UseRivalAi:true]
			[RivalAiReplaceRemoteControl:true]
			[ClearGridInventories:true]
			[GridsAreEditable:false]
			[GridsAreDestructable:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Alliance-ToSOBANColor-Manipulation</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[RecolorGrid:true]
			[RecolorOld:{X:0.0195 Y:-0.8 Z:-0.15}]
			[RecolorNew:{X:0.0194444451 Y:0.04 Z:0.38}]
			[RecolorOld:{X:0.075 Y:-0.8 Z:-0.02}]
			[RecolorNew:{X:0.075 Y:-0.8 Z:0.32}]
			[RecolorOld:{X:0.803 Y:-0.8 Z:-0.3}]
			[RecolorNew:{X:0 Y:-0.8 Z:-0.3}]
			[RecolorOld:{X:0.0583333336 Y:0.2 Z:-0.2}]
			[RecolorNew:{X:0.0194444451 Y:0.04 Z:0.38}]
			[RecolorOld:{X:0.158333331 Y:-0.48 Z:0.12}]
			[RecolorNew:{X:0.075 Y:-0.8 Z:0.32}]
			[RecolorOld:{X:0.05 Y:0.1 Z:0.11}]
			[RecolorNew:{X:0 Y:-0.8 Z:-0.3}]
			[ReskinTarget:{X:0 Y:-0.8 Z:-0.3}]
			[ReskinTexture:SciFi_Armor]
			</Description>
		</EntityComponent>

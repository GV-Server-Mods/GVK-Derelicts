		<!-- Rover store at Crossroads with light cores -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-StaticEncounters-TradeStations-SpawnGroup-RoverSales01b</SubtypeId>
			</Id>
			<Description>
			[Modular Encounters SpawnGroup]
			[StaticEncounter:true]
			[FactionOwner:COALITION]
			[InitializeStoreBlocks:false]
			[ReactorsOn:true]
			[ForceStaticGrid:true]
			[TriggerCoords:{X:61674.736938916 Y:28709.8607850768 Z:39507.1760364224}]
			[TriggerRadius:30000]
			[IgnoreCleanupRules:true]
			[ReplenishSystems:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:true]
			[ForceExactPositionAndOrientation:true]
			[StaticEncounterCoords:{X:61674.736938916 Y:28709.8607850768 Z:39507.1760364224}]
			[StaticEncounterForward:{X:-0.13871361218967 Y:-0.990332536975885 Z:-4.4845421287159E-07}]
			[StaticEncounterUp:{X:-0.96545414149982 Y:0.135229053128802 Z:-0.222736175442457}]
			[ManipulationProfiles:GVK-Static-TradeStation-Manipulation]
			[UseRivalAi:true]
			[UseRemoteControlCodeRestrictions:true]
			[RemoteControlCode:GVK-Static]
			[RemoteControlCodeMinDistance:500]
			[RemoteControlCodeMaxDistance:-1]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>5.0</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NTS [COAL] Rover Store 2">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Vehicle Store</BeaconText>
					<Behaviour>GVK-Store-Behavior-RoverSales-Basic</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

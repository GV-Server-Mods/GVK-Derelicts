	<SpawnGroups>
		<!-- Khar Toba, Z3 all grids permitted -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Static-KOTH-Massive-SpawnGroup-01</SubtypeId>
			</Id>
			<Description>
			[Modular Encounters SpawnGroup]
			[StaticEncounter:true]
			[FactionOwner:KOTH]
			[ManipulationProfiles:GVK-Static-KOTH-Massive-Manipulation]
			[ReactorsOn:true]
			[ForceStaticGrid:true]
			[TriggerCoords:{X:4308.00713731524 Y:38829.8174611633 Z:26097.6385303603}]
			[TriggerRadius:10000]
			[IgnoreCleanupRules:true]
			[ReplenishSystems:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:true]
			[RotateFirstCockpitToForward:false]
			[ForceExactPositionAndOrientation:true]
			[StaticEncounterCoords:{X:4314.69890977618 Y:38878.6326467102 Z:26100.417338954}]
			[StaticEncounterForward:{X:0.122852876782417 Y:-0.311551094055176 Z:-0.942254245281219}]
			[StaticEncounterUp:{X:-0.990446865558624 Y:0.021424937993288 Z:-0.136220365762711}]
			[SandboxVariables:KOTHsEnabled]
			[ZoneConditions:GVK-Universal-ZoneConditions-KOTH-Massive-01]
			[ZoneConditions:GVK-Universal-ZoneConditions-KOTH-Massive-02]
			[ZoneConditions:GVK-Universal-ZoneConditions-KOTH-Massive-03]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>5.0</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NKO [KOTH] Khar Toba">
					<Position>
						<X>0.0</X>
						<Y>0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Massive Signal</BeaconText>
					<Behaviour>GVK-Static-KOTH-Massive01-Behavior</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

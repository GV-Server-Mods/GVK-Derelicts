<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Behavior for Trade Stations -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-Generic-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:false]
			[Triggers:GVK-Static-TradeStation-Trigger-Unload-ResetCooldown]
			[Triggers:GVK-Static-TradeStation-Trigger-Unload-Despawn]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-PlayerKOTH-Behavior</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:Passive]
				[PlayerDistanceTimerTrigger:3600]
				[PlayerDistanceTrigger:1]
				[UseNoTargetTimer:false]
				[UseRetreatTimer:false]
				[Triggers:GVK-PlanetaryInstallations-PlayerKOTH-Trigger-OnSpawn]
				[Triggers:GVK-PlanetaryInstallations-Trigger-Defenses-Medium]
				[Triggers:GVK-PlanetaryInstallations-PlayerKOTH-Trigger-Timer]
				[Triggers:GVK-PlanetaryInstallations-PlayerKOTH-Trigger-Compromised]
				[Triggers:GVK-PlanetaryInstallations-PlayerKOTH-Trigger-BeaconDisabled]
				[Triggers:GVK-PlanetaryInstallations-PlayerKOTH-Trigger-Despawn]
				[Triggers:GVK-PlanetaryInstallations-PlayerKOTH-Trigger-DespawnMES]
				[Triggers:GVK-Generic-Trigger-CreateKPL]
				[TargetData:GVK-Generic-Target-EnemyGrids-LongRange]
				[RemoteControlCode:GVK-LargeDerelict]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-PlayerKOTH-Trigger-OnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Session]
				[UseTrigger:true]
				[StartsReady:true]
				[Actions:GVK-PlanetaryInstallations-PlayerKOTH-Action-OnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-PlayerKOTH-Action-OnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetSandboxBooleansTrue:LargeWreckActive]
				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-PlayerKOTH-Chat-Announce]
				[UseJetpackInhibitorEffect:true]
			</Description>
		</EntityComponent>
		<!-- need to run jetpack inhibitor on restart as well -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		  <Id>
			  <TypeId>Inventory</TypeId>
			  <SubtypeId>GVK-PlanetaryInstallations-PlayerKOTH-Chat-Announce</SubtypeId>
		  </Id>
		  <Description>

			  [RivalAI Chat]
			  
			  [UseChat:true]
			  [StartsReady:true]
			  [Chance:100]
			  [MaxChats:2]
			  [BroadcastRandomly:false]
			  [Author:COALITION]
			  [Color:White]
			  
			  [ChatMessages:The Player King Of the Hill Event is now active for 1 hour.]
			  [ChatAudio:ArcHudGPSNotification2]
			  [BroadcastChatType:Chat]
			  [ChatMessages:The Player King Of the Hill Event is now active for 1 hour.]
			  [BroadcastChatType:Notify]
			  [SendToAllOnlinePlayers:true]

		  </Description>      
		</EntityComponent>
		<!-- Trigger sequences for PlayerKOTH to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-PlayerKOTH-Trigger-Timer</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:3600000]
				[MaxCooldownMs:3600001]
				[StartsReady:false]
				[Actions:GVK-PlanetaryInstallations-PlayerKOTH-Action-Compromised]
			</Description>      
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-PlayerKOTH-Trigger-BeaconDisabled</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10000]
				[StartsReady:false]
				[Conditions:GVK-PlanetaryInstallations-Condition-BeaconDisabled]				  
				[Actions:GVK-PlanetaryInstallations-PlayerKOTH-Action-Compromised]
			</Description>      
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-PlayerKOTH-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Compromised]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-PlanetaryInstallations-PlayerKOTH-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-PlayerKOTH-Trigger-Despawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Despawn]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-PlanetaryInstallations-PlayerKOTH-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-PlayerKOTH-Trigger-DespawnMES</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:DespawnMES]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-PlanetaryInstallations-PlayerKOTH-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-PlayerKOTH-Action-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[GridEditable:true]
				[SubGridsEditable:true]
				[GridDestructible:true]
				[SubGridsDestructible:true]
				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-PlayerKOTH-Chat-Compromised]
				[ToggleBlocksOfType:true]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/ZoneBlock]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconSmall]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconLarge]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/SmallBlockBeacon]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/LargeBlockBeacon]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlLarge]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlSmall]
				[BlockTypeToggles:Off]
				[GenerateExplosion:true]
				[ExplosionOffsetFromRemote:{X:0 Y:0 Z:0}]
				[ExplosionRange:200]
				[ExplosionDamage:1]
				[ExplosionIgnoresVoxels:true]
				[EnableBlocks:true]
				[EnableBlockNames:NPC Beacon]
				[EnableBlockStates:Off]
				[SetSandboxBooleansFalse:LargeWreckActive]	
				[UseJetpackInhibitorEffect:false]
				[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-PlayerKOTH-Chat-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:Coalition]
				[Color:White]
				[ChatMessages:The Player King Of the Hill Event has Ended.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
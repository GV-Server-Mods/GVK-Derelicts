<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Horsefly Rover Carrier Behavior for Season 2 Event-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Behavior</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:Passive]
				[UseAmmoReplenish:true]
				[AmmoReplenishClipAmount:10]
				[MaxAmmoReplenishments:99999999]
				[UsePlayerDistanceTimer:false]
				[UseRetreatTimer:false]
				[UseNoTargetTimer:false]
				[Triggers:GVK-PlanetaryInstallations-GaalsienHangar-Trigger-OnSpawn]
				[Triggers:GVK-PlanetaryInstallations-GaalsienHangar-Trigger-SpawnDefenses]
				[Triggers:GVK-PlanetaryInstallations-GaalsienHangar-Trigger-SpawnCruisers]
				[Triggers:GVK-Generic-Trigger-SPRTTargetAcquiredChatter]
				[Triggers:GVK-PlanetaryInstallations-GaalsienHangar-Trigger-Despawn]
				[Triggers:GVK-PlanetaryInstallations-GaalsienHangar-Trigger-DespawnMES]
				[Triggers:GVK-PlanetaryInstallations-GaalsienHangar-Trigger-Compromised]
				[Triggers:GVK-PlanetaryInstallations-GaalsienHangar-Trigger-BeaconDisabled]
				[TargetData:GVK-Generic-TargetProfile-EnemyGrids-LongRange]
				[RemoteControlCode:GVK-LargeDerelict]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Carrier Spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Trigger-OnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[MinCooldownMs:900000]
				[MaxCooldownMs:900000]
				[Actions:GVK-PlanetaryInstallations-GaalsienHangar-Action-OnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Action-OnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetSandboxBooleansTrue:LargeWreckActive]
				[SetWeaponsToMaxRange:true]
				[UseJetpackInhibitorEffect:true]
				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-Chat-Spawned-Large]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		  <Id>
			  <TypeId>Inventory</TypeId>
			  <SubtypeId>GVK-PlanetaryInstallations-Chat-Spawned-Large</SubtypeId>
		  </Id>
		  <Description>

			  [RivalAI Chat]
			  
			  [UseChat:true]
			  [StartsReady:true]
			  [Chance:100]
			  [MaxChats:2]
			  [BroadcastRandomly:false]
			  [Author:COALITION]
			  [Color:White]
			  
			  [ChatMessages:A Gaalsien Hangar has been spotted.]
			  [ChatAudio:ArcHudGPSNotification2]
			  [BroadcastChatType:Chat]
			  [ChatMessages:A Gaalsien Hangar has been spotted.]
			  [BroadcastChatType:Notify]
			  [SendToAllOnlinePlayers:true]

		  </Description>      
		</EntityComponent>
		<!-- need to run jetpack inhibitor on restart as well -->
		<!-- Trigger sequence for GaalsienHangar to spawn initial defenses -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Trigger-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:PlayerNear]
				[UseTrigger:true]
				[TargetDistance:4000]
				[StartsReady:true]
				[MaxActions:4]
				[MinCooldownMs:5000]
				[MaxCooldownMs:5000]
				[Actions:GVK-PlanetaryInstallations-GaalsienHangar-Action-SpawnDefenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Action-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SpawnEncounter:true]
				[Spawner:GVK-PlanetaryInstallations-GaalsienHangar-Spawner-SpawnDefenses]
				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-GaalsienHangar-Chat-SpawnDefenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Spawner-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[MinDistance:500]
				[MaxDistance:1500]
				[MinAltitude:10]
				[MaxAltitude:20]
				[MaxSpawns:4]
				[InheritNpcAltitude:true]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-AssaultShip]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-Honorguard]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-ArtilleryCruiser]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-MissileCruiser]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-ProductionCruiser]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-RailgunCruiser]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-TorpedoCruiser]
				[ProcessAsAdminSpawn:false]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Chat-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:Gaalsien Hangar]
				[Color:Red]
				[ChatMessages:Enemies in-bound.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for GaalsienHangar to spawn Cruisers -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Trigger-SpawnCruisers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:PlayerNear]
				[UseTrigger:true]
				[TargetDistance:3000]
				[StartsReady:false]
				[MaxActions:-1]
				[MinCooldownMs:120000]
				[MaxCooldownMs:180000]
				[Actions:GVK-PlanetaryInstallations-GaalsienHangar-Action-SpawnCruisers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Action-SpawnCruisers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SpawnEncounter:true]
				[Spawner:GVK-PlanetaryInstallations-GaalsienHangar-Spawner-SpawnCruisers]
				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-GaalsienHangar-Chat-SpawnCruisers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Spawner-SpawnCruisers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[MinDistance:500]
				[MaxDistance:1500]
				[MinAltitude:10]
				[MaxAltitude:20]
				[MaxSpawns:4]
				[InheritNpcAltitude:true]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-AssaultShip]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-Honorguard]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-ArtilleryCruiser]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-MissileCruiser]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-ProductionCruiser]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-RailgunCruiser]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-TorpedoCruiser]
				[ProcessAsAdminSpawn:false]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Chat-SpawnCruisers</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[BroadcastRandomly:false]
				[Author:Gaalsien Hangar]
				[Color:Red]
				[ChatMessages:Cruiser ready for action.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequences for Hangar to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Trigger-BeaconDisabled</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10000]
				[StartsReady:false]
				[Conditions:GVK-PlanetaryInstallations-Condition-BeaconDisabled]
				[Actions:GVK-PlanetaryInstallations-GaalsienHangar-Action-Compromised]
			</Description>      
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Compromised]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-PlanetaryInstallations-GaalsienHangar-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Trigger-Despawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Despawn]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-PlanetaryInstallations-GaalsienHangar-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Trigger-DespawnMES</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:DespawnMES]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-PlanetaryInstallations-GaalsienHangar-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Action-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-GaalsienHangar-Chat-Compromised]
				[ToggleBlocksOfType:true]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/ZoneBlock]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconSmall]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconLarge]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/SmallBlockBeacon]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/LargeBlockBeacon]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlLarge]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlSmall]
				[BlockTypeToggles:Off]
				[GenerateExplosion:true]
				[ExplosionOffsetFromRemote:{X:0 Y:45 Z:0}]
				[ExplosionRange:50]
				[ExplosionDamage:10000]
				[ExplosionIgnoresVoxels:true]
				[SetSandboxBooleansFalse:LargeWreckActive]	
				[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienHangar-Chat-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:Coalition]
				[Color:White]
				[ChatMessages:The Gaalsien Hangar has been defeated!]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
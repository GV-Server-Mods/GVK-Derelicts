<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Horsefly Rover Carrier Behavior for Season 2 Event-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienFortress-Behavior</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:Passive]
				[UseAmmoReplenish:true]
				[AmmoReplenishClipAmount:10]
				[MaxAmmoReplenishments:99999999]
				[UsePlayerDistanceTimer:false]
				[UseRetreatTimer:false]
				[UseNoTargetTimer:false]
				[Triggers:GVK-PlanetaryInstallations-GaalsienFortress-Trigger-OnSpawn]
				[Triggers:GVK-PlanetaryInstallations-Trigger-Defenses-Large]
				[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-FireMissilesTimers]
				[Triggers:GVK-Generic-Trigger-SPRTTargetAcquiredChatter]
				[Triggers:GVK-PlanetaryInstallations-GaalsienFortress-Trigger-Compromised]
				[Triggers:GVK-PlanetaryInstallations-GaalsienFortress-Trigger-BeaconDisabled]
				[Triggers:GVK-PlanetaryInstallations-GaalsienFortress-Trigger-Despawn]
				[Triggers:GVK-PlanetaryInstallations-GaalsienFortress-Trigger-DespawnMES]
				[TargetData:GVK-Generic-TargetProfile-EnemyGrids-LongRange]
				[RemoteControlCode:GVK-LargeDerelict]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Carrier Spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienFortress-Trigger-OnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[MinCooldownMs:900000]
				[MaxCooldownMs:900000]
				[Actions:GVK-PlanetaryInstallations-GaalsienFortress-Action-OnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienFortress-Action-OnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetSandboxBooleansTrue:LargeWreckActive]
				[SetWeaponsToMaxRange:true]
				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-GaalsienFortress-Chat-Announce]
				[UseJetpackInhibitorEffect:true]
			</Description>
		</EntityComponent>
		<!-- need to run jetpack inhibitor on restart as well -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		  <Id>
			  <TypeId>Inventory</TypeId>
			  <SubtypeId>GVK-PlanetaryInstallations-GaalsienFortress-Chat-Announce</SubtypeId>
		  </Id>
		  <Description>

			  [RivalAI Chat]
			  
			  [UseChat:true]
			  [StartsReady:true]
			  [Chance:100]
			  [MaxChats:2]
			  [BroadcastRandomly:false]
			  [Author:COALITION]
			  [Color:White]
			  
			  [ChatMessages:A Gaalsien Fortress has been spotted.]
			  [ChatAudio:ArcHudGPSNotification2]
			  [BroadcastChatType:Chat]
			  [ChatMessages:A Gaalsien Fortress has been spotted.]
			  [BroadcastChatType:Notify]
			  [SendToAllOnlinePlayers:true]

		  </Description>      
		</EntityComponent>
		<!-- Trigger sequences for Fortress to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienFortress-Trigger-BeaconDisabled</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10000]
				[StartsReady:false]
				[Conditions:GVK-PlanetaryInstallations-Condition-BeaconDisabled]				  
				[Actions:GVK-PlanetaryInstallations-GaalsienFortress-Action-Compromised]
			</Description>      
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienFortress-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Compromised]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-PlanetaryInstallations-GaalsienFortress-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienFortress-Trigger-Despawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Despawn]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-PlanetaryInstallations-GaalsienFortress-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienFortress-Trigger-DespawnMES</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:DespawnMES]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-PlanetaryInstallations-GaalsienFortress-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienFortress-Action-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-GaalsienFortress-Chat-Compromised]
				[ToggleBlocksOfType:true]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/ZoneBlock]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconSmall]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconLarge]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/SmallBlockBeacon]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/LargeBlockBeacon]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlLarge]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlSmall]
				[BlockTypeToggles:Off]
				[GenerateExplosion:true]
				[ExplosionOffsetFromRemote:{X:0 Y:60 Z:0}]
				[ExplosionRange:100]
				[ExplosionDamage:50000]
				[ExplosionIgnoresVoxels:true]
				[EnableBlocks:true]
				[EnableBlockNames:NPC Beacon]
				[EnableBlockStates:Off]
				[TriggerTimerBlocks:True]
				[TimerBlockNames:Timer Block Warheads]
				[SetSandboxBooleansFalse:LargeWreckActive]	
				[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienFortress-Chat-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:Coalition]
				[Color:White]
				[ChatMessages:The Gaalsien Fortress has been defeated!]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
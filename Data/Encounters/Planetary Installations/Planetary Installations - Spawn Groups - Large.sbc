		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-NPC-PlanetDerelict-GAALSIEN-Liberty</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[SpawnConditionsProfiles:GVK-SpawnConditions-Derelicts-Large]
				[ManipulationProfiles:MES-Manipulation-RivalAi]
				[ManipulationProfiles:GVK-Manipulation-Derelicts-Large]
				[CutVoxelsAtAirtightCells:true]
				[CutVoxelSize:9]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>5.0</Frequency>
			<Prefabs>
				<Prefab SubtypeId="[NPC Large Wreck] Liberty">
					<Position>
						<X>0.0</X>
						<Y>30.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Large Crash Site</BeaconText>
					<Behaviour>GVK-NPC-PlanetDerelictLarge-Behavior-Start</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

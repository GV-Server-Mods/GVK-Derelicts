			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[SpawnConditionsProfiles:GVK-PlanetaryInstallations-SpawnConditions-LargeDerelict]

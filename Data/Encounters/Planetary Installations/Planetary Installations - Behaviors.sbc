<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Behavior-Small</SubtypeId>
			</Id>
			<Description>

				[RivalAI Behavior]

				[BehaviorName:Passive]

				[UseRetreatTimer:false]
				[UseNoTargetTimer:false]
				[UsePlayerDistanceTimer:false]
				[PlayerDistanceTimerTrigger:1800]
				[PlayerDistanceTrigger:15000]
				  
				[Triggers:GVK-PlanetaryInstallations-Trigger-Spawned-Small]
				[Triggers:GVK-PlanetaryInstallations-Trigger-Despawn]
				[Triggers:GVK-PlanetaryInstallations-Trigger-DespawnMES]
				[Triggers:GVK-PlanetaryInstallations-Trigger-Compromised-Small]
				[Triggers:GVK-PlanetaryInstallations-Trigger-BeaconDisabled-Small]

				[TargetData:GVK-Generic-TargetProfile-EnemyPlayers]

				[RemoteControlCode:GVK-Derelict]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Behavior-Medium</SubtypeId>
			</Id>
			<Description>

				[RivalAI Behavior]

				[BehaviorName:Passive]

				[UseRetreatTimer:false]
				[UseNoTargetTimer:false]
				[UsePlayerDistanceTimer:false]
				[PlayerDistanceTimerTrigger:1800]
				[PlayerDistanceTrigger:15000]
				  
				[Triggers:GVK-PlanetaryInstallations-Trigger-Spawned-Medium]
				[Triggers:GVK-PlanetaryInstallations-Trigger-Despawn]
				[Triggers:GVK-PlanetaryInstallations-Trigger-DespawnMES]
				[Triggers:GVK-PlanetaryInstallations-Trigger-Compromised-Medium]
				[Triggers:GVK-PlanetaryInstallations-Trigger-BeaconDisabled-Medium]
				[Triggers:GVK-PlanetaryInstallations-Trigger-Defenses-Medium]

				[TargetData:GVK-Generic-TargetProfile-EnemyPlayers]

				[RemoteControlCode:GVK-Derelict]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Behavior-Large</SubtypeId>
			</Id>
			<Description>

				[RivalAI Behavior]

				[BehaviorName:Passive]

				[UseRetreatTimer:false]
				[UseNoTargetTimer:false]
				[UsePlayerDistanceTimer:false]
				[PlayerDistanceTimerTrigger:1800]
				[PlayerDistanceTrigger:15000]
				  
				[Triggers:GVK-PlanetaryInstallations-Trigger-Spawned-Large]
				[Triggers:GVK-PlanetaryInstallations-Trigger-Despawn]
				[Triggers:GVK-PlanetaryInstallations-Trigger-DespawnMES]
				[Triggers:GVK-PlanetaryInstallations-Trigger-Compromised-Large]
				[Triggers:GVK-PlanetaryInstallations-Trigger-BeaconDisabled-Large]
				[Triggers:GVK-PlanetaryInstallations-Trigger-Defenses-Large]

				[TargetData:GVK-Generic-TargetProfile-EnemyPlayers]

				[RemoteControlCode:GVK-LargeDerelict]
	  
			</Description>
		</EntityComponent>
		<!-- Chat for small spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-Spawned-Small</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[Type:Timer]
				[MinCooldownMs:5000]
				[MaxCooldownMs:5000]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:2]
				  
				[Actions:GVK-PlanetaryInstallations-Action-Spawned-Small]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Action-Spawned-Small</SubtypeId>
			</Id>
			<Description>

				[RivalAI Action]
				  
				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-Chat-Spawned-Small]
	  	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Chat-Spawned-Small</SubtypeId>
			</Id>
			<Description>

				[RivalAI Chat]

				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:2]
				[BroadcastRandomly:false]
				[IgnoreAntennaRequirement:true]
				[IgnoredAntennaRangeOverride:6000]
				[Author:COALITION]
				[Color:White]

				[ChatMessages:A Small Derelict has been detected.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Chat]
				[ChatMessages:A Small Derelict has been detected]
				[BroadcastChatType:Notify]
				[SendToAllOnlinePlayers:false]

			</Description>
		</EntityComponent>
		<!-- Chat for medium spawns -->

				[StartsReady:false]
				[MaxActions:2]
				  
				[Actions:GVK-PlanetaryInstallations-Action-Spawned-Large]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Action-Spawned-Large</SubtypeId>
			</Id>
			<Description>

				[RivalAI Action]

				[SetSandboxBooleansTrue:LargeWreckActive]
				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-Chat-Spawned-Large]
	  	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">

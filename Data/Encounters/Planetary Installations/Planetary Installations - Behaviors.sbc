				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:2]
				[BroadcastRandomly:false]
				[Author:COALITION]
				[Color:White]

				[ChatMessages:A Large Derelict has been detected.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Chat]
				[ChatMessages:A Large Derelict has been detected]
				[BroadcastChatType:Notify]
				[SendToAllOnlinePlayers:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-Despawn</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[Type:Despawn]
				[UseTrigger:true]
				[MaxActions:1]

				[Actions:GVK-PlanetaryInstallations-Action-Despawned]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-DespawnMES</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[Type:DespawnMES]
				[UseTrigger:true]
				[MaxActions:1]

				[Actions:GVK-PlanetaryInstallations-Action-Despawned]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Action-Despawned</SubtypeId>
			</Id>
			<Description>

				[RivalAI Action]

				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-Chat-Despawned]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Chat-Despawned</SubtypeId>
			</Id>
			<Description>

				[RivalAI Chat]

				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:COALITION]
				[Color:White]

				[ChatMessages:A Derelict has disappeared]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-Compromised-Small</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[Type:Compromised]
				[UseTrigger:true]
				[MaxActions:1]

				[Actions:GVK-PlanetaryInstallations-Action-Compromised-All]
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-Small]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-Compromised-Medium</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[Type:Compromised]
				[UseTrigger:true]
				[MaxActions:1]

				[Actions:GVK-PlanetaryInstallations-Action-Compromised-All]
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-Medium]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-Compromised-Large</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[Type:Compromised]
				[UseTrigger:true]
				[MaxActions:1]

				[Actions:GVK-PlanetaryInstallations-Action-Compromised-All]
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-Large]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Action-Compromised-All</SubtypeId>
			</Id>
			<Description>

				[RivalAI Action]
				
				[DisableTriggers:true]
				[DisableTriggerNames:GVK-PlanetaryInstallations-Trigger-Compromised-Small]
				[DisableTriggerNames:GVK-PlanetaryInstallations-Trigger-Compromised-Medium]
				[DisableTriggerNames:GVK-PlanetaryInstallations-Trigger-Compromised-Large]
				[DisableTriggerNames:GVK-PlanetaryInstallations-Trigger-BeaconDisabled-Small]
				[DisableTriggerNames:GVK-PlanetaryInstallations-Trigger-BeaconDisabled-Medium]
				[DisableTriggerNames:GVK-PlanetaryInstallations-Trigger-BeaconDisabled-Large]
				[DisableTriggerNames:GVK-PlanetaryInstallations-Trigger-Despawn]
				[DisableTriggerNames:GVK-PlanetaryInstallations-Trigger-DespawnMES]
				
				[GenerateExplosion:true]
				[ExplosionOffsetFromRemote:{X:0 Y:0 Z:0}]
				[ExplosionRange:10]
				[ExplosionDamage:1]
				[ExplosionIgnoresVoxels:true]

				[ToggleBlocksOfType:true]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/ZoneBlock]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconSmall]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconLarge]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/SmallBlockBeacon]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/LargeBlockBeacon]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlLarge]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlSmall]
				[BlockTypeToggles:Off]
				[TerminateBehavior:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Action-Compromised-Small</SubtypeId>
			</Id>
			<Description>

				[RivalAI Action]
				  
				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-Chat-Compromised-Small]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Action-Compromised-Medium</SubtypeId>
			</Id>
			<Description>

				[RivalAI Action]
				  
				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-Chat-Compromised-Medium]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Action-Compromised-Large</SubtypeId>
			</Id>
			<Description>

				[RivalAI Action]
				 
				[SetSandboxBooleansFalse:LargeWreckActive]	  	  

				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-Chat-Compromised-Large]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Chat-Compromised-Small</SubtypeId>
			</Id>
			<Description>

				[RivalAI Chat]

				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:COALITION]
				[Color:White]

				[ChatMessages:A Small Derelict has been disabled.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Chat-Compromised-Medium</SubtypeId>
			</Id>
			<Description>

				[RivalAI Chat]

				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:COALITION]
				[Color:White]


		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Chat-Compromised-Large</SubtypeId>
			</Id>
			<Description>

				[RivalAI Chat]

				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:COALITION]
				[Color:White]

				[ChatMessages:A Large Derelict has been disabled.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-BeaconDisabled-Small</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10000]
				[StartsReady:false]

				[Conditions:GVK-PlanetaryInstallations-Condition-BeaconDisabled]
				  
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-All]
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-Small]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-BeaconDisabled-Medium</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10000]
				[StartsReady:false]

				[Conditions:GVK-PlanetaryInstallations-Condition-BeaconDisabled]
				  
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-All]
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-Medium]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-BeaconDisabled-Large</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10000]
				[StartsReady:false]

				[Conditions:GVK-PlanetaryInstallations-Condition-BeaconDisabled]
				  
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-All]
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-Large]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Condition-BeaconDisabled</SubtypeId>
			</Id>
			<Description>

				[RivalAI Condition]

				[UseConditions:true]
				[MatchAnyCondition:false]

				[UseRequiredFunctionalBlocks:true]
				[RequiredNoneFunctionalBlockNames:Proprietary Beacon]
				[RequiredNoneFunctionalBlockNames:Small Crash Site]
				[RequiredNoneFunctionalBlockNames:Medium Crash Site]
				[RequiredNoneFunctionalBlockNames:Large Crash Site]
				[RequiredNoneFunctionalBlockNames:Planet Derelict]
				[RequiredNoneFunctionalBlockNames:Disposable Beacon]
				[RequiredNoneFunctionalBlockNames:Large Abandoned Building]
				[RequiredNoneFunctionalBlockNames:Small Drill Rig]
				[RequiredNoneFunctionalBlockNames:Fortress]
				[RequiredNoneFunctionalBlockNames:Hangar]
				[RequiredNoneFunctionalBlockNames:Outpost]

			</Description>
		</EntityComponent>
		<!-- Trigger Sequence for Small Defenses currently unused -->
		<!-- Trigger Sequence for Medium Defenses -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-Defenses-Medium</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[UseTrigger:true]
				[Type:PlayerNear]
				[TargetDistance:500]
				[StartsReady:true]
				[MinCooldownMs:5000]
				[MaxCooldownMs:10000]

				[MaxActions:3]
				[Actions:GVK-PlanetaryInstallations-Action-Defenses-Medium]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Action-Defenses-Medium</SubtypeId>
			</Id>
			<Description>

				[RivalAI Action]

				[Chance:60]

				[SpawnEncounter:true]
				[Spawner:GVK-PlanetaryInstallations-Spawner-DefenseDrones-Medium]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Spawner-DefenseDrones-Medium</SubtypeId>
			</Id>
			<Description>
	  
				[RivalAI Spawn]

				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[ProcessAsAdminSpawn:false]
				[MaxSpawns:3]

				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-Defiant]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-Hawk]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-Reaper]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-Revenant]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-Wasp]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-Hornet]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-Slicer]
				[SpawnGroups:GVK-CustomSpawns-DefenseDrone-SpawnGroup-GAALSIEN-Dragoon]

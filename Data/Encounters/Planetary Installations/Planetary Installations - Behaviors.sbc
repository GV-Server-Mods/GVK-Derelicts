			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Chat-Compromised-Large</SubtypeId>
			</Id>
			<Description>

				[RivalAI Chat]

				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:COALITION]
				[Color:White]

				[ChatMessages:A Large Derelict has been disabled.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Both]
				[SendToAllOnlinePlayers:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-BeaconDisabled-Small</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10000]
				[StartsReady:false]

				[Conditions:GVK-PlanetaryInstallations-Condition-BeaconDisabled]
				  
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-All]
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-Small]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-BeaconDisabled-Medium</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10000]
				[StartsReady:false]

				[Conditions:GVK-PlanetaryInstallations-Condition-BeaconDisabled]
				  
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-All]
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-Medium]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-BeaconDisabled-Large</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:10000]
				[MaxCooldownMs:10000]
				[StartsReady:false]

				[Conditions:GVK-PlanetaryInstallations-Condition-BeaconDisabled]
				  
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-All]
				[Actions:GVK-PlanetaryInstallations-Action-Compromised-Large]
	  
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Condition-BeaconDisabled</SubtypeId>
			</Id>
			<Description>

				[RivalAI Condition]

				[UseConditions:true]
				[MatchAnyCondition:false]
				
				[CheckForBlocksOfType:true]
				[BlocksOfType:MyObjectBuilder_Beacon]
				[UseFailCondition:true]

			</Description>
		</EntityComponent>
		<!-- Trigger Sequence for Small Defenses currently unused -->
		<!-- Trigger Sequence for Medium Defenses -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-Defenses-Medium-PlayerNear</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[UseTrigger:true]
				[Type:PlayerNear]
				[TargetDistance:750]
				[StartsReady:true]
				[MinCooldownMs:5000]
				[MaxCooldownMs:10000]

				[MaxActions:3]
				[Actions:GVK-PlanetaryInstallations-Action-Defenses-Medium]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Trigger-Defenses-Medium-Damage</SubtypeId>
			</Id>
			<Description>

				[RivalAI Trigger]

				[UseTrigger:true]
				[Type:Damage]
				[DamageTypes:Any]
				[StartsReady:true]
				[MinCooldownMs:5000]
				[MaxCooldownMs:10000]

				[MaxActions:3]
				[Actions:GVK-PlanetaryInstallations-Action-Defenses-Medium]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Action-Defenses-Medium</SubtypeId>
			</Id>
			<Description>

				[RivalAI Action]

				[Chance:75]

				[SpawnEncounter:true]
				[Spawner:GVK-PlanetaryInstallations-Spawner-DefenseDrones-Medium]

				[UseChatBroadcast:true]
				[ChatData:GVK-PlanetaryInstallations-Chat-Defenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-Spawner-DefenseDrones-Medium</SubtypeId>
			</Id>
			<Description>
	  
				[RivalAI Spawn]

				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[ProcessAsAdminSpawn:false]
				[MaxSpawns:3]


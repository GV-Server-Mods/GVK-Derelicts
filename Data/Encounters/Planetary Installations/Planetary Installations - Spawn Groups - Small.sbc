				<Prefab SubtypeId="[NPC Small Wreck] Thornback Ray">
					<Position>
						<X>0.0</X>
						<Y>3.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Small Crash Site</BeaconText>
					<Behaviour>GVK-NPC-PlanetDerelictSmall-Behavior-Start</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

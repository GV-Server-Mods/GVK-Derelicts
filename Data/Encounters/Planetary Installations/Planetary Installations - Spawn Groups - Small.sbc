			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-SpawnGroups-Small-Thornback Ray</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[SpawnConditionsProfiles:GVK-PlanetaryInstallations-SpawnConditions-SmallDerelict]
				[ManipulationProfiles:MES-Manipulation-RivalAi]
				[ManipulationProfiles:GVK-PlanetaryInstallations-Manipulations-Small]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>5.0</Frequency>

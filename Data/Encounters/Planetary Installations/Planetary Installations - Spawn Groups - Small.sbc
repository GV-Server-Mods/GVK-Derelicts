			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-NPC-PlanetDerelict-GAALSIEN-Thornback Ray</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[SpawnConditionsProfiles:GVK-SpawnConditions-Derelicts-Small]
				[ManipulationProfiles:MES-Manipulation-RivalAi]
				[ManipulationProfiles:GVK-Manipulation-Derelicts-Small]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>5.0</Frequency>

			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB38]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB39]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB40]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB41]

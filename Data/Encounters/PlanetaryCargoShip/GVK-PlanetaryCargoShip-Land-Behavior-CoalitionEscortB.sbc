			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB20]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB21]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB22]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB23]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB24]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB25]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB26]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB27]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB28]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB29]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB30]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB31]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB32]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB33]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB34]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB35]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB36]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB37]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB38]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB39]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB40]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB41]

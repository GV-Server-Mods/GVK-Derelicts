			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB14]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB15]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB16]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB17]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB18]

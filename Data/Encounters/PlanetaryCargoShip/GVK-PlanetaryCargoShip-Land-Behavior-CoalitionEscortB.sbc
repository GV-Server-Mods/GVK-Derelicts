<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Route B, Crossroads to Mastodon -->
		<!-- Cargo Ship Behavior for land rover following roads -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Behavior-EscortB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:CargoShip]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:3600]
			[PlayerDistanceTrigger:4000]
			[UseRetreatTimer:false]
			[RetreatTimerTrigger:3600]
			[UseNoTargetTimer:false]
			[RetreatDespawnDistance:3000]
			[AutopilotData:GVK-CargoShip-Land-COALITION-EscortPrimaryAutopilot]
			[SecondaryAutopilotData:GVK-CargoShip-Land-COALITION-EscortSecondaryAutopilot]
			[TertiaryAutopilotData:GVK-CargoShip-Land-COALITION-EscortTertiaryAutopilot]
			[TargetData:GVK-Universal-Target-COALITIONTradeStation]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[Triggers:GVK-Universal-Trigger-EditableOnCompromised]
			[Triggers:GVK-Universal-Trigger-TargetAttacker]
			[Triggers:GVK-Universal-Trigger-TurretTarget]
			[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortOnSpawnB]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortAddWaypointsB]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortArriveAtWaypoint]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortLeaveWaypoint]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortBeaconDisabled]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortCompromised]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortAttacked]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerNear]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerStillNear]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerNotNear]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideZ1]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ1]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideZ2]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ2]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideZ3]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ3]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessTargetB]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessCounterB]
			[RemoteControlCode:COALITIONRouteB]
			</Description>
		</EntityComponent>
		<!-- Escort chat when spawned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortOnSpawnB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1000]
			[ActionExecution:All]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortOnSpawnB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-EscortOnSpawnB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[SetWeaponsToMaxRange:true]
			[ResetCounters:WaypointCounter]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-Land-COALITION-Chat-EscortOnSpawnB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-EscortOnSpawnB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:{Faction}]
			[Color:{PlayerRelation}]
			[ChatMessages:A Transport is ready for escort from Crossroads to Mastodon (Moderate).]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:999999]
			</Description>
		</EntityComponent>
		<!-- Trigger to add waypoints after spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortAddWaypointsB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:2]
			[MinCooldownMs:3000]
			[MaxCooldownMs:3001]
			[ActionExecution:All]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortAddWaypointsB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-EscortAddWaypointsB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[AddWaypoints:true]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB01]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB02]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB03]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB04]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB05]

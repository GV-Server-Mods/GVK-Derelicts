			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB49]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB50]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB51]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB52]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB54]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB55]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB56]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB57]

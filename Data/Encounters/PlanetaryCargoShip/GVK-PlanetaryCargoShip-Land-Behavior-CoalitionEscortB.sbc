			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB63]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB64]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB65]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB66]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB67]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB68]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB69]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB70]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-Land-COALITION-Chat-EscortAddWaypointsB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-EscortAddWaypointsB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:false]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Land Cargo Ship]
			[Color:White]
			[ChatMessages:Adding waypoints.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger when it reaches Sevastapol to spawn reward -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessTargetB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:TargetNear]
			[UseTrigger:true]
			[StartsReady:false]
			[TargetDistance:250]
			[ActionExecution:All]
			[MinCooldownMs:9998]
			[MaxCooldownMs:9999]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortSuccessB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessCounterB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[ActionExecution:All]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[Conditions:GVK-CargoShip-Land-COALITION-Condition-EscortSuccessB]
			[ConditionCheckResetsTimer:true]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortSuccessB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Condition-EscortSuccessB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckCustomCounters:true]
			[CustomCounters:WaypointCounter]
			[CustomCountersTargets:69]
			[CounterCompareTypes:GreaterOrEqual]
			[AllowAnyValidCounter:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-EscortSuccessB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-Land-COALITION-Chat-EscortSuccessB]
			[SpawnEncounter:true]
			[Spawner:GVK-CargoShip-Land-COALITION-Spawner-EscortSuccessB]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessTargetB]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessCounterB]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerNear]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerNotNear]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideZ1]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ1]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideZ2]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ2]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideZ3]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ3]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortAttacked]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortBeaconDisabled]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortCompromised]
			[PlayParticleEffectAtRemote:true]
			[ParticleEffectId:CruiserPoofSmoke]
			[ParticleEffectOffset:{X:0.0 Y:0.0 Z:0.0}]
			[ParticleEffectScale:3.0]
			[ParticleEffectMaxTime:2000]
			[ParticleEffectColor:{X:1.0 Y:1.0 Z:1.0}]
			[PlaySoundAtPosition:true]
			[SoundAtPosition:Cruiser_Explosion]
			[ForceDespawn:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-EscortSuccessB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:{Faction}]
			[Color:{PlayerRelation}]
			[ChatMessages:Cargo Transport arrived safely at Mastodon.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
		  </Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Spawner-EscortSuccessB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:true]
			[MaxSpawns:1]
			[SpawnGroups:GVK-Other-Loot-SpawnGroup-COALITION-CargoDrop2x]
			[MinDistance:300]
			[MaxDistance:400]
			[MinAltitude:300]
			[MaxAltitude:301]
			[InheritNpcAltitude:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
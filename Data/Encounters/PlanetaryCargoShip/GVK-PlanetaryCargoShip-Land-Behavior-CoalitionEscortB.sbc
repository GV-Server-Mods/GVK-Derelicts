			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB67]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB68]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB69]
			[WaypointsToAdd:GVK-Convoy-Static-LandRouteB70]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-Land-COALITION-Chat-EscortAddWaypointsB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-EscortAddWaypointsB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:false]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Land Cargo Ship]
			[Color:White]
			[ChatMessages:Adding waypoints.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger when it reaches Sevastapol to spawn reward -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessTargetB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:TargetNear]
			[UseTrigger:true]
			[StartsReady:false]
			[TargetDistance:250]
			[ActionExecution:All]
			[MinCooldownMs:9998]
			[MaxCooldownMs:9999]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortSuccessB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessCounterB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[ActionExecution:All]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[Conditions:GVK-CargoShip-Land-COALITION-Condition-EscortSuccessB]
			[ConditionCheckResetsTimer:true]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortSuccessB]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Condition-EscortSuccessB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckCustomCounters:true]
			[CustomCounters:WaypointCounter]
			[CustomCountersTargets:70]
			[CounterCompareTypes:GreaterOrEqual]
			[AllowAnyValidCounter:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-EscortSuccessB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-Land-COALITION-Chat-EscortSuccessB]
			[SpawnEncounter:true]
			[Spawner:GVK-CargoShip-Land-COALITION-Spawner-EscortSuccessB]
			[EnableBlocks:true]
			[EnableBlockNames:NPC Suspension]
			[EnableBlockStates:Off]
			[TriggerTimerBlocks:true]
			[TimerBlockNames:NPC Timer E-brake]
			[StopAllRotation:true]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessTargetB]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessCounterB]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerNear]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerNotNear]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawns]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortAttacked]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortCompromised]
			[RazeBlocksOfType:true]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/ZoneBlock]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/DisposableNpcBeaconSmall]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/DisposableNpcBeaconLarge]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/SmallBlockBeacon]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/LargeBlockBeacon]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/SmallBlockBeacon_NPCNoConceal]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/LargeBlockBeacon_NPCNoConceal]
			[ToggleBlocksOfType:true]
			[BlockTypesToToggle:MyObjectBuilder_RemoteControl/RivalAIRemoteControlLarge]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_RemoteControl/RivalAIRemoteControlSmall]
			[BlockTypeToggles:Off]
			[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-EscortSuccessB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Coalition]
			[Color:White]
			[ChatMessages:Cargo Transport arrived safely.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
		  </Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Spawner-EscortSuccessB</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:1]
			[SpawnGroups:GVK-Other-Loot-SpawnGroup-COALITION-CargoDrop2x]
			[MinDistance:300]
			[MaxDistance:400]
			[MinAltitude:300]
			[MaxAltitude:301]
			[InheritNpcAltitude:true]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB14]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB15]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB16]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB17]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB18]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB19]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB20]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB21]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB22]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB23]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB24]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB25]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB26]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB27]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB28]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB29]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB30]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB31]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB32]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB33]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB34]
			[WaypointsToAdd:GVK-Convoy-WaypointStatic-LandRouteB35]

		<!-- NDR [COAL] Cargo Cruiser East Crossroads-Sevastopol-->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<!--Do Not Edit-->
				<SubtypeId>GVK-PlanetaryCargoShip-Air-COALITION-SpawnGroup-EscortE</SubtypeId>
			</Id>
			<Description>
			[Modular Encounters SpawnGroup]
			[IgnoreCleanupRules:true]
			[ReplenishSystems:true]
			[SpawnConditionsProfiles:GVK-SpawnCondition-Land-CargoShip-COALITIONE]
			[ManipulationProfiles:MES-Manipulation-RivalAi] 
			[ManipulationProfiles:GVK-PlanetaryCargoShip-Air-Manipulation]
			</Description>
			<IsPirate>true</IsPirate>
			<!--Do not edit-->
			<Frequency>0.1</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NCS [COAL] Carryall">
					<Position>
						<X>80</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>50</Speed>
					<BeaconText>Aerial Cargo Escort (Sky-Sev)</BeaconText>
					<Behaviour>GVK-CargoShip-Air-COALITION-Behavior-EscortE</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>
	</SpawnGroups>

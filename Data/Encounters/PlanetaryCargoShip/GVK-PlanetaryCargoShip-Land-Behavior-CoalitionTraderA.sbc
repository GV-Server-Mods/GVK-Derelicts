<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Cargo Ship Behavior for land rover following roads -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Behavior-TraderA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:CargoShip]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:false]
			[UseRetreatTimer:true]
			[RetreatTimerTrigger:3600]
			[UseNoTargetTimer:false]
			[RetreatDespawnDistance:4000]
			[AutopilotData:GVK-CargoShip-Land-COALITION-TraderPrimaryAutopilot]
			[SecondaryAutopilotData:GVK-CargoShip-Land-COALITION-TraderSecondaryAutopilot]
			[TargetData:GVK-Universal-Target-EnemyGaalsienBeacon]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[Triggers:GVK-Universal-Trigger-IndestructibleOnSpawn]
			[Triggers:GVK-Drone-All-Trigger-BeaconDisabled]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-TurretTarget]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TraderOnSpawnA]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortAddWaypointsA]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortArriveAtWaypoint]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortLeaveWaypoint]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortHeadToDespawn]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortCompromised]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortAttacked]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNear]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerStillNear]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortOutsizeZone0]
			[RemoteControlCode:CoalitionRouteA]
			</Description>
		</EntityComponent>
		<!-- Trader Transport Ship Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-TraderPrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:1.25]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.20]
			[DisableInertiaDampeners:true]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:17.5]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:30]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:100]
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:200]
			[CollisionEvasionResumeDistance:100]
			[CollisionEvasionResumeTime:10]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[CollisionEvasionWaypointFromEntityMaxAngle:90]
			[WaypointAbandonTimeTrigger:60]
			[WaypointTolerance:95]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:50]
			[MaxSpeedTolerance:10]
			[SlowDownOnWaypointApproach:true]
			[WaypointWaitTimeTrigger:120]
			[ExtraSlowDownDistance:300]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:90]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Secondary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-TraderSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0]
			[IdealPlanetAltitude:17.5]
			[WaypointTolerance:95]
			</Description>
		</EntityComponent>
		<!-- Trigger when Cargo Ship Spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TraderOnSpawnA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1000]
			[Actions:GVK-CargoShip-Land-COALITION-Action-TraderOnSpawnA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TraderOnSpawnA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			[SetWeaponsToMaxRange:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-Land-COALITION-Chat-TraderOnSpawnA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-TraderOnSpawnA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Coalition]
			[Color:White]
			[ChatMessages:A Trader is en route to Sevastapol]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to stop moving when player is near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:300]
			[StartsReady:false]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Actions:GVK-CargoShip-Land-COALITION-Action-TraderPlayerNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TraderPlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[EnableBlocks:true]
			[EnableBlockNames:NPC Suspension]
			[EnableBlockStates:On]
			[TriggerTimerBlocks:true]
			[TimerBlockNames:NPC Timer E-brake]
			[EnableTriggers:true]
			[EnableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNear]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-Land-COALITION-Chat-TraderPlayerNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-TraderPlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Coalition Trader]
			[Color:White]
			[ChatMessages:Stopping for trade.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:1000]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to check if the player is still near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerStillNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:300]
			[StartsReady:false]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Actions:GVK-CargoShip-Land-COALITION-Action-TraderPlayerStillNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TraderPlayerStillNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[EnableTriggers:true]
			[EnableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to start moving when player is no longer near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:false]
			[MinCooldownMs:11000]
			[MaxCooldownMs:11001]
			[Actions:GVK-CargoShip-Land-COALITION-Action-TraderPlayerNotNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-TraderPlayerNotNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			[EnableBlocks:true]
			[EnableBlockNames:NPC Suspension]
			[EnableBlockStates:Off]
			[TriggerTimerBlocks:true]
			[TimerBlockNames:NPC Timer Resume Cruise]
			[EnableTriggers:true]
			[EnableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
			[EnableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNear]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-TraderPlayerNotNear]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-Land-COALITION-Chat-TraderPlayerNotNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-TraderPlayerNotNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Coalition Trader]
			[Color:White]
			[ChatMessages:Resuming Route.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:1000]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
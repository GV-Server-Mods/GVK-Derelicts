<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- 
		
			Route A, Crossroads to Sevastapol
			Cargo Ship Behavior for land rover following roads
			Use alternate spawning method in Canyon Route Zone
				GPS:Canyon Route:32649.04:36654.43:62459.73:#FF75C9F1:
				26.45km

		-->	
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Behavior-EscortA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:CargoShip]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:3600]
			[PlayerDistanceTrigger:4000]
			[UseRetreatTimer:false]
			[RetreatTimerTrigger:3600]
			[UseNoTargetTimer:false]
			[RetreatDespawnDistance:3000]
			[AutopilotData:GVK-CargoShip-Land-COALITION-EscortPrimaryAutopilot]
			[SecondaryAutopilotData:GVK-CargoShip-Land-COALITION-EscortSecondaryAutopilot]
			[TertiaryAutopilotData:GVK-CargoShip-Land-COALITION-EscortTertiaryAutopilot]
			[TargetData:GVK-Universal-Target-COALITIONTradeStation]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[Triggers:GVK-Universal-Trigger-EditableOnCompromised]
			[Triggers:GVK-Universal-Trigger-TargetAttacker]
			[Triggers:GVK-Universal-Trigger-TurretTarget]
			[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortOnSpawnA]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortAddWaypointsA]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortArriveAtWaypoint]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortLeaveWaypoint]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortBeaconDisabled]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortCompromised]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortAttacked]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerNear]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerStillNear]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerNotNear]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideZ1]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ1]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideZ2]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ2]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortInsideZ3]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawnsZ3]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessTargetA]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessCounterA]
			[RemoteControlCode:COALITIONRouteA]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Primary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-EscortPrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:1.25]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.50]
			[DisableInertiaDampeners:true]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:22.5]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:40]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:100]
			[UseVelocityCollisionEvasion:false]
			[CollisionEvasionWaypointDistance:200]
			[CollisionEvasionResumeDistance:100]
			[CollisionEvasionResumeTime:10]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[CollisionEvasionWaypointFromEntityMaxAngle:90]
			[WaypointAbandonTimeTrigger:9999999]
			[WaypointTolerance:95]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:40]
			[MaxSpeedTolerance:5]
			[SlowDownOnWaypointApproach:true]
			[WaypointWaitTimeTrigger:120]
			[ExtraSlowDownDistance:300]
			[AngleAllowedForForwardThrust:45]
			[MaxVelocityAngleForSpeedControl:1000]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Secondary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-EscortSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0.75]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.20]
			[IdealPlanetAltitude:22.5]
			[WaypointTolerance:95]
			[IdealMinSpeed:0]
			[IdealMaxSpeed:0]
			[MaxSpeedTolerance:2]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Tertiary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-EscortTertiaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:1.25]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.20]
			[DisableInertiaDampeners:true]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:22.5]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:40]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:100]
			[UseVelocityCollisionEvasion:false]
			[CollisionEvasionWaypointDistance:200]
			[CollisionEvasionResumeDistance:100]
			[CollisionEvasionResumeTime:10]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[CollisionEvasionWaypointFromEntityMaxAngle:90]
			[WaypointAbandonTimeTrigger:9999999]
			[WaypointTolerance:95]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:50]
			[MaxSpeedTolerance:10]
			[SlowDownOnWaypointApproach:true]
			[WaypointWaitTimeTrigger:120]
			[ExtraSlowDownDistance:300]
			[AngleAllowedForForwardThrust:90]
			[MaxVelocityAngleForSpeedControl:1000]
			</Description>
		</EntityComponent>		
		<!-- Trigger when Cargo Ship Spawns -->
		<!-- Escort chat when spawned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortOnSpawnA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1000]
			[ActionExecution:All]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortOnSpawnA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-EscortOnSpawnA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[SetWeaponsToMaxRange:true]
			[ResetCounters:WaypointCounter]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-Land-COALITION-Chat-EscortOnSpawnA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-EscortOnSpawnA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:{Faction}]
			[Color:{PlayerRelation}]
			[ChatMessages:A transport is ready for escort from Crossroads to Sevastopol (Difficult).]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:999999]
			</Description>
		</EntityComponent>
		<!-- Trigger to add waypoints after spawn -->

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Cargo Ship Behavior for land rover following roads -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Behavior-EscortA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:CargoShip]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:3600]
			[PlayerDistanceTrigger:4000]
			[UseRetreatTimer:false]
			[RetreatTimerTrigger:3600]
			[UseNoTargetTimer:false]
			[RetreatDespawnDistance:3000]
			[AutopilotData:GVK-CargoShip-Land-COALITION-EscortPrimaryAutopilot]
			[SecondaryAutopilotData:GVK-CargoShip-Land-COALITION-EscortSecondaryAutopilot]
			[TertiaryAutopilotData:GVK-CargoShip-Land-COALITION-EscortTertiaryAutopilot]
			[TargetData:GVK-Universal-Target-EnemyGaalsienBeacon]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[Triggers:GVK-Universal-Trigger-EditableOnCompromised]
			[Triggers:GVK-Drone-All-Trigger-BeaconDisabled]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-TurretTarget]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortOnSpawn]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortAddWaypointsA]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortArriveAtWaypoint]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortLeaveWaypoint]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortCompromised]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortAttacked]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortEnemySpawns]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerNear]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerStillNear]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortPlayerNotNear]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortOutsideZone0]
			[Triggers:GVK-CargoShip-Land-COALITION-Trigger-EscortSuccessA]
			[RemoteControlCode:CoalitionRouteA]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Primary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-EscortPrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:1.25]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.20]
			[DisableInertiaDampeners:true]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:22.5]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:40]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:100]
			[UseVelocityCollisionEvasion:false]
			[CollisionEvasionWaypointDistance:200]
			[CollisionEvasionResumeDistance:100]
			[CollisionEvasionResumeTime:10]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[CollisionEvasionWaypointFromEntityMaxAngle:90]
			[WaypointAbandonTimeTrigger:9999999]
			[WaypointTolerance:95]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:50]
			[MaxSpeedTolerance:10]
			[SlowDownOnWaypointApproach:true]
			[WaypointWaitTimeTrigger:120]
			[ExtraSlowDownDistance:300]
			[AngleAllowedForForwardThrust:90]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Secondary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-EscortSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0]
			[IdealPlanetAltitude:22.5]
			[WaypointTolerance:95]
			</Description>
		</EntityComponent>
		<!-- Escort Transport Ship Tertiary Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-EscortTertiaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:1.25]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.20]
			[DisableInertiaDampeners:true]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:22.5]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:40]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:100]
			[UseVelocityCollisionEvasion:false]
			[CollisionEvasionWaypointDistance:200]
			[CollisionEvasionResumeDistance:100]
			[CollisionEvasionResumeTime:10]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[CollisionEvasionWaypointFromEntityMaxAngle:90]
			[WaypointAbandonTimeTrigger:9999999]
			[WaypointTolerance:95]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:50]
			[MaxSpeedTolerance:10]
			[SlowDownOnWaypointApproach:true]
			[WaypointWaitTimeTrigger:120]
			[ExtraSlowDownDistance:300]
			[AngleAllowedForForwardThrust:90]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>		<!-- Trigger when Cargo Ship Spawns -->
		<!-- Escort chat when spawned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortOnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1000]
			[ActionExecution:All]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortOnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-EscortOnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[SetWeaponsToMaxRange:true]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh]
			[UseChatBroadcast:true]
			[ChatData:GVK-CargoShip-Land-COALITION-Chat-EscortOnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-EscortOnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Coalition]
			[Color:White]
			[ChatMessages:A Transport is ready for escort to Sevastopol.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:999999]
			</Description>
		</EntityComponent>
		<!-- Trigger to add waypoints after spawn -->

			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[ActionExecution:All]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortAddWaypointsA]
			</Description>
		</EntityComponent>

			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Chat-EscortAddWaypointsA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:false]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Land Cargo Ship]
			[Color:White]
			[ChatMessages:Adding waypoints.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger to fly level with gravity when horizon angle is high -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortHorizonAngleHigh</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:-1]
			[ActionExecution:All]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[Conditions:GVK-CargoShip-Land-COALITION-Condition-EscortHorizonAngleHigh]
			[ConditionCheckResetsTimer:true]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortHorizonAngleHigh]
			[UseElseActions:true]
			[ElseActions:GVK-CargoShip-Land-COALITION-Action-EscortHorizonAngleLow]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Condition-EscortHorizonAngleHigh</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckHorizonAngle:true]
			[MinHorizonAngle:16]
			[MaxHorizonAngle:90]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-EscortHorizonAngleHigh</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Tertiary]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-EscortHorizonAngleLow</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Cargo Ship to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortCompromised]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-LargeExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortCompromised]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-LargeExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortDespawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Despawn]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Trigger-EscortDespawnMES</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:DespawnMES]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-CargoShip-Land-COALITION-Action-EscortCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-Land-COALITION-Action-EscortCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[TriggerTimerBlocks:true]
			[TimerBlockNames:NPC Timer E-brake]
			[EnableBlocks:true]
			[EnableBlockNames:NPC Suspension]
			[EnableBlockStates:Off]
			[DisableTriggers:true]

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>
		<!-- NDR [COAL] Trader -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-PlanetaryCargoShip-Land-COALITION-SpawnGroup-TraderA</SubtypeId>
			</Id>
			<Description>
			[Modular Encounters SpawnGroup]
			[IgnoreCleanupRules:true]
			[ReplenishSystems:true]
			[SpawnConditionsProfiles:GVK-SpawnCondition-Land-CargoShip-COALITIONA]
			[ManipulationProfiles:MES-Manipulation-RivalAi] 
			[ManipulationProfiles:GVK-Manipulation-CargoShip-Trader]
			[PauseAutopilotAtPlayerDistance:500]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>0.1</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NCS [COAL] Trader">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>50</Speed>
					<BeaconText>Trader (Sevast.)</BeaconText>
					<Behaviour>GVK-CargoShip-Land-COALITION-Behavior-TraderA</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-Behavior-ConvoySpawner-CoalitionA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:false]
			[Triggers:GVK-Static-Trigger-ConvoySpawner-Coalition-SpawnConvoyA]
			</Description>
		</EntityComponent>
		<!-- wait timer until next spawn 3600000-7200000 = 1-2 hours -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-Trigger-ConvoySpawner-Coalition-SpawnConvoyA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[MinCooldownMs:4800000]
			[MaxCooldownMs:7200000]
			[UseTrigger:true]
			[StartsReady:false]
			[ConditionCheckResetsTimer:true]
			[Actions:GVK-Static-Action-ConvoySpawner-Coalition-SpawnConvoyA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-Action-ConvoySpawner-Coalition-SpawnConvoyA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SpawnEncounter:true]
			[Spawner:GVK-Static-Spawner-ConvoySpawner-Coalition-SpawnConvoyA]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Static-Spawner-ConvoySpawner-Coalition-SpawnConvoyA</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[SpawnGroups:GVK-PlanetaryCargoShip-Land-Coalition-SpawnGroup-TraderA]
			[SpawnGroups:GVK-PlanetaryCargoShip-Land-Coalition-SpawnGroup-EscortA]
			[MinDistance:200]
			[MaxDistance:500]
			[MinAltitude:40]
			[MaxAltitude:50]
			[InheritNpcAltitude:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
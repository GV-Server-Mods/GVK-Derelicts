<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--=== Target Profiles ===-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Target-EnemyPlayerAndGrid</SubtypeId>
			</Id>
			<Description>
			[RivalAI Target]
			[UseCustomTargeting:true]
			[Target:PlayerAndGrid]
			[UseTargetRefresh:false]
			[TimeUntilNextRefresh:60]
			[TimeUntilNextEvaluation:15]
			[MaxDistance:2000]
			[MaxExistingTargetDistance:2000]
			[GetTargetBy:ClosestDistance]
			[MatchAllFilters:Relation]
			[MatchAllFilters:OutsideOfSafezone]
			[MatchAllFilters:TargetValue]
			[MatchAllFilters:PlayerControlled]
			[MatchAllFilters:Powered]
			[Relations:Enemy]
			[MinTargetValue:10]
			[MaxTargetValue:999999]
			[PrioritizePlayerControlled:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Target-EnemyGrids</SubtypeId>
			</Id>
			<Description>
			[RivalAI Target]
			[UseCustomTargeting:true]
			[Target:Grid]
			[UseTargetRefresh:false]
			[TimeUntilNextRefresh:60]
			[TimeUntilNextEvaluation:15]
			[MaxDistance:2000]
			[MaxExistingTargetDistance:2000]
			[GetTargetBy:ClosestDistance]
			[MatchAllFilters:Relation]
			[MatchAllFilters:OutsideOfSafezone]
			[MatchAllFilters:TargetValue]
			[MatchAllFilters:PlayerControlled]
			[MatchAllFilters:Powered]
			[Relations:Enemy]
			[MinTargetValue:10]
			[MaxTargetValue:999999]
			[PrioritizePlayerControlled:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Target-EnemyGridsLongRange</SubtypeId>
			</Id>
			<Description>
			[RivalAI Target]
			[UseCustomTargeting:true]
			[Target:Grid]
			[UseTargetRefresh:true]
			[TimeUntilNextRefresh:60]
			[TimeUntilNextEvaluation:15]
			[MaxDistance:3000]
			[MaxExistingTargetDistance:3000]
			[GetTargetBy:ClosestDistance]
			[MatchAllFilters:Relation]
			[MatchAllFilters:OutsideOfSafezone]
			[MatchAllFilters:TargetValue]
			[MatchAllFilters:PlayerControlled]
			[MatchAllFilters:Powered]
			[Relations:Enemy]
			[MinTargetValue:100]
			[MaxTargetValue:999999]
			[PrioritizePlayerControlled:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
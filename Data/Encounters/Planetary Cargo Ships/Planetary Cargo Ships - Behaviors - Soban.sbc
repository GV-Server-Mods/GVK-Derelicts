<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Cargo Ship Behavior for trade station routes-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Behavior</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:CargoShip]
				[UsePlayerDistanceTimer:false]
				[UseRetreatTimer:true]
				[RetreatTimerTrigger:3600]
				[UseNoTargetTimer:false]
				[RetreatDespawnDistance:4000]
				[AutopilotData:GVK-CargoShip-SOBAN-Autopilot]
				[TargetData:GVK-Generic-Target-EnemyPlayers]
				[Triggers:GVK-CargoShip-SOBAN-Trigger-OnSpawn]
				[Triggers:GVK-CargoShip-SOBAN-Trigger-RequestNearWaypoint]
				[Triggers:GVK-CargoShip-SOBAN-Trigger-RequestFarWaypoint]
				[Triggers:GVK-CargoShip-SOBAN-Trigger-ReceiveWaypoint]
				[Triggers:GVK-CargoShip-SOBAN-Trigger-ArriveAtWaypoint]
				[Triggers:GVK-CargoShip-SOBAN-Trigger-LeaveWaypoint]
				[Triggers:GVK-CargoShip-SOBAN-Trigger-HeadToDespawn]
				[Triggers:GVK-CargoShip-SOBAN-Trigger-Compromised]
				[Triggers:GVK-CargoShip-SOBAN-Trigger-Attacked]
				[Triggers:GVK-CargoShip-SOBAN-Trigger-Defenses]
				[Triggers:GVK-CargoShip-SOBAN-Trigger-LongWait]
				[WeaponSystem:GVK-NPC-Weapons-SOBAN-Carrier]
			</Description>
		</EntityComponent>
		<!-- Cargo Ship Autopilot-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Autopilot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:true]
				[RotationMultiplier:0.1]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:true]
				[LevelWithGravityWhenIdle:true]
				[IdealPlanetAltitude:500]
				[MinimumPlanetAltitude:20]
				[AltitudeTolerance:15]
				[MinAngleForLeveledDescent:120]
				[MaxAngleForLeveledAscent:180]
				[MaxVerticalSpeed:20]
				[IdealMinSpeed:10]
				[IdealMaxSpeed:70]
				[MaxSpeedTolerance:15]
				[SlowDownOnWaypointApproach:true]
				[WaypointWaitTimeTrigger:120]
				[ExtraSlowDownDistance:500]
				[WaypointTolerance:30]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.5]
				[ReverseOffsetDistAltAboveHeight:false]
				[ReverseOffsetHeight:0]
				[AngleAllowedForForwardThrust:90]
				[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Cargo Ship Autopilot Secondary-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Autopilot-Secondary</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:true]
				[RotationMultiplier:0.1]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:true]
				[LevelWithGravityWhenIdle:true]
				[IdealPlanetAltitude:100]
				[MinimumPlanetAltitude:20]
				[AltitudeTolerance:5]
				[MinAngleForLeveledDescent:120]
				[MaxAngleForLeveledAscent:180]
				[MaxVerticalSpeed:10]
				[IdealMinSpeed:10]
				[IdealMaxSpeed:30]
				[MaxSpeedTolerance:5]
				[SlowDownOnWaypointApproach:true]
				[WaypointWaitTimeTrigger:30]
				[ExtraSlowDownDistance:500]
				[WaypointTolerance:25]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.5]
				[OffsetPlanetMinTargetAltitude:-50]
				[OffsetPlanetMaxTargetAltitude:50]
				[ReverseOffsetDistAltAboveHeight:false]
				[ReverseOffsetHeight:0]
				[AngleAllowedForForwardThrust:90]
				[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Trigger when Cargo Ship Spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-OnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:1000]
				[MaxCooldownMs:1000]
				[Actions:GVK-CargoShip-SOBAN-Action-OnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-OnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetWeaponsToMaxRange:true]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-SOBAN-Chat-OnSpawn]
				[UseJetpackInhibitorEffect:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Chat-OnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:Coalition]
				[Color:White]
				[ChatMessages:A Soban Cargo Ship has been spotted.]
				[ChatAudio:ArcHudGPSNotification2]
				[BroadcastChatType:Chat]
				[ChatMessages:A Soban Cargo Ship has been spotted.]
				[BroadcastChatType:Notify]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship Spawns to request near waypoint -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-RequestNearWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:5000]
				[MaxCooldownMs:5000]
				[Actions:GVK-CargoShip-SOBAN-Action-RequestNearWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-RequestNearWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[BroadcastCommandProfiles:true]
				[CommandProfileIds:GVK-CargoShip-SOBAN-Command-RequestNearWaypoint]
				[UseChatBroadcast:false]
				[ChatData:GVK-CargoShip-SOBAN-Chat-RequestNearWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Command-RequestNearWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Command]
				[CommandCode:CargoShip_RequestWaypoint]
				[SingleRecipient:false]
				[MatchSenderReceiverOwners:false]
				[IgnoreAntennaRequirement:true]
				[IgnoreReceiverAntennaRequirement:true]
				[Radius:30000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Chat-RequestNearWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:Soban Cargo Ship]
				[Color:Red]
				[ChatMessages:Requesting near waypoint]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship Spawns to request far waypoint -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-RequestFarWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:1]
				[MinCooldownMs:7000]
				[MaxCooldownMs:7000]
				[Actions:GVK-CargoShip-SOBAN-Action-RequestFarWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-RequestFarWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[BroadcastCommandProfiles:true]
				[CommandProfileIds:GVK-CargoShip-SOBAN-Command-RequestFarWaypoint]
				[UseChatBroadcast:false]
				[ChatData:GVK-CargoShip-SOBAN-Chat-RequestFarWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Command-RequestFarWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Command]
				[CommandCode:CargoShip_RequestWaypoint]
				[SingleRecipient:false]
				[MatchSenderReceiverOwners:false]
				[IgnoreAntennaRequirement:true]
				[IgnoreReceiverAntennaRequirement:true]
				[Radius:75000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Chat-RequestFarWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:Soban Cargo Ship]
				[Color:Red]
				[ChatMessages:Requesting far waypoint]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Cargo Ship to receive waypoints from GVK-TradeStation -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-ReceiveWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:CommandReceived]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:2]
				[CommandReceiveCode:CargoShip_ReceiveWaypoint]
				[Actions:GVK-CargoShip-SOBAN-Action-ReceiveWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-ReceiveWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[AddWaypointFromCommand:true]
				[UseChatBroadcast:false]
				[ChatData:GVK-CargoShip-SOBAN-Chat-ReceiveWaypoint]
				[ChangeAutopilotProfile:false]
				[AutopilotProfile:Secondary]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Chat-ReceiveWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:Soban Cargo Ship]
				[Color:Red]
				[ChatMessages:Waypoint Received.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Cargo Ship to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Compromised]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-CargoShip-SOBAN-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-Despawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Despawn]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-CargoShip-SOBAN-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-DespawnMES</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:DespawnMES]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GVK-CargoShip-SOBAN-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[ChangeInertiaDampeners:true]
				[InertiaDampenersEnable:false]
				[EnableBlocks:true]
				[EnableBlockNames:HoverEngine]
				[EnableBlockStates:Off]
				[EnableBlockNames:Thruster]
				[EnableBlockStates:Off]
				[EnableBlockNames:Magnetic Plate]
				[EnableBlockStates:On]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/ZoneBlock]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconSmall]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconLarge]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/SmallBlockBeacon]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/LargeBlockBeacon]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlLarge]
				[BlockTypeToggles:Off]
				[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlSmall]
				[BlockTypeToggles:Off]
				[GenerateExplosion:true]
				[ExplosionOffsetFromRemote:{X:0 Y:0 Z:0}]
				[ExplosionRange:25]
				[ExplosionDamage:1]
				[ExplosionIgnoresVoxels:true]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-SOBAN-Chat-Compromised]
				[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Chat-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:Coalition]
				[Color:White]
				[ChatMessages:A Soban Cargo Ship has been shot down!]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship arrives at a waypoint -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-ArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:BehaviorTriggerA]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:-1]
				[Actions:GVK-CargoShip-SOBAN-Action-ArriveAtWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-ArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-SOBAN-Chat-ArriveAtWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Chat-ArriveAtWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:Soban Cargo Ship]
				[Color:Red]
				[ChatMessages:Arrived at waypoint]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship leaves a waypoint -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-LeaveWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:BehaviorTriggerB]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:-1]
				[Actions:GVK-CargoShip-SOBAN-Action-LeaveWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-LeaveWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-SOBAN-Chat-LeaveWaypoint]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Chat-LeaveWaypoint</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:Soban Cargo Ship]
				[Color:Red]
				[ChatMessages:Heading to next destination]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cargo Ship departs to despawn waypoint -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-HeadToDespawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:BehaviorTriggerD]
				[MinCooldownMs:30000]
				[MaxCooldownMs:30000]
				[UseTrigger:true]
				[StartsReady:false]
				[MaxActions:-1]
				[Actions:GVK-CargoShip-SOBAN-Action-HeadToDespawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-HeadToDespawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[RecalculateDespawnCoords:true]
				[UseChatBroadcast:true]
				[ChatData:GVK-CargoShip-SOBAN-Chat-HeadToDespawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Chat-HeadToDespawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:Soban Cargo Ship]
				[Color:Red]
				[ChatMessages:Trade route complete.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence to change attacker reputation -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Trigger-Attacked</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Damage]
				[MinCooldownMs:120000]
				[MaxCooldownMs:240000]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:-1]
				[DamageTypes:Any]
				[Actions:GVK-CargoShip-SOBAN-Action-Attacked]
				[Actions:GVK-CargoShip-SOBAN-Action-Defenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CargoShip-SOBAN-Action-Attacked</SubtypeId>

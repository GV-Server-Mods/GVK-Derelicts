		<!-- Action group to set turrets to max range because of a bug in MES right now -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Trigger-WeaponsToMaxRange</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:false]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1000]
				
			[Actions:DefenseDrone-Action-WeaponsToMaxRange]
	
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Action-WeaponsToMaxRange</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Action]
				
			[SetWeaponsToMaxRange:true]
	
			</Description>
		</EntityComponent>
		<!-- Action group to fire Fixed Rocket Timer Blocks because of a bug in WC2 right now -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Trigger-FireRocketsTimers</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:TargetNear]
			
			[TargetDistance:1000]
			
			[Conditions:DefenseDrone-Condition-FireRocketsTimers]
			
			[Actions:DefenseDrone-Action-FireRocketsTimers]
	
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Condition-FireRocketsTimers</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]

			[UseConditions:true]
			[MatchAnyCondition:true]
			
			[CheckTargetAngleFromForward:true]
			[MinTargetAngle:0]
			[MaxTargetAngle:15]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Action-FireRocketsTimers</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Action]
				
			[TriggerTimerBlocks:True]
			[TimerBlockNames:Timer Block Rockets]
	
			</Description>
		</EntityComponent>
		<!-- Action group to fire Fixed Rockets because of a bug in WC2 right now -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Trigger-FireRockets</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:TargetNear]
			
			[TargetDistance:1000]
			
			[Conditions:DefenseDrone-Condition-FireRockets]
			
			[Actions:DefenseDrone-Action-FireRockets]
	
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Condition-FireRockets</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]

			[UseConditions:true]
			[MatchAnyCondition:true]
			
			[CheckTargetAngleFromForward:true]
			[MinTargetAngle:0]
			[MaxTargetAngle:15]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Action-FireRockets</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Action]
				
			[ToggleBlocksOfType:true]
			[BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncher/]
			[BlockTypeToggles:On]
			[BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncher/null]
			[BlockTypeToggles:On]
			[BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncher/LargeMissileLauncher]
			[BlockTypeToggles:On]
			
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:DefenseDrone-Trigger-StopRockets]
	
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Trigger-StopRockets</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1000]
				
			[Actions:DefenseDrone-Action-StopRockets]
	
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Action-StopRockets</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Action]
			
			[ToggleBlocksOfType:true]
			[BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncher/]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncher/null]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_SmallMissileLauncher/LargeMissileLauncher]
			[BlockTypeToggles:Off]
	
			</Description>
		</EntityComponent>
		<!-- Action group to fire Archer Pods via Timer because of a bug in WC2 right now -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Trigger-FireMissilesTimers</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:TargetNear]
			
			[MinCooldownMs:2000]
			[MaxCooldownMs:2000]
			[StartsReady:false]
			
			[TargetDistance:2500]
				
			[Actions:DefenseDrone-Action-FireMissilesTimers]
	
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Action-FireMissilesTimers</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Action]

			[TriggerTimerBlocks:True]
			[TimerBlockNames:Timer Block Missiles]
			[TimerBlockNames:Timer Block Torpedoes]
	
			</Description>
		</EntityComponent>
		<!-- Action group to fire Fixed Railguns because of a bug in WC2 right now -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Trigger-FireRailgunsTimers</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:TargetNear]
			
			[TargetDistance:2000]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[ConditionCheckResetsTimer:true]
			
			[Conditions:DefenseDrone-Condition-FireRailgunsTimers]
			
			[Actions:DefenseDrone-Action-FireRailgunsTimers]
	
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Condition-FireRailgunsTimers</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]

			[UseConditions:true]
			[MatchAnyCondition:true]
			
			[CheckTargetAngleFromForward:true]
			[MinTargetAngle:0]
			[MaxTargetAngle:5]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Action-FireRailgunsTimers</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Action]
				
			[TriggerTimerBlocks:True]
			[TimerBlockNames:Timer Block Railguns]
			[TimerBlockNames:Timer Block MAC]
	
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Drone crashes into the ground -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Trigger-Crashed</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[MaxActions:1]
			[ActionExecution:All]
			
			[Conditions:DefenseDrone-Condition-Crashed]
			
			[Actions:DefenseDrone-Action-Crashed]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Condition-Crashed</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]

			[UseConditions:true]
			[MatchAnyCondition:false]

			[CheckGridSpeed:true]
			[MinGridSpeed:0]
			[MaxGridSpeed:10]
			
			[AltitudeCheck:true]
			[MinAltitude:-999999]
			[MaxAltitude:5]
	
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Action-Crashed</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			
			[DisableTriggers:true]
			[DisableTriggerNames:DefenseDrone-Trigger-Compromised]
			
			[GenerateExplosion:true]
			[ExplosionRange:25]
			[ExplosionDamage:5000]
			[ExplosionIgnoresVoxels:true]

			[UseChatBroadcast:true]
			[ChatData:DefenseDrone-Chat-Crashed]
				
			[ForceDespawn:true]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:false]
			[TerminateBehavior:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Chat-Crashed</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]

			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]

			[Author:{GridName}]
			[Color:White]

			[ChatMessages:A defense drone has crashed.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:true]

			</Description>
		</EntityComponent>
		<!-- Trigger sequence when plane RAI Remote is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
	
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
				
			[Actions:DefenseDrone-Action-Compromised]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Action-Compromised</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			
			[DisableTriggers:true]
			[DisableTriggerNames:DefenseDrone-Trigger-Crashed]
			
			[GenerateExplosion:true]
			[ExplosionRange:25]
			[ExplosionDamage:5000]
			[ExplosionIgnoresVoxels:true]

			[UseChatBroadcast:true]
			[ChatData:DefenseDrone-Chat-Compromised]
			
			[ForceDespawn:true]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:false]
			[TerminateBehavior:true]
	
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Chat-Compromised</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]

			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]

			[Author:{GridName}]
			[Color:White]

			[ChatMessages:A defense drone has been shot down.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:true]

			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
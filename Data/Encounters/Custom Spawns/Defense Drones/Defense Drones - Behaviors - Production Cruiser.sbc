<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Production Cruiser Horsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-ProductionCruiser-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Horsefly]
			[UseStaticGuns:true]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:0]
			[PlayerDistanceTrigger:15000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:1800]
			[UseRetreatTimer:true]
			[RetreatTimerTrigger:3600]
			[RetreatDespawnDistance:1500]
			[AutopilotData:DefenseDrone-HoverCruiserHorsefly-Autopilot]
			[TargetData:GVK-Generic-TargetProfile-EnemyPlayers]
			[Triggers:DefenseDrone-Trigger-WeaponsToMaxRange]
			[Triggers:ProductionCruiser-Trigger-SpawnFighters]
			[Triggers:GVK-Generic-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:DefenseDrone-Trigger-Compromised]
			[Triggers:GVK-Generic-Trigger-SPRTNoWeapon]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for ProductionCruiser to spawn fighters -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>ProductionCruiser-Trigger-SpawnFighters</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:PlayerNear]
			[UseTrigger:true]
			[TargetDistance:2000]
			[StartsReady:true]
			[MaxActions:3]
			[MinCooldownMs:120000]
			[MaxCooldownMs:180000]
			[Actions:ProductionCruiser-Action-SpawnFighters]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>ProductionCruiser-Action-SpawnFighters</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SpawnEncounter:true]
			[Spawner:ProductionCruiser-Spawner-SpawnFighters]
			[UseChatBroadcast:true]
			[ChatData:ProductionCruiser-Chat-SpawnFighters]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>ProductionCruiser-Spawner-SpawnFighters</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[MinDistance:500]
			[MaxDistance:1000]
			[MinAltitude:100]
			[MaxAltitude:400]
			[InheritNpcAltitude:true]
			[SpawnGroups:GVK-CustomSpawn-DefenseDrone-SpawnGroup-GAALSIEN-ReaperSquad]
			[SpawnGroups:GVK-CustomSpawn-DefenseDrone-SpawnGroup-GAALSIEN-HornetSquad]
			[SpawnGroups:GVK-CustomSpawn-DefenseDrone-SpawnGroup-GAALSIEN-SlicerSquad]
			[ProcessAsAdminSpawn:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>ProductionCruiser-Chat-SpawnFighters</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:false]
			[Author:Production Cruiser]
			[Color:Red]
			[ChatMessages:Fighters Inbound.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
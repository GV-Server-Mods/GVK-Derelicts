			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<!--Do Not Edit-->
				<SubtypeId>GVK-CustomSpawn-DefenseDrone-SpawnGroup-SOBAN-Reaper</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:MES-Manipulation-RivalAi] 
				[ManipulationProfiles:GVK-CustomSpawns-DefenseDrones-Manipulation-H2Flyer]
				[SpawnConditionsProfiles:GVK-CustomSpawns-DefenseDrones-SpawnConditions-SOBAN-H2Flyer]
			</Description>
			<IsPirate>true</IsPirate>
			<!--Do not edit-->
			<Frequency>0.1</Frequency>
			<Prefabs>
				<Prefab SubtypeId="[NPC Drone] Reaper V2">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Reaper</BeaconText>
					<Behaviour>DefenseDrone-HorseFighter-Behavior-Start</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

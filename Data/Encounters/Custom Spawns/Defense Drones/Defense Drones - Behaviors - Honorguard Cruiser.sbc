<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Honorguard Cruiser Fighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-HonorguardCruiser-Behavior</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Behavior]
			
			[BehaviorName:Fighter]

			[UseStaticGuns:true]
			[UseTurrets:true]
			[UseVelocityCollisionEvasion:true]
			[MaxStaticWeaponRange:1000]
			[WeaponMaxAngleFromTarget:10]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:0]
			[PlayerDistanceTrigger:15000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:1800]
			[UseRetreatTimer:true]
			[RetreatTimerTrigger:3600]
			[RetreatDespawnDistance:1500]
			
			[HorseFighterTimeApproaching:30]
			[HorseFighterTimeEngaging:30]

			[TargetData:GVK-Generic-TargetProfile-EnemyPlayers]

			[AutopilotData:DefenseDrone-HonorguardCruiser-Autopilot-Primary]
			[SecondaryAutopilotData:DefenseDrone-HonorguardCruiser-Autopilot-Secondary]

			[Triggers:DefenseDrone-Trigger-WeaponsToMaxRange]
			[Triggers:DefenseDrone-Trigger-FireRailgunsTimers]
			[Triggers:DefenseDrone-Trigger-FireMissilesTimers]
			[Triggers:DefenseDrone-Trigger-FireRailgunsTimers]
			[Triggers:GVK-Generic-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:DefenseDrone-Trigger-Compromised]
			[Triggers:GVK-Generic-Trigger-SPRTNoWeapon]
			[Triggers:DefenseDrone-Trigger-StrafeingAutopilot]
			[Triggers:DefenseDrone-Trigger-ApproachingAutopilot]
			[Triggers:DefenseDrone-Trigger-JetpackInhibitorOnSpawn]
			[Triggers:DefenseDrone-Trigger-JetpackInhibitorOnRestart]
			[Triggers:DefenseDrone-Trigger-Crashed]

			</Description>
		</EntityComponent>
		<!-- Honorguard Cruiser Fighter Autopilot Primary -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-HonorguardCruiser-Autopilot-Primary</SubtypeId>
			</Id>
			<Description>

			[RivalAI Autopilot]
			
			[UseVelocityCollisionEvasion:false]
			[CollisionEvasionWaypointDistance:50]
			[CollisionFallEvasionWaypointDistance:35]

			[UseProjectileLeadPrediction:false]

			[RotationMultiplier:0.75]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:1]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[MaxVerticalSpeed:20]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:15]
			[AltitudeTolerance:500]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:false]
			[WaypointTolerance:100]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:30]
			[IdealMaxSpeed:70]
			[PadDistanceFromTarget:400]

			[OffsetSpaceMinDistFromTarget:700]
			[OffsetSpaceMaxDistFromTarget:1500]
			[OffsetPlanetMinDistFromTarget:700]
			[OffsetPlanetMaxDistFromTarget:1500]
			[OffsetPlanetMinTargetAltitude:10]
			[OffsetPlanetMaxTargetAltitude:10]
			[EngageDistancePlanet:1200]
			[DisengageDistancePlanet:1500]
			[AllowStrafing:true]
			[StrafeMinDurationMs:10000]
			[StrafeMaxDurationMs:30000]
			[StrafeMinCooldownMs:60]
			[StrafeMaxCooldownMs:60]
			[StrafeSpeedCutOff:150]
			[StrafeDistanceCutOff:500]	
			[StrafeMinimumTargetDistance:500]
			[StrafeMinimumSafeAngleFromTarget:35]

			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]

			</Description>
		</EntityComponent>
		<!-- Honorguard Cruiser Fighter Autopilot Secondary -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-HonorguardCruiser-Autopilot-Secondary</SubtypeId>
			</Id>
			<Description>

			[RivalAI Autopilot]
			
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:50]
			[CollisionFallEvasionWaypointDistance:35]

			[UseProjectileLeadPrediction:true]

			[RotationMultiplier:0.75]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:1]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[MaxVerticalSpeed:10]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:15]
			[AltitudeTolerance:5000]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointTolerance:100]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:30]
			[IdealMinSpeed:40]
			[IdealMaxSpeed:70]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:25]

			[OffsetSpaceMinDistFromTarget:600]
			[OffsetSpaceMaxDistFromTarget:1500]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:1500]
			[OffsetPlanetMinTargetAltitude:10]
			[OffsetPlanetMaxTargetAltitude:10]
			[EngageDistancePlanet:1200]
			[DisengageDistancePlanet:1500]
			[AllowStrafing:true]
			[StrafeMinDurationMs:20000]
			[StrafeMaxDurationMs:30000]
			[StrafeMinCooldownMs:60]
			[StrafeMaxCooldownMs:60]
			[StrafeSpeedCutOff:150]	
			[StrafeMinimumTargetDistance:500]
			[StrafeMinimumSafeAngleFromTarget:35]

			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]

			</Description>
		</EntityComponent>
		<!-- Action group switch to secondary autopilot when strafing -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Trigger-StrafeingAutopilot</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:BehaviorTriggerA]
			[StartsReady:true]
			[MinCooldownMs:3000]
			[MaxCooldownMs:3000]
				
			[Actions:DefenseDrone-Action-StrafeingAutopilot]
	
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Action-StrafeingAutopilot</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Action]
				
			[AutopilotProfile:Secondary]
		 
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Trigger-ApproachingAutopilot</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:BehaviorTriggerB]
			[StartsReady:true]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1000]
				
			[Actions:DefenseDrone-Action-ApproachingAutopilot]
	
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>DefenseDrone-Action-ApproachingAutopilot</SubtypeId>
			</Id>
			<Description>
	
			[RivalAI Action]
				
			[AutopilotProfile:Primary]
		 
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
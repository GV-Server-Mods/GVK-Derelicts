	<SpawnGroups>
		<!-- [NPC Drone] Reaper -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<!--Do Not Edit-->
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-SpawnGroup-KHAANEPH-Reaper</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:MES-Manipulation-RivalAi] 
				[ManipulationProfiles:GVK-CustomSpawns-DefenseDrones-Manipulation-H2Flyer]
				[SpawnConditionsProfiles:GVK-SpawnConditions-CustomSpawns-DefenseDrones-H2Flyer]
				[FactionOverride:KHAANEPH]
			</Description>
			<IsPirate>true</IsPirate>
			<!--Do not edit-->
			<Frequency>0.1</Frequency>
			<Prefabs>
				<Prefab SubtypeId="[NPC Drone] Reaper V2">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Reaper</BeaconText>
					<Behaviour>GVK-CustomSpawns-DefenseDrone-HorseFighter-Behavior</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

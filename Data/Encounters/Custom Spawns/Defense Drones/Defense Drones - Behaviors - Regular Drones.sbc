		<!-- LargeFlyerHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-Autopilot-LargeFlyerHorsefly</SubtypeId>
			</Id>
			<Description>

			[RivalAI Autopilot]

			[UseVelocityCollisionEvasion:true]

			[RotationMultiplier:0.5]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:300]
			[MinimumPlanetAltitude:250]
			[AltitudeTolerance:50]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointTolerance:250]
			[IdealMinSpeed:50]
			[IdealMaxSpeed:100]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:60]

			[OffsetSpaceMinDistFromTarget:900]
			[OffsetSpaceMaxDistFromTarget:1200]
			[OffsetPlanetMinDistFromTarget:1200]
			[OffsetPlanetMaxDistFromTarget:1700]
			[OffsetPlanetMinTargetAltitude:250]
			[OffsetPlanetMaxTargetAltitude:500]
			
			[MaxVerticalSpeed:20]

			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:300]
			[AngleAllowedForForwardThrust:180]

			</Description>
		</EntityComponent>

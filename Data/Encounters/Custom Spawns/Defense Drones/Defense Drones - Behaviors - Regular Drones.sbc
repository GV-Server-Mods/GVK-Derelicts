<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallFlyerHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-Behavior-SmallFlyerHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
				
			[BehaviorName:Horsefly]

			[UseStaticGuns:true]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]

			[TargetData:GVK-Generic-Target-EnemiesInKPL]
			
			[AutopilotData:GVK-CustomSpawns-DefenseDrone-Autopilot-SmallFlyerHorsefly]

			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-TargetAttacker]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-FireMissilesTimers]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-FireRocketsTimers]
			[Triggers:GVK-Generic-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-Crashed]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-Compromised]
			[Triggers:GVK-Generic-Trigger-SPRTNoWeapon]
			[Triggers:GVK-Generic-Trigger-CreateKPL]
			[Triggers:GVK-DroneEnconuter-Trigger-Retreat-NoTarget]
			[Triggers:GVK-DroneEnconuter-Trigger-Retreat-Timer]
			</Description>
		</EntityComponent>
		<!-- SmallFlyerHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-Autopilot-SmallFlyerHorsefly</SubtypeId>
			</Id>
			<Description>

			[RivalAI Autopilot]

			[UseVelocityCollisionEvasion:true]

			[RotationMultiplier:1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.5]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:250]
			[MinimumPlanetAltitude:150]
			[AltitudeTolerance:50]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointTolerance:150]
			[IdealMinSpeed:50]
			[IdealMaxSpeed:75]

			[OffsetPlanetMinDistFromTarget:500]
			[OffsetPlanetMaxDistFromTarget:1200]
			[OffsetPlanetMinTargetAltitude:150]
			[OffsetPlanetMaxTargetAltitude:400]
			[WaypointWaitTimeTrigger:0]
			
			[MaxVerticalSpeed:20]

			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:120]

			</Description>
		</EntityComponent>
		<!-- LargeFlyerHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>

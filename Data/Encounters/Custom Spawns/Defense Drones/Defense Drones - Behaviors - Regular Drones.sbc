				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-Action-Cruiser-Crashed</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-CustomSpawns-DefenseDrone-Trigger-Cruiser-Compromised]

			[UseChatBroadcast:true]
			[ChatData:GVK-CustomSpawns-DefenseDrone-Chat-Cruiser-Crashed]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-Chat-Cruiser-Crashed</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]

			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]

			[Author:COALITION]
			[Color:White]

			[ChatMessages:A Cruiser has crashed.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:true]

			</Description>
		</EntityComponent>
		<!-- Trigger sequence when a Cruiser RAI Remote is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-Trigger-Cruiser-Compromised</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
	
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
				
			[Actions:GVK-CustomSpawns-DefenseDrone-Action-Cruiser-Compromised]
			[Actions:GVK-CustomSpawns-DefenseDrone-Action-Disabled]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-Action-Cruiser-Compromised</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-CustomSpawns-DefenseDrone-Trigger-Cruiser-Crashed]

			[UseChatBroadcast:true]
			[ChatData:GVK-CustomSpawns-DefenseDrone-Chat-Cruiser-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-Chat-Cruiser-Compromised</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]

			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]

			[Author:COALITION]
			[Color:White]

			[ChatMessages:A Cruiser has been shot down.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:true]

			</Description>
		</EntityComponent>
		<!-- Trigger Sequence for Random Drone Encounter to retreat after a while-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-DroneEnconuter-Trigger-Retreat-NoTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:NoTarget]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[ActionExecution:All]
			[MinCooldownMs:1800000]
			[MaxCooldownMs:1800001]
			[Conditions:GVK-DroneEnconuter-Condition-IsDroneEncounter]
			[Actions:GVK-DroneEnconuter-Action-Retreat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-DroneEnconuter-Trigger-Retreat-Timer</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[ActionExecution:All]
			[MinCooldownMs:21600000]
			[MaxCooldownMs:21600001]
			[Conditions:GVK-DroneEnconuter-Condition-IsDroneEncounter]
			[Actions:GVK-DroneEnconuter-Action-Retreat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-DroneEnconuter-Condition-IsDroneEncounter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckForSpawnConditions:true]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-Salvager]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-SmallFlyerSingle]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-SmallHoverSingle]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-MediumHoverSingle]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-SmallFlyerSquad]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-MediumFlyerSingle]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-LargeHoverSingle]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-SmallHoverSquad]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-DroneEnconuter-Action-Retreat</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Retreat:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
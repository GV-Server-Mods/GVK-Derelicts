<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>GVK-NPC-ConvoySpawner-Behavior</SubtypeId>
      </Id>
      <Description>

      [RivalAI Behavior]
	  
      [BehaviorName:Passive]

	  [UseRetreatTimer:false]
	  [UseNoTargetTimer:false]
	  [UsePlayerDistanceTimer:false]
	  [PlayerDistanceTimerTrigger:1800]
	  [PlayerDistanceTrigger:15000]
	  	  
	  [Triggers:GVK-NPC-ConvoySpawner-Trigger-Start]
	  [Triggers:GVK-NPC-ConvoySpawner-Trigger-ConvoySpawner]

	  [TargetData:GVK-Generic-TargetProfile-EnemyPlayers]
	  	  
      </Description>
    </EntityComponent>

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>GVK-NPC-ConvoySpawner-Trigger-Start</SubtypeId>
      </Id>
      <Description>

      [RivalAI Trigger]
	  
      [Type:Timer]
	  [MinCooldownMs:1000]
	  [MaxCooldownMs:1000]
	  [UseTrigger:true]
	  [StartsReady:true]
	  [MaxActions:1]
	  	  	  
	  [Actions:GVK-NPC-ConvoySpawner-Action-Start]
	  
      </Description>      
    </EntityComponent>
	
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>GVK-NPC-ConvoySpawner-Action-Start</SubtypeId>
      </Id>
      <Description>

      [RivalAI Action]
	  	  
	  [SetSandboxBooleansTrue:ConvoyInactive]
	  
      </Description>
    </EntityComponent>
			
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>GVK-NPC-ConvoySpawner-Trigger-ConvoySpawner</SubtypeId>
      </Id>
      <Description>

      [RivalAI Trigger]
	  
      [Type:Timer]
	  [MinCooldownMs:30000000]
	  [MaxCooldownMs:60000000]
	  [UseTrigger:true]
	  [StartsReady:true]
	  
	  [Conditions:GVK-NPC-ConvoySpawner-Condition-ConvoySpawner]
	  [ConditionCheckResetsTimer:true]
	  	  
	  [Actions:GVK-NPC-ConvoySpawner-Action-ConvoySpawner]
	  
      </Description>      
    </EntityComponent>
	
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>GVK-NPC-ConvoySpawner-Condition-ConvoySpawner</SubtypeId>
      </Id>
      <Description>

      [RivalAI Condition]
      
      [UseConditions:true]
      [MatchAnyCondition:true]
	  [CheckTrueSandboxBooleans:true]
	  [TrueSandboxBooleans:ConvoyInactive]
      
      </Description>
    </EntityComponent>

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>GVK-NPC-ConvoySpawner-Action-ConvoySpawner</SubtypeId>
      </Id>
      <Description>

      [RivalAI Action]
	  	  
	  [SpawnEncounter:true]
      [Spawner:GVK-NPC-ConvoySpawner-Spawner-Convoy]
	  [SetSandboxBooleansFalse:ConvoyInactive]
	  
      </Description>
    </EntityComponent>

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>GVK-NPC-ConvoySpawner-Spawner-Convoy</SubtypeId>
      </Id>
      <Description>
	  
      [RivalAI Spawn]
	  
      [UseSpawn:true]
	  [SpawningType:CustomSpawn]
      [StartsReady:true]
	  
	  [SpawnGroups:GVK-Mothership-GAALSIEN-Convoy1]

      [MinDistance:2000]
      [MaxDistance:5000]
	  [MinAltitude:30]
	  [MaxAltitude:60]
	  [InheritNpcAltitude:false]
      [IgnoreSafetyChecks:true]
	  
      </Description>
    </EntityComponent>
			
  </EntityComponents>
</Definitions>
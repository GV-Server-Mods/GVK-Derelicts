		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Loot-LivingArea</SubtypeId>
			</Id>
			<Description>
			[MES Loot]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLockers]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockInsetBookshelf]
			[ContainerBlockTypes:MyObjectBuilder_InteriorLight/LargeBlockInsetKitchen]
			[ContainerBlockTypes:MyObjectBuilder_InteriorLight/LargeBlockInsetKitchen]
			[ContainerTypes:GVK-ContainerTypes-RifleWeapons-1]

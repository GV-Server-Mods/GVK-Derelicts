			[ContainerBlockTypes:MyObjectBuilder_OxygenGenerator/OxygenGeneratorSmall]
			[ContainerBlockTypes:MyObjectBuilder_OxygenGenerator/OxygenGenerator]
			[ContainerTypes:GVK-ContainerTypes-H2Generator]

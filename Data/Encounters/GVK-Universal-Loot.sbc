			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Loot-Refinery</SubtypeId>
			</Id>
			<Description>
			[MES Loot]
			[ContainerBlockTypes:MyObjectBuilder_Refinery/Blast Furnace]
			[ContainerBlockTypes:MyObjectBuilder_Refinery/LargeRefinery]
			[ContainerBlockTypes:MyObjectBuilder_Refinery/LargeRefineryIndustrial]
			[ContainerTypes:GVK-ContainerTypes-OreBasic]
			[ContainerTypes:GVK-ContainerTypes-OreExotic]
			[ContainerTypes:GVK-ContainerTypes-IngotBasic]
			[ContainerTypes:GVK-ContainerTypes-IngotExotic]

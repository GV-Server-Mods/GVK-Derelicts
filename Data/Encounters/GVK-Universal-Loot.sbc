			[ContainerBlockTypes:MyObjectBuilder_Assembler/BasicAssembler]
			[ContainerBlockTypes:MyObjectBuilder_Assembler/LargeAssembler]
			[ContainerBlockTypes:MyObjectBuilder_Assembler/LargeAssemblerIndustrial]
			[ContainerTypes:GVK-ContainerTypes-IngotBasic]
			[ContainerTypes:GVK-ContainerTypes-IngotExotic]
			[ContainerTypes:GVK-ContainerTypes-ComponentBasic]
			[ContainerTypes:GVK-ContainerTypes-ComponentAdvanced]

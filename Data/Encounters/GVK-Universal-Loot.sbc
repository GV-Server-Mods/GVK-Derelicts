<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Main Tech Loot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Loot-Small</SubtypeId>
			</Id>
			<Description>
			[MES Loot]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockSmallContainer]
            [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeIndustrialContainer]
			[ContainerTypes:Kharak_Loot_Small]
			[MinBlocks:4]
			[MaxBlocks:6]
			[AppendNameToBlock:true]
			[AppendedName: (Loot)]
			[Chance:100]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Loot-Medium</SubtypeId>
			</Id>
			<Description>
			[MES Loot]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockSmallContainer]
            [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeIndustrialContainer]
			[ContainerTypes:Kharak_Loot_Medium]
			[MinBlocks:8]
			[MaxBlocks:12]
			[AppendNameToBlock:true]
			[AppendedName: (Loot)]
			[Chance:100]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Loot-Large</SubtypeId>
			</Id>
			<Description>
			[MES Loot]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockSmallContainer]
            [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeIndustrialContainer]
			[ContainerTypes:Kharak_Loot_Large]
			[MinBlocks:16]
			[MaxBlocks:20]
			[AppendNameToBlock:true]
			[AppendedName: (Loot)]
			[Chance:100]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Loot-Huge</SubtypeId>
			</Id>
			<Description>
			[MES Loot]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockSmallContainer]
            [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeIndustrialContainer]
			[ContainerTypes:Kharak_Loot_Large]
			[MinBlocks:20]
			[MaxBlocks:24]
			[AppendNameToBlock:true]
			[AppendedName: (Loot)]
			[Chance:100]
			</Description>
		</EntityComponent>
		<!-- Regular loot for immersion -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Loot-Freight</SubtypeId>
			</Id>
			<Description>
			[MES Loot]
			[ContainerBlockTypes:MyObjectBuilder_CubeBlock/Freight1]
			[ContainerBlockTypes:MyObjectBuilder_CubeBlock/Freight2]
			[ContainerBlockTypes:MyObjectBuilder_CubeBlock/Freight3]
			[ContainerBlockTypes:MyObjectBuilder_CubeBlock/LargeBarrel]
			[ContainerBlockTypes:MyObjectBuilder_CubeBlock/SmallBarrel]
			[ContainerBlockTypes:MyObjectBuilder_CubeBlock/LargeBarrelThree]
			[ContainerBlockTypes:MyObjectBuilder_CubeBlock/LargeBarrelStack]
			[ContainerBlockTypes:MyObjectBuilder_TerminalBlock/LargeCrate]
			[ContainerTypes:GVK-ContainerTypes-Consumable]
			[ContainerTypes:GVK-ContainerTypes-Mixed1]
			[ContainerTypes:GVK-ContainerTypes-Mixed2]
			[ContainerTypes:GVK-ContainerTypes-Mixed3]
			[ContainerTypes:GVK-ContainerTypes-Mixed4]
			[ContainerTypes:GVK-ContainerTypes-ComponentBasic]
			[ContainerTypes:GVK-ContainerTypes-IngotBasic]
			[MinBlocks:3]
			[MaxBlocks:6]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Loot-H2Generator</SubtypeId>
			</Id>
			<Description>

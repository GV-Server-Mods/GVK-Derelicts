			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeIndustrialContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockModularContainer]
			[ContainerTypes:Kharak_Loot_Large]

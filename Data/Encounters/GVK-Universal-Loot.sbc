			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Loot-Armory</SubtypeId>
			</Id>
			<Description>
			[MES Loot]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLockerRoom]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLockerRoomCorner]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockWeaponRack]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockWeaponRack]
			[ContainerTypes:GVK-ContainerTypes-Tool]
			[ContainerTypes:GVK-ContainerTypes-PistolWeapon]
			[ContainerTypes:GVK-ContainerTypes-RifleWeapon1]
			[ContainerTypes:GVK-ContainerTypes-RifleWeapon2]
			[ContainerTypes:GVK-ContainerTypes-LauncherWeapon1]
			[ContainerTypes:GVK-ContainerTypes-LauncherWeapon2]

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:2400]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-Init]
			[Triggers:GVK-Universal-Trigger-DespawnInZ0]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-SpawnDefenses]
			[RemoteControlCode:GVK-LargeDerelict]
			BountyOnKill=20000000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-Init</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Large-Action-Init]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Action-Init</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,WreckLarge]
			[CustomStrings:EncounterDisplayName,Large signal]
			[SetCustomCountersVariables:true]
			[CustomCountersVariables:DefenseSpawn_Limit,8]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Large-Chat-Init]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Chat-Init</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:{EncounterDisplayName} detected.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
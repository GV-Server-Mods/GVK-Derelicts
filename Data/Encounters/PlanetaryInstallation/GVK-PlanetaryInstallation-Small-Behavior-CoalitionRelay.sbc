<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Behavior-COALITIONRelay</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:false]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-Despawn]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-DespawnMES]
			[Triggers:GVK-PlanetaryInstallation-Small-Trigger-COALITIONRelayOnSpawn]
			[Triggers:GVK-PlanetaryInstallation-Small-Trigger-COALITIONRelayButtonPress]
			[Triggers:GVK-PlanetaryInstallation-Small-Trigger-COALITIONRelaySpawnsManual]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Wreck Spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Trigger-COALITIONRelayOnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Session]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-PlanetaryInstallation-Small-Action-COALITIONRelayOnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Action-COALITIONRelayOnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Small-Chat-COALITIONRelayOnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Chat-COALITIONRelayOnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:COALITION]
			[Color:White]
			[ChatMessages:GAALSIEN units have disabled a comms relay, please assist!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:5000]
		  </Description>
		</EntityComponent>
		<!-- Trigger when activation button is pressed -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Trigger-COALITIONRelayButtonPress</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:ButtonPress]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ButtonPanelName:NPC Button]
			[ButtonPanelIndex:0]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Small-Action-COALITIONRelayButtonPress]
			[Actions:GVK-PlanetaryInstallation-Small-Action-COALITIONRelayEnemiesManual]
			[Actions:GVK-PlanetaryInstallation-All-Action-CompromisedGeneric]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Action-COALITIONRelayButtonPress</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[ApplyContainerTypeToInventoryBlock:true]
			[ContainerTypeBlockNames:Shared Cargo Container]
			[ContainerTypeSubtypeIds:Kharak_Loot_Large]
			[ContainerTypeSubtypeIds:Kharak_Loot_Large]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Small-Chat-COALITIONRelayButtonPress]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Chat-COALITIONRelayButtonPress</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Comms Relay re-activated.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
		  </Description>
		</EntityComponent>
		<!-- Trigger Sequence for Small Defenses -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Action-COALITIONRelayEnemiesManual</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-PlanetaryInstallation-All-Trigger-Despawn]
			[DisableTriggerNames:GVK-PlanetaryInstallation-All-Trigger-DespawnMES]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Small-Trigger-COALITIONRelayOnSpawn]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Small-Trigger-COALITIONRelaySpawnsManual]
			[SpawnEncounter:true]
			[Spawner:GVK-PlanetaryInstallation-Small-Spawner-COALITIONRelayDefenseDroneSmall]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-All-Chat-Defenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Spawner-COALITIONRelayDefenseDroneSmall</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:1]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-LightSandskimmerSquad]
			[MinDistance:1500]
			[MaxDistance:1750]
			[MinAltitude:20]
			[MaxAltitude:21]
			[InheritNpcAltitude:true]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
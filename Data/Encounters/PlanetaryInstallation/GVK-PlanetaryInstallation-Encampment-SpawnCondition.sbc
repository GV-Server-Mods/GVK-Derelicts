				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-SpawnCondition-Khar Toba</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[PlanetaryInstallation:true]
			[PlanetaryInstallationType:Large]
			[ForceStaticGrid:true]
			[ZoneConditions:GVK-Universal-ZoneConditions-WreckZone23]
			[ZoneConditions:GVK-Universal-ZoneConditions-WreckZone3Only]
			[FactionOwner:COALITION]
			[ReactorsOn:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:true]
			[SkipAirDensityCheck:true]
			[UseRemoteControlCodeRestrictions:true]
			[RemoteControlCode:Encampment]
			[RemoteControlCodeMinDistance:999999]
			[RemoteControlCodeMaxDistance:-1]
			[RotateInstallations:{X:10 Y:0 Z:0}]
			[SandboxVariables:LargeWrecksEnabled]
			</Description>
		</EntityComponent>

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Horsefly Rover Carrier Behavior for Season 2 Event-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Behavior-GAALSIENFortress</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:false]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGridsLongRange]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-Universal-Trigger-TargetAcquiredChatter-GAALSIEN]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENFortressOnSpawn]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENFortressBeaconDisabled]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENFortressDespawn]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENFortressDespawnMES]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENFortressCompromised]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarSpawnCruisers]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-DefensesPlayerNear]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-DefensesDamage]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-DefensesManual]
			[Triggers:GVK-Drone-All-Trigger-FireMissilesTimers]
			[Triggers:GVK-Universal-Trigger-DespawnInZ0]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendDefenseHeartbeat]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
			[RemoteControlCode:GVK-LargeDerelict]
			BountyOnKill=20000000;
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Carrier Spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-GAALSIENFortressOnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[MinCooldownMs:900000]
			[MaxCooldownMs:900000]
			[Actions:GVK-PlanetaryInstallation-GAALSIENFortress-Action-OnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-GAALSIENFortress-Action-OnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SetSandboxBooleansTrue:LargeWreckActive]
			[SetWeaponsToMaxRange:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-GAALSIENFortress-Chat-Announce]
			</Description>
		</EntityComponent>
		<!-- need to run jetpack inhibitor on restart as well -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-GAALSIENFortress-Chat-Announce</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:2]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:GAALSIEN base detected.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
		  </Description>
		</EntityComponent>
		<!-- Trigger sequences for Fortress to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-GAALSIENFortressBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10000]
			[StartsReady:false]
			[Conditions:GVK-PlanetaryInstallation-All-Condition-BeaconDisabled]				  
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-GAALSIENFortress-Action-Compromised]
			[Actions:GVK-PlanetaryInstallation-Large-Action-DefensesTrigger]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-LargeExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-GAALSIENFortressCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-GAALSIENFortress-Action-Compromised]
			[Actions:GVK-PlanetaryInstallation-Large-Action-DefensesTrigger]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-LargeExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-GAALSIENFortressDespawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Despawn]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-PlanetaryInstallation-GAALSIENFortress-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-GAALSIENFortressDespawnMES</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:DespawnMES]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-PlanetaryInstallation-GAALSIENFortress-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-GAALSIENFortress-Action-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[RemoveKnownPlayerArea:false]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-GAALSIENFortress-Chat-Compromised]
			[SetSandboxBooleansFalse:LargeWreckActive]	
			[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-GAALSIENFortress-Chat-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:COALITION]
			[Color:White]
			[ChatMessages:GAALSIEN base destroyed]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
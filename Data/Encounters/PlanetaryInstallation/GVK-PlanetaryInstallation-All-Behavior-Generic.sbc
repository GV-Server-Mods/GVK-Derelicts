<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:2000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-PlanetaryInstallation-Small-Trigger-Spawned]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-Despawn]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-DespawnMES]
			[Triggers:GVK-PlanetaryInstallation-Small-Trigger-Compromised]
			[Triggers:GVK-PlanetaryInstallation-Small-Trigger-BeaconDisabled]
			[RemoteControlCode:GVK-Derelict]
			BountyOnKill=200000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:2400]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-Spawned]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-Despawn]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-DespawnMES]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-Compromised]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-BeaconDisabled]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-DefensesPlayerNear]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-DefensesDamage]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-DefensesManual]
			[RemoteControlCode:GVK-Derelict]
			BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:2400]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-Spawned]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-Despawn]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-DespawnMES]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-Compromised]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-BeaconDisabled]

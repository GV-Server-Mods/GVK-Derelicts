			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Trigger-BeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10000]
			[StartsReady:false]
			[Conditions:GVK-PlanetaryInstallation-All-Condition-BeaconDisabled]

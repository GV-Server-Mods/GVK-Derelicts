			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-DefensesDamage]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-DefensesManual]
			[RemoteControlCode:GVK-LargeDerelict]
			BountyOnKill=5000000;
			</Description>
		</EntityComponent>
		<!-- Chat for small spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Trigger-Spawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Small-Action-Spawned]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Action-Spawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Small-Chat-Spawned]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Chat-Spawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:6000]
			[Author:COALITION]
			[Color:White]
			[ChatMessages:A Small Derelict has been detected.]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			</Description>
		</EntityComponent>
		<!-- Chat for medium spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>

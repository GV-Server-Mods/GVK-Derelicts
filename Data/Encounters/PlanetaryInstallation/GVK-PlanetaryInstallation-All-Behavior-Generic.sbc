				<SubtypeId>GVK-PlanetaryInstallation-Large-Action-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SetSandboxBooleansFalse:LargeWreckActive]	  	  
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Large-Chat-Compromised]
			[SpawnEncounter:true]
			[Spawner:GVK-PlanetaryInstallation-Large-Spawner-DefenseDrone]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>

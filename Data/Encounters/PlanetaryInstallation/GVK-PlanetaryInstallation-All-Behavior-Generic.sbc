<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[Triggers:GVK-PlanetaryInstallation-Small-Trigger-Spawned]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-Despawn]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-DespawnMES]
			[Triggers:GVK-PlanetaryInstallation-Small-Trigger-Compromised]
			[Triggers:GVK-PlanetaryInstallation-Small-Trigger-BeaconDisabled]
			[RemoteControlCode:GVK-Derelict]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-Spawned]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-Despawn]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-DespawnMES]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-Compromised]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-BeaconDisabled]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-DefensesPlayerNear]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-DefensesDamage]
			[RemoteControlCode:GVK-Derelict]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-Spawned]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-Despawn]
			[Triggers:GVK-PlanetaryInstallation-All-Trigger-DespawnMES]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-Compromised]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-BeaconDisabled]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-DefensesPlayerNear]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-DefensesDamage]
			[RemoteControlCode:GVK-LargeDerelict]
			</Description>
		</EntityComponent>
		<!-- Chat for small spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Trigger-Spawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Small-Action-Spawned]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Action-Spawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Small-Chat-Spawned]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Chat-Spawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:6000]
			[Author:COALITION]
			[Color:White]
			[ChatMessages:A Small Derelict has been detected.]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			</Description>
		</EntityComponent>
		<!-- Chat for medium spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Trigger-Spawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Medium-Action-Spawned]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>

			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckForBlocksOfType:true]
			[BlocksOfType:MyObjectBuilder_Beacon]
			[UseFailCondition:true]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence for Small Defenses currently unused -->
		<!-- Trigger Sequence for Medium Defenses -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Trigger-DefensesPlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:750]
			[StartsReady:true]
			[MinCooldownMs:15000]
			[MaxCooldownMs:15001]
			[Conditions:GVK-PlanetaryInstallation-Medium-Condition-Defenses]
			[MaxActions:4]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Medium-Action-Defenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Trigger-DefensesDamage</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[DamageTypes:Any]
			[StartsReady:true]
			[MinCooldownMs:15000]
			[MaxCooldownMs:15001]
			[Conditions:GVK-PlanetaryInstallation-Medium-Condition-Defenses]
			[MaxActions:4]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Medium-Action-Defenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Condition-Defenses</SubtypeId>

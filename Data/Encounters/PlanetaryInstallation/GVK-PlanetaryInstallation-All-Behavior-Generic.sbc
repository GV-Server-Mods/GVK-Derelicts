			[Type:DespawnMES]
			[UseTrigger:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-All-Action-Despawned]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-All-Action-Despawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[RemoveKnownPlayerArea:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-All-Chat-Despawned]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-All-Chat-Despawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:COALITION]
			[Color:White]
			[ChatMessages:A Derelict has disappeared]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-All-Action-CompromisedGeneric]
			[Actions:GVK-PlanetaryInstallation-Small-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-All-Action-CompromisedGeneric]
			[Actions:GVK-PlanetaryInstallation-Medium-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-All-Action-CompromisedGeneric]
			[Actions:GVK-PlanetaryInstallation-Large-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-All-Action-CompromisedGeneric</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[RemoveKnownPlayerArea:true]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Small-Trigger-BeaconDisabled]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Medium-Trigger-BeaconDisabled]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Large-Trigger-BeaconDisabled]
			[DisableTriggerNames:GVK-PlanetaryInstallation-All-Trigger-Despawn]
			[DisableTriggerNames:GVK-PlanetaryInstallation-All-Trigger-DespawnMES]
			[GenerateExplosion:true]
			[ExplosionOffsetFromRemote:{X:0 Y:0 Z:0}]
			[ExplosionRange:10]
			[ExplosionDamage:1]
			[ExplosionIgnoresVoxels:true]
			[ToggleBlocksOfType:true]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/ZoneBlock]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconSmall]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconLarge]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/SmallBlockBeacon]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/LargeBlockBeacon]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlLarge]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlSmall]
			[BlockTypeToggles:Off]
			[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-Action-Compromised</SubtypeId>

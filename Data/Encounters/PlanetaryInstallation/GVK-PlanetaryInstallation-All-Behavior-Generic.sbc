			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Medium-Chat-Spawned]
			[SetCounters:MediumDefenseSpawns]
			[SetCountersValues:0]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Chat-Spawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:COALITION]
			[Color:White]
			[ChatMessages:A Medium Derelict has been detected.]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Chat for large spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-Spawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Large-Action-Spawned]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Action-Spawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SetSandboxBooleansTrue:LargeWreckActive]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Large-Chat-Spawned]
			[SetCounters:LargeDefenseSpawns]
			[SetCountersValues:0]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Chat-Spawned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]

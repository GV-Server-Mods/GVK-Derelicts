<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Horsefly Rover Carrier Behavior for Season 2 Event-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Behavior-GAALSIENHangar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:false]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGridsLongRange]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-Universal-Trigger-TargetAcquiredChatter-GAALSIEN]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarOnSpawn]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarBeaconDisabled]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarDespawn]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarDespawnMES]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarCompromised]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarSpawnCruisers]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-DefensesPlayerNear]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-DefensesDamage]
			[Triggers:GVK-PlanetaryInstallation-Large-Trigger-DefensesManual]
			[Triggers:GVK-Universal-Trigger-DespawnInZ0]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendDefenseHeartbeat]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
			[RemoteControlCode:GVK-LargeDerelict]
			BountyOnKill=20000000;
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Carrier Spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarOnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[MinCooldownMs:900000]
			[MaxCooldownMs:900000]
			[Actions:GVK-PlanetaryInstallation-GAALSIENHangar-Action-OnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-GAALSIENHangar-Action-OnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SetSandboxBooleansTrue:LargeWreckActive]
			[SetWeaponsToMaxRange:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-GAALSIENHangar-Chat-Spawned-Large]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-GAALSIENHangar-Chat-Spawned-Large</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:2]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:GAALSIEN base detected.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
		  </Description>
		</EntityComponent>
		<!-- need to run jetpack inhibitor on restart as well -->
		<!-- Trigger sequence for GAALSIENHangar to spawn Cruisers -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarSpawnCruisers</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:PlayerNear]
			[UseTrigger:true]
			[TargetDistance:3000]
			[StartsReady:false]
			[MaxActions:4]
			[MinCooldownMs:120000]
			[MaxCooldownMs:180000]
			[Actions:GVK-PlanetaryInstallation-GAALSIENHangar-Action-SpawnCruisers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-GAALSIENHangar-Action-SpawnCruisers</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SpawnEncounter:true]
			[Spawner:GVK-PlanetaryInstallation-GAALSIENHangar-Spawner-SpawnCruisers]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-GAALSIENHangar-Chat-SpawnCruisers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-GAALSIENHangar-Spawner-SpawnCruisers</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[MinDistance:500]
			[MaxDistance:1500]
			[MinAltitude:10]
			[MaxAltitude:20]
			[MaxSpawns:4]
			[InheritNpcAltitude:true]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-MediumHoverHeavy]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-LargeHover]
			[ProcessAsAdminSpawn:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-GAALSIENHangar-Chat-SpawnCruisers</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:false]
			[Author:GAALSIEN]
			[Color:Red]
			[ChatMessages:Cruiser ready for action.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequences for Hangar to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10000]
			[StartsReady:false]
			[Conditions:GVK-PlanetaryInstallation-All-Condition-BeaconDisabled]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-GAALSIENHangar-Action-Compromised]
			[Actions:GVK-PlanetaryInstallation-Large-Action-DefensesTrigger]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-LargeExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-GAALSIENHangar-Action-Compromised]
			[Actions:GVK-PlanetaryInstallation-Large-Action-DefensesTrigger]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-LargeExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarDespawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Despawn]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-PlanetaryInstallation-GAALSIENHangar-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Large-Trigger-GAALSIENHangarDespawnMES</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:DespawnMES]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-PlanetaryInstallation-GAALSIENHangar-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-GAALSIENHangar-Action-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[RemoveKnownPlayerArea:false]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-GAALSIENHangar-Chat-Compromised]
			[SetSandboxBooleansFalse:LargeWreckActive]	
			[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-GAALSIENHangar-Chat-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:GAALSIEN base destroyed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Small-SpawnGroup-Thornback Ray</SubtypeId>
			</Id>
			<Description>
			[Modular Encounters SpawnGroup]
			[IgnoreCleanupRules:false]
			[ReplenishSystems:true]
			[SpawnConditionsProfiles:GVK-PlanetaryInstallation-Small-SpawnCondition-Derelict]
			[ManipulationProfiles:MES-Manipulation-RivalAi]
			[ManipulationProfiles:GVK-PlanetaryInstallation-Small-Manipulation]
			[CutVoxelsAtAirtightCells:true]
			[CutVoxelSize:9]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>0.1</Frequency>
			<Prefabs>
				<Prefab SubtypeId="[NPC Small Wreck] Thornback Ray">
					<Position>
						<X>0.0</X>
						<Y>3.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Small Signal</BeaconText>
					<Behaviour>GVK-PlanetaryInstallation-Small-Behavior</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

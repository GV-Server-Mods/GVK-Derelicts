<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:2400]
			[PlayerDistanceTrigger:1800]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-Init]
			[Triggers:GVK-Universal-Trigger-DespawnInZ0]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-SpawnDefenses]
			[RemoteControlCode:GVK-MediumDerelict]
			BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Trigger-Init</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Medium-Action-Init]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Action-Init</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,WreckMedium]
			[CustomStrings:EncounterDisplayName,Medium signal]
			[SetCustomCountersVariables:true]
			[CustomCountersVariables:DefenseSpawn_Limit,4]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Medium-Chat-Init]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Chat-Init</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:{EncounterDisplayName} detected.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:40000]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
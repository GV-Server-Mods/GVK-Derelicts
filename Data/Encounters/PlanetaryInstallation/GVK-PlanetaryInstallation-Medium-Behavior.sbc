<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:2400]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyPlayerAndGrid3km]
			[Triggers:GVK-PlanetaryInstallation-Medium-Trigger-Init]
			[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-DespawnInZ0]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-SpawnDefenses]
			[RemoteControlCode:GVK-MediumDerelict]
			BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Trigger-Init</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:true]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Medium-Action-Init]
			[Actions:GVK-Universal-Action-DisableVanillaBlocks]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Medium-Action-Init</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,WreckMedium]
			[CustomStrings:EncounterDisplayName,Medium signal]
			[SetCustomCountersVariables:true]
			[CustomCountersVariables:DefenseSpawn_Limit,5]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Medium-Chat-Init]
			[ChangeAntennaRanges:true]
			[AntennaNamesForRangeChange:NPC Disposable Beacon]
			[AntennaNamesForRangeChange:Medium Signal]
			[AntennaNamesForRangeChange:Compact Antenna]
			[AntennaRangeChangeType:Set]
			[AntennaRangeChangeAmount:10000]
			[ChangeAntennaHudText:true]
			[AntennaHudText: ]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
	<SpawnGroups>
		<!--
		
		Vanilla Prefabs
		
		TODO:
		 - Adjust beacon ranges
		 
		Notes:
		 - CutVoxels does not actually work on SpawnConditions, only on the SpawnGroup.
		 - Below are missing a beacon so they don't work in spawn groups:
			C51_Derelict_Shuttle
		 
		-->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-SpawnGroup-Small-NWS D2 Hauler</SubtypeId>
			</Id>
			<Description>
			[Modular Encounters SpawnGroup]
			[IgnoreCleanupRules:true]
			[ReplenishSystems:true]
			[SpawnConditionsProfiles:GVK-PlanetaryInstallation-Small-SpawnCondition-Wreck-DERELICT]
			[ManipulationProfiles:GVK-PlanetaryInstallation-Small-Manipulation]
			[ManipulationProfiles:GVK-Universal-Manipulation-ShiftColorHue]
			[CutVoxelsAtAirtightCells:true]
			[CutVoxelSize:9]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>0.4</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NWS D2 Hauler">
					<Position>
						<X>0.0</X>
						<Y>20</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Small Signal</BeaconText>
					<Behaviour>GVK-PlanetaryInstallation-Small-Behavior</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

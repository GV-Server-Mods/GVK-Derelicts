<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-SpawnGroups-Large-Encampment</SubtypeId>
			</Id>
			<Description>
			[Modular Encounters SpawnGroup]
			[IgnoreCleanupRules:true]
			[ReplenishSystems:true]
			[SpawnConditionsProfiles:GVK-PlanetaryInstallation-Encampment-SpawnCondition]
			[IgnoreGlobalBlockReplacer:true]
			[ManipulationProfiles:MES-Manipulation-RivalAi]
			[ManipulationProfiles:GVK-Static-TradeStation-Manipulation]
			[UseRivalAi:true]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>5.0</Frequency>
			<Prefabs>
				<Prefab SubtypeId="[NPC Static] Convoy Outpost">
					<Position>
						<X>0.0</X>
						<Y>-25</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Unearthed Monument</BeaconText>
					<Behaviour>GVK-PlanetaryInstallation-Encampment-Behavior</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>
	</SpawnGroups>
</Definitions>
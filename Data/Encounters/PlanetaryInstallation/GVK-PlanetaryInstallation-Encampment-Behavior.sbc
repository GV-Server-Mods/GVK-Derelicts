<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:false]
			[RemoteControlCode:Encampment]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-PlanetaryInstallation-Encampment-Trigger-OnSpawn]
			[Triggers:GVK-PlanetaryInstallation-Encampment-Trigger-Timer]
			[Triggers:GVK-PlanetaryInstallation-Encampment-Trigger-Compromised]
			[Triggers:GVK-PlanetaryInstallation-Encampment-Trigger-Despawn]
			[Triggers:GVK-PlanetaryInstallation-Encampment-Trigger-DespawnMES]
			[Triggers:GVK-PlanetaryInstallation-Encampment-Trigger-CoalitionWreckDefensesPlayerNear]
			[Triggers:GVK-PlanetaryInstallation-Encampment-Trigger-CoalitionWreckSpawnsManual]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Trigger-OnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Session]
			[UseTrigger:true]
			[StartsReady:true]
			[Actions:GVK-PlanetaryInstallation-Encampment-Action-OnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Action-OnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SetSandboxBooleansFalse:MassiveSignalEligible]
			[SpawnEncounter:true]
			[Spawner:GVK-PlanetaryInstallation-Encampment-Spawner-OnSpawn]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Encampment-Chat-Announce]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Spawner-OnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:1]
			[SpawnGroups:GVK-Other-KOTH-SpawnGroup-Outpost]
			[MinDistance:1200]
			[MaxDistance:1201]
			[MinAltitude:0]
			[MaxAltitude:0]
			[InheritNpcAltitude:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Chat-Announce</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Massive signal detected.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
		  </Description>
		</EntityComponent>
		<!-- Trigger sequences for PlayerKOTH to die (172,800,000 = 2 days in ms)-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Trigger-Timer</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[MinCooldownMs:172800000]
			[MaxCooldownMs:172800001]
			[StartsReady:false]
			[Actions:GVK-PlanetaryInstallation-Encampment-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-PlanetaryInstallation-Encampment-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Trigger-Despawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Despawn]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-PlanetaryInstallation-Encampment-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Trigger-DespawnMES</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:DespawnMES]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-PlanetaryInstallation-Encampment-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Action-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Encampment-Chat-Compromised]
			[UseJetpackInhibitorEffect:false]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Encampment-Trigger-Timer]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Encampment-Trigger-Compromised]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Encampment-Trigger-Despawn]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Encampment-Trigger-DespawnMES]
			[TerminateBehavior:true]
			[ForceDespawn:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Chat-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Massive derelict fully extracted of resources.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence for Medium Defenses every 15 mins while players are near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Trigger-CoalitionWreckDefensesPlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:3000]
			[StartsReady:true]
			[MinCooldownMs:1800000]
			[MaxCooldownMs:3600000]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Encampment-Action-CoalitionWreckSpawns]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Action-CoalitionWreckSpawns</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-PlanetaryInstallation-Encampment-Trigger-CoalitionWreckSpawnsManual]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Trigger-CoalitionWreckSpawnsManual</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[StartsReady:true]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-PlanetaryInstallation-Encampment-Action-CoalitionWreckEnemiesManual]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Action-CoalitionWreckEnemiesManual</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SpawnEncounter:true]
			[Spawner:GVK-PlanetaryInstallation-Encampment-Spawner-CoalitionWreckDefenseDroneMedium]
			[Spawner:GVK-PlanetaryInstallation-Encampment-Spawner-CoalitionWreckDefenseDroneSmall]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Spawner-CoalitionWreckDefenseDroneSmall</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:-1]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-InterceptorSquad]
			[MinDistance:1500]
			[MaxDistance:1750]
			[MinAltitude:80]
			[MaxAltitude:81]
			[InheritNpcAltitude:true]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Spawner-CoalitionWreckDefenseDroneMedium</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:-1]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-MediumHoverLight]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-MediumHoverHeavy]
			[MinDistance:1500]
			[MaxDistance:1750]
			[MinAltitude:40]
			[MaxAltitude:41]
			[InheritNpcAltitude:true]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
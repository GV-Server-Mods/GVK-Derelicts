<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[UseRetreatTimer:false]
			[UseNoTargetTimer:false]
			[UsePlayerDistanceTimer:false]
			[RemoteControlCode:Encampment]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-PlanetaryInstallation-Encampment-Trigger-OnSpawn]
			[Triggers:GVK-PlanetaryInstallation-Encampment-Trigger-Timer]
			[Triggers:GVK-PlanetaryInstallation-Encampment-Trigger-Compromised]
			[Triggers:GVK-PlanetaryInstallation-Encampment-Trigger-Despawn]
			[Triggers:GVK-PlanetaryInstallation-Encampment-Trigger-DespawnMES]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Trigger-OnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Session]
			[UseTrigger:true]
			[StartsReady:true]
			[Actions:GVK-PlanetaryInstallation-Encampment-Action-OnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Action-OnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SetSandboxBooleansTrue:LargeWreckActive]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Encampment-Chat-Announce]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Chat-Announce</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Massive signal detected.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
		  </Description>
		</EntityComponent>
		<!-- Trigger sequences for PlayerKOTH to die (172,800,000 = 2 days in ms)-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Trigger-Timer</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[MinCooldownMs:172800000]
			[MaxCooldownMs:172800001]
			[StartsReady:false]
			[Actions:GVK-PlanetaryInstallation-Encampment-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-PlanetaryInstallation-Encampment-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Trigger-Despawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Despawn]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-PlanetaryInstallation-Encampment-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Trigger-DespawnMES</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:DespawnMES]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-PlanetaryInstallation-Encampment-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Action-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[GridEditable:No]
			[SubGridsEditable:No]
			[GridDestructible:No]
			[SubGridsDestructible:No]
			[UseChatBroadcast:true]
			[ChatData:GVK-PlanetaryInstallation-Encampment-Chat-Compromised]
			[ToggleBlocksOfType:true]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/ZoneBlock]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconSmall]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconLarge]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/SmallBlockBeacon]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/LargeBlockBeacon]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlLarge]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlSmall]
			[BlockTypeToggles:Off]
			[GenerateExplosion:true]
			[ExplosionOffsetFromRemote:{X:0 Y:0 Z:0}]
			[ExplosionRange:300]
			[ExplosionDamage:1]
			[ExplosionIgnoresVoxels:true]
			[EnableBlocks:true]
			[EnableBlockNames:NPC Beacon]
			[EnableBlockStates:Off]
			[UseJetpackInhibitorEffect:false]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Encampment-Trigger-Timer]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Encampment-Trigger-Compromised]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Encampment-Trigger-Despawn]
			[DisableTriggerNames:GVK-PlanetaryInstallation-Encampment-Trigger-DespawnMES]
			[TerminateBehavior:true]
			[ForceDespawn:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallation-Encampment-Chat-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Massive derelict fully extracted of resources.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- This spawns 1 large hover ONLY in Z3 -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-SpawnCondition-GAALSIEN-LargeHoverSingle</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[BossEncounterAtmo:true]
			[BossCustomAnnounceEnable:true]
			[BossCustomAnnounceAuthor:Sensors]
			[BossCustomAnnounceMessage:Elite Gaalsien unit detected]
			[BossCustomGPSLabel:Dangerous Encounter]
			[BossCustomGPSColor:{X:255 Y:0 Z:0}]
			[FactionOwner:GAALSIEN]
			[MinSpawnFromPlanetSurface:-1]
			[MaxSpawnFromPlanetSurface:1000]
			[ReactorsOn:true]
			[ForceStaticGrid:false]
			[SkipVoxelSpawnChecks:false]
			[SkipGridSpawnChecks:false]
			[UseThreatLevelCheck:false]
			[ThreatLevelCheckRange:2000]
			[ThreatIncludeOtherNpcOwners:false]
			[ThreatScoreMinimum:250]
			[ThreatScoreMaximum:99999999]
 			[PrefabSpawningMode:Random]
			[RemoteControlCode:GVK-Boss]
			[ZoneConditions:GVK-Universal-ZoneConditions-WreckZone23]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
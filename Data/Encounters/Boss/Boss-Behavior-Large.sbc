<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- HoverCruiserHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-Behavior-HoverCruiserHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Horsefly]
			[UseStaticGuns:true]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyPlayerAndGrid]
			[AutopilotData:GVK-Drone-All-Autopilot-HoverCruiserHorsefly]
			[Triggers:GVK-Universal-Trigger-SetEnemyReputation]
			[Triggers:GVK-Boss-Trigger-CruiserBeaconDisabled]
			[Triggers:GVK-Boss-Trigger-CruiserCompromised]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Drone-All-Trigger-FireMissilesTimers]
			[Triggers:GVK-Universal-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			BountyOnKill=10000000;
			</Description>
		</EntityComponent>
		<!-- Honorguard Cruiser Fighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-Behavior-HonorguardCruiserFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Fighter]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[HorseFighterTimeApproaching:30]
			[HorseFighterTimeEngaging:30]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[AutopilotData:GVK-Drone-All-Autopilot-HonorguardCruiserPrimary]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-HonorguardCruiserSecondary]
			[Triggers:GVK-Universal-Trigger-SetEnemyReputation]
			[Triggers:GVK-Boss-Trigger-CruiserBeaconDisabled]
			[Triggers:GVK-Boss-Trigger-CruiserCompromised]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Drone-All-Trigger-FireRailgunsTimers]
			[Triggers:GVK-Drone-All-Trigger-FireMissilesTimers]
			[Triggers:GVK-Universal-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:GVK-Drone-All-Trigger-HonorguardCruiserSecondaryAutopilot]
			[Triggers:GVK-Drone-All-Trigger-HonorguardCruiserPrimaryAutopilot]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatNoTarget]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatTimer]
			[WeaponSystem:GVK-Drone-All-Weapon-Fixed]
			BountyOnKill=10000000;
			</Description>
		</EntityComponent>
		<!-- Production Cruiser Horsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-Behavior-ProductionCruiserHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Horsefly]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[AutopilotData:GVK-Drone-All-Autopilot-HoverCruiserHorsefly]
			[TargetData:GVK-Universal-Target-EnemyPlayerAndGrid]
			[Triggers:GVK-Universal-Trigger-SetEnemyReputation]
			[Triggers:GVK-Boss-Trigger-CruiserBeaconDisabled]
			[Triggers:GVK-Boss-Trigger-CruiserCompromised]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Drone-All-Trigger-FireMissilesTimers]
			[Triggers:GVK-Drone-All-Trigger-ProductionCruiserSpawnFighters]
			[Triggers:GVK-Universal-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatNoTarget]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatTimer]
			BountyOnKill=10000000;
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cruiser RAI Remote is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-Trigger-CruiserCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Boss-Action-CruiserCompromised]
			[Actions:GVK-Drone-All-Action-LargeDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-Action-CruiserCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Boss-Chat-CruiserCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-Chat-CruiserCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Elite cruiser destroyed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cruiser NPC Beacon is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-Trigger-CruiserBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Drone-All-Condition-CruiserBeaconDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Boss-Action-CruiserCompromised]
			[Actions:GVK-Drone-All-Action-LargeDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
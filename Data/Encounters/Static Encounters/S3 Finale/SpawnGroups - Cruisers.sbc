<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>
		<!-- [NPC Drone] Assault Ship MAC Hover -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-CustomSpawns-GAALSIEN-AssaultShip</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[IgnoreCleanupRules:true]
				[ReplenishSystems:true]
				[ManipulationProfiles:MES-Manipulation-RivalAi]
				[ManipulationProfiles:GVK-CustomSpawns-DefenseDrones-Manipulation-H2Hover]
				[SpawnConditionsProfiles:GVK-SpawnConditions-GAALSIEN-S3F-Cruisers]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>0.1</Frequency>
			<Prefabs>
				<Prefab SubtypeId="[NPC Drone] Assault Ship">
					<Position>
						<X>0.0</X>
						<Y>10.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Assault Ship</BeaconText>
					<Behaviour>GVK-CustomSpawns-DefenseDrone-HonorguardCruiser-Behavior</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

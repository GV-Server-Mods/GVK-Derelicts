<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Horsefly Rover Carrier Behavior for Season 2 Event-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-PlanetaryInstallations-GaalsienFortress-Behavior</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:Passive]
				[UseAmmoReplenish:true]
				[AmmoReplenishClipAmount:10]
				[MaxAmmoReplenishments:99999999]
				[UsePlayerDistanceTimer:false]
				[UseRetreatTimer:false]
				[UseNoTargetTimer:false]
				[TargetData:GVK-Generic-Target-EnemyGrids-LongRange]
				[Triggers:GaalsienFortress-Trigger-OnSpawn]
				[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-FireMissilesTimers]
				[Triggers:GVK-Generic-Trigger-SPRTTargetAcquiredChatter]
				[Triggers:GaalsienFortress-Trigger-Compromised]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Carrier Spawns -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GaalsienFortress-Trigger-OnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[StartsReady:true]
				[MinCooldownMs:900000]
				[MaxCooldownMs:900000]
				[Actions:GaalsienFortress-Action-OnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GaalsienFortress-Action-OnSpawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetWeaponsToMaxRange:true]
				[UseChatBroadcast:true]
				[ChatData:GaalsienFortress-Chat-Announce]
				[UseJetpackInhibitorEffect:true]
			</Description>
		</EntityComponent>
		<!-- need to run jetpack inhibitor on restart as well -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		  <Id>
			  <TypeId>Inventory</TypeId>
			  <SubtypeId>GaalsienFortress-Chat-Announce</SubtypeId>
		  </Id>
		  <Description>

			  [RivalAI Chat]
			  
			  [UseChat:true]
			  [StartsReady:true]
			  [Chance:100]
			  [MaxChats:-1]
			  [BroadcastRandomly:false]
			  [Author:COALITION]
			  [Color:White]
			  [GPSLabel:Gaalsien Fortress]
			  
			  [ChatMessages:A Gaalsien Fortress has been spotted near `{GPS}`]
			  [ChatAudio:ArcHudGPSNotification2]
			  [BroadcastChatType:Chat]
			  [ChatMessages:A Gaalsien Fortress has been spotted.]
			  [BroadcastChatType:Notify]
			  [SendToAllOnlinePlayers:true]

		  </Description>      
		</EntityComponent>
		<!-- Trigger sequence for Carrier to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GaalsienFortress-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Compromised]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GaalsienFortress-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GaalsienFortress-Trigger-Despawn</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Despawn]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GaalsienFortress-Action-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GaalsienFortress-Trigger-DespawnMES</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:DespawnMES]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:1]
				[Actions:GaalsienFortress-Action-Compromised]
				[Actions:GaalsienFortress-Action-SelfDestruct1]
				[Actions:GaalsienFortress-Action-SelfDestruct2]
				[Actions:GaalsienFortress-Action-SelfDestruct3]
				[Actions:GaalsienFortress-Action-SelfDestruct4]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GaalsienFortress-Action-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[UseChatBroadcast:true]
				[ChatData:GaalsienFortress-Chat-Compromised]
				[GenerateExplosion:true]
				[ExplosionOffsetFromRemote:{X:0 Y:60 Z:0}]
				[ExplosionRange:100]
				[ExplosionDamage:50000]
				[ExplosionIgnoresVoxels:true]
				[EnableBlocks:true]
				[EnableBlockNames:NPC Beacon]
				[EnableBlockStates:Off]
				[TriggerTimerBlocks:True]
				[TimerBlockNames:Timer Block Warheads]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GaalsienFortress-Action-SelfDestruct1</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[GenerateExplosion:true]
				[ExplosionOffsetFromRemote:{X:50 Y:60 Z:50}]
				[ExplosionRange:50]
				[ExplosionDamage:50000]
				[ExplosionIgnoresVoxels:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GaalsienFortress-Action-SelfDestruct2</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[GenerateExplosion:true]
				[ExplosionOffsetFromRemote:{X:-50 Y:60 Z:-50}]
				[ExplosionRange:50]
				[ExplosionDamage:50000]
				[ExplosionIgnoresVoxels:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GaalsienFortress-Action-SelfDestruct3</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[GenerateExplosion:true]
				[ExplosionOffsetFromRemote:{X:50 Y:60 Z:-50}]
				[ExplosionRange:50]
				[ExplosionDamage:50000]
				[ExplosionIgnoresVoxels:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GaalsienFortress-Action-SelfDestruct4</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[GenerateExplosion:true]
				[ExplosionOffsetFromRemote:{X:-50 Y:60 Z:50}]
				[ExplosionRange:50]
				[ExplosionDamage:50000]
				[ExplosionIgnoresVoxels:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GaalsienFortress-Chat-Compromised</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:1]
				[BroadcastRandomly:false]
				[Author:Coalition]
				[Color:White]
				[ChatMessages:The Gaalsien Fortress has been defeated!]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-SpawnCondition-GAALSIEN-S3F-Cruisers</SubtypeId>
			</Id>
			<Description>
				[MES Spawn Conditions]
				[RivalAiAtmosphericSpawn:true]
				[FactionOwner:GAALSIEN]
				[ReactorsOn:true]
				[ForceStaticGrid:false]
				[MinSpawnFromPlanetSurface:-1]
				[MaxSpawnFromPlanetSurface:2000]
				[SkipVoxelSpawnChecks:true]
				[SkipGridSpawnChecks:true]
				[UseKnownPlayerLocations:true]
				[KnownPlayerLocationMustMatchFaction:true]
				[KnownPlayerLocationMinSpawnedEncounters:-1]
				[KnownPlayerLocationMaxSpawnedEncounters:-1]
				[SandboxVariables:AllowS3FSpawns]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
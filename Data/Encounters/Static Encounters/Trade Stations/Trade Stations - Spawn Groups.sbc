	<SpawnGroups>
		<!-- these don't use spawn conditions because each has a different static coord, and they can't be split -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-StaticEncounters-TradeStations-SpawnGroup-Sevastapol_2</SubtypeId>
			</Id>
			<Description>
				[Modular Encounters SpawnGroup]
				[StaticEncounter:true]
				[FactionOwner:COALITION]
				[InitializeStoreBlocks:false]
				[ReactorsOn:true]
				[ForceStaticGrid:true]
				[TriggerCoords:{X:64290.2373847149 Y:62037.8993698961 Z:31283.5925882591}]
				[TriggerRadius:999999]
				[IgnoreCleanupRules:true]
				[IgnoreGlobalBlockReplacer:true]
				[ReplenishSystems:true]
				[ForceExactPositionAndOrientation:true]
				[StaticEncounterCoords:{X:2992.95013042559 Y:30433.3822596881 Z:34042.6074296833}]
				[StaticEncounterForward:{X:-0.0420774294019423 Y:-0.00324445845020388 Z:-0.99910908484724}]
				[StaticEncounterUp:{X:-0.996152177363732 Y:-0.0768101748324146 Z:0.0422023290318264}]
				[ManipulationProfiles:GVK-StaticEncounters-TradeStations-Manipulation]
				[UseRivalAi:true]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>5.0</Frequency>
			<Prefabs>
				<Prefab SubtypeId="[NPC Trade Station] Sevastapol">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Sevastapol Trade Station</BeaconText>
					<Behaviour>GVK-TradeStation-Behavior-Start</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>

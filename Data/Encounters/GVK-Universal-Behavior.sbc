<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- === Trigger Sequences === -->
		<!-- NPC Chat when target is acquired -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-TargetAcquiredChatter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:AcquiredTarget]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Universal-Action-SPRTTargetAcquiredChatter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-SPRTTargetAcquiredChatter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Universal-Chat-SPRTTargetAcquiredChatter]
			</Description>
		</EntityComponent>
		<!-- retreat when all weapons are gone -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-NoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:NoWeapon]
			[UseTrigger:true]
			[StartsReady:false]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[MaxActions:1]
			[Actions:GVK-Universal-Action-NoWeapon]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-NoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Retreat:true]
			[RecalculateDespawnCoords:true]
			</Description>
		</EntityComponent>
		<!-- Jetpack Inhibitor on Session (This appears to be broken in DS MP, players can glide long distances  -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-JetpackInhibitor</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Session]
			[UseTrigger:false]
			[StartsReady:false]
			[MaxActions:-1]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Actions:GVK-Universal-Action-JetpackInhibitor]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-JetpackInhibitor</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[UseJetpackInhibitorEffect:true]
			</Description>
		</EntityComponent>
		<!-- Trigger Make indestructable on spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-IndestructibleOnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Universal-Action-IndestructibleOnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-IndestructibleOnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[GridDestructible:No]
			[SubGridsDestructible:No]
			</Description>
		</EntityComponent>
		<!-- Trigger Make non-editable on spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-UneditableOnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Universal-Action-UneditableOnSpawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-UneditableOnSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[GridEditable:No]
			[SubGridsEditable:No]
			</Description>
		</EntityComponent>
		<!-- Trigger Make editable on defeat -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-EditableOnCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-EditableOnCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[GridEditable:Yes]
			[SubGridsEditable:Yes]
			</Description>
		</EntityComponent>
		<!-- === Chat === -->
		<!-- Generic SPRT Battle Chatter -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Chat-SPRTBattleChatter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[MinTime:30]
			[MaxTime:90]
			[StartsReady:true]
			[Chance:10]
			[BroadcastRandomly:true]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			[Author:{GridName}]
			[Color:Red]
			[ChatMessages:Lets dance!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Your mother was a hamster and your father smelt of elderberries!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Its just a flesh wound.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:wE hAvE cHiLdReN oN bOaRd, PlEaSe HoLd YoUr FiRe.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:You don't stand a chance.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:You're going to regret this.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:I’m a leaf on the wind!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Tis but a scratch]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Please enjoy the music while your party is being reached.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Target is continuing to attack, requesting fire support!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:ouch, I felt that sim speed hit]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:I'm doing my part!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:This is pretty boring, you should drop your base coords in the chat]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Hmmm, RBH fights better than this, and that’s saying something]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:I'm gonna whip yer sorry hide like a mule!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Lock S-Foils in attack position.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			</Description>
		</EntityComponent>
		<!-- Generic SPRT Target Acquired Chatter -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Chat-SPRTTargetAcquiredChatter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:50]
			[BroadcastRandomly:true]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			[Author:{GridName}]
			[Color:Red]
			[ChatMessages:Target acquired.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Target locked.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Enemy ship in-sight.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:I'm moving in.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Tangos in-bound.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Engaging enemy.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Enemy detected.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Look who decided to show up.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:This will be easy.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:This isn't even worth my time.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:These Coalition sympathizers don't stand a chance.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:In the name of Sajuuk.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:For Kiith Gaalsien!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:Kill the blasphemers!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:This is your last chance to run.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			</Description>
		</EntityComponent>
		<!-- Condition for beacon disabled triggers with all known beacon names -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Condition-BeaconDisabled-WIP</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[UseRequiredFunctionalBlocks:true]
			[RequiredNoneFunctionalBlockNames:Proprietary Beacon]
			[RequiredNoneFunctionalBlockNames:Small Signal]
			[RequiredNoneFunctionalBlockNames:Medium Signal]
			[RequiredNoneFunctionalBlockNames:Large Signal]
			[RequiredNoneFunctionalBlockNames:Massive Signal]
			[RequiredNoneFunctionalBlockNames:Disposable Beacon]
			[RequiredNoneFunctionalBlockNames:Fortress]
			[RequiredNoneFunctionalBlockNames:Hangar]
			[RequiredNoneFunctionalBlockNames:Outpost]
			[RequiredNoneFunctionalBlockNames:Player KOTH]
			[RequiredNoneFunctionalBlockNames:Distress Signal]
			[RequiredNoneFunctionalBlockNames:Downed Salvager]
			[MatchAnyCondition:false]
			[CheckForBlocksOfType:true]
			[BlocksOfType:MyObjectBuilder_Beacon]
			[UseFailCondition:true]
			</Description>
		</EntityComponent>
		<!-- Explosion effects for non-gaalsien NPCs -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-SmallExplosionEffects</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Universal-Action-SmallExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-SmallExplosionEffects</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[PlayParticleEffectAtRemote:true]
			[ParticleEffectId:BlockDestroyedExplosion_Large3X]
			[ParticleEffectOffset:{X:0.0 Y:0.0 Z:0.0}]
			[ParticleEffectScale:1.0]
			[ParticleEffectMaxTime:1000]
			[ParticleEffectColor:{X:1.0 Y:1.0 Z:1.0}]
			[PlaySoundAtPosition:true]
			[SoundAtPosition:HWR_SmallExplosion]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-MediumExplosionEffects</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Universal-Action-MediumExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-MediumExplosionEffects</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[PlayParticleEffectAtRemote:true]
			[ParticleEffectId:Explosion_Warhead_30]
			[ParticleEffectOffset:{X:0.0 Y:0.0 Z:0.0}]
			[ParticleEffectScale:1.0]
			[ParticleEffectMaxTime:1000]
			[ParticleEffectColor:{X:1.0 Y:1.0 Z:1.0}]
			[PlaySoundAtPosition:true]
			[SoundAtPosition:HWR_LargeExplosion]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-LargeExplosionEffects</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Universal-Action-LargeExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-LargeExplosionEffects</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[PlayParticleEffectAtRemote:true]
			[ParticleEffectId:Explosion_Warhead_50]
			[ParticleEffectOffset:{X:0.0 Y:0.0 Z:0.0}]
			[ParticleEffectScale:1.0]
			[ParticleEffectMaxTime:1000]
			[ParticleEffectColor:{X:1.0 Y:1.0 Z:1.0}]
			[PlaySoundAtPosition:true]
			[SoundAtPosition:Cruiser_Explosion]
			</Description>
		</EntityComponent>
		<!-- Explosion effects for Gaalsien NPCs -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-SmallBlueExplosionEffects</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Universal-Action-SmallBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-SmallBlueExplosionEffects</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[PlayParticleEffectAtRemote:true]
			[ParticleEffectId:BlockDestroyedExplosion_Large3X_Blue]
			[ParticleEffectOffset:{X:0.0 Y:0.0 Z:0.0}]
			[ParticleEffectScale:1.0]
			[ParticleEffectMaxTime:1000]
			[ParticleEffectColor:{X:1.0 Y:1.0 Z:1.0}]
			[PlaySoundAtPosition:true]
			[SoundAtPosition:HWR_SmallExplosion]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-MediumBlueExplosionEffects</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Universal-Action-MediumBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-MediumBlueExplosionEffects</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[PlayParticleEffectAtRemote:true]
			[ParticleEffectId:Explosion_Warhead_30_Blue]
			[ParticleEffectOffset:{X:0.0 Y:0.0 Z:0.0}]
			[ParticleEffectScale:1.0]
			[ParticleEffectMaxTime:1000]
			[ParticleEffectColor:{X:1.0 Y:1.0 Z:1.0}]
			[PlaySoundAtPosition:true]
			[SoundAtPosition:HWR_LargeExplosion]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Trigger-LargeBlueExplosionEffects</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:GVK-Universal-Action-LargeBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-LargeBlueExplosionEffects</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[PlayParticleEffectAtRemote:true]
			[ParticleEffectId:Explosion_Warhead_50_Blue]
			[ParticleEffectOffset:{X:0.0 Y:0.0 Z:0.0}]
			[ParticleEffectScale:1.0]
			[ParticleEffectMaxTime:1000]
			[ParticleEffectColor:{X:1.0 Y:1.0 Z:1.0}]
			[PlaySoundAtPosition:true]
			[SoundAtPosition:Cruiser_Explosion]
			</Description>
		</EntityComponent>
		<!-- Shared disabled action for most NPCs that do not despawn on death -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-Disabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[EnableBlocks:true]
			[EnableBlockNames:Magnetic Plate]
			[EnableBlockStates:On]
			[EnableBlockNames:NPC Beacon]
			[EnableBlockStates:Off]
			[StopAllRotation:true]
			[StopAllThrust:true]
			[RazeBlocksOfType:true]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/ZoneBlock]
			[RazeBlocksTypes:MyObjectBuilder_RemoteControl/RivalAIRemoteControlLarge]
			[RazeBlocksTypes:MyObjectBuilder_RemoteControl/RivalAIRemoteControlSmall]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/SmallBlockBeacon]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/LargeBlockBeacon]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/SmallBlockBeacon_NPCNoConceal]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/LargeBlockBeacon_NPCNoConceal]
			[ToggleBlocksOfType:true]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconSmall]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconLarge]
			[BlockTypeToggles:Off]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:false]
			[TerminateBehavior:true]
			[ForceDespawn:false]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
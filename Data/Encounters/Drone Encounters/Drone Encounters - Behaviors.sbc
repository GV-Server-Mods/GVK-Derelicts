		<!-- Honorguard Cruiser Fighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-DroneEnconuter-HonorguardCruiser-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Fighter]
			[UseStaticGuns:true]
			[UseTurrets:true]
			[UseVelocityCollisionEvasion:true]
			[MaxStaticWeaponRange:1000]
			[WeaponMaxAngleFromTarget:10]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:0]
			[PlayerDistanceTrigger:15000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:1800]
			[UseRetreatTimer:true]
			[RetreatTimerTrigger:86400]
			[RetreatDespawnDistance:1500]
			[HorseFighterTimeApproaching:30]
			[HorseFighterTimeEngaging:30]
			[TargetData:GVK-Generic-TargetProfile-EnemyPlayers]
			[AutopilotData:GVK-CustomSpawns-DefenseDrone-HonorguardCruiser-Autopilot-Primary]
			[SecondaryAutopilotData:GVK-CustomSpawns-DefenseDrone-HonorguardCruiser-Autopilot-Secondary]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-TargetAttacker]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-FireRailgunsTimers]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-FireMissilesTimers]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-FireRailgunsTimers]
			[Triggers:GVK-Generic-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-Cruiser-Crashed]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-Cruiser-Compromised]
			[Triggers:GVK-Generic-Trigger-SPRTNoWeapon]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-StrafeingAutopilot]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-ApproachingAutopilot]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-JetpackInhibitorOnSpawn]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-JetpackInhibitorOnRestart]

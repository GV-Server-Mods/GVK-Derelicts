<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Production Cruiser Horsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-Behavior-ProductionCruiserHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Horsefly]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[AutopilotData:GVK-CustomSpawns-DefenseDrone-Autopilot-HoverCruiserHorsefly]
			[TargetData:GVK-Generic-Target-EnemyPlayers]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-CustomSpawns-DefenseDrone-ProductionCruiser-Trigger-SpawnFighters]
			[Triggers:GVK-Generic-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-Cruiser-Crashed]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-Cruiser-Compromised]
			[Triggers:GVK-Generic-Trigger-SPRTNoWeapon]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-JetpackInhibitorOnSpawn]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-JetpackInhibitorOnRestart]
			[Triggers:GVK-CustomSpawns-DefenseDrone-Trigger-Crashed]
			[Triggers:GVK-Generic-Trigger-CreateKPL]
			[Triggers:GVK-DroneEnconuter-Trigger-Retreat-NoTarget]
			[Triggers:GVK-DroneEnconuter-Trigger-Retreat-Timer]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for ProductionCruiser to spawn fighters -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-ProductionCruiser-Trigger-SpawnFighters</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:PlayerNear]
			[UseTrigger:true]
			[TargetDistance:2000]
			[StartsReady:true]
			[MaxActions:3]
			[MinCooldownMs:120000]
			[MaxCooldownMs:180000]
			[Actions:GVK-CustomSpawns-DefenseDrone-ProductionCruiser-Action-SpawnFighters]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-ProductionCruiser-Action-SpawnFighters</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SpawnEncounter:true]
			[Spawner:GVK-CustomSpawns-DefenseDrone-ProductionCruiser-Spawner-SpawnFighters]
			[UseChatBroadcast:true]
			[ChatData:GVK-CustomSpawns-DefenseDrone-ProductionCruiser-Chat-SpawnFighters]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-ProductionCruiser-Spawner-SpawnFighters</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[MinDistance:500]
			[MaxDistance:1000]
			[MinAltitude:100]
			[MaxAltitude:400]
			[InheritNpcAltitude:true]
			[SpawnGroups:GVK-DroneEncounter-SpawnGroup-GAALSIEN-SmallFlyers]
			[ProcessAsAdminSpawn:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-ProductionCruiser-Chat-SpawnFighters</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:false]
			[Author:Production Cruiser]
			[Color:Red]
			[ChatMessages:Fighters Inbound.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
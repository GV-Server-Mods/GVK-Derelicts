<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-Manipulation-Flyer</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:100]
				[ClearAuthorship:true]
				[EraseIngameScripts:true]
				[IgnoreGlobalBlockReplacer:false]
				[ClearGridInventories:true]
				[DisableBlocksWithName:Survival]
				[AllowPartialNames:true]
				[UseLootProfiles:true]
				[LootProfiles:GVK-Derelict-Loot-Medium]
				[DisableGyroOverride:true]
				[UseBlockReplacerProfile:true]
				[BlockReplacerProfileNames:MES-Armor-HeavyToLight]
				[ConfigureSpecialNpcThrusters:true]
				[RestrictNpcIonThrust:true]
				[NpcIonThrustForceMultiply:5]
				[NpcIonThrustPowerMultiply:0.0001]
				[RestrictNpcAtmoThrust:true]
				[NpcAtmoThrustForceMultiply:2]
				[NpcAtmoThrustPowerMultiply:0.0001]
				[RestrictNpcHydroThrust:true]
				[NpcHydroThrustForceMultiply:2]
				[NpcHydroThrustPowerMultiply:0.000001]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-CustomSpawns-DefenseDrone-Manipulation-Hover</SubtypeId>
			</Id>
			<Description>
				[MES Manipulation]
				[ManipulationChance:100]
				[ClearAuthorship:true]
				[EraseIngameScripts:true]
				[IgnoreGlobalBlockReplacer:false]
				[ClearGridInventories:true]
				[DisableBlocksWithName:Survival]
				[AllowPartialNames:true]
				[UseLootProfiles:true]
				[LootProfiles:GVK-Derelict-Loot-Medium]
				[DisableGyroOverride:true]
				[UseBlockReplacerProfile:true]
				[BlockReplacerProfileNames:GVK-Replacer-LargeCockpitToRivalAI]
				[BlockReplacerProfileNames:MES-Armor-LightToHeavy]
				[ConfigureSpecialNpcThrusters:true]
				[RestrictNpcIonThrust:true]
				[NpcIonThrustForceMultiply:5]
				[NpcIonThrustPowerMultiply:0.0001]
				[RestrictNpcAtmoThrust:true]
				[NpcAtmoThrustForceMultiply:5]
				[NpcAtmoThrustPowerMultiply:0.0001]
				[RestrictNpcHydroThrust:true]
				[NpcHydroThrustForceMultiply:5]
				[NpcHydroThrustPowerMultiply:0.000001]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
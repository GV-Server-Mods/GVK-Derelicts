<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--
		
		When called, check if the grid is small, and force despawn if true.
				
		Tags:GVK-Universal-TriggerTags-AttemptSmallDespawn

		-->
		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-TriggerTags-AttemptSmallDespawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Tags:GVK-Universal-TriggerTags-AttemptSmallDespawn]
			[Type:Manual]
			[StartsReady:true]
			[Conditions:GVK-Universal-Condition-GridSizeSmall]
			[ActionExecution:All]
			[Actions:GVK-Universal-Action-AttemptSmallDespawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Action-AttemptSmallDespawn</SubtypeId>
			</Id>
			<Description>
			[//DebugMessage:AttemptSmallDespawn]
			[RivalAI Action]
			[ForceDespawn:true]
			</Description>
		</EntityComponent>
		<!--
		
		When called, run universal disabled actions.
				
		Tags:GVK-Universal-TriggerTags-AttemptSmallDespawn

		-->
		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-TriggerTags-Disabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Tags:GVK-Universal-TriggerTags-Disabled]
			[Type:Manual]
			[StartsReady:true]
			[ActionExecution:All]
			[Actions:GVK-Universal-Action-Disabled]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
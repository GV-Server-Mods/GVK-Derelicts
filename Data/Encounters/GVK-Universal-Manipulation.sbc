<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Manipulation-Large3x3StandardTurrets</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[ChangeTurretSettings:true]
			[TurretRange:3000]
			[TurretTargetNeutrals:false]
			[RandomizeWeapons:true]
			[IgnoreWeaponRandomizerTargetGlobalBlacklist:true]
			[IgnoreWeaponRandomizerTargetGlobalWhitelist:true]
			[WeaponRandomizerWhitelist:MyObjectBuilder_LargeGatlingTurret/(null),MyObjectBuilder_LargeMissileTurret/LargeCalibreTurret,MyObjectBuilder_LargeMissileTurret/KhopeshTurret,MyObjectBuilder_LargeMissileTurret/LargeBlockMediumCalibreTurret,MyObjectBuilder_LargeMissileTurret/SentinelTurret,MyObjectBuilder_LargeMissileTurret/(null)]
			[WeaponRandomizerTargetWhitelist:MyObjectBuilder_LargeMissileTurret/LargeCalibreTurret,MyObjectBuilder_LargeMissileTurret/KhopeshTurret,MyObjectBuilder_LargeMissileTurret/LargeBlockMediumCalibreTurret,MyObjectBuilder_LargeMissileTurret/SentinelTurret,MyObjectBuilder_LargeMissileTurret/(null)]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Manipulation-Large3x3HeavyTurrets</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ChangeTurretSettings:true]
			[TurretRange:3000]
			[TurretTargetNeutrals:false]
			[ManipulationChance:100]
			[RandomizeWeapons:true]
			[IgnoreWeaponRandomizerTargetGlobalBlacklist:true]
			[IgnoreWeaponRandomizerTargetGlobalWhitelist:true]
			[WeaponRandomizerWhitelist:MyObjectBuilder_LargeMissileTurret/ARYXSpartanTurret,MyObjectBuilder_LargeMissileTurret/ARYXVulcanTurret,MyObjectBuilder_LargeMissileTurret/ARYXHeavyFlakTurret,MyObjectBuilder_ConveyorSorter/missileBattery01]
			[WeaponRandomizerTargetWhitelist:MyObjectBuilder_LargeMissileTurret/ARYXSpartanTurret,MyObjectBuilder_LargeMissileTurret/ARYXVulcanTurret,MyObjectBuilder_LargeMissileTurret/ARYXHeavyFlakTurret,MyObjectBuilder_ConveyorSorter/missileBattery01]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Manipulation-UpgradeBlocks1</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:33]
			[UseBlockReplacer:true]
			[ReplaceBlockOld:MyObjectBuilder_Decoy/GVUpgrade_CombatMobility]
			[ReplaceBlockNew:MyObjectBuilder_Decoy/GVUpgrade_Resistance]
			[ReplaceBlockOld:MyObjectBuilder_Decoy/GVUpgrade_CombatMobility_Small]
			[ReplaceBlockNew:MyObjectBuilder_Decoy/GVUpgrade_Resistance_Small]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Manipulation-UpgradeBlocks2</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:33]
			[UseBlockReplacer:true]
			[ReplaceBlockOld:MyObjectBuilder_Decoy/GVUpgrade_CombatMobility]
			[ReplaceBlockNew:MyObjectBuilder_Decoy/GVUpgrade_Production]
			[ReplaceBlockOld:MyObjectBuilder_Decoy/GVUpgrade_CombatMobility_Small]
			[ReplaceBlockNew:MyObjectBuilder_Decoy/GVUpgrade_Production_Small]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Manipulation-UpgradeBlocks3</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:33]
			[UseBlockReplacer:true]
			[ReplaceBlockOld:MyObjectBuilder_Decoy/GVUpgrade_CombatMobility]
			[ReplaceBlockNew:MyObjectBuilder_Decoy/GVUpgrade_Engineering]
			[ReplaceBlockOld:MyObjectBuilder_Decoy/GVUpgrade_CombatMobility_Small]
			[ReplaceBlockNew:MyObjectBuilder_Decoy/GVUpgrade_Engineering_Small]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
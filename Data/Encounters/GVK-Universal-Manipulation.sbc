<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- TargetWhitlist blocks must be Public -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-Large3x3StandardTurrets</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:75]
			[ChangeTurretSettings:true]
			[TurretRange:3000]
			[TurretTargetNeutrals:false]
			[RandomizeWeapons:true]
			[IgnoreWeaponRandomizerTargetGlobalBlacklist:true]
			[IgnoreWeaponRandomizerTargetGlobalWhitelist:true]
			[WeaponRandomizerWhitelist:MyObjectBuilder_LargeGatlingTurret/LargeGatlingTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeCalibreTurret_NPC,MyObjectBuilder_LargeMissileTurret/KhopeshTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeBlockMediumCalibreTurret_NPC,MyObjectBuilder_LargeMissileTurret/SentinelTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeMissileTurret_NPC]
			[WeaponRandomizerTargetWhitelist:MyObjectBuilder_LargeGatlingTurret/LargeGatlingTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeCalibreTurret_NPC,MyObjectBuilder_LargeMissileTurret/KhopeshTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeBlockMediumCalibreTurret_NPC,MyObjectBuilder_LargeMissileTurret/SentinelTurret_NPC,MyObjectBuilder_LargeMissileTurret/LargeMissileTurret_NPC]
			</Description>
		</EntityComponent>
		<!-- TargetWhitlist blocks must be Public -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Manipulation-Large3x3HeavyTurrets</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ChangeTurretSettings:true]
			[TurretRange:3000]
			[TurretTargetNeutrals:false]
			[ManipulationChance:75]
			[RandomizeWeapons:true]
			[IgnoreWeaponRandomizerTargetGlobalBlacklist:true]
			[IgnoreWeaponRandomizerTargetGlobalWhitelist:true]
			[WeaponRandomizerWhitelist:MyObjectBuilder_LargeMissileTurret/ARYXSpartanTurret_NPC,MyObjectBuilder_LargeMissileTurret/GVK_AvengerGatlingTurret_NPC,MyObjectBuilder_LargeMissileTurret/ARYXHeavyFlakTurret_NPC,MyObjectBuilder_ConveyorSorter/missileBattery01_NPC,MyObjectBuilder_LargeMissileTurret/GVK_CycloneCannonTurret_NPC]
			[WeaponRandomizerTargetWhitelist:MyObjectBuilder_LargeMissileTurret/ARYXSpartanTurret_NPC,MyObjectBuilder_LargeMissileTurret/GVK_AvengerGatlingTurret_NPC,MyObjectBuilder_LargeMissileTurret/ARYXHeavyFlakTurret_NPC,MyObjectBuilder_ConveyorSorter/missileBattery01_NPC,MyObjectBuilder_LargeMissileTurret/GVK_CycloneCannonTurret_NPC,MyObjectBuilder_ConveyorSorter/GVK_GriffinMissileTurret_NPC]
			</Description>
		</EntityComponent>
		<!-- TargetWhitlist blocks must be Public -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Manipulation-Small5x5StandardTurrets</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[ChangeTurretSettings:true]
			[TurretRange:3000]
			[TurretTargetNeutrals:false]
			[RandomizeWeapons:true]
			[IgnoreWeaponRandomizerTargetGlobalBlacklist:true]
			[IgnoreWeaponRandomizerTargetGlobalWhitelist:true]
			[WeaponRandomizerWhitelist:MyObjectBuilder_LargeGatlingTurret/SmallGatlingTurret_NPC,MyObjectBuilder_LargeMissileTurret/ReceptorTurret_NPC,MyObjectBuilder_LargeMissileTurret/SmallMissileTurret_NPC]
			[WeaponRandomizerTargetWhitelist:MyObjectBuilder_LargeGatlingTurret/SmallGatlingTurret_NPC,MyObjectBuilder_LargeMissileTurret/ReceptorTurret_NPC,MyObjectBuilder_LargeMissileTurret/SmallMissileTurret_NPC]
			</Description>
		</EntityComponent>
		<!-- Damage Reduction 0.25x -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-DamageModifier25</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[OverrideBlockDamageModifier:true]
			[BlockDamageModifier:25]
			</Description>
		</EntityComponent>
		<!-- Damage Reduction 0.5x -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-DamageModifier50</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[OverrideBlockDamageModifier:true]
			[BlockDamageModifier:50]
			</Description>
		</EntityComponent>
		<!-- Damage Reduction 0.75x -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Universal-Manipulation-DamageModifier75</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[OverrideBlockDamageModifier:true]
			[BlockDamageModifier:75]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Convoy Patrol Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Lead-Behavior-GaalsienCarrier</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[AutopilotData:GVK-Convoy-Autopilot-Lead-GaalsienCarrier]
			[TargetData:GVK-Universal-Target-EnemyGridsLongRange]
			[EscortOffsets:{X:300 Y:0 Z:300}]
			[EscortOffsets:{X:-300 Y:0 Z:-300}]
			[EscortOffsets:{X:0 Y:0 Z:400}]
			[EscortOffsets:{X:300 Y:0 Z:-300}]
			[EscortOffsets:{X:-300 Y:0 Z:300}]
			[EscortOffsets:{X:400 Y:0 Z:0}]
			[EscortOffsets:{X:-400 Y:0 Z:0}]
			[Triggers:GVK-Convoy-Trigger-Lead-GaalsienCarrier-Session]
			[Triggers:GVK-Convoy-Trigger-Lead-GaalsienCarrier-SpawnDefenses]
			[Triggers:GVK-Drone-All-Trigger-FireMissilesTimers]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:GVK-Convoy-Trigger-Lead-GaalsienCarrier-AssignEscortSlot]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-Convoy-Trigger-Lead-GaalsienCarrier-Despawn]
			[Triggers:GVK-Convoy-Trigger-Lead-GaalsienCarrier-DespawnMES]
			[Triggers:GVK-Convoy-Trigger-Lead-GaalsienCarrier-Compromised]
			[Triggers:GVK-Convoy-Trigger-Lead-SpawnFighters]
			[RemoteControlCode:ConvoyEncounter]
			</Description>
		</EntityComponent>
		<!-- Convoy Patrol Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Autopilot-Lead-GaalsienCarrier</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[RotationMultiplier:0.075]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.1]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:30]
			[MinimumPlanetAltitude:1]
			[AltitudeTolerance:30]
			[WaypointAbandonTimeTrigger:180]
			[WaypointTolerance:200]
			[IdealMinSpeed:20]
			[IdealMaxSpeed:30]
			[MaxSpeedTolerance:5]
			[SlowDownOnWaypointApproach:true]
			[ExtraSlowDownDistance:500]
			[WaypointWaitTimeTrigger:0]
			[OffsetPlanetMinDistFromTarget:3000]
			[OffsetPlanetMaxDistFromTarget:4000]
			[OffsetPlanetMinTargetAltitude:30]
			[OffsetPlanetMaxTargetAltitude:40]
			[UseSurfaceHoverThrustMode:false]
			[HoverPathStepDistance:201]
			[AngleAllowedForForwardThrust:179]
			[MaxVelocityAngleForSpeedControl:179]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Trigger-Lead-GaalsienCarrier-Session</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Session]
			[UseTrigger:true]
			[StartsReady:true]
			[Actions:GVK-Convoy-Action-Lead-GaalsienCarrier-Session]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Action-Lead-GaalsienCarrier-Session</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SetSandboxBooleansFalse:ConvoyInactive]
			[UseChatBroadcast:true]
			[ChatData:GVK-Convoy-Chat-Lead-GaalsienCarrier-Session]
			[GridEditable:No]
			[SubGridsEditable:No]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Chat-Lead-GaalsienCarrier-Session</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Coalition]
			[Color:White]
			[ChatMessages:A Gaalsien Convoy has been spotted near `{GPS}`]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:A Gaalsien Convoy has been spotted.]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Carrier to spawn initial defenses -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Trigger-Lead-GaalsienCarrier-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:5]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10000]
			[ActionExecution:All]
			[Actions:GVK-Convoy-Action-Lead-GaalsienCarrier-SpawnDefenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Action-Lead-GaalsienCarrier-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SpawnEncounter:true]
			[Spawner:GVK-Convoy-Spawner-Lead-GaalsienCarrier-SpawnDefenses]
			[UseChatBroadcast:false]
			[ChatData:GVK-Convoy-Chat-Lead-GaalsienCarrier-SpawnDefenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Spawner-Lead-GaalsienCarrier-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[UseRelativeSpawnPosition:false]
			[MinDistance:500]
			[MaxDistance:700]
			[MinAltitude:20]
			[MaxAltitude:30]
			[MaxSpawns:5]
			[InheritNpcAltitude:false]
			[SpawnGroups:GVK-Convoy-Escort-SpawnGroup-MediumHovers]
			[SpawnGroups:GVK-Convoy-Escort-SpawnGroup-LargeHovers]
			[ProcessAsAdminSpawn:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Chat-Lead-GaalsienCarrier-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Gaalsien Carrier]
			[Color:Red]
			[ChatMessages:Enemies in-bound.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Carrier to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Trigger-Lead-GaalsienCarrier-Despawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Despawn]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Convoy-Action-Lead-GaalsienCarrier-Despawn]
			[Actions:GVK-Convoy-Action-Lead-GaalsienCarrier-SendScatterCommand]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Trigger-Lead-GaalsienCarrier-DespawnMES</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:DespawnMES]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Convoy-Action-Lead-GaalsienCarrier-Despawn]
			[Actions:GVK-Convoy-Action-Lead-GaalsienCarrier-SendScatterCommand]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Action-Lead-GaalsienCarrier-Despawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:false]
			[EnableBlocks:true]
			[EnableBlockNames:HoverEngine]
			[EnableBlockStates:Off]
			[EnableBlockNames:Thruster]
			[EnableBlockStates:Off]
			[EnableBlockNames:Magnetic Plate]
			[EnableBlockStates:On]
			[UseChatBroadcast:true]
			[GenerateExplosion:true]
			[ExplosionRange:25]
			[ExplosionDamage:1]
			[ExplosionIgnoresVoxels:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-Convoy-Chat-Lead-GaalsienCarrier-Despawn]
			[SetSandboxBooleansTrue:ConvoyInactive]
			[GridEditable:Yes]
			[SubGridsEditable:Yes]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Chat-Lead-GaalsienCarrier-Despawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Coalition]
			[Color:White]
			[ChatMessages:The Gaalsien Convoy has left.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Trigger-Lead-GaalsienCarrier-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Convoy-Action-Lead-GaalsienCarrier-Compromised]
			[Actions:GVK-Convoy-Action-Lead-GaalsienCarrier-SendScatterCommand]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Action-Lead-GaalsienCarrier-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:false]
			[EnableBlocks:true]
			[EnableBlockNames:HoverEngine]
			[EnableBlockStates:Off]
			[EnableBlockNames:Thruster]
			[EnableBlockStates:Off]
			[EnableBlockNames:Magnetic Plate]
			[EnableBlockStates:On]
			[UseChatBroadcast:true]
			[GenerateExplosion:true]
			[ExplosionRange:25]
			[ExplosionDamage:1]
			[ExplosionIgnoresVoxels:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-Convoy-Chat-Lead-GaalsienCarrier-Compromised]
			[SetSandboxBooleansTrue:ConvoyInactive]
			[GridEditable:Yes]
			[SubGridsEditable:Yes]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Chat-Lead-GaalsienCarrier-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Coalition]
			[Color:White]
			[ChatMessages:The Gaalsien Convoy has been defeated!]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Carrier to receive the Drone's escort request command -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Trigger-Lead-GaalsienCarrier-AssignEscortSlot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:CommandReceived]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:-1]
			[CommandReceiveCode:GVK_Command_Lead_RequestEscortSlot]
			[Actions:GVK-Convoy-Action-Lead-GaalsienCarrier-AssignEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Action-Lead-GaalsienCarrier-AssignEscortSlot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[AssignEscortFromCommand:true]
			[UseChatBroadcast:false]
			[ChatData:GVK-Convoy-Chat-Lead-GaalsienCarrier-AssignEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Chat-Lead-GaalsienCarrier-AssignEscortSlot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Gaalsien Carrier]
			[Color:Red]
			[ChatMessages:Assigning an escort slot.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Carrier to disperse escorts when defeated -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Action-Lead-GaalsienCarrier-SendScatterCommand</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-Convoy-Command-Lead-GaalsienCarrier-SendScatterCommand]
			[UseChatBroadcast:true]
			[ChatData:GVK-Convoy-Chat-Lead-GaalsienCarrier-SendScatterCommand]
			[SetSandboxBooleansTrue:ConvoyInactive]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Command-Lead-GaalsienCarrier-SendScatterCommand</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[SingleRecipient:false]
			[MatchSenderReceiverOwners:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:5000]
			[CommandCode:GVK_Command_Escort_Scatter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Chat-Lead-GaalsienCarrier-SendScatterCommand</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Gaalsien Carrier]
			[Color:Red]
			[ChatMessages:Scattering Escorts.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for ProductionCruiser to spawn fighters -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Trigger-Lead-SpawnFighters</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:PlayerNear]
			[UseTrigger:true]
			[TargetDistance:3000]
			[StartsReady:true]
			[MaxActions:5]
			[MinCooldownMs:120000]
			[MaxCooldownMs:180000]
			[Actions:GVK-Convoy-Action-Lead-SpawnFighters]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Action-Lead-SpawnFighters</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SpawnEncounter:true]
			[Spawner:GVK-Convoy-Spawner-Lead-SpawnFighters]
			[UseChatBroadcast:true]
			[ChatData:GVK-Convoy-Chat-Lead-SpawnFighters]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Spawner-Lead-SpawnFighters</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[MinDistance:500]
			[MaxDistance:1000]
			[MinAltitude:100]
			[MaxAltitude:400]
			[InheritNpcAltitude:true]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-SmallFlyerSquad]
			[ProcessAsAdminSpawn:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Chat-Lead-SpawnFighters</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:false]
			[Author:Gaalsien Carrier]
			[Color:Red]
			[ChatMessages:Fighters Inbound.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
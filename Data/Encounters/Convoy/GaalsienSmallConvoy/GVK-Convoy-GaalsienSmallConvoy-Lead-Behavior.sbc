<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Convoy Patrol Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:CargoShip]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[AutopilotData:GVK-Convoy-GAALSIENSmallConvoy-Lead-Autopilot]
			[TargetData:GVK-Universal-Target-EnemyGridsLongRange]
			[EscortOffsets:{X:0 Y:0 Z:-250}]
			[EscortOffsets:{X:0 Y:0 Z:200}]
			[EscortOffsets:{X:0 Y:0 Z:-500}]
			[EscortOffsets:{X:0 Y:0 Z:400}]
			[Triggers:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-AddWaypoints]
			[Triggers:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-BeaconDisabled]
			[Triggers:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-Session]
			[Triggers:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-SpawnDefenses]
			[Triggers:GVK-Drone-All-Trigger-FireMissilesTimers]
			[Triggers:GVK-Universal-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-TargetAcquiredChatter-GAALSIEN]
			[Triggers:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-AssignEscortSlot]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-Despawn]
			[Triggers:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-DespawnMES]
			[Triggers:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-Compromised]
			[Triggers:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-SpawnFighters]
			[RemoteControlCode:ConvoyEncounter]
			BountyOnKill=10000000;
			</Description>
		</EntityComponent>
		<!-- Convoy Patrol Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Autopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[RotationMultiplier:8]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.25]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:30]
			[MinimumPlanetAltitude:1]
			[AltitudeTolerance:30]
			[WaypointAbandonTimeTrigger:9999999]
			[WaypointTolerance:200]
			[IdealMinSpeed:30]
			[IdealMaxSpeed:40]
			[MaxSpeedTolerance:5]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:500]
			[WaypointWaitTimeTrigger:0]
			[OffsetPlanetMinDistFromTarget:3000]
			[OffsetPlanetMaxDistFromTarget:4000]
			[OffsetPlanetMinTargetAltitude:30]
			[OffsetPlanetMaxTargetAltitude:40]
			[UseSurfaceHoverThrustMode:false]
			[HoverPathStepDistance:201]
			[AngleAllowedForForwardThrust:70]
			[MaxVelocityAngleForSpeedControl:1000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-Session</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Session]
			[UseTrigger:true]
			[StartsReady:true]
			[Actions:GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-Session]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-Session</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Convoy-GAALSIENSmallConvoy-Lead-Chat-Session]
			[GridEditable:No]
			[SubGridsEditable:No]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Chat-Session</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:{Faction}]
			[Color:{PlayerRelation}]
			[ChatMessages:A GAALSIEN Convoy has been spotted in Zone 2.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:A GAALSIEN Convoy has been spotted.]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger to add waypoints after spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-AddWaypoints</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:2]
			[MinCooldownMs:3000]
			[MaxCooldownMs:3001]
			[ActionExecution:All]
			[Actions:GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-AddWaypoints]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-AddWaypoints</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[AddWaypoints:true]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD01]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD02]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD03]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD04]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD05]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD06]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD07]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD08]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD09]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD10]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD11]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD12]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD13]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD14]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD15]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD16]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD17]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD18]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD19]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD20]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD21]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD22]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD23]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD24]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD25]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD26]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD27]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD28]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD29]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD30]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD31]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD32]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD33]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD34]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD35]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD36]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD37]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD38]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD39]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD40]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD41]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD42]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD43]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD44]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD45]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD46]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD47]
			[WaypointsToAdd:GVK-Convoy-Waypoint-LandRouteD48]
			[UseChatBroadcast:false]
			[ChatData:GVK-Convoy-GAALSIENSmallConvoy-Lead-Chat-AddWaypoints]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Chat-AddWaypoints</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Land Cargo Ship]
			[Color:White]
			[ChatMessages:Adding waypoints.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Carrier to spawn initial defenses -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:2]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10000]
			[ActionExecution:All]
			[Actions:GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-SpawnDefenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SpawnEncounter:true]
			[Spawner:GVK-Convoy-GAALSIENSmallConvoy-Lead-Spawner-SpawnEscorts]
			[Spawner:GVK-Convoy-GAALSIENSmallConvoy-Lead-Spawner-SpawnSalvagers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Spawner-SpawnEscorts</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[UseRelativeSpawnPosition:false]
			[MinDistance:500]
			[MaxDistance:700]
			[MinAltitude:20]
			[MaxAltitude:30]
			[MaxSpawns:1]
			[InheritNpcAltitude:false]
			[SpawnGroups:GVK-Convoy-Escort-SpawnGroup-MediumHovers]
			[ProcessAsAdminSpawn:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Spawner-SpawnSalvagers</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[UseRelativeSpawnPosition:false]
			[MinDistance:500]
			[MaxDistance:700]
			[MinAltitude:20]
			[MaxAltitude:30]
			[MaxSpawns:2]
			[InheritNpcAltitude:false]
			[SpawnGroups:GVK-Convoy-Escort-SpawnGroup-Salvagers]
			[ProcessAsAdminSpawn:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Carrier to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-Despawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Despawn]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-SendScatterCommand]
			[Actions:GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-Despawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-DespawnMES</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:DespawnMES]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-SendScatterCommand]
			[Actions:GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-Despawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-Despawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Convoy-GAALSIENSmallConvoy-Lead-Chat-Despawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Chat-Despawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:{Faction}]
			[Color:{PlayerRelation}]
			[ChatMessages:The GAALSIEN Convoy has reached its desitnation.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-SendScatterCommand]
			[Actions:GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-Compromised]
			[Actions:GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-Disabled]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-LargeBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Convoy-GAALSIENSmallConvoy-Lead-Chat-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-Disabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-Compromised]			
			[DisableTriggerNames:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-BeaconDisabled]
			[DisableTriggerNames:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-Despawn]
			[DisableTriggerNames:GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-DespawnMES]
			[GridEditable:Yes]
			[SubGridsEditable:Yes]
			[ForceDespawn:false]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:false]
			[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Chat-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:{Faction}]
			[Color:{PlayerRelation}]
			[ChatMessages:The GAALSIEN Convoy has been defeated!]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Carrier to receive the Drone's escort request command -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Trigger-AssignEscortSlot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:CommandReceived]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:-1]
			[CommandReceiveCode:GVK_Command_Lead_RequestEscortSlot]
			[Actions:GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-AssignEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-AssignEscortSlot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[AssignEscortFromCommand:true]
			[UseChatBroadcast:false]
			[ChatData:GVK-Convoy-GAALSIENSmallConvoy-Lead-Chat-AssignEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Chat-AssignEscortSlot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:GAALSIEN Production Cruiser]
			[Color:Red]
			[ChatMessages:Assigning an escort slot.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Carrier to disperse escorts when defeated -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Action-SendScatterCommand</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:GVK-Convoy-GAALSIENSmallConvoy-Lead-Command-SendScatterCommand]
			[UseChatBroadcast:true]
			[ChatData:GVK-Convoy-GAALSIENSmallConvoy-Lead-Chat-SendScatterCommand]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Command-SendScatterCommand</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[SingleRecipient:false]
			[MatchSenderReceiverOwners:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:5000]
			[CommandCode:GVK_Command_Escort_Scatter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GAALSIENSmallConvoy-Lead-Chat-SendScatterCommand</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:GAALSIEN Production Cruiser]
			[Color:Red]
			[ChatMessages:Scattering Escorts.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for ProductionCruiser to spawn fighters -->

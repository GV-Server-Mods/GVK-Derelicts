<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Lead-SpawnCondition-GAALSIENCarrier</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[FactionOwner:GAALSIEN]
			[ReactorsOn:true]
			[ForceStaticGrid:false]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:true]
			[SkipAirDensityCheck:true]
			[UsePlayerCountCheck:true]
			[PlayerCountCheckRadius:50000]
			[MinimumPlayers:10]
			[MaximumPlayers:999]
			[UseRemoteControlCodeRestrictions:true]
			[RemoteControlCode:ConvoyEncounter]
			[RemoteControlCodeMinDistance:999999]
			[RemoteControlCodeMaxDistance:-1]
			[SandboxVariables:LargeWrecksEnabled]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
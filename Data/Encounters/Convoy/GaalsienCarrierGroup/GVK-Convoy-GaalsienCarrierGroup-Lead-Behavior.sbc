		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Chat-AddWaypoints</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Land Cargo Ship]
			[Color:White]
			[ChatMessages:Adding waypoints.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Carrier to spawn initial defenses -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Trigger-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:5]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10000]
			[ActionExecution:All]
			[Actions:GVK-Convoy-GaalsienCarrier-Lead-Action-SpawnDefenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Action-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:100]
			[SpawnEncounter:true]
			[Spawner:GVK-Convoy-GaalsienCarrier-Lead-Spawner-SpawnDefenses]
			[UseChatBroadcast:false]
			[ChatData:GVK-Convoy-GaalsienCarrier-Lead-Chat-SpawnDefenses]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Spawner-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[UseRelativeSpawnPosition:false]
			[MinDistance:500]
			[MaxDistance:700]
			[MinAltitude:20]
			[MaxAltitude:30]
			[MaxSpawns:5]
			[InheritNpcAltitude:false]
			[SpawnGroups:GVK-Convoy-Escort-SpawnGroup-MediumHovers]
			[SpawnGroups:GVK-Convoy-Escort-SpawnGroup-LargeHovers]
			[ProcessAsAdminSpawn:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Chat-SpawnDefenses</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Gaalsien Carrier]
			[Color:Red]
			[ChatMessages:Enemies in-bound.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Carrier to die -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Trigger-Despawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Despawn]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Convoy-GaalsienCarrier-Lead-Action-SendScatterCommand]
			[Actions:GVK-Convoy-GaalsienCarrier-Lead-Action-Despawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Trigger-DespawnMES</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:DespawnMES]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Convoy-GaalsienCarrier-Lead-Action-SendScatterCommand]
			[Actions:GVK-Convoy-GaalsienCarrier-Lead-Action-Despawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Action-Despawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Convoy-GaalsienCarrier-Lead-Chat-Despawn]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Chat-Despawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Coalition]
			[Color:White]
			[ChatMessages:The Gaalsien Convoy has left.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Convoy-GaalsienCarrier-Lead-Action-SendScatterCommand]
			[Actions:GVK-Convoy-GaalsienCarrier-Lead-Action-Compromised]
			[Actions:GVK-Convoy-GaalsienCarrier-Lead-Action-Disabled]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-LargeBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Action-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Convoy-GaalsienCarrier-Lead-Chat-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Action-Disabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[StopAllRotation:true]
			[StopAllThrust:true]
			[EnableBlocks:true]
			[EnableBlockNames:Magnetic Plate]
			[EnableBlockStates:On]
			[GenerateExplosion:false]
			[ExplosionRange:31]
			[ExplosionDamage:1]
			[ExplosionIgnoresVoxels:true]
			[RazeBlocksOfType:true]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/ZoneBlock]
			[RazeBlocksTypes:MyObjectBuilder_RemoteControl/RivalAIRemoteControlLarge]
			[RazeBlocksTypes:MyObjectBuilder_RemoteControl/RivalAIRemoteControlSmall]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/ZoneBlock]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/SmallBlockBeacon]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/LargeBlockBeacon]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/SmallBlockBeacon_NPCNoConceal]
			[RazeBlocksTypes:MyObjectBuilder_Beacon/LargeBlockBeacon_NPCNoConceal]
			[ToggleBlocksOfType:true]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/ZoneBlock]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconSmall]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/DisposableNpcBeaconLarge]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/SmallBlockBeacon]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/LargeBlockBeacon]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/LargeBlockBeacon_NPCNoConceal]
			[BlockTypeToggles:Off]
			[BlockTypesToToggle:MyObjectBuilder_Beacon/SmallBlockBeacon_NPCNoConceal]
			[BlockTypeToggles:Off]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Convoy-GaalsienCarrier-Lead-Trigger-Compromised]			
			[DisableTriggerNames:GVK-Convoy-GaalsienCarrier-Lead-Trigger-BeaconDisabled]
			[DisableTriggerNames:GVK-Convoy-GaalsienCarrier-Lead-Trigger-Despawn]
			[DisableTriggerNames:GVK-Convoy-GaalsienCarrier-Lead-Trigger-DespawnMES]
			[GridEditable:Yes]
			[SubGridsEditable:Yes]
			[ForceDespawn:false]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:false]
			[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Chat-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:Coalition]
			[Color:White]
			[ChatMessages:The Gaalsien Convoy has been defeated!]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Carrier to receive the Drone's escort request command -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Trigger-AssignEscortSlot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:CommandReceived]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:-1]
			[CommandReceiveCode:GVK_Command_Lead_RequestEscortSlot]
			[Actions:GVK-Convoy-GaalsienCarrier-Lead-Action-AssignEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Action-AssignEscortSlot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]

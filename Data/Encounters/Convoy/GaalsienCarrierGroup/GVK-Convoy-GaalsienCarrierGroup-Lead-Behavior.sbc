<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Convoy Patrol Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:CargoShip]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[AutopilotData:GVK-Convoy-GaalsienCarrier-Lead-Autopilot]
			[TargetData:GVK-Universal-Target-EnemyGridsLongRange]
			[EscortOffsets:{X:0 Y:0 Z:-450}]
			[EscortOffsets:{X:0 Y:0 Z:300}]
			[EscortOffsets:{X:0 Y:0 Z:-700}]
			[EscortOffsets:{X:0 Y:0 Z:600}]
			[EscortOffsets:{X:150 Y:0 Z:-100}]
			[EscortOffsets:{X:-150 Y:0 Z:-100}]
			[Triggers:GVK-Convoy-GaalsienCarrier-Lead-Trigger-AddWaypoints]
			[Triggers:GVK-Convoy-GaalsienCarrier-Lead-Trigger-BeaconDisabled]
			[Triggers:GVK-Convoy-GaalsienCarrier-Lead-Trigger-Session]
			[Triggers:GVK-Convoy-GaalsienCarrier-Lead-Trigger-SpawnDefenses]
			[Triggers:GVK-Drone-All-Trigger-FireMissilesTimers]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:GVK-Convoy-GaalsienCarrier-Lead-Trigger-AssignEscortSlot]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-Convoy-GaalsienCarrier-Lead-Trigger-Despawn]
			[Triggers:GVK-Convoy-GaalsienCarrier-Lead-Trigger-DespawnMES]
			[Triggers:GVK-Convoy-GaalsienCarrier-Lead-Trigger-Compromised]
			[Triggers:GVK-Convoy-GaalsienCarrier-Lead-Trigger-SpawnFighters]
			[RemoteControlCode:ConvoyEncounter]
			BountyOnKill=20000000;
			</Description>
		</EntityComponent>
		<!-- Convoy Patrol Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Autopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[RotationMultiplier:0.075]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.1]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:30]
			[MinimumPlanetAltitude:1]
			[AltitudeTolerance:30]
			[WaypointAbandonTimeTrigger:180]
			[WaypointTolerance:200]
			[IdealMinSpeed:20]
			[IdealMaxSpeed:30]
			[MaxSpeedTolerance:5]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:500]
			[WaypointWaitTimeTrigger:0]
			[UseSurfaceHoverThrustMode:false]
			[HoverPathStepDistance:201]
			[AngleAllowedForForwardThrust:179]
			[MaxVelocityAngleForSpeedControl:179]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Trigger-Session</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Session]
			[UseTrigger:true]
			[StartsReady:true]
			[Actions:GVK-Convoy-GaalsienCarrier-Lead-Action-Session]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Action-Session</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Convoy-GaalsienCarrier-Lead-Chat-Session]
			[GridEditable:No]
			[SubGridsEditable:No]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Chat-Session</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Coalition]
			[Color:White]
			[ChatMessages:A Gaalsien Carrier Group has been spotted in Zone 3.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[ChatMessages:A Gaalsien Convoy has been spotted.]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger to add waypoints after spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Trigger-AddWaypoints</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:2]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[ActionExecution:All]
			[Actions:GVK-Convoy-GaalsienCarrier-Lead-Action-AddWaypoints]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-GaalsienCarrier-Lead-Action-AddWaypoints</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[AddWaypoints:true]
			[WaypointsToAdd:GVK-Convoy-StaticRandom-LandRouteC02]

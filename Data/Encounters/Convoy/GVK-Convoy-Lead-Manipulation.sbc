<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Convoy-Lead-Manipulation-GaalsienCarrier</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[ClearAuthorship:true]
			[EraseIngameScripts:true]
			[IgnoreGlobalBlockReplacer:false]
			[ClearGridInventories:true]
			[DisableBlocksWithName:Survival,Blood]
			[AllowPartialNames:true]
			[UseLootProfiles:true]
			[LootProfiles:GVK-Universal-Loot-Huge]
			[UseRivalAi:true]
			[RivalAiReplaceRemoteControl:true]
			[UseBlockReplacerProfile:true]
			[BlockReplacerProfileNames:GVK-Replacer-NPCWeapons]
			[BlockReplacerProfileNames:GVK-Replacer-NPCHovers]
			[BlockReplacerProfileNames:GVK-Replacer-LargeCockpitToRivalAI]
			[BlockReplacerProfileNames:MES-Armor-LightToHeavy]
			[ConfigureSpecialNpcThrusters:true]
			[RestrictNpcIonThrust:true]
			[NpcIonThrustForceMultiply:5]
			[NpcIonThrustPowerMultiply:0.0001]
			[RestrictNpcAtmoThrust:true]
			[NpcAtmoThrustForceMultiply:5]
			[NpcAtmoThrustPowerMultiply:0.0001]
			[RestrictNpcHydroThrust:true]
			[NpcHydroThrustForceMultiply:5]
			[NpcHydroThrustPowerMultiply:0.000001]
			[DisableGyroOverride:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
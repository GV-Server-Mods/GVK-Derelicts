<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Manipulation-Flyer</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[ClearAuthorship:true]
			[EraseIngameScripts:true]
			[IgnoreGlobalBlockReplacer:false]
			[ClearGridInventories:true]
			[DisableBlocksWithName:Survival]
			[AllowPartialNames:true]
			[UseLootProfiles:true]
			[LootProfiles:GVK-Universal-Loot-Medium]
			[LootProfiles:GVK-Universal-Loot-Freight]
			[LootProfiles:GVK-Universal-Loot-H2Generator]
			[LootProfiles:GVK-Universal-Loot-Assembler]
			[LootProfiles:GVK-Universal-Loot-Refinery]
			[LootProfiles:GVK-Universal-Loot-Cockpit]
			[LootProfiles:GVK-Universal-Loot-Armory]
			[LootProfiles:GVK-Universal-Loot-LivingArea]
			[DisableGyroOverride:true]
			[UseBlockReplacerProfile:true]
			[BlockReplacerProfileNames:GVK-Replacer-LargeCockpitToRivalAI]
			[BlockReplacerProfileNames:MES-Armor-LightToHeavy]
			[ConfigureSpecialNpcThrusters:true]
			[RestrictNpcIonThrust:true]
			[NpcIonThrustForceMultiply:1.5]
			[NpcIonThrustPowerMultiply:0.00001]
			[RestrictNpcAtmoThrust:true]
			[NpcAtmoThrustForceMultiply:7]
			[NpcAtmoThrustPowerMultiply:0.00001]
			[RestrictNpcHydroThrust:true]
			[NpcHydroThrustForceMultiply:7]
			[NpcHydroThrustPowerMultiply:0.000001]
			[UseGridDereliction:true]
			[DerelictionProfiles:GVK-Universal-Dereliction-ProgrammableBlocks-NonFunctional]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>

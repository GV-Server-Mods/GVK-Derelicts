<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- This spawns 2 small flyers ONLY in Z3 -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Defense-SpawnCondition-COALITION-LAV</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[RivalAiAtmosphericSpawn:true]
			[FactionOwner:COALITION]
			[ReactorsOn:true]
			[ForceStaticGrid:false]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:true]
			[ZoneConditions:GVK-Universal-ZoneConditions-WreckZone123]
 			[PrefabSpawningMode:All]
			[PrefabOffsetOverrides:{X:25 Y:0 Z:0}]
			[PrefabOffsetOverrides:{X:-25 Y:0 Z:0}]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Defense-SpawnCondition-COALITION-SmallFlyerSquad</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[RivalAiAtmosphericSpawn:true]
			[FactionOwner:COALITION]
			[ReactorsOn:true]
			[ForceStaticGrid:false]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:true]
			[ZoneConditions:GVK-Universal-ZoneConditions-WreckZone3Only]
 			[PrefabSpawningMode:All]
			[PrefabFixedCount:2]
			[PrefabOffsetOverrides:{X:25 Y:100 Z:0}]
			[PrefabOffsetOverrides:{X:-25 Y:100 Z:0}]
			</Description>
		</EntityComponent>
		<!-- This spawns 1 Medium flyer in Z23 -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Defense-SpawnCondition-COALITION-MediumFlyerSingle</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[RivalAiAtmosphericSpawn:true]
			[FactionOwner:COALITION]
			[ReactorsOn:true]
			[ForceStaticGrid:false]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:true]
			[ZoneConditions:GVK-Universal-ZoneConditions-WreckZone123]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Defense-SpawnCondition-COALITION-MediumRoverSingle</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[RivalAiAtmosphericSpawn:true]
			[FactionOwner:COALITION]
			[ReactorsOn:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:false]
 			[PrefabSpawningMode:Random]
			[ZoneConditions:GVK-Universal-ZoneConditions-WreckZone123]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Defense-SpawnCondition-COALITION-LargeRoverSingle</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[RivalAiAtmosphericSpawn:true]
			[FactionOwner:COALITION]
			[ReactorsOn:true]
			[SkipVoxelSpawnChecks:true]
			[SkipGridSpawnChecks:true]
 			[PrefabSpawningMode:Random]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea01]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea02]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea03]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea05]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea04]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea06]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea07]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea08]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea09]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea10]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea11]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea12]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea13]
			[ZoneConditions:GVK-Universal-ZoneConditions-COALITIONArea14]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
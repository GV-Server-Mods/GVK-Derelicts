<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- MediumHoverHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-MediumHoverPatrolHorsefly-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:false]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[AutopilotData:GVK-Drone-All-Autopilot-MediumHoverPatrolHorsefly-Passive]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-MediumHoverPatrolHorsefly-Aggressive]
			[Triggers:GVK-Drone-All-Trigger-Init-MediumHoverPatrolHorsefly-GAALSIEN]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-DroneDefaults-MediumDrone-GAALSIEN]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorseflyKPL]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveDefenseHeartbeat]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-ConvoySystem-Escort-TriggerGroup]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-Init-MediumHoverPatrolHorsefly-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-Init-MediumHoverPatrolHorsefly-GAALSIEN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-Init-MediumHoverPatrolHorsefly-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,DroneMedium]
			[CustomStrings:EncounterDisplayName,craft]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
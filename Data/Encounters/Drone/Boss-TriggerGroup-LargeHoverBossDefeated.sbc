<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-TriggerGroup-LargeHoverBossDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Boss-ManualTrigger-LargeHoverBossDefeated]
			[Triggers:GVK-Boss-Trigger-LargeHoverBossCompromised]			
			[Triggers:GVK-Boss-Trigger-LargeHoverBossBeaconDisabled]			
			</Description>
		</EntityComponent>
		<!-- Manual Trigger sequence Large NPC is defeated through Compromised, Beacon -->
		<!-- Manual is used to prevent multiple different defeated actions running at the same time -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-ManualTrigger-LargeHoverBossDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Manual]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Boss-Action-LargeHoverBossDefeated]
			[Actions:GVK-Universal-Action-LargeBlueExplosionEffects]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-Action-LargeHoverBossDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Boss-Chat-LargeHoverBossDefeated]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Boss-Trigger-LargeHoverBossCompromised]			
			[DisableTriggerNames:GVK-Boss-Trigger-LargeHoverBossBeaconDisabled]			
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-Chat-LargeHoverBossDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Elite Cruiser destroyed!]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- shared action since compromised/nobeacon/noweapon would be identical -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-Action-ManualTriggerLargeHoverBossDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Boss-ManualTrigger-LargeHoverBossDefeated]
			[ForceManualTriggerActivation:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Large NPC RAI Remote is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-Trigger-LargeHoverBossCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Boss-Action-ManualTriggerLargeHoverBossDefeated]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Large NPC Beacon is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Boss-Trigger-LargeHoverBossBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Boss-Action-ManualTriggerLargeHoverBossDefeated]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
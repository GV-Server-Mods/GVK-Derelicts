<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallHoverHorseFighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-SmallHoverHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UseStaticGuns:true]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[HorseFighterTimeApproaching:10]
			[HorseFighterTimeEngaging:10]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[AutopilotData:GVK-Drone-All-Autopilot-SmallHoverHorseFighter-Patrol]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-SmallHoverHorseFighter-HorseFighter]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[TriggerGroups:GVK-Drone-Encounter-TriggerGroup-InactivityRetreat]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorseFighter]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-SmallHoverDefeated]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
		<!-- SmallHoverHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-SmallHoverHorseFighter-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:5]
			[MinimumPlanetAltitude:3]
			[AltitudeTolerance:10]
			[WaypointTolerance:50]
			[RamMinDurationMs:0]
			[RamMaxDurationMs:0]
			[IdealMinSpeed:39]
			[IdealMaxSpeed:40]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:200]
			[OffsetPlanetMinDistFromTarget:400]
			[OffsetPlanetMaxDistFromTarget:700]
			[OffsetPlanetMinTargetAltitude:3]
			[OffsetPlanetMaxTargetAltitude:4]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:10]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1500]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:0]
			[StrafeMaxCooldownMs:1]
			[StrafeSpeedCutOff:75]	
			[StrafeMinimumTargetDistance:500]
			[StrafeMinimumSafeAngleFromTarget:25]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- SmallHoverHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-SmallHoverHorseFighter-HorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:5]
			[MinimumPlanetAltitude:3]
			[AltitudeTolerance:10]
			[WaypointTolerance:50]
			[RamMinDurationMs:6000]
			[RamMaxDurationMs:6001]
			[IdealMinSpeed:40]
			[IdealMaxSpeed:120]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:200]
			[OffsetPlanetMinDistFromTarget:400]
			[OffsetPlanetMaxDistFromTarget:700]
			[OffsetPlanetMinTargetAltitude:3]
			[OffsetPlanetMaxTargetAltitude:4]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:30]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1500]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:0]
			[StrafeMaxCooldownMs:1]
			[StrafeSpeedCutOff:75]	
			[StrafeMinimumTargetDistance:500]
			[StrafeMinimumSafeAngleFromTarget:25]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
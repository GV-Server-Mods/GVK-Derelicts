<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Honorguard Cruiser Fighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-HonorguardCruiserFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Fighter]
			[UseVelocityCollisionEvasion:true]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[HorseFighterTimeApproaching:30]
			[HorseFighterTimeEngaging:30]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[AutopilotData:GVK-Drone-All-Autopilot-HonorguardCruiserPrimary]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-HonorguardCruiserSecondary]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Drone-All-Trigger-FireRailgunsTimers]
			[Triggers:GVK-Drone-All-Trigger-FireMissilesTimers]
			[Triggers:GVK-Universal-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:GVK-Drone-All-Trigger-CruiserCrashed]
			[Triggers:GVK-Drone-All-Trigger-CruiserCompromised]
			[Triggers:GVK-Universal-Trigger-SPRTNoWeapon]
			[Triggers:GVK-Drone-All-Trigger-HonorguardCruiserSecondaryAutopilot]
			[Triggers:GVK-Drone-All-Trigger-HonorguardCruiserPrimaryAutopilot]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-Drone-All-Trigger-Crashed]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatNoTarget]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatTimer]
			</Description>
		</EntityComponent>
		<!-- Honorguard Cruiser Fighter Autopilot Primary -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-HonorguardCruiserPrimary</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseProjectileLeadPrediction:true]
			[RotationMultiplier:1]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:2]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:15]
			[IdealMinSpeed:30]
			[IdealMaxSpeed:50]
			[PadDistanceFromTarget:400]
			[EngageDistancePlanet:800]
			[DisengageDistancePlanet:800]
			[AllowStrafing:true]
			[StrafeMinDurationMs:10000]
			[StrafeMaxDurationMs:30000]
			[StrafeDistanceCutOff:500]	
			[StrafeMinimumTargetDistance:400]
			[StrafeMinimumSafeAngleFromTarget:45]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Honorguard Cruiser Fighter Autopilot Secondary -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-HonorguardCruiserSecondary</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseProjectileLeadPrediction:true]
			[RotationMultiplier:1]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:2]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:15]
			[IdealMinSpeed:30]
			[IdealMaxSpeed:50]
			[PadDistanceFromTarget:400]
			[EngageDistancePlanet:800]
			[DisengageDistancePlanet:800]
			[AllowStrafing:true]
			[StrafeMinDurationMs:10000]
			[StrafeMaxDurationMs:30000]
			[StrafeDistanceCutOff:500]	
			[StrafeMinimumTargetDistance:400]
			[StrafeMinimumSafeAngleFromTarget:45]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Action group switch to secondary autopilot when strafing -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-HonorguardCruiserSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[TargetDistance:2000]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[StartsReady:true]
			[ConditionCheckResetsTimer:false]
			[Conditions:GVK-Drone-All-Condition-HonorguardCruiserSecondaryAutopilot]
			[Actions:GVK-Drone-All-Action-HonorguardCruiserSecondaryAutopilot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-HonorguardCruiserSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckTargetAngleFromForward:true]
			[MinTargetAngle:0]
			[MaxTargetAngle:6]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-HonorguardCruiserSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[UseChatBroadcast:false]
			[ChatData:GVK-Drone-All-Chat-HonorguardCruiserSecondaryAutopilot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-HonorguardCruiserSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:true]
			[Author:COALITION]
			[Color:White]
			[ChatMessages:Secondary Autopilot]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-HonorguardCruiserPrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[TargetDistance:2000]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[StartsReady:true]
			[ConditionCheckResetsTimer:false]
			[Conditions:GVK-Drone-All-Condition-HonorguardCruiserPrimaryAutopilot]
			[Actions:GVK-Drone-All-Action-HonorguardCruiserPrimaryAutopilot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-HonorguardCruiserPrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckTargetAngleFromForward:true]
			[MinTargetAngle:7]
			[MaxTargetAngle:180]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-HonorguardCruiserPrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			[UseChatBroadcast:false]
			[ChatData:GVK-Drone-All-Chat-HonorguardCruiserPrimaryAutopilot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-HonorguardCruiserPrimaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:true]
			[Author:COALITION]
			[Color:White]
			[ChatMessages:Primary Autopilot]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Honorguard Cruiser Fighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-HonorguardCruiserFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[HorseFighterTimeApproaching:30]
			[HorseFighterTimeEngaging:30]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[AutopilotData:GVK-Drone-All-Autopilot-HoverCruiserHorsefly-Passive]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-HonorguardCruiser-Aggressive]
			[TertiaryAutopilotData:GVK-Drone-All-Autopilot-HonorguardCruiser-Tertiary]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-GAALSIEN-TargetAcquiredChatter]
			[Triggers:GVK-Universal-Trigger-JetpackInhibitor]
			[Triggers:GVK-Drone-Encounter-Trigger-SpawnAnyCOALITIONAttackers]
			[TriggerGroups:GVK-Drone-Encounter-TriggerGroup-InactivityRetreat]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-AimAtTargetAngle]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolFighter]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-LargeHoverDefeated]
			[WeaponSystem:GVK-Universal-Weapons-Static06]
			BountyOnKill=3000000;
			</Description>
		</EntityComponent>
		<!-- Honorguard Cruiser Fighter Autopilot Primary -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-HonorguardCruiser-Aggressive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[UseProjectileLeadPrediction:false]
			[RotationMultiplier:1]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:2]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:15]
			[AltitudeTolerance:20]
			[IdealMinSpeed:30]
			[IdealMaxSpeed:50]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1000]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:1]
			[StrafeMaxCooldownMs:2]
			[StrafeSpeedCutOff:50]
			[StrafeDistanceCutOff:500]	
			[StrafeMinimumTargetDistance:400]
			[StrafeMinimumSafeAngleFromTarget:25]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Honorguard Cruiser Fighter Autopilot Secondary -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-HonorguardCruiser-Tertiary</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[UseProjectileLeadPrediction:false]
			[RotationMultiplier:1]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:2]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:15]
			[AltitudeTolerance:20]
			[IdealMinSpeed:30]
			[IdealMaxSpeed:100]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1000]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:1]
			[StrafeMaxCooldownMs:2]
			[StrafeSpeedCutOff:50]
			[StrafeDistanceCutOff:500]	
			[StrafeMinimumTargetDistance:400]
			[StrafeMinimumSafeAngleFromTarget:25]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
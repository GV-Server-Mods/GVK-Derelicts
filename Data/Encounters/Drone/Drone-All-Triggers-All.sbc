<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Action group to do a barrel roll -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-BarrelRoll</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[DamageTypes:Any]
			[MinCooldownMs:30000]
			[MaxCooldownMs:60000]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:GVK-Drone-All-Action-BarrelRoll]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-BarrelRoll</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[BarrelRoll:true]
			</Description>
		</EntityComponent>
		<!-- Action group to engage enemy upon taking damage -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-TargetAttacker</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[StartsReady:true]
			[MinCooldownMs:30000]
			[MaxCooldownMs:30000]
			[DamageTypes:Any]
			[Actions:GVK-Drone-All-Action-TargetAttacker]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-TargetAttacker</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SwitchToReceivedTarget:true]
			</Description>
		</EntityComponent>
		<!-- Action group to engage enemy when turret has a target -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-TurretTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TurretTarget]
			[StartsReady:true]
			[MinCooldownMs:30000]
			[MaxCooldownMs:30000]
			[DamageTypes:Any]
			[Actions:GVK-Drone-All-Action-TurretTarget]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-TurretTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SwitchToReceivedTarget:true]
			</Description>
		</EntityComponent>
		<!-- Action group to set turrets to max range because of a bug in MES right now -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-WeaponsToMaxRange</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:false]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[Actions:GVK-Drone-All-Action-WeaponsToMaxRange]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-WeaponsToMaxRange</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SetWeaponsToMaxRange:true]
			</Description>
		</EntityComponent>
		<!-- Action group to fire Fixed Rocket Timer Blocks because of a bug in WC2 right now -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-FireRocketsTimers</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[TargetDistance:1000]
			[Conditions:GVK-Drone-All-Condition-FireRocketsTimers]
			[Actions:GVK-Drone-All-Action-FireRocketsTimers]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-FireRocketsTimers</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckTargetAngleFromForward:true]
			[MinTargetAngle:0]
			[MaxTargetAngle:15]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-FireRocketsTimers</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[TriggerTimerBlocks:True]
			[TimerBlockNames:Timer Block Rockets]
			</Description>
		</EntityComponent>
		<!-- Action group to fire Archer Pods via Timer because of a bug in WC2 right now -->

<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- COALITION Strike Fighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-COALITIONStrikeFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UseStaticGuns:true]
			[UseTurrets:false]
			[MaxStaticWeaponRange:2000]
			[WeaponMaxAngleFromTarget:90]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:20]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[HorseFighterTimeApproaching:10]
			[HorseFighterTimeEngaging:10]
			[TargetData:GVK-Universal-Target-EnemyGAALSIENBeacon]
			[AutopilotData:GVK-Drone-All-Autopilot-COALITIONStrikeFighter-Patrol]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-COALITIONStrikeFighter-Strike]
			[Triggers:GVK-Drone-All-Trigger-BarrelRoll]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-COALITION-TargetAcquiredChatter]
			[Triggers:GVK-Universal-Trigger-COALITION-NoTargetsChatter]
			[Triggers:GVK-Drone-Encounter-Trigger-SpawnSmallGAALSIENAttackers]
			[TriggerGroups:GVK-Drone-Encounter-TriggerGroup-InactivityRetreat]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolStrike]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-SmallCOALITIONFlyerDefeated]
			</Description>
		</EntityComponent>
		<!-- SmallFlyerHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-COALITIONStrikeFighter-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[WaypointAbandonTimeTrigger:15]
			[RotationMultiplier:0.25]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:1]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:200]
			[MinimumPlanetAltitude:200]
			[AltitudeTolerance:50]
			[WaypointTolerance:150]
			[RamMinDurationMs:0]
			[RamMaxDurationMs:0]
			[IdealMinSpeed:49]
			[IdealMaxSpeed:50]
			[BarrelRollMinDurationMs:0]
			[BarrelRollMaxDurationMs:0]
			[OffsetPlanetMinDistFromTarget:1000]
			[OffsetPlanetMaxDistFromTarget:1001]
			[OffsetPlanetMinTargetAltitude:250]
			[OffsetPlanetMaxTargetAltitude:300]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- SmallFlyerHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-COALITIONStrikeFighter-Strike</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[StrikeBeginPlanetAttackRunDistance:100]
			[StrikeBreakawayDistance:700]
			[StrikeOffsetRecalculationTime:30]
			[StrikeEngageUseSafePlanetPathing:false]
			[StrikeEngageUseCollisionEvasion:false]
			[WaypointAbandonTimeTrigger:60]
			[RotationMultiplier:1]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:1]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:500]
			[MinimumPlanetAltitude:150]
			[AltitudeTolerance:10]
			[WaypointTolerance:200]
			[RamMinDurationMs:6000]
			[RamMaxDurationMs:6001]
			[IdealMinSpeed:50]
			[IdealMaxSpeed:130]
			[BarrelRollMinDurationMs:3000]
			[BarrelRollMaxDurationMs:5001]
			[OffsetPlanetMinDistFromTarget:1700]
			[OffsetPlanetMaxDistFromTarget:2001]
			[OffsetPlanetMinTargetAltitude:-100]
			[OffsetPlanetMaxTargetAltitude:100]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallFlyer-Interceptor Patrol to Hosrefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Behavior-Interceptor-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[WeaponSystem:GVK-Universal-Weapons-Static90]
			[UsePlayerDistanceTimer:false]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[AutopilotData:GVK-Drone-Autopilot-Interceptor-Passive]
			[SecondaryAutopilotData:GVK-Drone-Autopilot-Interceptor-Aggressive]
			[Triggers:GVK-Drone-All-Trigger-Init-Interceptor-KHAANEPH]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-DroneDefaults-SmallDrone]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorsefly]
			[TriggerGroups:GVK-Drone-Encounter-TriggerGroup-InactivityRetreat]
			[TriggerGroups:GVK-Alliance-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-Init-Interceptor-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-Init-Interceptor-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-Init-Interceptor-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,DroneSmall]
			[CustomStrings:EncounterDisplayName,aircraft]
			[SetBooleansTrue:GVK_MobilityType_Aircraft]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
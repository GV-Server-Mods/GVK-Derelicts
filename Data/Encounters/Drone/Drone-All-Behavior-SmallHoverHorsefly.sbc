<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallHoverHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-SmallHoverHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[AutopilotData:GVK-Drone-All-Autopilot-SmallHoverHorsefly-Patrol]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-SmallHoverHorsefly-Horsefly]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-GAALSIEN-TargetAcquiredChatter]
			[TriggerGroups:GVK-Drone-Encounter-TriggerGroup-InactivityRetreat]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorseflyKPL]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-SmallHoverDefeated]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
		<!-- SmallHoverHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-SmallHoverHorsefly-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:1]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[AltitudeTolerance:5000]
			[WaypointAbandonTimeTrigger:20]
			[WaypointTolerance:100]
			[RamMinDurationMs:0]
			[RamMaxDurationMs:0]
			[IdealMinSpeed:34]
			[IdealMaxSpeed:35]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:601]
			[OffsetPlanetMinTargetAltitude:3]
			[OffsetPlanetMaxTargetAltitude:5]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- SmallHoverHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-SmallHoverHorsefly-Horsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:1]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[AltitudeTolerance:5000]
			[WaypointAbandonTimeTrigger:10]
			[WaypointTolerance:100]
			[RamMinDurationMs:6000]
			[RamMaxDurationMs:6001]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:100]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:800]
			[OffsetPlanetMinTargetAltitude:3]
			[OffsetPlanetMaxTargetAltitude:5]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallHoverHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-Sandskimmer-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:5]
			[MinimumPlanetAltitude:3]
			[AltitudeTolerance:10]
			[WaypointTolerance:50]
			[RamMinDurationMs:0]
			[RamMaxDurationMs:0]
			[IdealMinSpeed:39]
			[IdealMaxSpeed:40]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:200]
			[OffsetPlanetMinDistFromTarget:400]
			[OffsetPlanetMaxDistFromTarget:700]
			[OffsetPlanetMinTargetAltitude:3]
			[OffsetPlanetMaxTargetAltitude:4]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:10]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1500]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:0]
			[StrafeMaxCooldownMs:1]
			[StrafeSpeedCutOff:75]	
			[StrafeMinimumTargetDistance:500]
			[StrafeMinimumSafeAngleFromTarget:25]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>

<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Salvager Hover Drone Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Behavior-Salvager-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:true]
			[RetreatTimerTrigger:1800]
			[RetreatDespawnDistance:2000]
			[AutopilotData:GVK-Drone-Encounter-Autopilot-Salvager-GAALSIEN]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveDefenseHeartbeat]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-SalvagerDefeated]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-SalvagerRetreat]
			[TriggerGroups:GVK-Universal-TriggerGroup-SendTargets]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
		<!-- Salvager Patrol Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Autopilot-Salvager-GAALSIEN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[RotationMultiplier:0.5]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[AltitudeTolerance:5000]
			[WaypointAbandonTimeTrigger:60]
			[WaypointTolerance:100]
			[IdealMinSpeed:25]
			[IdealMaxSpeed:65]
			[MaxSpeedTolerance:10]
			[WaypointWaitTimeTrigger:10]
			[OffsetPlanetMinDistFromTarget:200]
			[OffsetPlanetMaxDistFromTarget:500]
			[OffsetPlanetMinTargetAltitude:0]
			[OffsetPlanetMaxTargetAltitude:10]
			[AngleAllowedForForwardThrust:120]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
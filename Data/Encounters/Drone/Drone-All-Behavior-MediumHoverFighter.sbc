<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Medium Hover Fighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-MediumHoverFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UseStaticGuns:true]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:10]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[AutopilotData:GVK-Drone-All-Autopilot-MediumHoverFighter-Patrol]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-MediumHoverFighter-Fighter]
			[Triggers:GVK-Universal-Trigger-TargetAcquiredChatter]
			[Triggers:GVK-Universal-Trigger-NoWeapon]
			[Triggers:GVK-Drone-All-Trigger-MediumCompromised]
			[Triggers:GVK-Drone-All-Trigger-MediumBeaconDisabled]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatNoTarget]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatTimer]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolFighter]
			BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<!-- Medium Hover Fighter Autopilot Primary Passive for Patrol behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-MediumHoverFighter-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0.5]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:15]
			[AltitudeTolerance:500]
			[WaypointTolerance:50]
			[IdealMinSpeed:29]
			[IdealMaxSpeed:30]
			[MaxSpeedTolerance:10]
			[WaypointAbandonTimeTrigger:6]
			[OffsetPlanetMinDistFromTarget:500]
			[OffsetPlanetMaxDistFromTarget:501]
			[OffsetPlanetMinTargetAltitude:15]
			[OffsetPlanetMaxTargetAltitude:16]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Medium Hover Fighter Autopilot Secondary -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-MediumHoverFighter-Fighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[UseProjectileLeadPrediction:false]
			[RotationMultiplier:1]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:4]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:15]
			[AltitudeTolerance:20]
			[IdealMinSpeed:30]
			[IdealMaxSpeed:60]
			[MaxSpeedTolerance:10]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1000]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:1]
			[StrafeMaxCooldownMs:2]
			[StrafeSpeedCutOff:50]
			[StrafeDistanceCutOff:500]	
			[StrafeMinimumTargetDistance:400]
			[StrafeMinimumSafeAngleFromTarget:25]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Medium Hover Fighter Autopilot Tertiary -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-MediumHoverFighter-Tertiary</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[UseProjectileLeadPrediction:false]
			[RotationMultiplier:2]
			[LimitRotationSpeed:false]
			[MaxRotationMagnitude:4]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:15]
			[AltitudeTolerance:20]
			[IdealMinSpeed:30]
			[IdealMaxSpeed:60]
			[MaxSpeedTolerance:10]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1000]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:1]
			[StrafeMaxCooldownMs:2]
			[StrafeSpeedCutOff:50]
			[StrafeDistanceCutOff:500]	
			[StrafeMinimumTargetDistance:400]
			[StrafeMinimumSafeAngleFromTarget:25]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Action group switch to Tertiary autopilot when strafing -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-MediumHoverFighterTertiaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[TargetDistance:2000]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5000]
			[StartsReady:true]
			[ConditionCheckResetsTimer:false]
			[Conditions:GVK-Drone-All-Condition-MediumHoverFighterTertiaryAutopilot]
			[Actions:GVK-Drone-All-Action-MediumHoverFighterTertiaryAutopilot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-MediumHoverFighterTertiaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckTargetAngleFromForward:true]
			[MinTargetAngle:0]
			[MaxTargetAngle:20]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-MediumHoverFighterTertiaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Tertiary]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-MediumHoverFighterSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[TargetDistance:2000]
			[StartsReady:true]
			[ConditionCheckResetsTimer:false]
			[Conditions:GVK-Drone-All-Condition-MediumHoverFighterSecondaryAutopilot]
			[Actions:GVK-Drone-All-Action-MediumHoverFighterSecondaryAutopilot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-MediumHoverFighterSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckTargetAngleFromForward:true]
			[MinTargetAngle:11]
			[MaxTargetAngle:180]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-MediumHoverFighterSecondaryAutopilot</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
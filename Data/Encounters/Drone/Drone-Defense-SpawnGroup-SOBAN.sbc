<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>
		<!-- These are separate from Drone Encounters since spawn groups are called directly by the spawner -->
		<!-- NDR Interceptor Flyer Single-->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<!--Do Not Edit-->
				<SubtypeId>GVK-Drone-Defense-SpawnGroup-SOBAN-InterceptorSingle</SubtypeId>
			</Id>
			<Description>
			[Modular Encounters SpawnGroup]
			[IgnoreCleanupRules:true]
			[ReplenishSystems:true]
			[ManipulationProfiles:GVK-Drone-All-Manipulation-Small5x5StandardTurrets]
			[ManipulationProfiles:GVK-Drone-All-Manipulation-Interceptor]
			[SpawnConditionsProfiles:GVK-Drone-Defense-SpawnCondition-SOBAN-SmallFlyerSingle]
			</Description>
			<IsPirate>true</IsPirate>
			<!--Do not edit-->
			<Frequency>0.2</Frequency>
			<Prefabs>
				<Prefab SubtypeId="NDR [SOBA] Strike Fighter">
					<Position>
						<X>0</X>
						<Y>0.0</Y>
						<Z>0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Strike Fighter</BeaconText>
					<Behaviour>GVK-Drone-All-Behavior-StrikeFighter-SOBAN</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>
		<!-- NDR Interceptor Flyer Squad -->
		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<!--Do Not Edit-->

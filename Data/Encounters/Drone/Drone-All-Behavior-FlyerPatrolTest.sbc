<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallFlyer-Interceptor Patrol to Hosrefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Behavior</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UseStaticGuns:true]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[AutopilotData:GVK-Drone-FylerPatrolTest-Autopilot-Passive]
			[SecondaryAutopilotData:GVK-Drone-FylerPatrolTest-Autopilot-Aggressive]
			[WeaponSystem:GVK-Universal-Weapons-Static90]
			[Triggers:GVK-Drone-All-Trigger-SmallBeaconDisabled]
			[Triggers:GVK-Drone-All-Trigger-SmallCrashed]
			[Triggers:GVK-Drone-All-Trigger-SmallCompromised]
			[Triggers:GVK-Drone-All-Trigger-BarrelRoll]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-GAALSIEN-TargetAcquiredChatter]
			[TriggerGroups:GVK-Drone-Encounter-TriggerGroup-InactivityRetreat]
			[Triggers:GVK-Drone-FylerPatrolTest-ManualTrigger-SwitchToHorsefly]
			[Triggers:GVK-Drone-FylerPatrolTest-ManualTrigger-SwitchToPatrol]
			[Triggers:GVK-Drone-FylerPatrolTest-Trigger-TargetNear]
			[Triggers:GVK-Drone-FylerPatrolTest-Trigger-LostTarget]
			[Triggers:GVK-Drone-FylerPatrolTest-Trigger-TargetFar]
			[Triggers:GVK-Drone-FylerPatrolTest-ManualTrigger-CreateKPL]
			[Triggers:GVK-Drone-FylerPatrolTest-Trigger-CheckforKPL]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
		<!-- SmallFlyer-Interceptor Passive Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Autopilot-Passive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0.5]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:300]
			[MinimumPlanetAltitude:200]
			[AltitudeTolerance:20]
			[WaypointTolerance:100]
			[BarrelRollMinDurationMs:0]
			[BarrelRollMaxDurationMs:0]
			[IdealMinSpeed:39]
			[IdealMaxSpeed:40]
			[SlowDownOnWaypointApproach:true]
			[WaypointWaitTimeTrigger:0]
			[MaxSpeedTolerance:10]
			[WaypointAbandonTimeTrigger:6]
			[OffsetPlanetMinDistFromTarget:400]
			[OffsetPlanetMaxDistFromTarget:500]
			[OffsetPlanetMinTargetAltitude:300]
			[OffsetPlanetMaxTargetAltitude:400]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- SmallFlyer-Interceptor Aggressive Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Autopilot-Aggressive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:true]
			[RotationMultiplier:0.5]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:400]
			[MinimumPlanetAltitude:300]
			[AltitudeTolerance:30]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointTolerance:200]
			[BarrelRollMinDurationMs:2000]
			[BarrelRollMaxDurationMs:4000]
			[IdealMinSpeed:70]
			[IdealMaxSpeed:100]
			[MaxSpeedTolerance:20]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:30]
			[OffsetSpaceMinDistFromTarget:900]
			[OffsetSpaceMaxDistFromTarget:1000]
			[OffsetPlanetMinDistFromTarget:500]
			[OffsetPlanetMaxDistFromTarget:1500]
			[OffsetPlanetMinTargetAltitude:400]
			[OffsetPlanetMaxTargetAltitude:500]
			[MaxVerticalSpeed:-1]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- trigger sequence to switch between patrol and horsefly -->
		<!-- These are manual so multiple other triggers can use them without interfering -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-ManualTrigger-SwitchToHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[Actions:GVK-Drone-FylerPatrolTest-Action-SwitchToHorsefly]
			[ToggleWithTriggerProfile:GVK-Drone-FylerPatrolTest-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Action-SwitchToHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Horsefly]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-FylerPatrolTest-Chat-SwitchToHorsefly]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Chat-SwitchToHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:true]
			[Author:FylerPatrolTest]
			[Color:Red]
			[ChatMessages:SwitchToHorsefly]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- should start false since it already spawns in Patrol mode -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-ManualTrigger-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Manual]
			[StartsReady:true]
			[Actions:GVK-Drone-FylerPatrolTest-Action-SwitchToPatrol]
			[ToggleWithTriggerProfile:GVK-Drone-FylerPatrolTest-ManualTrigger-SwitchToHorsefly]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Action-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Patrol]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-FylerPatrolTest-Chat-SwitchToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Chat-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:true]
			[Author:FylerPatrolTest]
			[Color:Red]
			[ChatMessages:SwitchToPatrol]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for aggressive action when target in range -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Trigger-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[Actions:GVK-Drone-FylerPatrolTest-Action-TargetNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Action-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[EnableTriggers:true]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-FylerPatrolTest-ManualTrigger-SwitchToHorsefly]
			[ManuallyActivatedTriggerNames:GVK-Drone-FylerPatrolTest-ManualTrigger-CreateKPL]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-FylerPatrolTest-Chat-TargetNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-ManualTrigger-CreateKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[StartsReady:true]
			[MinCooldownMs:20000]
			[MaxCooldownMs:20001]
			[Actions:GVK-Drone-FylerPatrolTest-Action-CreateKPL]
			[ToggleWithTriggerProfile:GVK-Drone-FylerPatrolTest-Trigger-CheckforKPL]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Action-CreateKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[CreateKnownPlayerArea:true]
			[KnownPlayerAreaRadius:4000]
			[KnownPlayerAreaTimer:5]
			[KnownPlayerAreaMaxSpawns:-1]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-FylerPatrolTest-Chat-CreateKPL]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Chat-CreateKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:true]
			[Author:FylerPatrolTest]
			[Color:Red]
			[ChatMessages:CreateKPL]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Chat-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:true]
			[Author:FylerPatrolTest]
			[Color:Red]
			[ChatMessages:TargetNear]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for passive action when target lost/out of range -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Trigger-CheckforKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:PlayerKnownLocation]
			[StartsReady:true]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Actions:GVK-Drone-FylerPatrolTest-Action-StillinKPL]
			[UseElseActions:true]
			[ElseActions:GVK-Drone-FylerPatrolTest-Action-NotinKPL]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Action-StillinKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:GVK-Drone-FylerPatrolTest-ManualTrigger-CreateKPL]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-FylerPatrolTest-Chat-StillinKPL]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Chat-StillinKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:true]
			[Author:FylerPatrolTest]
			[Color:Red]
			[ChatMessages:StillinKPL]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Action-NotinKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-FylerPatrolTest-ManualTrigger-SwitchToPatrol]
			[EnableTriggers:true]
			[EnableTriggerNames:GVK-Drone-FylerPatrolTest-ManualTrigger-CreateKPL]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-FylerPatrolTest-Trigger-CheckforKPL]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-FylerPatrolTest-Chat-NotinKPL]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Chat-NotinKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:true]
			[Author:FylerPatrolTest]
			[Color:Red]
			[ChatMessages:NotinKPL]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Trigger-LostTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:LostTarget]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[AllowTargetFarWithoutTarget:true]
			[Actions:GVK-Drone-FylerPatrolTest-Action-TargetFar]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Trigger-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetFar]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[AllowTargetFarWithoutTarget:true]
			[Actions:GVK-Drone-FylerPatrolTest-Action-TargetFar]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Action-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[EnableTriggers:true]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-FylerPatrolTest-ManualTrigger-SwitchToPatrol]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-FylerPatrolTest-Chat-TargetFar]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-FylerPatrolTest-Chat-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[BroadcastRandomly:true]
			[Author:FylerPatrolTest]
			[Color:Red]
			[ChatMessages:TargetFar]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
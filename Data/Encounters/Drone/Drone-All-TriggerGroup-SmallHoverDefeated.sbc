<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Hovers add the crashed trigger -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-TriggerGroup-SmallHoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Drone-All-Trigger-SmallHoverCompromised]			
			[Triggers:GVK-Drone-All-Trigger-SmallHoverBeaconDisabled]			
			[Triggers:GVK-Drone-All-Trigger-SmallHoverNoWeapon]			
			</Description>
		</EntityComponent>
		<!-- Manual Trigger sequence small NPC is defeated through Compromised, Beacon, Crashed or NoWeapon (instant delete) -->
		<!-- this is used to prevent multiple different defeated actions running at the same time -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-SmallHoverCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-SmallHoverDefeated]
			[Actions:GVK-Universal-Action-SmallBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-SmallHoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-SmallHoverDefeated]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallHoverCompromised]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallHoverBeaconDisabled]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallHoverNoWeapon]			
			[ForceDespawn:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-SmallHoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:GAALSIEN unit destroyed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when small NPC Beacon is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-SmallHoverBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-SmallHoverExplosion]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-SmallHoverExplosion</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallHoverCrashed]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallHoverBeaconDisabled]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallHoverNoWeapon]			
			[StopAllRotation:true]
			[StopAllThrust:true]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:false]
			[GenerateExplosion:true]
			[ExplosionRange:1]
			[ExplosionDamage:1]
			[ExplosionIgnoresVoxels:true]
			[RazeBlocksOfType:true]
			[RazeBlocksTypes:MyObjectBuilder_RemoteControl/RivalAIRemoteControlSmall]
			[TerminateBehavior:true]
			</Description>
		</EntityComponent>
		<!-- Random chance to ram or die when out of weapons -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-SmallHoverNoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:NoWeapon]
			[UseTrigger:true]
			[StartsReady:false]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[MaxActions:1]
			[ActionExecution:Random]
			[Actions:GVK-Drone-All-Action-SmallHoverNoWeapon]
			[Actions:GVK-Drone-All-Action-SmallHoverExplosion]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-SmallHoverNoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Ramming:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
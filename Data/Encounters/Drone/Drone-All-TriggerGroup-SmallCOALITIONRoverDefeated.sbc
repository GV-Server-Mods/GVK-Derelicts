<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-TriggerGroup-SmallCOALITIONRoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Drone-All-ManualTrigger-SmallCOALITIONRoverDefeated]
			[Triggers:GVK-Drone-All-Trigger-SmallCOALITIONRoverCompromised]			
			[Triggers:GVK-Drone-All-Trigger-SmallCOALITIONRoverBeaconDisabled]			
			[Triggers:GVK-Drone-All-Trigger-SmallCOALITIONRoverNoWeapon]			
			</Description>
		</EntityComponent>
		<!-- Manual Trigger sequence small NPC is defeated through Compromised, Beacon, or NoWeapon (instant delete) -->
		<!-- this is used to prevent multiple different defeated actions running at the same time -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-ManualTrigger-SmallCOALITIONRoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			[Actions:GVK-Drone-All-Action-SmallCOALITIONRoverDefeated]
			[Actions:GVK-Universal-Action-SmallExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-SmallCOALITIONRoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-SmallCOALITIONRoverDefeated]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallCOALITIONRoverCompromised]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallCOALITIONRoverBeaconDisabled]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallCOALITIONRoverNoWeapon]			
			[TerminateBehavior:true]
			[ForceDespawn:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-SmallCOALITIONRoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:{Faction} Craft destroyed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- shared action since compromised/nobeacon/noweapon would be identical -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-ManualTriggerSmallCOALITIONRoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-All-ManualTrigger-SmallCOALITIONRoverDefeated]
			[ForceManualTriggerActivation:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Small NPC RAI Remote is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-SmallCOALITIONRoverCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-ManualTriggerSmallCOALITIONRoverDefeated]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when small NPC Beacon is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-SmallCOALITIONRoverBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-ManualTriggerSmallCOALITIONRoverDefeated]
			</Description>
		</EntityComponent>
		<!-- Random chance to ram or die when out of weapons -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-SmallCOALITIONRoverNoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:NoWeapon]
			[UseTrigger:true]
			[StartsReady:false]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[MaxActions:1]
			[ActionExecution:Random]
			[Actions:GVK-Drone-All-Action-SmallCOALITIONRoverNoWeapon]
			[Actions:GVK-Drone-All-Action-ManualTriggerSmallCOALITIONRoverDefeated]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-SmallCOALITIONRoverNoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Ramming:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- MediumHoverHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-MediumHoverPatrolHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UseStaticGuns:true]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[AutopilotData:GVK-Drone-All-Autopilot-MediumHoverPatrolHorsefly-Passive]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-MediumHoverPatrolHorsefly-Aggressive]
			[Triggers:GVK-Universal-Trigger-GAALSIEN-TargetAcquiredChatter]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Drone-Encounter-Trigger-SpawnSmallCOALITIONAttackers]
			[TriggerGroups:GVK-Drone-Encounter-TriggerGroup-InactivityRetreat]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorsefly]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-MediumHoverDefeated]
			BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<!-- MediumHoverHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-MediumHoverPatrolHorsefly-Passive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0.5]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[AltitudeTolerance:5000]
			[WaypointAbandonTimeTrigger:10]
			[WaypointTolerance:100]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:40]
			[MaxSpeedTolerance:10]
			[OffsetPlanetMinDistFromTarget:500]
			[OffsetPlanetMaxDistFromTarget:501]
			[OffsetPlanetMinTargetAltitude:10]
			[OffsetPlanetMaxTargetAltitude:15]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-MediumHoverPatrolHorsefly-Aggressive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0.5]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[AltitudeTolerance:5000]
			[WaypointAbandonTimeTrigger:20]
			[WaypointTolerance:100]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:100]
			[MaxSpeedTolerance:10]
			[OffsetPlanetMinDistFromTarget:800]
			[OffsetPlanetMaxDistFromTarget:1500]
			[OffsetPlanetMinTargetAltitude:10]
			[OffsetPlanetMaxTargetAltitude:15]
			[AngleAllowedForForwardThrust:120]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
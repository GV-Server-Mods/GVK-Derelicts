<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LAV Hover Drone Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-LAV-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:false]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[AutopilotData:GVK-Drone-All-Autopilot-LAV-Passive]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-LAV-Aggressive]
			[TertiaryAutopilotData:GVK-Drone-All-Autopilot-LAV-BigAirTime]
			[Triggers:GVK-Universal-Trigger-TargetAcquiredChatter]
			[Triggers:GVK-Universal-Trigger-NoTargetsChatter]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-TurretTarget]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorsefly]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-FlyLevelOnJump]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-SmallRoverDefeated]
			[TriggerGroups:GVK-Alliance-TriggerGroup-PointsDroneSmall-SOBAN]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Hongorguard Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Elite-Behavior-Hongorguard-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[WeaponSystem:GVK-Universal-Weapons-Static06]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:2400]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[HorseFighterTimeApproaching:30]
			[HorseFighterTimeEngaging:30]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[AutopilotData:GVK-Drone-All-Autopilot-HoverCruiserHorsefly-Passive]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-Honorguard-Aggressive]
			[TertiaryAutopilotData:GVK-Drone-All-Autopilot-Honorguard-Tertiary]
			[Triggers:GVK-Drone-Elite-Trigger-Init-Hongorguard-KHAANEPH]
			[Triggers:GVK-Drone-Elite-Trigger-SpawnMediumEscorts-KHAANEPH]
			[Triggers:GVK-Drone-All-Trigger-SpawnInterceptorSingle-KHAANEPH]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-DroneDefaults-LargeDrone]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-AimAtTargetAngle]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolFighterKPL]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-ConvoySystem-Leader-TriggerGroup]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			[EscortOffsets:{X:150 Y:0 Z:0}]
			[EscortOffsets:{X:-150 Y:0 Z:0}]
			[RemoteControlCode:GVK-Boss]
			BountyOnKill=50000000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Elite-Trigger-Init-Hongorguard-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Session]
			[StartsReady:true]
			[MaxActions:-1]
			[ActionExecution:All]
			[Actions:GVK-Drone-Elite-Action-Init-Hongorguard-KHAANEPH]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Elite-Action-Init-Hongorguard-KHAANEPH</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,DroneElite]
			[CustomStrings:EncounterDisplayName,Elite Honorguard]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-Elite-Chat-Spawned]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
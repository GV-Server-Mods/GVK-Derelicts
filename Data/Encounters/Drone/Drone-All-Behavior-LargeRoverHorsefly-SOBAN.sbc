<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LargeRoverHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-LargeRoverHorsefly-SOBAN</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:2400]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[AutopilotData:GVK-Drone-All-Autopilot-LargeRoverHorsefly-Patrol]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-LargeRoverHorsefly-Horsefly]
			[TertiaryAutopilotData:GVK-Drone-All-Autopilot-LargeRoverHorsefly-Tertiary]
			[Triggers:GVK-Drone-All-Trigger-Init-LargeRoverHorsefly-SOBAN]
			[Triggers:GVK-Drone-All-Trigger-SpawnStrikeFighterSingle-SOBAN]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-DroneDefaults-LargeDrone]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorsefly]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-FlyAwayFailsafe]
			[TriggerGroups:GVK-ConvoySystem-Leader-TriggerGroup]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			BountyOnKill=3000000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-Init-LargeRoverHorsefly-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-Init-LargeRoverHorsefly-SOBAN]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-Init-LargeRoverHorsefly-SOBAN</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,DroneLarge]
			[CustomStrings:EncounterDisplayName,cruiser]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LargeFlyerHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-LargeFlyerHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Horsefly]
			[UseStaticGuns:true]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyPlayerAndGrid]
			[AutopilotData:GVK-Drone-All-Autopilot-LargeFlyerHorsefly]
			[Triggers:GVK-Universal-Trigger-SetEnemyReputation]
			[Triggers:GVK-Drone-All-Trigger-LargeFlyerBeaconDisabled]
			[Triggers:GVK-Drone-All-Trigger-LargeFlyerCrashed]
			[Triggers:GVK-Drone-All-Trigger-LargeFlyerCompromised]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Drone-All-Trigger-FireMissilesTimers]
			[Triggers:GVK-Drone-All-Trigger-FireRocketsTimers]
			[Triggers:GVK-Universal-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:GVK-Universal-Trigger-SPRTNoWeapon]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatNoTarget]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatTimer]
			BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<!-- LargeFlyerHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-LargeFlyerHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:true]
			[RotationMultiplier:0.5]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:300]
			[MinimumPlanetAltitude:250]
			[AltitudeTolerance:50]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointTolerance:250]
			[IdealMinSpeed:50]
			[IdealMaxSpeed:100]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:60]
			[OffsetSpaceMinDistFromTarget:900]
			[OffsetSpaceMaxDistFromTarget:1200]
			[OffsetPlanetMinDistFromTarget:1200]
			[OffsetPlanetMaxDistFromTarget:1700]
			[OffsetPlanetMinTargetAltitude:250]
			[OffsetPlanetMaxTargetAltitude:500]
			[MaxVerticalSpeed:20]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:300]
			[AngleAllowedForForwardThrust:180]
			</Description>
		</EntityComponent>
		<!-- LargeFlyerHorseFighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-LargeFlyerHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:HorseFighter]
			[UseStaticGuns:false]
			[UseTurrets:false]
			[MaxStaticWeaponRange:2000]
			[WeaponMaxAngleFromTarget:15]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[HorseFighterTimeApproaching:10]
			[HorseFighterTimeEngaging:10]
			[TargetData:GVK-Universal-Target-EnemyPlayerAndGrid]
			[AutopilotData:GVK-Drone-All-Autopilot-LargeFlyerHorseFighter]
			[Triggers:GVK-Universal-Trigger-SetEnemyReputation]
			[Triggers:GVK-Drone-All-Trigger-LargeFlyerBeaconDisabled]
			[Triggers:GVK-Drone-All-Trigger-LargeFlyerCrashed]
			[Triggers:GVK-Drone-All-Trigger-LargeFlyerCompromised]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Drone-All-Trigger-FireRocketsTimers]
			[Triggers:GVK-Drone-All-Trigger-FireMissilesTimers]
			[Triggers:GVK-Drone-All-Trigger-FireRailgunsTimers]
			[Triggers:GVK-Universal-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:GVK-Universal-Trigger-SPRTNoWeapon]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatNoTarget]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatTimer]
			BountyOnKill=1000000;
			</Description>
		</EntityComponent>
		<!-- LargeFlyerHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-LargeFlyerHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:50]
			[CollisionFallEvasionWaypointDistance:35]
			[UseProjectileLeadPrediction:true]
			[RotationMultiplier:0.7]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[MaxVerticalSpeed:20]
			[IdealPlanetAltitude:300]
			[MinimumPlanetAltitude:250]
			[AltitudeTolerance:50]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointTolerance:100]
			[IdealMinSpeed:50]
			[IdealMaxSpeed:75]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:25]
			[OffsetSpaceMinDistFromTarget:600]
			[OffsetSpaceMaxDistFromTarget:1200]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:1200]
			[OffsetPlanetMinTargetAltitude:250]
			[OffsetPlanetMaxTargetAltitude:500]
			[AllowStrafing:true]
			[StrafeMinDurationMs:2000]
			[StrafeMaxDurationMs:10000]
			[StrafeMinCooldownMs:0]
			[StrafeMaxCooldownMs:1]
			[StrafeSpeedCutOff:45]	
			[StrafeMinimumTargetDistance:600]
			[StrafeMinimumSafeAngleFromTarget:30]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:90]
			</Description>
		</EntityComponent>

			[IdealPlanetAltitude:10]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:5000]
			[CollisionEvasionWaypointDistance:300]
			[CollisionEvasionResumeDistance:150]
			[CollisionEvasionResumeTime:10]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointAbandonTimeTrigger:20]
			[WaypointTolerance:150]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:60]
			[OffsetPlanetMinDistFromTarget:1200]
			[OffsetPlanetMaxDistFromTarget:2000]
			[OffsetPlanetMinTargetAltitude:10]
			[OffsetPlanetMaxTargetAltitude:15]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Large NPC crashes into the ground -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-LargeCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[MaxActions:1]
			[Conditions:GVK-Drone-All-Condition-LargeCrashed]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-LargeCrashed]
			[Actions:GVK-Drone-All-Action-LargeDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-LargeCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckGridSpeed:true]
			[MinGridSpeed:0]
			[MaxGridSpeed:10]
			[AltitudeCheck:true]
			[MinAltitude:-999999]
			[MaxAltitude:10]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-LargeCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-LargeCompromised]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-LargeCrashed]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-LargeCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Gaalsien craft crashed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>

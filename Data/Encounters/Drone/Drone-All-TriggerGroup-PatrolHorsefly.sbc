<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Drone Patrol/Horsefly trigger group without KPL (Soban and Khaaneph) -->
		<!-- requires two autopilots: pimary passive and secondary aggressive -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-TriggerGroup-PatrolHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Drone-All-PatrolHorsefly-ManualTrigger-SwitchToHorsefly]
			[Triggers:GVK-Drone-All-PatrolHorsefly-ManualTrigger-SwitchToPatrol]
			[Triggers:GVK-Drone-All-PatrolHorsefly-Trigger-TargetNear]
			[Triggers:GVK-Drone-All-PatrolHorsefly-Trigger-LostTarget]
			[Triggers:GVK-Drone-All-PatrolHorsefly-Trigger-TargetFar]
			</Description>
		</EntityComponent>
		<!-- manual triggers so multiple triggers can reference it without complications -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorsefly-ManualTrigger-SwitchToHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[Actions:GVK-Drone-All-PatrolHorsefly-Action-SwitchToHorsefly]
			[ToggleWithTriggerProfile:GVK-Drone-All-PatrolHorsefly-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorsefly-Action-SwitchToHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Horsefly]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[UseChatBroadcast:false]
			[ChatData:GVK-Drone-All-PatrolHorsefly-Chat-SwitchToHorsefly]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorsefly-Chat-SwitchToHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:{GridName}]
			[Color:White]
			[ChatMessages:Switching to Horsefly.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]
			</Description>
		</EntityComponent>
		<!-- should start false since it already spawns in Patrol mode -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorsefly-ManualTrigger-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Manual]
			[StartsReady:true]
			[Actions:GVK-Drone-All-PatrolHorsefly-Action-SwitchToPatrol]
			[ToggleWithTriggerProfile:GVK-Drone-All-PatrolHorsefly-ManualTrigger-SwitchToHorsefly]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorsefly-Action-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Patrol]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			[UseChatBroadcast:false]
			[ChatData:GVK-Drone-All-PatrolHorsefly-Chat-SwitchToPatrol]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorsefly-Chat-SwitchToPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:{GridName}]
			[Color:White]
			[ChatMessages:Switching to Patrol.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]
			</Description>
		</EntityComponent>
		<!-- When target in 2km, become aggressive -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorsefly-Trigger-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[Actions:GVK-Drone-All-PatrolHorsefly-Action-TargetNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorsefly-Action-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-All-PatrolHorsefly-ManualTrigger-SwitchToHorsefly]
			[UseChatBroadcast:false]
			[ChatData:GVK-Drone-All-PatrolHorsefly-Chat-TargetNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorsefly-Chat-TargetNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:false]
			[Author:{GridName}]
			[Color:White]
			[ChatMessages:Target Near.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorsefly-Trigger-LostTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:LostTarget]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[AllowTargetFarWithoutTarget:true]
			[Actions:GVK-Drone-All-PatrolHorsefly-Action-TargetFar]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorsefly-Trigger-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetFar]
			[StartsReady:true]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[TargetDistance:2000]
			[AllowTargetFarWithoutTarget:true]
			[Actions:GVK-Drone-All-PatrolHorsefly-Action-TargetFar]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-PatrolHorsefly-Action-TargetFar</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[EnableTriggers:true]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-All-PatrolHorsefly-ManualTrigger-SwitchToPatrol]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
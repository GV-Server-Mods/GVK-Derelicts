<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-TriggerGroup-LargeRoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Drone-All-ManualTrigger-LargeRoverDefeated]
			[Triggers:GVK-Drone-All-Trigger-LargeRoverCompromised]			
			[Triggers:GVK-Drone-All-Trigger-LargeRoverBeaconDisabled]			
			[Triggers:GVK-Drone-All-Trigger-LargeRoverNoWeapon]			
			</Description>
		</EntityComponent>
		<!-- Manual Trigger sequence Large NPC is defeated through Compromised, Beacon, or NoWeapon (instant delete) -->
		<!-- this is used to prevent multiple different defeated actions running at the same time -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-ManualTrigger-LargeRoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-LargeRoverDefeated]
			[Actions:GVK-Universal-Action-LargeExplosionEffects]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-LargeRoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-LargeRoverDefeated]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-LargeRoverCompromised]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-LargeRoverBeaconDisabled]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-LargeRoverNoWeapon]			
			[TerminateBehavior:true]
			[ForceDespawn:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-LargeRoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:{Faction} Cruiser destroyed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- shared action since compromised/nobeacon/noweapon would be identical -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-ManualTriggerLargeRoverDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-All-ManualTrigger-LargeRoverDefeated]
			[ForceManualTriggerActivation:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Large NPC RAI Remote is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-LargeRoverCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-ManualTriggerLargeRoverDefeated]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Large NPC Beacon is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-LargeRoverBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-ManualTriggerLargeRoverDefeated]
			</Description>
		</EntityComponent>
		<!-- Random chance to retreat or do nothing when out of weapons -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-LargeRoverNoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:NoWeapon]
			[UseTrigger:true]
			[StartsReady:false]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[MaxActions:1]
			[ActionExecution:Random]
			[Actions:GVK-Drone-All-Action-LargeRoverNoWeapon]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-LargeRoverNoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:25]
			[Retreat:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
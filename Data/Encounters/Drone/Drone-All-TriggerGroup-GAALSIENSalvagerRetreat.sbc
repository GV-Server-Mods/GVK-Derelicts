<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Trigger sequence for Salvager to run away when player is near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-TriggerGroup-GAALSIENSalvagerRetreat</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Drone-All-Trigger-GAALSIENSalvagerPlayerNear]			
			[Triggers:GVK-Drone-All-Trigger-GAALSIENSalvagerDamage]			
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-GAALSIENSalvagerPlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:PlayerNear]
			[UseTrigger:true]
			[StartsReady:true]
			[TargetDistance:500]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-GAALSIENSalvagerRetreat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-GAALSIENSalvagerDamage</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Damage]
			[UseTrigger:true]
			[StartsReady:true]
			[DamageTypes:Any]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-GAALSIENSalvagerRetreat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-GAALSIENSalvagerRetreat</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Retreat:true]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-GAALSIENSalvagerRetreat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-GAALSIENSalvagerRetreat</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:GAALSIEN Salvager]
			[Color:Red]
			[ChatMessages:Enemy Detected, retreating immediately.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
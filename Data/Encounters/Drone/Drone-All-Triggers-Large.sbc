<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Trigger sequence when Large NPC RAI Remote is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-LargeCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-LargeCompromised]
			[Actions:GVK-Drone-All-Action-LargeDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-LargeBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-LargeCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-LargeCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-LargeCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Gaalsien craft destroyed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when large NPC Beacon is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-LargeBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Drone-All-Condition-LargeBeaconDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-LargeCompromised]
			[Actions:GVK-Drone-All-Action-LargeDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-LargeBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-LargeBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckForBlocksOfType:true]
			[BlocksOfType:MyObjectBuilder_Beacon]
			[UseFailCondition:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cruiser RAI Remote is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-CruiserCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-CruiserCompromised]
			[Actions:GVK-Drone-All-Action-LargeDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-LargeBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-CruiserCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-LargeBeaconDisabled]
			[DisableTriggerNames:GVK-Drone-All-Trigger-CruiserCompromised]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-CruiserCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-CruiserCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Gaalsien cruiser destroyed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cruiser NPC Beacon is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-CruiserBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Drone-All-Condition-CruiserBeaconDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-CruiserCompromised]
			[Actions:GVK-Drone-All-Action-LargeDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-LargeBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-CruiserBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckForBlocksOfType:true]
			[BlocksOfType:MyObjectBuilder_Beacon]
			[UseFailCondition:true]
			</Description>
		</EntityComponent>
		<!-- Action for Large drones when defeated to disable stuff -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-LargeDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-LargeCompromised]
			[DisableTriggerNames:GVK-Drone-All-Trigger-CruiserCompromised]
			[DisableTriggerNames:GVK-Drone-All-Trigger-LargeBeaconDisabled]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:false]
			[TerminateBehavior:true]
			[ForceDespawn:false]
			</Description>
		</EntityComponent>
		<!-- Flyers are handled different because they despawn on death, and have crashed trigger -->
		<!-- Trigger sequence when Large NPC crashes into the ground -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-LargeFlyerCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[MaxActions:1]
			[Conditions:GVK-Drone-All-Condition-LargeFlyerCrashed]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-LargeFlyerCrashed]
			[Actions:GVK-Drone-All-Action-LargeFlyerDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			[Actions:GVK-Universal-Action-LargeBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-LargeFlyerCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckGridSpeed:true]
			[MinGridSpeed:0]
			[MaxGridSpeed:10]
			[AltitudeCheck:true]
			[MinAltitude:-999999]
			[MaxAltitude:10]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-LargeFlyerCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-LargeFlyerCompromised]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-LargeFlyerCrashed]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-LargeFlyerCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Gaalsien aircraft crashed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Large NPC RAI Remote is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-LargeFlyerCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-LargeFlyerCompromised]
			[Actions:GVK-Drone-All-Action-LargeFlyerDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			[Actions:GVK-Universal-Action-LargeBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-LargeFlyerCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-LargeFlyerCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-LargeFlyerCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Gaalsien aircraft destroyed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cruiser NPC Beacon is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-LargeFlyerBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Drone-All-Condition-LargeFlyerBeaconDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-LargeFlyerCompromised]
			[Actions:GVK-Drone-All-Action-LargeFlyerDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			[Actions:GVK-Universal-Action-MediumBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-LargeFlyerBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckForBlocksOfType:true]
			[BlocksOfType:MyObjectBuilder_Beacon]
			[UseFailCondition:true]
			</Description>
		</EntityComponent>
		<!-- Action for Large drones when defeated to disable stuff and despawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-LargeFlyerDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-LargeFlyerCrashed]
			[DisableTriggerNames:GVK-Drone-All-Trigger-LargeFlyerCompromised]
			[DisableTriggerNames:GVK-Drone-All-Trigger-LargeFlyerBeaconDisabled]
			[ForceDespawn:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LAV Hover Drone Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Behavior-LAV-COALITION</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:true]
			[RetreatTimerTrigger:1800]
			[RetreatDespawnDistance:2000]
			[AutopilotData:GVK-Drone-Encounter-Autopilot-LAV-COALITION]
			[TargetData:TargetData:GVK-Universal-Target-EnemyPlayerAndGrid]
			[Triggers:GVK-Universal-Trigger-SetEnemyReputation]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[Triggers:GVK-Drone-Encounter-LAV-COALITION-Trigger-PlayerNear]
			[Triggers:GVK-Drone-Encounter-LAV-COALITION-Trigger-Compromised]
			[Triggers:GVK-Drone-Encounter-LAV-COALITION-Trigger-BeaconDisabled]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatNoTarget]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatTimer]
			</Description>
		</EntityComponent>
		<!-- LAV Patrol Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Autopilot-LAV-COALITION</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[RotationMultiplier:5]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:1]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:2.75]
			[AltitudeTolerance:50]
			[WaypointAbandonTimeTrigger:30]
			[WaypointTolerance:45]
			[IdealMinSpeed:25]
			[IdealMaxSpeed:65]
			[WaypointWaitTimeTrigger:0]
			[OffsetPlanetMinDistFromTarget:300]
			[OffsetPlanetMaxDistFromTarget:500]
			[OffsetPlanetMinTargetAltitude:0]
			[OffsetPlanetMaxTargetAltitude:5]
			[AngleAllowedForForwardThrust:120]
			[DisableInertiaDampeners:true]
			[MinimumPlanetAltitude:0]
			[UseSurfaceHoverThrustMode:false]
			[HoverPathStepDistance:50]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for LAV to spawn enemies when player is near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-LAV-COALITION-Trigger-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:PlayerNear]
			[UseTrigger:true]
			[StartsReady:true]
			[TargetDistance:2500]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-Encounter-LAV-COALITION-Action-PlayerNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-LAV-COALITION-Action-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[TriggerTimerBlocks:true]
			[TimerBlockNames:NPC Timer Resume Cruise]
			[SpawnEncounter:true]
			[Spawner:GVK-Drone-Encounter-LAV-COALITION-Spawner-PlayerNear]
			[UseChatBroadcast:false]
			[ChatData:GVK-Drone-Encounter-LAV-COALITION-Chat-PlayerNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-LAV-COALITION-Chat-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Coalition LAV]
			[Color:White]
			[ChatMessages:Enemies detected, requesting assistance!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-LAV-COALITION-Spawner-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:1]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-LightSandskimmerSquad]
			[MinDistance:500]
			[MaxDistance:750]
			[MinAltitude:20]
			[MaxAltitude:21]
			[InheritNpcAltitude:true]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when LAV is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-LAV-COALITION-Trigger-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-Encounter-LAV-COALITION-Action-Compromised]
			[Actions:GVK-Drone-All-Action-LargeFlyerDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Beacon is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-LAV-COALITION-Trigger-BeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Drone-All-Condition-LargeFlyerBeaconDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-Encounter-LAV-COALITION-Action-Compromised]
			[Actions:GVK-Drone-All-Action-LargeFlyerDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-LAV-COALITION-Action-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-Encounter-LAV-COALITION-Trigger-PlayerNear]
			[DisableTriggerNames:GVK-Drone-Encounter-LAV-COALITION-Trigger-Compromised]
			[DisableTriggerNames:GVK-Drone-Encounter-LAV-COALITION-Trigger-BeaconDisabled]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-Encounter-LAV-COALITION-Chat-Compromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-LAV-COALITION-Chat-Compromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Coalition LAV disabled.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
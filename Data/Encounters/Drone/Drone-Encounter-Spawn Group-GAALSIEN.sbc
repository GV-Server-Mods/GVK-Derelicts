		<SpawnGroup>
			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>GVK-Drone-Encounter-SpawnGroup-GAALSIEN-Salvager</SubtypeId>
			</Id>
			<Description>
			[Modular Encounters SpawnGroup]
			[IgnoreCleanupRules:true]
			[ReplenishSystems:true]
			[ManipulationProfiles:MES-Manipulation-RivalAi] 
			[SpawnConditionsProfiles:GVK-Drone-Encounter-SpawnConditionSalvager]
			</Description>
			<IsPirate>true</IsPirate>
			<Frequency>0.1</Frequency>
			<Prefabs>
				<Prefab SubtypeId="[NPC Drone] Gaalsien Salvager">
					<Position>
						<X>0.0</X>
						<Y>0.0</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>0</Speed>
					<BeaconText>Salvager</BeaconText>
					<Behaviour>GVK-Drone-Encounter-Behavior-Salvager</Behaviour>
				</Prefab>
			</Prefabs>
		</SpawnGroup>		

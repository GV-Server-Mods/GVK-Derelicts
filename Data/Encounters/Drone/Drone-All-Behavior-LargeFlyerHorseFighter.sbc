<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LargeFlyerHorseFighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-LargeFlyerHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[WeaponSystem:GVK-Universal-Weapons-Static06]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[HorseFighterTimeApproaching:10]
			[HorseFighterTimeEngaging:10]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[AutopilotData:GVK-Drone-All-Autopilot-LargeFlyerHorseFighter-Patrol]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-LargeFlyerHorseFighter-HorseFighter]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-GAALSIEN-TargetAcquiredChatter]
			[Triggers:GVK-Drone-Encounter-Trigger-SpawnSmallCOALITIONAttackers]
			[TriggerGroups:GVK-Drone-Encounter-TriggerGroup-InactivityRetreat]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorseFighterKPL]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-LargeFlyerDefeated]
			BountyOnKill=1500000;
			</Description>
		</EntityComponent>
		<!-- LargeFlyerHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-LargeFlyerHorseFighter-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:50]
			[CollisionFallEvasionWaypointDistance:35]
			[UseProjectileLeadPrediction:true]
			[RotationMultiplier:0.7]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[MaxVerticalSpeed:20]
			[IdealPlanetAltitude:300]
			[MinimumPlanetAltitude:250]
			[AltitudeTolerance:50]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointTolerance:100]
			[IdealMinSpeed:50]
			[IdealMaxSpeed:50]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:25]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:601]
			[OffsetPlanetMinTargetAltitude:300]
			[OffsetPlanetMaxTargetAltitude:500]
			[AllowStrafing:true]
			[StrafeMinDurationMs:2000]
			[StrafeMaxDurationMs:10000]
			[StrafeMinCooldownMs:0]
			[StrafeMaxCooldownMs:1]
			[StrafeSpeedCutOff:45]	
			[StrafeMinimumTargetDistance:600]
			[StrafeMinimumSafeAngleFromTarget:30]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:90]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- LargeFlyerHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-LargeFlyerHorseFighter-HorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:50]
			[CollisionFallEvasionWaypointDistance:35]
			[UseProjectileLeadPrediction:true]
			[RotationMultiplier:0.7]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[MaxVerticalSpeed:20]
			[IdealPlanetAltitude:400]
			[MinimumPlanetAltitude:300]
			[AltitudeTolerance:50]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointTolerance:100]
			[IdealMinSpeed:50]
			[IdealMaxSpeed:100]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:25]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:1201]
			[OffsetPlanetMinTargetAltitude:-100]
			[OffsetPlanetMaxTargetAltitude:100]
			[AllowStrafing:true]
			[StrafeMinDurationMs:2000]
			[StrafeMaxDurationMs:10000]
			[StrafeMinCooldownMs:0]
			[StrafeMaxCooldownMs:1]
			[StrafeSpeedCutOff:45]	
			[StrafeMinimumTargetDistance:600]
			[StrafeMinimumSafeAngleFromTarget:30]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:90]
			[MaxVelocityAngleForSpeedControl:45]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
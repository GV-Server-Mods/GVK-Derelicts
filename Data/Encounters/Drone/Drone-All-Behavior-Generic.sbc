			[BlockTypesToToggle:MyObjectBuilder_Beacon/RivalAIRemoteControlSmall]
			[BlockTypeToggles:Off]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-Crashed]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-Compromised]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-BeaconDisabled]

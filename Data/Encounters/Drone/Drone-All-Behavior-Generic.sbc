			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:COALITION]
			[Color:White]
			[ChatMessages:A Cruiser has been shot down.]
			[ChatAudio:GreetingSoundId-A]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-BeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Drone-All-Condition-BeaconDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-Compromised]
			[Actions:GVK-Drone-All-Action-Disabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-BeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckForBlocksOfType:true]
			[BlocksOfType:MyObjectBuilder_Beacon]
			[UseFailCondition:true]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence for Random Drone Encounter to retreat after a while-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Trigger-RetreatNoTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:NoTarget]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[ActionExecution:All]
			[MinCooldownMs:1800000]
			[MaxCooldownMs:1800001]
			[Conditions:GVK-Drone-Encounter-Condition-IsDroneEncounter]
			[Actions:GVK-Drone-Encounter-Action-Retreat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Trigger-RetreatTimer</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MaxActions:1]
			[ActionExecution:All]
			[MinCooldownMs:21600000]
			[MaxCooldownMs:21600001]
			[Conditions:GVK-Drone-Encounter-Condition-IsDroneEncounter]
			[Actions:GVK-Drone-Encounter-Action-Retreat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Condition-IsDroneEncounter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckForSpawnConditions:true]
			[RequiredSpawnConditions:GVK-Drone-Encounter-SpawnCondition-GAALSIEN-Salvager]
			[RequiredSpawnConditions:GVK-Drone-Encounter-SpawnCondition-GAALSIEN-SmallFlyerSingle]
			[RequiredSpawnConditions:GVK-Drone-Encounter-SpawnConditionSmallHoverSingle]
			[RequiredSpawnConditions:GVK-Drone-Encounter-SpawnConditionMediumHoverSingle]
			[RequiredSpawnConditions:GVK-Drone-Encounter-SpawnCondition-GAALSIEN-SmallFlyerSquad]
			[RequiredSpawnConditions:GVK-Drone-Encounter-SpawnCondition-GAALSIEN-MediumFlyerSingle]
			[RequiredSpawnConditions:GVK-Drone-Encounter-SpawnConditionLargeHoverSingle]
			[RequiredSpawnConditions:GVK-Drone-Encounter-SpawnConditionSmallHoverSquad]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Action-Retreat</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Retreat:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
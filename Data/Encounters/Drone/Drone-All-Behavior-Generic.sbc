<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- SmallFlyerHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-SmallFlyerHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Horsefly]
			[UseStaticGuns:true]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:5000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyPlayerAndGrid]
			[AutopilotData:GVK-Drone-All-Autopilot-SmallFlyerHorsefly]
			[Triggers:GVK-Drone-All-Trigger-BeaconDisabled]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Drone-All-Trigger-FireMissilesTimers]
			[Triggers:GVK-Drone-All-Trigger-FireRocketsTimers]
			[Triggers:GVK-Drone-All-Trigger-Crashed]
			[Triggers:GVK-Drone-All-Trigger-Compromised]
			[Triggers:GVK-Universal-Trigger-SPRTTargetAcquiredChatter]
			[Triggers:GVK-Universal-Trigger-SPRTNoWeapon]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatNoTarget]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatTimer]
			</Description>
		</EntityComponent>
		<!-- SmallFlyerHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-SmallFlyerHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:true]
			[RotationMultiplier:1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.5]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:250]
			[MinimumPlanetAltitude:150]
			[AltitudeTolerance:50]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointTolerance:150]
			[IdealMinSpeed:50]
			[IdealMaxSpeed:75]
			[OffsetPlanetMinDistFromTarget:500]
			[OffsetPlanetMaxDistFromTarget:1200]
			[OffsetPlanetMinTargetAltitude:150]
			[OffsetPlanetMaxTargetAltitude:400]
			[WaypointWaitTimeTrigger:0]
			[MaxVerticalSpeed:20]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:120]
			</Description>
		</EntityComponent>

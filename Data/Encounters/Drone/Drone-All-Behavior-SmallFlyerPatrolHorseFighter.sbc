<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
			<!-- SmallFlyerHorseFighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-SmallFlyerPatrolHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[WeaponSystem:GVK-Universal-Weapons-All]
			[HorseFighterTimeApproaching:10]
			[HorseFighterTimeEngaging:10]
			[UsePlayerDistanceTimer:false]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[AutopilotData:GVK-Drone-All-Autopilot-SmallFlyerPatrolHorseFighter-Patrol]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-SmallFlyerPatrolHorseFighter-HorseFighter]
			[Triggers:GVK-Drone-All-Trigger-Init-SmallFlyerPatrolHorseFighter]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-DroneDefaults-SmallDrone]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorseFighterKPL]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveDefenseHeartbeat]
			[TriggerGroups:GVK-Universal-TriggerGroup-ReceiveTargets]
			[TriggerGroups:GVK-Universal-TriggerGroup-DefeatedAndAttacked]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-Init-SmallFlyerPatrolHorseFighter</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-Init-SmallFlyerPatrolHorseFighter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-Init-SmallFlyerPatrolHorseFighter</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[SetCustomStrings:true]
			[CustomStrings:EncounterType,DroneSmall]
			[CustomStrings:EncounterDisplayName,aircraft]
			[SetBooleansTrue:GVK_MobilityType_Aircraft]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
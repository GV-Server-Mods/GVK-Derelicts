<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
			<!-- SmallFlyerHorseFighter Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-SmallFlyerPatrolHorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UseStaticGuns:true]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[HorseFighterTimeApproaching:10]
			[HorseFighterTimeEngaging:10]
			[TargetData:GVK-Universal-Target-EnemyGrids]
			[AutopilotData:GVK-Drone-All-Autopilot-SmallFlyerPatrolHorseFighter-Patrol]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-SmallFlyerPatrolHorseFighter-HorseFighter]
			[Triggers:GVK-Drone-All-Trigger-BarrelRoll]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-TargetAcquiredChatter]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatNoTarget]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatTimer]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorseFighter]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-SmallFlyerDefeated]
			BountyOnKill=500000;
			</Description>
		</EntityComponent>
		<!-- SmallFlyerHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-SmallFlyerPatrolHorseFighter-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[WaypointAbandonTimeTrigger:10]
			[RotationMultiplier:0.5]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[MaxVerticalSpeed:20]
			[IdealPlanetAltitude:250]
			[MinimumPlanetAltitude:150]
			[AltitudeTolerance:50]
			[WaypointTolerance:150]
			[RamMinDurationMs:0]
			[RamMaxDurationMs:0]
			[IdealMinSpeed:49]
			[IdealMaxSpeed:50]
			[OffsetPlanetMinDistFromTarget:500]
			[OffsetPlanetMaxDistFromTarget:501]
			[OffsetPlanetMinTargetAltitude:150]
			[OffsetPlanetMaxTargetAltitude:400]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1500]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:0]
			[StrafeMaxCooldownMs:1]
			[StrafeSpeedCutOff:45]	
			[StrafeMinimumTargetDistance:400]
			[StrafeMinimumSafeAngleFromTarget:30]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- SmallFlyerHorseFighter Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-SmallFlyerPatrolHorseFighter-HorseFighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[WaypointAbandonTimeTrigger:10]
			[RotationMultiplier:0.5]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[MaxVerticalSpeed:20]
			[IdealPlanetAltitude:350]
			[MinimumPlanetAltitude:150]
			[AltitudeTolerance:30]
			[WaypointTolerance:150]
			[RamMinDurationMs:6000]
			[RamMaxDurationMs:6001]
			[IdealMinSpeed:50]
			[IdealMaxSpeed:100]
			[OffsetPlanetMinDistFromTarget:400]
			[OffsetPlanetMaxDistFromTarget:701]
			[OffsetPlanetMinTargetAltitude:250]
			[OffsetPlanetMaxTargetAltitude:400]
			[AllowStrafing:true]
			[StrafeMinDurationMs:1500]
			[StrafeMaxDurationMs:5000]
			[StrafeMinCooldownMs:0]
			[StrafeMaxCooldownMs:1]
			[StrafeSpeedCutOff:45]	
			[StrafeMinimumTargetDistance:400]
			[StrafeMinimumSafeAngleFromTarget:30]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Salvager Hover Drone Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Behavior-Salvager-COALITION</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:true]
			[RetreatTimerTrigger:1800]
			[RetreatDespawnDistance:2000]
			[AutopilotData:GVK-Drone-Encounter-Autopilot-Salvager-COALITION]
			[SecondaryAutopilotData:GVK-Drone-Encounter-Autopilot-Salvager-COALITION]
			[TertiaryAutopilotData:GVK-Drone-All-Autopilot-COALITION-Salvager-Stop]
			[TargetData:TargetData:GVK-Universal-Target-EnemyGrids2km]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[Triggers:GVK-Drone-Encounter-Salvager-COALITION-Trigger-PlayerNear]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-FrontSensorStop]
			[TriggerGroups:GVK-Drone-Encounter-TriggerGroup-InactivityRetreat]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-SmallRoverDefeated]
			</Description>
		</EntityComponent>
		<!-- Salvager at wrecks does not spawn attacker sandskimmers -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Behavior-Salvager-COALITION-WreckSpawn</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:1800]
			[PlayerDistanceTrigger:4000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:true]
			[RetreatTimerTrigger:1800]
			[RetreatDespawnDistance:2000]
			[AutopilotData:GVK-Drone-Encounter-Autopilot-Salvager-COALITION]
			[SecondaryAutopilotData:GVK-Drone-Encounter-Autopilot-Salvager-COALITION]
			[TertiaryAutopilotData:GVK-Drone-All-Autopilot-COALITION-Salvager-Stop]
			[TargetData:TargetData:GVK-Universal-Target-EnemyGrids2km]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-FrontSensorStop]
			[TriggerGroups:GVK-Drone-Encounter-TriggerGroup-InactivityRetreat]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-SmallRoverDefeated]
			</Description>
		</EntityComponent>
		<!-- Salvager Patrol Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Autopilot-Salvager-COALITION</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[RotationMultiplier:1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.25]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:60]
			[AltitudeTolerance:5000]
			[WaypointAbandonTimeTrigger:30]
			[WaypointTolerance:55]
			[IdealPlanetAltitude:13]
			[IdealMinSpeed:25]
			[IdealMaxSpeed:30]
			[WaypointWaitTimeTrigger:10]
			[OffsetPlanetMinDistFromTarget:500]
			[OffsetPlanetMaxDistFromTarget:501]
			[OffsetPlanetMinTargetAltitude:9]
			[OffsetPlanetMaxTargetAltitude:10]
			[AngleAllowedForForwardThrust:45]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-COALITION-Salvager-Stop</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[RotationMultiplier:0]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:1]
			[IdealPlanetAltitude:13]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:5000]
			[WaypointAbandonTimeTrigger:15]
			[WaypointTolerance:1]
			[IdealMinSpeed:0]
			[IdealMaxSpeed:0]
			[MaxSpeedTolerance:1]
			[OffsetPlanetMinDistFromTarget:0]
			[OffsetPlanetMaxDistFromTarget:1]
			[OffsetPlanetMinTargetAltitude:13]
			[OffsetPlanetMaxTargetAltitude:14]
			[AngleAllowedForForwardThrust:0]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Salvager to spawn enemies when player is near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Salvager-COALITION-Trigger-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:PlayerNear]
			[UseTrigger:true]
			[StartsReady:true]
			[TargetDistance:2500]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-Encounter-Salvager-COALITION-Action-PlayerNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Salvager-COALITION-Action-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SpawnEncounter:true]
			[Spawner:GVK-Drone-Encounter-Salvager-COALITION-Spawner-PlayerNear]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-Encounter-Salvager-COALITION-Chat-PlayerNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Salvager-COALITION-Chat-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:COALITION Salvager]
			[Color:White]
			[ChatMessages:Enemies detected, requesting assistance!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:9999999]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Encounter-Salvager-COALITION-Spawner-PlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]
			[ProcessAsAdminSpawn:false]
			[MaxSpawns:1]
			[SpawnGroups:GVK-Drone-Defense-SpawnGroup-GAALSIEN-LightSandskimmerSquad]
			[MinDistance:500]
			[MaxDistance:750]
			[MinAltitude:20]
			[MaxAltitude:21]
			[InheritNpcAltitude:false]
			[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
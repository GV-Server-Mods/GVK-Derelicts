<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LargeRoverHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-LargeRoverHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Horsefly]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGaalsienBeacon]
			[AutopilotData:GVK-Drone-All-Autopilot-LargeRoverHorsefly]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[Triggers:GVK-Drone-All-Trigger-CoalitionRoverBeaconDisabled]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-TurretTarget]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Drone-All-Trigger-CoalitionRoverCompromised]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatNoTarget]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatTimer]
			[Triggers:GVK-Drone-All-Trigger-CoalitionPlayerNear]
			[Triggers:GVK-Drone-All-Trigger-CoalitionPlayerNotNear]
			[Triggers:GVK-Drone-All-Trigger-CoalitionRoverHasTarget]
			[Triggers:GVK-Drone-All-Trigger-CoalitionRoverNoTarget]
			[Triggers:GVK-Drone-All-Trigger-CoalitionHorizonAngleSteep]
			</Description>
		</EntityComponent>
		<!-- LargeRoverHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-LargeRoverHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0.1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.25]
			[DisableInertiaDampeners:true]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:10]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:30]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:50]
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:200]
			[CollisionEvasionResumeDistance:100]
			[CollisionEvasionResumeTime:10]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[CollisionEvasionWaypointFromEntityMaxAngle:90]
			[WaypointAbandonTimeTrigger:30]
			[WaypointTolerance:40]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:60]
			[OffsetPlanetMinDistFromTarget:800]
			[OffsetPlanetMaxDistFromTarget:1200]
			[OffsetPlanetMinTargetAltitude:10]
			[OffsetPlanetMaxTargetAltitude:15]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to stop when player is near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-CoalitionPlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:750]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[Actions:GVK-Drone-All-Action-CoalitionPlayerNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-CoalitionPlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Passive]
			[EnableBlocks:true]
			[EnableBlockNames:NPC Suspension]
			[EnableBlockStates:Off]
			[EnableTriggers:true]
			[EnableTriggerNames:GVK-Drone-All-Trigger-CoalitionPlayerNotNear]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-CoalitionRoverHasTarget]
			[DisableTriggerNames:GVK-Drone-All-Trigger-CoalitionRoverNoTarget]
			[DisableTriggerNames:GVK-Drone-All-Trigger-CoalitionHorizonAngleSteep]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:GVK-Drone-All-Trigger-CoalitionPlayerNotNear]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to stop when player is no longer near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-CoalitionPlayerNotNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Actions:GVK-Drone-All-Action-CoalitionPlayerNotNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-CoalitionPlayerNotNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Horsefly]
			[EnableBlocks:true]
			[EnableBlockNames:NPC Suspension]
			[EnableBlockStates:On]
			[EnableTriggers:true]
			[EnableTriggerNames:GVK-Drone-All-Trigger-CoalitionRoverHasTarget]
			[EnableTriggerNames:GVK-Drone-All-Trigger-CoalitionRoverNoTarget]
			[EnableTriggerNames:GVK-Drone-All-Trigger-CoalitionHorizonAngleSteep]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-CoalitionPlayerNotNear]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to turn on wheels when target near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-CoalitionRoverHasTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:HasTarget]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Actions:GVK-Drone-All-Action-CoalitionRoverHasTarget]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-CoalitionRoverHasTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[EnableBlocks:true]
			[EnableBlockNames:NPC Suspension]
			[EnableBlockStates:On]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to turn off wheels when target far -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-CoalitionRoverNoTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:NoTarget]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Actions:GVK-Drone-All-Action-CoalitionRoverNoTarget]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-CoalitionRoverNoTarget</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[EnableBlocks:true]
			[EnableBlockNames:NPC Suspension]
			[EnableBlockStates:Off]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to reverse wheel direction if the slope is too steep -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-CoalitionHorizonAngleSteep</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[Conditions:GVK-Drone-All-Condition-CoalitionHorizonAngleSteep]
			[Actions:GVK-Drone-All-Action-CoalitionHorizonAngleSteep]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-CoalitionHorizonAngleSteep</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[CheckHorizonAngle:true]
			[MinHorizonAngle:30]
			[MaxHorizonAngle:90]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-CoalitionHorizonAngleSteep</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[TriggerTimerBlocks:true]
			[TimerBlockNames:Timer Reverse Suspension]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Large NPC RAI Remote is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-CoalitionRoverCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-CoalitionRoverCompromised]
			[Actions:GVK-Drone-All-Action-LargeDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-CoalitionRoverCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-CoalitionRoverCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-CoalitionRoverCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:Coalition cruiser destroyed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Cruiser NPC Beacon is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-CoalitionRoverBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Drone-All-Condition-CoalitionRoverBeaconDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-CoalitionRoverCompromised]
			[Actions:GVK-Drone-All-Action-LargeDisabled]
			[Actions:GVK-Universal-Action-EditableOnCompromised]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-CoalitionRoverBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckForBlocksOfType:true]
			[BlocksOfType:MyObjectBuilder_Beacon]
			[UseFailCondition:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
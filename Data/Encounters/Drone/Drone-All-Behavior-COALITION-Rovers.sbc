<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LargeRoverHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-LargeRoverHorsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGAALSIENBeacon]
			[AutopilotData:GVK-Drone-All-Autopilot-LargeRoverHorsefly-Patrol]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-LargeRoverHorsefly-Horsefly]
			[TertiaryAutopilotData:GVK-Drone-All-Autopilot-LargeRoverHorsefly-Tertiary]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[Triggers:GVK-Universal-Trigger-COALITION-TargetAcquiredChatter]
			[Triggers:GVK-Universal-Trigger-COALITION-NoTargetsChatter]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-TurretTarget]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Drone-Encounter-Trigger-SpawnAnyGAALSIENAttackers]
			[TriggerGroups:GVK-Drone-Encounter-TriggerGroup-InactivityRetreat]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PlayerNearStop]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-LargeCOALITIONRoverDefeated]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorsefly]
			</Description>
		</EntityComponent>
		<!-- LargeRoverHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-LargeRoverHorsefly-Patrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.1]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:17.5]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:30]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:60]
			[UseVelocityCollisionEvasion:false]
			[CollisionEvasionWaypointDistance:200]
			[CollisionEvasionResumeDistance:100]
			[CollisionEvasionResumeTime:10]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[CollisionEvasionWaypointFromEntityMaxAngle:90]
			[WaypointAbandonTimeTrigger:30]
			[WaypointTolerance:55]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:30]
			[MaxSpeedTolerance:5]
			[OffsetPlanetMinDistFromTarget:800]
			[OffsetPlanetMaxDistFromTarget:801]
			[OffsetPlanetMinTargetAltitude:10]
			[OffsetPlanetMaxTargetAltitude:15]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- LargeRoverHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-LargeRoverHorsefly-Horsefly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.1]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:17.5]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:30]
			[UseSurfaceHoverThrustMode:true]
			[HoverPathStepDistance:80]
			[UseVelocityCollisionEvasion:false]
			[CollisionEvasionWaypointDistance:200]
			[CollisionEvasionResumeDistance:100]
			[CollisionEvasionResumeTime:10]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[CollisionEvasionWaypointFromEntityMaxAngle:90]
			[WaypointAbandonTimeTrigger:30]
			[WaypointTolerance:75]
			[IdealMinSpeed:35]
			[IdealMaxSpeed:50]
			[MaxSpeedTolerance:10]
			[OffsetPlanetMinDistFromTarget:800]
			[OffsetPlanetMaxDistFromTarget:1200]
			[OffsetPlanetMinTargetAltitude:10]
			[OffsetPlanetMaxTargetAltitude:15]
			[ReverseOffsetDistAltAboveHeight:false]
			[ReverseOffsetHeight:0]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-LargeRoverHorsefly-Tertiary</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:17.5]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:30]
			[UseSurfaceHoverThrustMode:false]
			[HoverPathStepDistance:60]
			[WaypointAbandonTimeTrigger:30]
			[WaypointTolerance:50]
			[IdealMinSpeed:0]
			[IdealMaxSpeed:0]
			[MaxSpeedTolerance:0]
			[OffsetPlanetMinDistFromTarget:0]
			[OffsetPlanetMaxDistFromTarget:1]
			[OffsetPlanetMinTargetAltitude:15]
			[OffsetPlanetMaxTargetAltitude:15]
			[AngleAllowedForForwardThrust:0]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
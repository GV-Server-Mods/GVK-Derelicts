<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Flyers add the crashed trigger -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-TriggerGroup-MediumFlyerDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Drone-All-ManualTrigger-MediumFlyerDefeated]
			[Triggers:GVK-Drone-All-Trigger-MediumFlyerCrashed]			
			[Triggers:GVK-Drone-All-Trigger-MediumFlyerCompromised]			
			[Triggers:GVK-Drone-All-Trigger-MediumFlyerBeaconDisabled]
			[Triggers:GVK-Drone-All-Trigger-MediumFlyerNoWeapon]
			</Description>
		</EntityComponent>
		<!-- Manual Trigger sequence Medium NPC is defeated through Compromised, Beacon, Crashed or NoWeapon (instant delete) -->
		<!-- this is used to prevent multiple different defeated actions running at the same time -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-ManualTrigger-MediumFlyerDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-MediumFlyerDefeated]
			[Actions:GVK-Universal-Action-MediumBlueExplosionEffects]
			[Actions:GVK-Universal-Action-Disabled]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-MediumFlyerDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-MediumFlyerDefeated]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-MediumFlyerCrashed]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-MediumFlyerCompromised]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-MediumFlyerBeaconDisabled]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-MediumFlyerNoWeapon]			
			[TerminateBehavior:true]
			[ForceDespawn:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-MediumFlyerDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:GAALSIEN aircraft destroyed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Medium NPC crashes into the ground (instant delete) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-MediumFlyerCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MinCooldownMs:5000]
			[MaxCooldownMs:5001]
			[MaxActions:1]
			[Conditions:GVK-Drone-All-Condition-MediumFlyerCrashed]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-ManualTriggerMediumFlyerDefeated]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-MediumFlyerCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckGridSpeed:true]
			[MinGridSpeed:0]
			[MaxGridSpeed:10]
			[AltitudeCheck:true]
			[MinAltitude:-999999]
			[MaxAltitude:10]
			</Description>
		</EntityComponent>
		<!-- shared action since compromised/crashed/nobeacon/noweapon would be identical -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-ManualTriggerMediumFlyerDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:GVK-Drone-All-ManualTrigger-MediumFlyerDefeated]
			[ForceManualTriggerActivation:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Medium NPC RAI Remote is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-MediumFlyerCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-ManualTriggerMediumFlyerDefeated]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when Medium NPC Beacon is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-MediumFlyerBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-ManualTriggerMediumFlyerDefeated]
			</Description>
		</EntityComponent>
		<!-- Random chance to retreat, die, or do nothing when out of weapons -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-MediumFlyerNoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:NoWeapon]
			[UseTrigger:false]
			[StartsReady:false]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[MaxActions:1]
			[ActionExecution:Random]
			[Actions:GVK-Drone-All-Action-MediumFlyerNoWeapon]
			[Actions:GVK-Drone-All-Action-ManualTriggerMediumFlyerDefeated]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-MediumFlyerNoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Chance:50]
			[Retreat:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
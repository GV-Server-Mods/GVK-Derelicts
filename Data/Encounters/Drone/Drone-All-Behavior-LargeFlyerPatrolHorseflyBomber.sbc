<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- LargeFlyerHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-LargeFlyerPatrolHorseflyBomber</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UseStaticGuns:true]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:true]
			[NoTargetTimerTrigger:900]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGrids2km]
			[AutopilotData:GVK-Drone-Autopilot-LargeFlyerPatrolHorseflyBomber-Passive]
			[SecondaryAutopilotData:GVK-Drone-Autopilot-LargeFlyerPatrolHorseflyBomber-Aggressive]
			[WeaponSystem:GVK-Universal-Weapons-Static90]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Universal-Trigger-GAALSIEN-TargetAcquiredChatter]
			[Triggers:GVK-Drone-Encounter-Trigger-SpawnSmallCOALITIONAttackers]
			[TriggerGroups:GVK-Drone-Encounter-TriggerGroup-InactivityRetreat]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorsefly]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-LargeFlyerDefeated]
			BountyOnKill=1500000;
			</Description>
		</EntityComponent>
		<!-- SmallFlyer-Interceptor Passive Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Autopilot-LargeFlyerPatrolHorseflyBomber-Passive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[RotationMultiplier:0.5]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:400]
			[MinimumPlanetAltitude:250]
			[AltitudeTolerance:50]
			[WaypointTolerance:100]
			[IdealMinSpeed:39]
			[IdealMaxSpeed:50]
			[SlowDownOnWaypointApproach:false]
			[WaypointWaitTimeTrigger:0]
			[MaxSpeedTolerance:10]
			[WaypointAbandonTimeTrigger:6]
			[OffsetPlanetMinDistFromTarget:600]
			[OffsetPlanetMaxDistFromTarget:601]
			[OffsetPlanetMinTargetAltitude:500]
			[OffsetPlanetMaxTargetAltitude:600]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- LargeFlyerHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-Autopilot-LargeFlyerPatrolHorseflyBomber-Aggressive</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:true]
			[RotationMultiplier:0.5]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.75]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:false]
			[IdealPlanetAltitude:600]
			[MinimumPlanetAltitude:500]
			[AltitudeTolerance:50]
			[CollisionEvasionWaypointCalculatedAwayFromEntity:true]
			[WaypointTolerance:250]
			[IdealMinSpeed:50]
			[IdealMaxSpeed:100]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:60]
			[OffsetSpaceMinDistFromTarget:900]
			[OffsetSpaceMaxDistFromTarget:1200]
			[OffsetPlanetMinDistFromTarget:1200]
			[OffsetPlanetMaxDistFromTarget:1700]
			[OffsetPlanetMinTargetAltitude:-100]
			[OffsetPlanetMaxTargetAltitude:100]
			[AngleAllowedForForwardThrust:180]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
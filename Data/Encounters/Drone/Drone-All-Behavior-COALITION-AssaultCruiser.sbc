<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- HoverCruiserHorsefly Behavior -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Behavior-COALITION-AssaultCruiser</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Patrol]
			[UseTurrets:true]
			[MaxStaticWeaponRange:-1]
			[WeaponMaxAngleFromTarget:180]
			[UseAmmoReplenish:true]
			[AmmoReplenishClipAmount:10]
			[MaxAmmoReplenishments:99999999]
			[UsePlayerDistanceTimer:true]
			[PlayerDistanceTimerTrigger:900]
			[PlayerDistanceTrigger:3000]
			[UseNoTargetTimer:false]
			[UseRetreatTimer:false]
			[TargetData:GVK-Universal-Target-EnemyGAALSIENBeacon]
			[AutopilotData:GVK-Drone-All-Autopilot-HoverCruiserHorsefly-Passive]
			[SecondaryAutopilotData:GVK-Drone-All-Autopilot-HoverCruiserHorsefly-Aggressive]
			[TertiaryAutopilotData:GVK-Drone-All-Autopilot-COALITION-AssaultCruiserTertiary]
			[Triggers:GVK-Universal-Trigger-UneditableOnSpawn]
			[Triggers:GVK-Drone-All-Trigger-TargetAttacker]
			[Triggers:GVK-Drone-All-Trigger-TurretTarget]
			[Triggers:GVK-Drone-All-Trigger-WeaponsToMaxRange]
			[Triggers:GVK-Drone-All-Trigger-FireMissilesTimers]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatNoTarget]
			[Triggers:GVK-Drone-Encounter-Trigger-RetreatTimer]
			[Triggers:GVK-Drone-All-Trigger-COALITION-LargeRoverCompromised]
			[Triggers:GVK-Drone-All-Trigger-COALITION-LargeRoverBeaconDisabled]
			[Triggers:GVK-Drone-All-Trigger-COALITION-AssaultCruiserPlayerNear]
			[Triggers:GVK-Drone-All-Trigger-COALITION-AssaultCruiserPlayerNotNear]
			[TriggerGroups:GVK-Drone-All-TriggerGroup-PatrolHorsefly]
			</Description>
		</EntityComponent>
		<!-- HoverCruiserHorsefly Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Autopilot-COALITION-AssaultCruiserTertiary</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseVelocityCollisionEvasion:false]
			[RotationMultiplier:0]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0]
			[DisableInertiaDampeners:false]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[IdealPlanetAltitude:15]
			[MinimumPlanetAltitude:0]
			[AltitudeTolerance:5000]
			[WaypointAbandonTimeTrigger:15]
			[WaypointTolerance:1]
			[IdealMinSpeed:0]
			[IdealMaxSpeed:0]
			[MaxSpeedTolerance:1]
			[OffsetPlanetMinDistFromTarget:0]
			[OffsetPlanetMaxDistFromTarget:1]
			[OffsetPlanetMinTargetAltitude:14]
			[OffsetPlanetMaxTargetAltitude:15]
			[AngleAllowedForForwardThrust:0]
			[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to stop when player is near -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-COALITION-AssaultCruiserPlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:400]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[Actions:GVK-Drone-All-Action-COALITION-AssaultCruiserPlayerNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-COALITION-AssaultCruiserPlayerNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:false]
			[NewBehaviorSubclass:Passive]
			[EnableTriggers:true]
			[EnableTriggerNames:GVK-Drone-All-Trigger-COALITION-AssaultCruiserPlayerNotNear]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:GVK-Drone-All-Trigger-COALITION-AssaultCruiserPlayerNotNear]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Tertiary]
			</Description>
		</EntityComponent>
		<!-- Trigger Sequence to stop when player is no longer near -->
		<!-- This is more suitable than ElseActions because it needs to stop applying the else action after player leaves -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-COALITION-AssaultCruiserPlayerNotNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[Actions:GVK-Drone-All-Action-COALITION-AssaultCruiserPlayerNotNear]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-COALITION-AssaultCruiserPlayerNotNear</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeBehaviorSubclass:false]
			[NewBehaviorSubclass:Patrol]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-COALITION-AssaultCruiserPlayerNotNear]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
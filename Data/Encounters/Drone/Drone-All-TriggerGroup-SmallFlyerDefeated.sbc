<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Flyers add the crashed trigger -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-TriggerGroup-SmallFlyerDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:GVK-Drone-All-Trigger-SmallFlyerCrashed]			
			[Triggers:GVK-Drone-All-Trigger-SmallFlyerCompromised]			
			[Triggers:GVK-Drone-All-Trigger-SmallFlyerBeaconDisabled]			
			[Triggers:GVK-Drone-All-Trigger-SmallFlyerNoWeapon]			
			</Description>
		</EntityComponent>
		<!-- Manual Trigger sequence small NPC is defeated through Compromised, Beacon, Crashed or NoWeapon (instant delete) -->
		<!-- this is used to prevent multiple different defeated actions running at the same time -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-SmallFlyerCompromised</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Compromised]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-SmallFlyerDefeated]
			[Actions:GVK-Universal-Action-SmallBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-SmallFlyerDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-SmallFlyerDefeated]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallFlyerCrashed]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallFlyerCompromised]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallFlyerBeaconDisabled]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallFlyerNoWeapon]			
			[ForceDespawn:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Chat-SmallFlyerDefeated</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Sensors]
			[Color:Blue]
			[ChatMessages:GAALSIEN aircraft destroyed.]
			[ChatAudio:ArcHudSensors]
			[BroadcastChatType:Notify]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when small NPC crashes into the ground (instant delete) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-SmallFlyerCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:false]
			[MinCooldownMs:3000]
			[MaxCooldownMs:3001]
			[MaxActions:1]
			[Conditions:GVK-Drone-All-Condition-SmallFlyerCrashed]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-SmallFlyerDestroyed]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-SmallBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Condition-SmallFlyerCrashed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckGridSpeed:true]
			[MinGridSpeed:0]
			[MaxGridSpeed:10]
			[AltitudeCheck:true]
			[MinAltitude:-999999]
			[MaxAltitude:10]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence when small NPC Beacon is disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-SmallFlyerBeaconDisabled</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:Timer]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:GVK-Universal-Condition-AllBeaconsDisabled]
			[MaxActions:1]
			[ActionExecution:All]
			[Actions:GVK-Drone-All-Action-SmallFlyerDestroyed]
			[Actions:GVK-Universal-Action-Disabled]
			[Actions:GVK-Universal-Action-SmallBlueExplosionEffects]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-SmallFlyerDestroyed</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:GVK-Drone-All-Chat-SmallFlyerDefeated]
			[DisableTriggers:true]
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallFlyerCrashed]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallFlyerCompromised]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallFlyerBeaconDisabled]			
			[DisableTriggerNames:GVK-Drone-All-Trigger-SmallFlyerNoWeapon]			
			[ForceDespawn:false]
			</Description>
		</EntityComponent>
		<!-- Random chance to ram or die when out of weapons -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Trigger-SmallFlyerNoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[Type:NoWeapon]
			[UseTrigger:true]
			[StartsReady:false]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[MaxActions:1]
			[ActionExecution:Random]
			[Actions:GVK-Drone-All-Action-SmallFlyerNoWeapon]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Drone-All-Action-SmallFlyerNoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[Ramming:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
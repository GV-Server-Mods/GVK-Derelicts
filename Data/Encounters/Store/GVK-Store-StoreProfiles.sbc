<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<!-- To sell grids at an NPC store:
1. 	Must have a StoreItem def with ItemType Prefab
2. 	Must be added to a BUILDER FactionType def as a GridsForSale (PrefabName)
3. 	Must be added to an MES Store as StoreIteme offer
4. 	(Optional) add DisplayName, Description, Icon, and TooltipImage tags into the prefab's .sbc
5a. (Optional) Icon and TooltipImage are difficult as DDS, just use a 256x256 PNG file. These load after the sbcB5 file is created.
5b. There is a bug that randomly breaks modded prefab textures on store blocks:
	https://support.keenswh.com/spaceengineers/pc/topic/49223-mod-added-ships-in-economy-stores-dont-have-icons
6a. (Optional) The store block needs to be near empty space for grids to spawn as it has a limited spawn radius (124m)
6b. This includes safezones on Singleplayer, but don't seem to affect Dedicated Server.
-->
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Store-StoreProfile-AllVehicles</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:GVK-Store-StoreItems-AllVehicles.xml]
			[MinOfferItems:5]
			[MaxOfferItems:5]
			[ItemsRequireInventory:false]
			[RequiredOffers:Starter Baserunner]
			[RequiredOffers:Combat Baserunner]
			[RequiredOffers:Support Cruiser]
			[RequiredOffers:Missile Cruiser]
			[RequiredOffers:Battlecruiser]
			[RequiredOffers:Siege Cruiser H2]
			[RequiredOffers:COALITION LAV]
			[RequiredOffers:Meerkat]
			[RequiredOffers:Light Hauler]
			[RequiredOffers:Strike Fighter]
			[RequiredOffers:Dragoon]
			[RequiredOffers:Kuda Bike]
			[RequiredOffers:Bulat Rover]
			[RequiredOffers:Croc Rover]
			[RequiredOffers:Patria]
			</Description>
		</EntityComponent>

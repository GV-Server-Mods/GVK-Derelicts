<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!--=== Trigger Sequences ===-->
		<!--NPC Defeated when all thrusters or gyros offline: Trigger warheads, generic SPRT Defeated Chat-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Generic-Trigger-SPRTCantFly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]

			[Type:Timer]
			[UseTrigger:true]
			[MinCooldownMs:15000]
			[MaxCooldownMs:15000]
			[StartsReady:false]
			[MaxActions:1]

			[Conditions:GVK-Generic-Condition-SPRTCantFly]
			[ConditionCheckResetsTimer:true]
			  
			[Actions:GVK-Generic-Action-SPRTDefeated]
			</Description>
		</EntityComponent>
		<!--future improvements coming to RAI to make this work better-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Generic-Condition-SPRTCantFly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]

			[UseConditions:true]
			[UseFailCondition:true]
			[MatchAnyCondition:true]
			[CheckForBlocksOfType:true]
			[BlocksOfType:MyObjectBuilder_Gyro]
			[BlocksOfType:MyObjectBuilder_Thrust]
			</Description>
		</EntityComponent>
		<!--NPC Chat when target is acquired-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Generic-Trigger-SPRTTargetAcquiredChatter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]

			[Type:AcquiredTarget]
			[UseTrigger:true]
			[StartsReady:true]
			[MaxActions:1]
			  
			[Actions:GVK-Generic-Action-SPRTTargetAcquiredChatter]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Generic-Action-SPRTTargetAcquiredChatter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
				
			[UseChatBroadcast:true]
			[ChatData:GVK-Generic-Chat-SPRTTargetAcquiredChatter]
			</Description>
		</EntityComponent>
		<!--NPC Retreat when all guns are disabled, does not work with WC1-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Generic-Trigger-SPRTNoWeapon</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]

			[Type:NoWeapon]
			[UseTrigger:false]
			[MinCooldownMs:15000]
			[MaxCooldownMs:15000]
			[StartsReady:false]
			[MaxActions:1]

			[Actions:GVK-Generic-Action-SPRTDefeated]
			</Description>
		</EntityComponent>
		<!--=== Chat ===-->
		<!--Generic SPRT Battle Chatter-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Generic-Chat-SPRTBattleChatter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]

			[UseChat:true]
			[MinTime:30]
			[MaxTime:90]
			[StartsReady:true]
			[Chance:10]
			[BroadcastRandomly:true]
			[SendToAllOnlinePlayers:true]
			[Author:{GridName}]
			[Color:Red]

			[ChatMessages:Lets dance!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:Your mother was a hamster and your father smelt of elderberries!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:Its just a flesh wound.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:wE hAvE cHiLdReN oN bOaRd, PlEaSe HoLd YoUr FiRe.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:You don't stand a chance.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:You're going to regret this.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:I’m a leaf on the wind!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:Tis but a scratch]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:Please enjoy the music while your party is being reached.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:Target is continuing to attack, requesting fire support!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:ouch, I felt that sim speed hit]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:I'm doing my part!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:This is pretty boring, you should drop your base coords in the chat]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:Hmmm, RBH fights better than this, and that’s saying something]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:I'm gonna whip yer sorry hide like a mule!]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			</Description>
		</EntityComponent>
		<!--Generic SPRT Target Acquired Chatter-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Generic-Chat-SPRTTargetAcquiredChatter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]

			[UseChat:true]
			[StartsReady:true]
			[Chance:50]
			[BroadcastRandomly:true]
			[SendToAllOnlinePlayers:true]
			[Author:{GridName}]
			[Color:Red]

			[ChatMessages:Target acquired.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:Target locked.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:Enemy ship in-sight.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:Lock S-Foils in attack position.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:I'm moving in.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]

			[ChatMessages:Tangos in-bound.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Chat]
			</Description>
		</EntityComponent>
		<!-- Create KPL upon Spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Generic-Trigger-CreateKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]

			[Type:Session]
			[UseTrigger:true]
			[StartsReady:true]
			[Conditions:
			[Actions:GVK-Generic-Action-CreateKPL]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Generic-Condition-CreateKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:true]
			[CheckForSpawnConditions:true]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-Salvager]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-SmallFlyerSingle]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-SmallHoverSingle]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-MediumHoverSingle]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-SmallFlyerSquad]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-MediumFlyerSingle]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-LargeHoverSingle]
			[RequiredSpawnConditions:GVK-SpawnConditions-DroneEncounters-SmallHoverSquad]
			[RequiredSpawnConditions:GVK-SpawnConditions-PlanetaryInstallations-SmallDerelict]
			[RequiredSpawnConditions:GVK-SpawnConditions-PlanetaryInstallations-MediumDerelict]
			[RequiredSpawnConditions:GVK-SpawnConditions-PlanetaryInstallations-LargeDerelict]
			[RequiredSpawnConditions:GVK-SpawnConditions-PlanetaryInstallations-SmallBuilding]
			[RequiredSpawnConditions:GVK-SpawnConditions-PlanetaryInstallations-MediumBuilding]
			[RequiredSpawnConditions:GVK-SpawnConditions-PlanetaryInstallations-LargeBuilding]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Generic-Action-CreateKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
				
			[CreateKnownPlayerArea:true]
			[KnownPlayerAreaRadius:2000]
			[KnownPlayerAreaTimer:21600]
			[UseChatBroadcast:true]
			[ChatData:GVK-Generic-Chat-CreateKPL]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVK-Generic-Chat-CreateKPL</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]

			[UseChat:false]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:1]
			[Author:COALITION]
			[Color:White]

			[ChatMessages:Creating KPL]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
		<!-- Horsefly Rover Mothership Behavior for Season 2 Event-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>Mothership-Rover-Behavior-Season2Event-Start</SubtypeId>
			</Id>
			<Description>
				[RivalAI Behavior]
				[BehaviorName:CargoShip]
				[UseStaticGuns:true]
				[MaxStaticWeaponRange:-1]
				[WeaponMaxAngleFromTarget:180]
				[UseAmmoReplenish:true]
				[AmmoReplenishClipAmount:10]
				[MaxAmmoReplenishments:99999999]
				[UsePlayerDistanceTimer:false]
				[PlayerDistanceTimerTrigger:0]
				[PlayerDistanceTrigger:15000]
				[UseNoTargetTimer:false]
				[NoTargetTimerTrigger:1800]
				[UseRetreatTimer:true]
				[RetreatTimerTrigger:3600]
				[RetreatDespawnDistance:2000]
				[EscortOffsets:{X:400 Y:0 Z:400}]
				[EscortOffsets:{X:-400 Y:0 Z:-400}]
				[EscortOffsets:{X:0 Y:0 Z:400}]
				[EscortOffsets:{X:400 Y:0 Z:-400}]
				[EscortOffsets:{X:-400 Y:0 Z:400}]
				[EscortOffsets:{X:400 Y:0 Z:0}]
				[EscortOffsets:{X:-400 Y:0 Z:0}]
				[AutopilotData:Mothership-Rover-Autopilot-Season2Event]
				[TargetData:GVK-Generic-TargetProfile-EnemyGrids]
				[OverrideTargetData:GVK-Convoy-TargetProfileOverride-EnemyGrids]
				[Triggers:DefenseDrone-Trigger-FireArchers]
				[Triggers:DefenseDrone-Trigger-StopArchers]
				[Triggers:DefenseDrone-Trigger-WeaponsToMaxRange]
				[Triggers:GVK-Generic-Trigger-SPRTTargetAcquiredChatter]
				[Triggers:Mothership-Trigger-SpawnEscorts]
				[Triggers:Mothership-Trigger-AssignEscortSlot]
				[Triggers:Mothership-Trigger-Compromised]
				[Triggers:Mothership-Trigger-Despawn]
				[Triggers:Mothership-Trigger-DespawnMES]
				[Triggers:DefenseDrone-Trigger-Compromised]
				[Triggers:GVK-Generic-Trigger-SPRTNoWeapon]
				[Triggers:Mothership-Trigger-ArrivedAtTarget]
				[RemoteControlCode:ConvoyEncounter]
				[CustomWaypoints:{X:101904 Y:64470 Z:66981}]
			</Description>
		</EntityComponent>
		<!-- Horsefly Rover Mothership Autopilot for Season 2 Event-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>Mothership-Rover-Autopilot-Season2Event</SubtypeId>
			</Id>
			<Description>
				[RivalAI Autopilot]
				[UseVelocityCollisionEvasion:false]
				[RotationMultiplier:0.05]
				[DisableInertiaDampeners:false]
				[FlyLevelWithGravity:true]
				[LevelWithGravityWhenIdle:true]
				[IdealPlanetAltitude:15]
				[MinimumPlanetAltitude:-100]
				[AltitudeTolerance:5000]
				[IdealMinSpeed:20]
				[IdealMaxSpeed:50]
				[MaxSpeedTolerance:5]
				[SlowDownOnWaypointApproach:true]
				[ExtraSlowDownDistance:1000]
				[WaypointTolerance:400]
				[LimitRotationSpeed:true]
				[MaxRotationMagnitude:0.1]
				[OffsetPlanetMinTargetAltitude:-50]
				[OffsetPlanetMaxTargetAltitude:50]
				[ReverseOffsetDistAltAboveHeight:false]
				[ReverseOffsetHeight:0]
				[AngleAllowedForForwardThrust:60]
				[MaxVelocityAngleForSpeedControl:180]
			</Description>
		</EntityComponent>

		<!-- Trigger sequence for Mothership to spawn escorts -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>Mothership-Trigger-SpawnEscorts</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:PlayerNear]
				[UseTrigger:true]
				[TargetDistance:2000]
				[StartsReady:true]
				[MinCooldownMs:120000]
				[MaxCooldownMs:240000]
				[Actions:Mothership-Action-SpawnEscorts]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>Mothership-Action-SpawnEscorts</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[Chance:100]
				[SetWeaponsToMaxRange:true]
				[SpawnEncounter:true]
				[Spawner:Mothership-Spawner-SpawnEscorts]
				[SpawnEncounter:true]
				[Spawner:Mothership-Spawner-SpawnHonorguard]
				[UseChatBroadcast:true]
				[ChatData:Mothership-Chat-Announce]
				[UseJetpackInhibitorEffect:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>Mothership-Spawner-SpawnHonorguard</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[SpawnMinCooldown:30]
				[SpawnMinCooldown:60]
				[MinDistance:1000]
				[MaxDistance:1500]
				[MinAltitude:20]
				[MaxAltitude:20]
				[MaxSpawns:3]
				[InheritNpcAltitude:false]
				[SpawnGroups:GVK-Drone-GAALSIEN-Honorguard]
				[ProcessAsAdminSpawn:true]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>Mothership-Spawner-SpawnEscorts</SubtypeId>
			</Id>
			<Description>
				[RivalAI Spawn]
				[UseSpawn:true]
				[SpawningType:CustomSpawn]
				[StartsReady:true]
				[MinDistance:500]
				[MaxDistance:1000]
				[MinAltitude:100]
				[MaxAltitude:400]
				[InheritNpcAltitude:true]
				[SpawnGroups:GVK-Drone-GAALSIEN-HornetIon]
				[SpawnGroups:GVK-Drone-GAALSIEN-SlicerIon]
				[SpawnGroups:GVK-Drone-GAALSIEN-ReaperIon]
				[ProcessAsAdminSpawn:true]
				[IgnoreSafetyChecks:true]
			</Description>
		</EntityComponent>
	
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		  <Id>
			  <TypeId>Inventory</TypeId>
			  <SubtypeId>Mothership-Chat-Announce</SubtypeId>
		  </Id>
		  <Description>

			  [RivalAI Chat]
			  
			  [UseChat:true]
			  [StartsReady:true]
			  [Chance:100]
			  [MaxChats:2]
			  [BroadcastRandomly:false]
			  [Author:COALITION]
			  [Color:White]
			  [GPSLabel:Convoy]
			  
			  [ChatMessages:A Gaalsien Convoy has been spotted near `{GPS}`]
			  [ChatAudio:ArcHudGPSNotification2]
			  [BroadcastChatType:Chat]
			  [ChatMessages:A Gaalsien Convoy has been spotted.]
			  [BroadcastChatType:Notify]
			  [SendToAllOnlinePlayers:true]

		  </Description>      
		</EntityComponent>
	
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>Mothership-Chat-SpawnEscorts</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[BroadcastRandomly:false]
				[Author:Mothership]
				[Color:Red]
				[ChatMessages:Fighters Inbound.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Drone to request an escort slot from Mothership -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>EscortDrone-Trigger-RequestEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:Timer]
				[UseTrigger:true]
				[MinCooldownMs:2000]
				[MaxCooldownMs:2000]
				[StartsReady:false]
				[MaxActions:1]
				[Actions:EscortDrone-Action-RequestEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>EscortDrone-Action-RequestEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[BroadcastCommandProfiles:true]
				[CommandProfileIds:EscortDrone-Command-RequestEscortSlot]
				[UseChatBroadcast:false]
				[ChatData:EscortDrone-Chat-RequestEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>EscortDrone-Command-RequestEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Command]
				[SingleRecipient:true]
				[MatchSenderReceiverOwners:true]
				[IgnoreAntennaRequirement:true]
				[IgnoreReceiverAntennaRequirement:true]
				[Radius:5000]
				[CommandCode:Mothership_RequestEscortSlot]
				[RequestEscortSlot:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>EscortDrone-Chat-RequestEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:Escort Drone]
				[Color:Red]
				[ChatMessages:Requesting escort slot.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Mothership to receive the Drone's escort request command -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>Mothership-Trigger-AssignEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Trigger]
				[Type:CommandReceived]
				[UseTrigger:true]
				[StartsReady:true]
				[MaxActions:-1]
				[CommandReceiveCode:Mothership_RequestEscortSlot]
				[Actions:Mothership-Action-AssignEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>Mothership-Action-AssignEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Action]
				[AssignEscortFromCommand:true]
				[UseChatBroadcast:false]
				[ChatData:Mothership-Chat-AssignEscortSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>Mothership-Chat-AssignEscortSlot</SubtypeId>
			</Id>
			<Description>
				[RivalAI Chat]
				[UseChat:true]
				[StartsReady:true]
				[Chance:100]
				[MaxChats:-1]
				[BroadcastRandomly:false]
				[Author:Mothership]
				[Color:Red]
				[ChatMessages:Assigning an escort slot.]
				[ChatAudio:GreetingSoundId-A]
				[BroadcastChatType:Chat]
				[SendToAllOnlinePlayers:true]
			</Description>
		</EntityComponent>
		<!-- Trigger sequence for Mothership to send disabled command to escorts -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>Mothership-Trigger-Compromised</SubtypeId>
			</Id>
